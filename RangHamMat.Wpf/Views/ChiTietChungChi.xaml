<Window x:Class="RangHamMat.Views.ChiTietChungChi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết chứng chỉ hành nghề"
        Width="880" Height="650"
        MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="DetailTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Chi tiết chứng chỉ hành nghề" FontSize="26" FontWeight="Bold"/>
                <TextBlock x:Name="lblHeaderTenCC" Text="Chứng chỉ" FontSize="14"
                           Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" FontSize="9" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="#10B981"/>
                    <TextBlock x:Name="lblHeaderTrangThai" Text="Còn hiệu lực" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- NỘI DUNG -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- THÔNG TIN CHỨNG CHỈ -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thông tin chứng chỉ" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Mã chứng chỉ" Style="{StaticResource DetailLabel}"/>
                                <TextBox x:Name="txtMaCC" IsReadOnly="True" Background="#F8FAFC" Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nhân viên sở hữu *" Style="{StaticResource DetailLabel}"/>
                                <ComboBox x:Name="cboNhanVien" DisplayMemberPath="HoTen" SelectedValuePath="MaNV" Height="40" Margin="0,0,0,14"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Số chứng chỉ *" Style="{StaticResource DetailLabel}"/>
                        <TextBox x:Name="txtSoChungChi" Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Tên chứng chỉ *" Style="{StaticResource DetailLabel}"/>
                        <TextBox x:Name="txtTenChungChi" Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Nơi cấp chứng chỉ *" Style="{StaticResource DetailLabel}"/>
                        <TextBox x:Name="txtNoiCap" Style="{StaticResource DetailTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- THỜI HẠN VÀ TRẠNG THÁI -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thời hạn &amp; Trạng thái" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Ngày cấp *" Style="{StaticResource DetailLabel}"/>
                        <DatePicker x:Name="dpNgayCap" Height="40" Margin="0,0,0,14"/>

                        <TextBlock Text="Hạn chứng chỉ (nếu có)" Style="{StaticResource DetailLabel}"/>
                        <DatePicker x:Name="dpHanChungChi" Height="40" Margin="0,0,0,14"/>

                        <TextBlock Text="Trạng thái *" Style="{StaticResource DetailLabel}"/>
                        <ComboBox x:Name="cboTrangThai" Height="40" Margin="0,0,0,14">
                            <ComboBoxItem Content="Còn hiệu lực"/>
                            <ComboBoxItem Content="Sắp hết hạn"/>
                            <ComboBoxItem Content="Hết hiệu lực"/>
                        </ComboBox>

                        <TextBlock Text="Ghi chú" Style="{StaticResource DetailLabel}"/>
                        <TextBox x:Name="txtGhiChu" MinHeight="75" Padding="10" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="0,0,0,14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Thông tin chứng chỉ được đồng bộ với CSDL hệ thống."
                       Foreground="{StaticResource Muted}" FontSize="12"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" x:Name="btnDong"
                    Content="Đóng" Width="95" Height="40" Click="btnDong_Click"/>

            <Button Grid.Column="3" x:Name="btnLuu"
                    Content="Lưu thay đổi" Width="130" Height="40"
                    Style="{StaticResource Primary}" Click="btnLuu_Click"/>
        </Grid>
    </Grid>
</Window>
