<UserControl x:Class="RangHamMat.Views.PhieuHuongDan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="850" MinHeight="460">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Nen" Color="#F5F8FC"/>
        <SolidColorBrush x:Key="Vien" Color="#DEE6F0"/>
        <SolidColorBrush x:Key="Chu" Color="#18304C"/>
        <SolidColorBrush x:Key="ChuPhu" Color="#64748B"/>
        <SolidColorBrush x:Key="Xanh" Color="#2563EB"/>
        <Style x:Key="Khung" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Vien}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="NutChinh" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Xanh}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NutPhu" TargetType="Button" BasedOn="{StaticResource NutChinh}">
            <Setter Property="Background" Value="#E9F0FA"/>
            <Setter Property="Foreground" Value="{StaticResource Chu}"/>
        </Style>
        <Style x:Key="Nhan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ChuPhu}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DuLieu" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Chu}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Otim" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Vien}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="CotBang" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F1F5FA"/>
            <Setter Property="Foreground" Value="{StaticResource Chu}"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Vien}"/>
        </Style>
        <Style x:Key="ONoDung" TargetType="TextBlock">
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Nen}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="18,16,18,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Phiếu hướng dẫn khám bệnh" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource Chu}"/>
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource ChuPhu}"
                           Text="Lấy thông tin từ phiếu tiếp nhận · Kiểm tra số thứ tự, khoa, phòng và bác sĩ trước khi in"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Làm mới danh sách" Style="{StaticResource NutPhu}"
                    Click="LamMoi_Click" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1" Margin="18,0,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Danh sách phiếu đã tiếp nhận; không tạo thêm bản ghi tiếp nhận trùng. -->
            <Border Style="{StaticResource Khung}" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Danh sách tiếp nhận" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource Chu}"/>
                        <TextBlock Text="Chọn một phiếu để xem hướng dẫn" Style="{StaticResource Nhan}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="txtTimKiem" Grid.Row="1" Style="{StaticResource Otim}"
                             TextChanged="txtTimKiem_TextChanged" Margin="0,0,0,10"
                             ToolTip="Tìm theo mã phiếu, mã bệnh nhân, tên bệnh nhân hoặc phòng"
                             AutomationProperties.Name="Tìm phiếu, bệnh nhân hoặc phòng"/>
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cboTrangThai" MinHeight="34" Padding="7,5"
                                  SelectionChanged="cboTrangThai_SelectionChanged" Margin="0,0,8,0"
                                  AutomationProperties.Name="Lọc trạng thái phiếu"/>
                        <CheckBox x:Name="chkHomNay" Grid.Column="1" Content="Hôm nay" VerticalAlignment="Center"
                                  Foreground="{StaticResource Chu}" IsChecked="False"
                                  Checked="chkHomNay_Changed" Unchecked="chkHomNay_Changed"/>
                    </Grid>
                    <DataGrid x:Name="gridPhieu" Grid.Row="3" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                              GridLinesVisibility="None" RowHeight="42" ColumnHeaderHeight="37"
                              BorderBrush="{StaticResource Vien}" BorderThickness="1"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ColumnHeaderStyle="{StaticResource CotBang}"
                              SelectionChanged="gridPhieu_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding SoThuTu}" Width="52"
                                                ElementStyle="{StaticResource ONoDung}"/>
                            <DataGridTextColumn Header="Bệnh nhân" Binding="{Binding HoTenBN}" Width="1.45*"
                                                ElementStyle="{StaticResource ONoDung}"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding TenPhong}" Width="1.1*"
                                                ElementStyle="{StaticResource ONoDung}"/>
                            <DataGridTextColumn Header="Tiếp nhận" Binding="{Binding ThoiGianTiepNhan, StringFormat='{}{0:dd/MM HH:mm}'}" Width="100"
                                                ElementStyle="{StaticResource ONoDung}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="lblSoLuong" Grid.Row="4" Foreground="{StaticResource ChuPhu}"
                               Margin="0,12,0,0" Text="Chưa tải danh sách"/>
                </Grid>
            </Border>

            <!-- Xem trước trong vùng nội dung, không có popup nhập liệu. -->
            <Border Style="{StaticResource Khung}" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chi tiết và bản xem trước" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource Chu}"/>
                            <TextBlock x:Name="lblMaPhieu" Text="Chưa chọn phiếu" Style="{StaticResource Nhan}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="lblTrangThai" Grid.Column="1" Foreground="{StaticResource Xanh}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#F1F6FF" CornerRadius="8" Margin="0,16,0,12" Padding="12">
                        <TextBlock Foreground="{StaticResource Chu}" TextWrapping="Wrap"
                                   Text="Phiếu hướng dẫn lấy dữ liệu từ tiếp nhận. Để thay đổi bác sĩ, phòng, dịch vụ hoặc số thứ tự, hãy sửa ở nghiệp vụ tiếp nhận/điều phối trước khi in."/>
                    </Border>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                        <Button x:Name="btnIn" Content="In / Lưu PDF (A5)" Style="{StaticResource NutChinh}"
                                Click="In_Click" IsEnabled="False"/>
                        <Button x:Name="btnMoKham" Content="Mở khám điều trị" Style="{StaticResource NutPhu}"
                                Click="MoKham_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource Vien}" BorderThickness="1" CornerRadius="8">
                        <DocumentViewer x:Name="viewerPhieu" Zoom="62" ShowPageBorders="True"
                                                Background="#E9EEF5"/>
                    </Border>
                    <TextBlock x:Name="lblThongBao" Grid.Row="4" Margin="0,12,0,0"
                               Foreground="{StaticResource ChuPhu}" TextWrapping="Wrap"
                               Text="Chọn phiếu để xem và in hướng dẫn."/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
