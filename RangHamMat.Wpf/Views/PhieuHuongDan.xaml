<UserControl x:Class="RangHamMat.Views.PhieuHuongDan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Phiếu hướng dẫn bệnh nhân" Style="{StaticResource Title}"/>
            <TextBlock Text="Mẫu nhập thông tin và xem trước phiếu hướng dẫn" Style="{StaticResource Subtitle}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Hồ sơ" Margin="0,0,0,6"/>
                        <ComboBox SelectionChanged="ComboBox_SelectionChanged"/>
                        <TextBlock Text="Lịch khám" Margin="0,0,0,6"/>
                        <ComboBox SelectionChanged="ComboBox_SelectionChanged"/>
                        <TextBlock Text="Bác sĩ" Margin="0,0,0,6"/>
                        <ComboBox SelectionChanged="ComboBox_SelectionChanged"/>
                        <TextBlock Text="Dịch vụ" Margin="0,0,0,6"/>
                        <ComboBox SelectionChanged="ComboBox_SelectionChanged"/>
                        <TextBlock Text="Số thứ tự" Margin="0,0,0,6"/>
                        <TextBox BorderBrush="Black" BorderThickness="1" />
                        <TextBlock Text="Thời gian tiếp nhận" Margin="0,0,0,6"/>
                        <TextBox BorderBrush="Black" BorderThickness="1" />
                        <TextBlock Text="Thông tin đã ghi nhận" Margin="0,18,0,6"/>
                        <TextBox BorderBrush="Black" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <TextBlock Text="Khoa tiếp nhận" Margin="0,18,0,6"/>
                        <ComboBox/>
                        <TextBlock Text="Phòng khám" Margin="0,18,0,6"/>
                        <ComboBox/>
                        <TextBlock Text="Ghi chú" Margin="0,18,0,6"/>
                        <TextBox BorderBrush="Black" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <TextBlock Text="Trạng thái" Margin="0,0,0,6"/>
                        <TextBox BorderBrush="Black" BorderThickness="1" />
                        <Button Content="Tạo bản xem trước" Style="{StaticResource Primary}" Margin="0,22,0,10"/>
                        <Button Content="In / Lưu PDF"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8">
                <FlowDocumentScrollViewer IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
