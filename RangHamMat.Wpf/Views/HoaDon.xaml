<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã tạo/chỉnh style PaymentTextInput: FontSize 13 và Padding 10,4 để ô số tiền/lý do trong thu/hoàn tiền cao 38 DIP như ComboBox; bổ sung giải thích bộ lọc, bảng và binding các nút. -->
<!-- AI hỗ trợ: bổ sung chú thích cho hóa đơn, thu/hoàn tiền và cấp thuốc. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl x:Class="RangHamMat.Views.HoaDon" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RangHamMat.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
                <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <views:InvoiceMoneyConverter x:Key="InvoiceMoney"/>
            <!-- AI hỗ trợ chỉnh giao diện: template TextBox có đệm ở vùng cuộn; giảm Padding để ô tiền/lý do cao 38 DIP như ComboBox. -->
            <!-- Style PaymentTextInput cho TextBox: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalTextInput} để dùng chung template và hành vi control. -->
            <Style x:Key="PaymentTextInput" TargetType="TextBox" BasedOn="{StaticResource HospitalTextInput}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="10,4"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Hóa đơn và thanh toán" Style="{StaticResource HospitalHeading}"/>
            <TextBlock Text="Thu phí dịch vụ đã xác nhận và thuốc đã cấp. Giữ cùng bệnh nhân, lần khám khi chuyển mục." Style="{StaticResource HospitalMuted}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,18,0,12">
            <StackPanel Width="240" Margin="0,0,14,10">
                <TextBlock Text="Bệnh nhân" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="PatientFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Patient_Changed" AutomationProperties.Name="Bệnh nhân"/>
            </StackPanel>
            <StackPanel Width="245" Margin="0,0,14,10">
                <TextBlock Text="Lần khám" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="VisitFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Visit_Changed" AutomationProperties.Name="Lần khám"/>
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,14,10">
                <TextBlock Text="Nhân viên thực hiện *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="EmployeeFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Employee_Changed" AutomationProperties.Name="Nhân viên thực hiện"/>
            </StackPanel>
            <!-- Thao tác Tải lại: gọi Reload_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
            <Button Content="Tải lại" Click="Reload_Click" Margin="0,20,8,10"/>
            <!-- Thao tác Lập hóa đơn: gọi Create_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
            <Button x:Name="CreateButton" Content="Lập hóa đơn" Click="Create_Click" Style="{StaticResource HospitalPrimary}" Margin="0,20,0,10"/>
        </WrapPanel>
        <TextBlock x:Name="PageStatus" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#8F3B32" AutomationProperties.LiveSetting="Polite"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="270"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource HospitalPanel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="InvoiceCount" Text="Hóa đơn" FontWeight="SemiBold" Margin="8,2,8,12"/>
                    <!-- Vùng InvoiceList: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
                    <ListBox x:Name="InvoiceList" Grid.Row="1" SelectionChanged="Invoice_Changed" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TrangThai}" Style="{StaticResource HospitalMuted}"/>
                                        <TextBlock Text="{Binding MaHD, StringFormat=Hóa đơn #{0}}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding HoTenBN}" Margin="0,7,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding NgayLap, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{StaticResource HospitalMuted}"/>
                                    <TextBlock Text="{Binding SoTienPhaiThu, Converter={StaticResource InvoiceMoney}}" Foreground="{StaticResource AccentDark}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <TabControl x:Name="DetailTabs" Grid.Column="2">
                <!-- Nhóm Hóa đơn / thu tiền: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
                <TabItem Header="Hóa đơn / thu tiền">
                    <Grid Margin="0,14,0,0">
                        <!-- Vùng EditorHost: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
                        <ContentControl x:Name="EditorHost" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="InvoiceContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="InvoiceEmpty" Text="Chọn hóa đơn để xem khoản thu và thanh toán. Chọn lần khám để lập hóa đơn mới." Style="{StaticResource HospitalMuted}" Margin="8,14"/>
                                <Border x:Name="InvoicePanel" Style="{StaticResource HospitalPanel}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="InvoiceTitle" Style="{StaticResource HospitalSection}" Margin="0,0,8,12"/>
                                        <WrapPanel>
                                            <!-- Thao tác Xác nhận: gọi Confirm_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                            <Button x:Name="ConfirmButton" Content="Xác nhận" Click="Confirm_Click" Style="{StaticResource HospitalPrimary}"/>
                                            <!-- Thao tác Hủy nháp: gọi Cancel_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                            <Button x:Name="CancelButton" Content="Hủy nháp" Click="Cancel_Click"/>
                                            <!-- Thao tác Xem trước / In…: gọi Print_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                            <Button Content="Xem trước / In…" Click="Print_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="InvoiceInfo" Style="{StaticResource HospitalMuted}" Margin="0,12,0,8"/>
                                        <WrapPanel Margin="0,0,0,12">
                                            <!-- Thao tác Hồ sơ: gọi Patient_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                            <Button Content="Hồ sơ" Click="Patient_Click"/>
                                            <!-- Thao tác Lần khám: gọi Visit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                            <Button Content="Lần khám" Click="Visit_Click"/>
                                            <!-- Thao tác Dịch vụ: gọi Services_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                            <Button Content="Dịch vụ" Click="Services_Click"/>
                                            <!-- Thao tác Đơn thuốc: gọi Prescription_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                            <Button Content="Đơn thuốc" Click="Prescription_Click"/>
                                        </WrapPanel>
                                        <!-- Bảng DetailGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
                                        <DataGrid x:Name="DetailGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="320" MinHeight="100">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Khoản thu" Binding="{Binding NoiDung}" Width="2*"/>
                                                <DataGridTextColumn Header="SL" Binding="{Binding SoLuong, StringFormat=N3}" Width="70"/>
                                                <DataGridTextColumn Header="Giá chốt" Binding="{Binding DonGiaChot, Converter={StaticResource InvoiceMoney}}" Width="110"/>
                                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, Converter={StaticResource InvoiceMoney}}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="TotalsText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,12"/>
                                        <TextBlock Text="Thu / hoàn tiền" Style="{StaticResource HospitalSection}"/>
                                        <WrapPanel x:Name="PaymentForm">
                                            <StackPanel Width="100" Margin="0,0,12,12">
                                                <TextBlock Text="Giao dịch" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="PaymentType" SelectedIndex="0">
                                                    <ComboBoxItem Content="Thu"/>
                                                    <ComboBoxItem Content="Hoàn"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Width="150" Margin="0,0,12,12">
                                                <TextBlock Text="Số tiền (₫) *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="AmountBox" Tag="DB:THANH_TOAN.SoTien" Style="{StaticResource PaymentTextInput}" AutomationProperties.Name="Số tiền thanh toán"/>
                                            </StackPanel>
                                            <StackPanel Width="180" Margin="0,0,12,12">
                                                <TextBlock Text="Phương thức *" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="MethodBox" SelectedIndex="0">
                                                    <ComboBoxItem Content="Tiền mặt"/>
                                                    <ComboBoxItem Content="Chuyển khoản"/>
                                                    <ComboBoxItem Content="Thẻ"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Width="250" Margin="0,0,12,12">
                                                <TextBlock Text="Lý do (bắt buộc khi hoàn)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="ReasonBox" Tag="DB:THANH_TOAN.LyDo" Style="{StaticResource PaymentTextInput}" AutomationProperties.Name="Lý do giao dịch"/>
                                            </StackPanel>
                                            <!-- Thao tác Ghi nhận giao dịch: gọi Payment_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                            <Button Content="Ghi nhận giao dịch" Click="Payment_Click" Style="{StaticResource HospitalPrimary}" Margin="0,20,0,12"/>
                                        </WrapPanel>
                                        <TextBlock Text="Lịch sử giao dịch" Style="{StaticResource HospitalSection}"/>
                                        <!-- Bảng PaymentGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
                                        <DataGrid x:Name="PaymentGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="240" MinHeight="90">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Thời gian" Binding="{Binding NgayThanhToan, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                                                <DataGridTextColumn Header="Loại" Binding="{Binding LoaiGiaoDich}" Width="60"/>
                                                <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien, Converter={StaticResource InvoiceMoney}}" Width="110"/>
                                                <DataGridTextColumn Header="Phương thức" Binding="{Binding PhuongThuc}" Width="130"/>
                                                <DataGridTextColumn Header="Nhân viên" Binding="{Binding NguoiThucHien}" Width="*"/>
                                                <DataGridTextColumn Header="Lý do" Binding="{Binding LyDo}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!-- Nhóm Cấp thuốc: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
                <TabItem Header="Cấp thuốc" x:Name="DispenseTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource HospitalPanel}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Cấp đủ đơn thuốc" Style="{StaticResource HospitalSection}" Margin="0,0,0,8"/>
                                <TextBlock Text="Chọn lần khám và đơn đã xác nhận. Thuốc được cấp đủ từ các lô còn sử dụng, chưa hết hạn trong kho đã chọn; ưu tiên lô nhập trước." Style="{StaticResource HospitalMuted}"/>
                                <WrapPanel Margin="0,18,0,0">
                                    <StackPanel Width="280" Margin="0,0,14,12">
                                        <TextBlock Text="Đơn thuốc *" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="PrescriptionFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Stock_Changed"/>
                                    </StackPanel>
                                    <StackPanel Width="240" Margin="0,0,14,12">
                                        <TextBlock Text="Kho cấp thuốc *" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="WarehouseFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Stock_Changed"/>
                                    </StackPanel>
                                    <!-- Thao tác Cấp thuốc và ghi sổ: gọi Dispense_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                    <Button x:Name="DispenseButton" Content="Cấp thuốc và ghi sổ" Click="Dispense_Click" Style="{StaticResource HospitalPrimary}" Margin="0,20,0,12"/>
                                </WrapPanel>
                                <TextBlock x:Name="DispenseInfo" Style="{StaticResource HospitalMuted}" Margin="0,0,0,12"/>
                                <TextBlock Text="Thuốc kê" Style="{StaticResource HospitalSection}"/>
                                <!-- Bảng PrescriptionGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
                                <DataGrid x:Name="PrescriptionGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="230" MinHeight="90">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thuốc" Binding="{Binding Thuoc}" Width="2*"/>
                                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat=N3}" Width="100"/>
                                        <DataGridTextColumn Header="Liều dùng" Binding="{Binding LieuDung}" Width="*"/>
                                        <DataGridTextColumn Header="Hướng dẫn" Binding="{Binding HuongDan}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Lô có thể cấp trong kho" Style="{StaticResource HospitalSection}"/>
                                <!-- Bảng StockGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
                                <DataGrid x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="280" MinHeight="90">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thuốc" Binding="{Binding Thuoc}" Width="2*"/>
                                        <DataGridTextColumn Header="Số lô" Binding="{Binding SoLo}" Width="100"/>
                                        <DataGridTextColumn Header="Ngày nhập" Binding="{Binding NgayNhap, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                                        <DataGridTextColumn Header="Hạn dùng" Binding="{Binding HanSuDung, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                                        <DataGridTextColumn Header="Tồn" Binding="{Binding TonKho, StringFormat=N3}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>

    