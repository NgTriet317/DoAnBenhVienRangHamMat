<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource WindowBase}" x:Class="RangHamMat.Views.ChonRang" Title="Chọn vị trí răng" Width="1000" Height="460" MinWidth="900" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Sơ đồ răng vĩnh viễn" Style="{StaticResource Title}" />
      <TextBlock Text="Bố cục chọn vị trí răng" Style="{StaticResource Subtitle}" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="HÀM TRÊN" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
        <UniformGrid Columns="16" />
        <UniformGrid Columns="16" Margin="0,16,0,10" />
        <TextBlock Text="HÀM DƯỚI" Foreground="{StaticResource Muted}" />
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Hủy" IsCancel="True" />
        <Button Content="Áp dụng vị trí" Style="{StaticResource Primary}" />
      </StackPanel>
      <TextBlock Text="Đã chọn: Chưa chọn" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</Window>