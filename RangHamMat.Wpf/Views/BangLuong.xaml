<!-- Giao diện BangLuong: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl x:Class="RangHamMat.Views.BangLuong"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1380" d:DesignHeight="860"
             FontFamily="Segoe UI" Background="#F5F4EF">
    <UserControl.Resources>
        <!-- Tài nguyên Muc (SolidColorBrush) dùng lại qua khóa XAML. -->
        <SolidColorBrush x:Key="Muc" Color="#17283B"/>
        <!-- Tài nguyên Phu (SolidColorBrush) dùng lại qua khóa XAML. -->
        <SolidColorBrush x:Key="Phu" Color="#718093"/>
        <!-- Tài nguyên Vien (SolidColorBrush) dùng lại qua khóa XAML. -->
        <SolidColorBrush x:Key="Vien" Color="#E9EBEA"/>
        <!-- Tài nguyên CanhDieuKhien (Style) áp dụng cho Button. -->
        <Style x:Key="CanhDieuKhien" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#14283B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CED7DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>
        <!-- Tài nguyên NhanNho (Style) áp dụng cho TextBlock. -->
        <Style x:Key="NhanNho" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#758399"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Tài nguyên OThongKe (Style) áp dụng cho Border. -->
        <Style x:Key="OThongKe" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <!-- Tài nguyên BoLoc (Style) áp dụng cho ComboBox. -->
        <Style x:Key="BoLoc" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#213145"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <!-- Tài nguyên OChiTiet (Style) áp dụng cho Border. -->
        <Style x:Key="OChiTiet" TargetType="Border">
            <Setter Property="Background" Value="#F5F7F7"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <!-- Tài nguyên GridCell (Style) áp dụng cho DataGridCell. -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EDF0F0"/>
        </Style>
    </UserControl.Resources>
    <Grid MinWidth="950" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Thiết kế riêng cho Lương: đầu trang tối, dải kỳ lương và thẻ số liệu. -->
            <Border Grid.Row="0" Background="#142436" Padding="30,26,28,27">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#EDB36A" VerticalAlignment="Center" Margin="0,0,11,0"/>
                            <TextBlock Text="QUẢN TRỊ NHÂN SỰ  /  SALARY STUDIO" Foreground="#B6CBD5" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Bảng lương &amp; hoa hồng" Foreground="White" FontSize="31" FontWeight="Bold"/>
                        <TextBlock Text="Theo dõi kỳ lương, đối soát công và chứng từ hoa hồng" Foreground="#AFC0CB" FontSize="13" Margin="0,8,0,17"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#27394B" CornerRadius="8" Padding="13,8" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="KỲ LƯƠNG" Foreground="#C1CCD2" FontSize="11" Margin="0,1,10,0"/>
                                    <!-- Trường lựa chọn cboThang. Chuyển sự kiện đến cboThang_SelectionChanged trong code-behind. -->
                                    <ComboBox x:Name="cboThang" SelectedIndex="9" SelectionChanged="cboThang_SelectionChanged" Width="65" Height="25" FontSize="12" Padding="0" Background="White">
                                        <ComboBoxItem Content="01"/><ComboBoxItem Content="02"/><ComboBoxItem Content="03"/><ComboBoxItem Content="04"/>
                                        <ComboBoxItem Content="05"/><ComboBoxItem Content="06"/><ComboBoxItem Content="07"/><ComboBoxItem Content="08"/>
                                        <ComboBoxItem Content="09"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
                                    </ComboBox>
                                    <!-- Ô nhập txtNam — 2026. Chuyển sự kiện đến txtNam_TextChanged trong code-behind. -->
                                    <TextBox x:Name="txtNam" Text="2026" TextChanged="txtNam_TextChanged" Width="58" Height="25" FontSize="12" Padding="3,2" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#213F46" CornerRadius="8" Padding="12,8">
                                <!-- Thông tin hiển thị lblTrangThaiKy — ● CHỜ ĐỐI SOÁT. -->
                                <TextBlock x:Name="lblTrangThaiKy" Text="●  CHỜ ĐỐI SOÁT" Foreground="#75E3CA" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- Nút thao tác Chấm công / Đối soát — Chấm công / Đối soát. Chuyển sự kiện đến btnMoChamCong_Click trong code-behind. -->
                        <Button Content="Chấm công / Đối soát" Click="btnMoChamCong_Click" Background="#315F60" Foreground="White" BorderThickness="0" Padding="14,10" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand"/>
                        <!-- Nút thao tác btnTaiLai — Làm mới. Chuyển sự kiện đến btnTaiLai_Click trong code-behind. -->
                        <Button x:Name="btnTaiLai" Content="Làm mới" Click="btnTaiLai_Click" Style="{StaticResource CanhDieuKhien}"/>
                        <!-- Nút thao tác btnTinhLuong — Tính lương kỳ này. Chuyển sự kiện đến btnTinhLuong_Click trong code-behind. -->
                        <Button x:Name="btnTinhLuong" Content="Tính lương kỳ này" Click="btnTinhLuong_Click" ToolTip="Tính lại phiếu nháp từ công đã duyệt, nghỉ phép, hoa hồng, phụ cấp và bảo hiểm" Background="#EDB36A" Foreground="#17283B"
                                Padding="18,10" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dải thống kê đặt riêng: không phủ lên bộ chọn kỳ lương. -->
            <Grid Grid.Row="1" Margin="28,18,14,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource OThongKe}">
                    <StackPanel><TextBlock Text="NHÂN VIÊN TRONG KỲ" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblTongNhanVien" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Muc}" Margin="0,5,0,0"/><TextBlock Text="Danh sách tính lương" Foreground="#8A96A3" FontSize="11"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OThongKe}">
                    <StackPanel><TextBlock Text="QUỸ LƯƠNG ĐANG LƯU" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblQuyLuong" Text="—" FontSize="27" FontWeight="Bold" Foreground="#0E756D" Margin="0,5,0,0"/><TextBlock Text="Số trong bản lương hiện tại" Foreground="#8A96A3" FontSize="11"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OThongKe}">
                    <StackPanel><TextBlock Text="CHỜ XÁC NHẬN CÔNG" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblChoDoiSoat" Text="—" FontSize="27" FontWeight="Bold" Foreground="#C17D35" Margin="0,5,0,0"/><TextBlock Text="Toàn bộ nhân viên trong kỳ" Foreground="#8A96A3" FontSize="11"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource OThongKe}">
                    <StackPanel><TextBlock Text="HOA HỒNG HỢP LỆ" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblHoaHong" Text="—" FontSize="27" FontWeight="Bold" Foreground="#48639E" Margin="0,5,0,0"/><TextBlock Text="Chỉ tính hóa đơn thu đủ" Foreground="#8A96A3" FontSize="11"/></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="28,0,28,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.85*" MinWidth="515"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*" MinWidth="340"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="18" Padding="19,17" BorderBrush="#E6EBED" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel LastChildFill="False" Margin="0,0,0,17">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Sổ lương nhân viên" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Muc}"/>
                                <TextBlock Text="Chọn một dòng để xem thành phần lương bên phải" FontSize="12" Foreground="{StaticResource Phu}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#F6F2E8" CornerRadius="8" Padding="11,7">
                                <!-- Thông tin hiển thị lblThongTinKy — KỲ LƯƠNG CHƯA TẢI. -->
                                <TextBlock x:Name="lblThongTinKy" Text="KỲ LƯƠNG CHƯA TẢI" Foreground="#96703B" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                            <!-- Ô nhập txtTimKiem. Chuyển sự kiện đến txtTimKiem_TextChanged trong code-behind. -->
                            <TextBox x:Name="txtTimKiem" Grid.Column="0" TextChanged="txtTimKiem_TextChanged" Padding="11,9" FontSize="13" BorderBrush="#DBE1E3" Background="#F8FAF9" ToolTip="Tìm mã hoặc tên nhân viên"/>
                            <!-- Trường lựa chọn cboChucVu. Chuyển sự kiện đến cboChucVu_SelectionChanged trong code-behind. -->
                            <ComboBox x:Name="cboChucVu" Grid.Column="1" SelectionChanged="cboChucVu_SelectionChanged" Margin="10,0,0,0" Style="{StaticResource BoLoc}" SelectedIndex="0"><ComboBoxItem Content="Tất cả chức vụ"/></ComboBox>
                            <!-- Trường lựa chọn cboTrangThai. Chuyển sự kiện đến cboTrangThai_SelectionChanged trong code-behind. -->
                            <ComboBox x:Name="cboTrangThai" Grid.Column="2" SelectionChanged="cboTrangThai_SelectionChanged" Margin="10,0,0,0" Style="{StaticResource BoLoc}" SelectedIndex="0">
                                <ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Nháp"/><ComboBoxItem Content="Đã chốt"/>
                            </ComboBox>
                        </Grid>
                        <!-- Danh sách gridBangLuong. Chuyển sự kiện đến gridBangLuong_SelectionChanged trong code-behind. -->
                        <DataGrid x:Name="gridBangLuong" Grid.Row="2" SelectionChanged="gridBangLuong_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False"
                                  RowHeaderWidth="0" HeadersVisibility="Column" GridLinesVisibility="None"
                                  AlternatingRowBackground="#FAFBFA" BorderThickness="0"
                                  ColumnHeaderHeight="41" RowHeight="44" FontSize="12" CellStyle="{StaticResource GridCell}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ NV" Binding="{Binding MaNV}" Width="78"/>
                                <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding HoTen}" Width="1.7*" MinWidth="145"/>
                                <DataGridTextColumn Header="CÔNG" Binding="{Binding CongThucTe, StringFormat=N2}" Width="65"/>
                                <DataGridTextColumn Header="HOA HỒNG" Binding="{Binding TienHoaHong, StringFormat=N0}" Width="95"/>
                                <DataGridTextColumn Header="THỰC NHẬN" Binding="{Binding TongLuong, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding TrangThai}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- Thông tin hiển thị lblGridRong — Chưa có dữ liệu cho kỳ lương này.. -->
                        <TextBlock x:Name="lblGridRong" Grid.Row="2" Visibility="Collapsed" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   FontSize="14" Foreground="#718093" TextWrapping="Wrap"
                                   Text="Chưa có dữ liệu cho kỳ lương này." />
                        <DockPanel Grid.Row="3" Margin="0,13,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Số liệu chưa xác nhận không dùng để thanh toán." Foreground="#8B96A1" FontSize="11" VerticalAlignment="Center"/>
                            <!-- Nút thao tác btnXemChiTiet — Chi tiết phiếu lương →. Chuyển sự kiện đến btnXemChiTiet_Click trong code-behind. -->
                            <Button DockPanel.Dock="Right" x:Name="btnXemChiTiet" Content="Chi tiết phiếu lương  →" Click="btnXemChiTiet_Click" Background="#E4ECE9" BorderThickness="0" Foreground="#1E5E59" FontWeight="SemiBold" Padding="12,8" Cursor="Hand"/>
                        </DockPanel>
                    </Grid>
                </Border>
                <!-- Tóm tắt phiếu bên phải, phần chi tiết cuộn riêng. -->
                <Border Grid.Column="2" Background="White" CornerRadius="18" BorderBrush="#E5E9EA" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="#EAF3F0" Padding="19,16" CornerRadius="18,18,0,0">
                            <StackPanel>
                                <TextBlock Text="PHIẾU LƯƠNG ĐANG CHỌN" Foreground="#42776C" FontSize="11" FontWeight="Bold"/>
                                <!-- Thông tin hiển thị lblNhanVienChiTiet — Chọn nhân viên trong sổ lương. -->
                                <TextBlock x:Name="lblNhanVienChiTiet" Text="Chọn nhân viên trong sổ lương"
                                           TextWrapping="Wrap" Foreground="#193E3B" FontSize="17" FontWeight="Bold" Margin="0,6,0,5"/>
                                <!-- Thông tin hiển thị lblMaPhieuChiTiet — —. -->
                                <TextBlock x:Name="lblMaPhieuChiTiet" Text="—" Foreground="#58766E" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
                            <StackPanel>
                                <Border Background="#F0F5F7" CornerRadius="9" Padding="12" Margin="0,0,0,13">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False"><TextBlock Text="Kỳ lương" Foreground="#647684"/><TextBlock x:Name="lblKyChiTiet" Text="—" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#203946"/></DockPanel>
                                        <DockPanel LastChildFill="False" Margin="0,7,0,0"><TextBlock Text="Công thực tế / chuẩn" Foreground="#647684"/><TextBlock x:Name="lblCongChiTiet" Text="—" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#203946"/></DockPanel>
                                        <DockPanel LastChildFill="False" Margin="0,7,0,0"><TextBlock Text="Trạng thái" Foreground="#647684"/><TextBlock x:Name="lblTrangThaiPhieu" Text="—" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#0E756D"/></DockPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="CÁC KHOẢN CỘNG" Style="{StaticResource NhanNho}" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Lương theo công"/><TextBlock x:Name="lblLuongCong" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Hoa hồng dịch vụ"/><TextBlock x:Name="lblHoaHongCaNhan" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Phụ cấp + Tăng ca"/><TextBlock x:Name="lblPhuCapTangCa" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                <TextBlock Text="CÁC KHOẢN TRỪ" Style="{StaticResource NhanNho}" Margin="0,11,0,10"/>
                                <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Bảo hiểm"/><TextBlock x:Name="lblBaoHiem" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Khấu trừ khác"/><TextBlock x:Name="lblKhauTru" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                <Border Background="#142436" CornerRadius="12" Padding="16" Margin="0,11,0,2">
                                    <StackPanel>
                                        <TextBlock Text="TỔNG THỰC NHẬN" Foreground="#B8C8D4" FontSize="11" FontWeight="Bold"/>
                                        <!-- Thông tin hiển thị lblThucNhanChiTiet — —. -->
                                        <TextBlock x:Name="lblThucNhanChiTiet" Text="—" Foreground="#F9C984" FontWeight="Bold" FontSize="26" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Background="#F9FAF8" BorderBrush="#EEF0EF" BorderThickness="0,1,0,0" Padding="17,12" CornerRadius="0,0,18,18">
                            <StackPanel>
                                <!-- Thông tin hiển thị lblDoiSoatChiTiet — Chọn nhân viên để kiểm tra điều kiện chốt.. -->
                                <TextBlock x:Name="lblDoiSoatChiTiet" Text="Chọn nhân viên để kiểm tra điều kiện chốt." TextWrapping="Wrap" FontSize="11" Foreground="#556B75" Margin="0,0,0,10"/>
                                <!-- Nút thao tác btnChotLuong — Chưa đủ điều kiện chốt. Chuyển sự kiện đến btnChotLuong_Click trong code-behind. -->
                                <Button x:Name="btnChotLuong" Content="Chưa đủ điều kiện chốt" IsEnabled="False" Click="btnChotLuong_Click"
                                        ToolTip="Chốt riêng phiếu đang chọn sau khi tính và đối soát đầy đủ"
                                        Foreground="White" Background="#196B60" BorderThickness="0" Padding="12,11" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <!-- Thông tin hiển thị lblThongBao — SALARY STUDIO • Tính phiếu nháp → kiểm tra từng nhân viên → chốt từ sau kỳ 5 ngày.. -->
            <TextBlock Grid.Row="3" Margin="28,0,28,16" x:Name="lblThongBao" Text="SALARY STUDIO  •  Tính phiếu nháp → kiểm tra từng nhân viên → chốt từ sau kỳ 5 ngày." Foreground="#88949E" FontSize="11"/>
        <!-- Chi tiết phiếu lương: xem toàn bộ trong bảng phiếu, không dùng MessageBox. -->
        <Grid x:Name="PhieuLuongOverlay" Grid.RowSpan="4" Panel.ZIndex="30" Visibility="Collapsed">
            <Border Background="#A50B1927"/>
            <Border Width="770" MaxHeight="760" Margin="20" Background="White" CornerRadius="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#142436" Padding="28,23" CornerRadius="18,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PHIẾU LƯƠNG NHÂN VIÊN" Foreground="#E8B978" FontSize="12" FontWeight="Bold"/>
                                <!-- Thông tin hiển thị lblTenPhieu — —. -->
                                <TextBlock x:Name="lblTenPhieu" Text="—" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,8,0,3"/>
                                <!-- Thông tin hiển thị lblChucVuPhieu — —. -->
                                <TextBlock x:Name="lblChucVuPhieu" Text="—" Foreground="#B9CCD6" FontSize="13"/>
                            </StackPanel>
                            <!-- Nút thao tác ✕ — ✕. Chuyển sự kiện đến btnDongPhieuLuong_Click trong code-behind. -->
                            <Button Grid.Column="1" Content="✕" Click="btnDongPhieuLuong_Click" FontSize="18" Width="38" Height="38"
                                    Background="#2F4457" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,19">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="MÃ PHIẾU" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblMaBLPhieu" Text="—" FontSize="15" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="KỲ LƯƠNG" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblKyPhieu" Text="—" FontSize="15" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="TRẠNG THÁI" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblTrangThaiPhieuDayDu" Text="—" Foreground="#0E756D" FontSize="15" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                            <Border Background="#F1F5F5" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="CÔNG THỰC TẾ" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblCongPhieu" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="CÔNG CHUẨN" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblCongChuanPhieu" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="NGÀY CHỐT" Style="{StaticResource NhanNho}"/><TextBlock x:Name="lblNgayChotPhieu" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CÁC KHOẢN CỘNG" Foreground="#177469" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Lương theo công"/><TextBlock x:Name="lblLuongCongPhieu" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                    <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Hoa hồng dịch vụ"/><TextBlock x:Name="lblHoaHongPhieu" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                    <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Phụ cấp"/><TextBlock x:Name="lblPhuCapPhieu" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                    <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Tăng ca"/><TextBlock x:Name="lblTangCaPhieu" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CÁC KHOẢN TRỪ" Foreground="#AB7144" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Bảo hiểm"/><TextBlock x:Name="lblBaoHiemPhieu" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                    <Border Style="{StaticResource OChiTiet}"><DockPanel LastChildFill="False"><TextBlock Text="Khấu trừ khác"/><TextBlock x:Name="lblKhauTruPhieu" Text="—" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel></Border>
                                    <TextBlock Text="Các khoản theo dữ liệu bảng lương đã lưu." TextWrapping="Wrap" FontSize="11" Foreground="#778899" Margin="3,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- Thông tin hiển thị lblGhiChuPhieu. -->
                            <TextBlock x:Name="lblGhiChuPhieu" Text="" TextWrapping="Wrap" Foreground="#5B6B78" FontSize="12" Margin="3,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#F1F6F4" BorderBrush="#D9E6E1" BorderThickness="0,1,0,0" Padding="26,17" CornerRadius="0,0,18,18">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="THỰC NHẬN" Foreground="#326C60" FontSize="12" FontWeight="Bold"/>
                                <!-- Thông tin hiển thị lblThucNhanPhieu — —. -->
                                <TextBlock x:Name="lblThucNhanPhieu" Text="—" Foreground="#0B685D" FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="Chỉ sử dụng phiếu đã chốt để chi trả." FontSize="11" Foreground="#778899"/>
                            </StackPanel>
                            <!-- Nút thao tác Đóng phiếu — Đóng phiếu. Chuyển sự kiện đến btnDongPhieuLuong_Click trong code-behind. -->
                            <Button DockPanel.Dock="Right" Content="Đóng phiếu" Click="btnDongPhieuLuong_Click"
                                    Background="#173F40" Foreground="White" Padding="22,11" BorderThickness="0"
                                    Cursor="Hand" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
