<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="RangHamMat.Views.BangLuong">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="Lương và hoa hồng"
                       Style="{StaticResource Title}" />

            <TextBlock
                Text="Theo dõi tiền công theo ca làm thực tế và hoa hồng dịch vụ trong từng tháng."
                Style="{StaticResource Subtitle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Bộ lọc -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,20">
            <WrapPanel VerticalAlignment="Center">

                <StackPanel Width="120" Margin="0,0,16,12">
                    <TextBlock Text="Tháng"
                               Foreground="{StaticResource Muted}"
                               Margin="0,0,0,8" />

                    <ComboBox
                        SelectedValue="{Binding Thang, Mode=TwoWay}"
                        SelectedValuePath="Content"
                        AutomationProperties.Name="Tháng tính lương">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                        <ComboBoxItem Content="5" />
                        <ComboBoxItem Content="6" />
                        <ComboBoxItem Content="7" />
                        <ComboBoxItem Content="8" />
                        <ComboBoxItem Content="9" />
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="11" />
                        <ComboBoxItem Content="12" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Width="120" Margin="0,0,16,12">
                    <TextBlock Text="Năm"
                               Foreground="{StaticResource Muted}"
                               Margin="0,0,0,8" />

                    <TextBox
                        Height="0"
                        Text="{Binding Nam, Mode=TwoWay}"
                        MaxLength="4"
                        AutomationProperties.Name="Năm tính lương" />
                </StackPanel>

                <StackPanel Width="260" Margin="0,0,16,12">
                    <TextBlock Text="Tìm nhân viên"
                               Foreground="{StaticResource Muted}"
                               Margin="0,0,0,8" />

                    <TextBox
                        Height="0"
                        Text="{Binding TuKhoa,
                            UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Nhập mã hoặc họ tên nhân viên"
                        AutomationProperties.Name="Tìm nhân viên theo mã hoặc họ tên" />
                </StackPanel>

                <StackPanel Width="210" Margin="0,0,16,12">
                    <TextBlock Text="Trạng thái thanh toán"
                               Foreground="{StaticResource Muted}"
                               Margin="0,0,0,8" />

                    <ComboBox
                        SelectedValue="{Binding TrangThaiLoc, Mode=TwoWay}"
                        SelectedValuePath="Content"
                        AutomationProperties.Name="Lọc trạng thái thanh toán">
                        <ComboBoxItem Content="Tất cả" />
                        <ComboBoxItem Content="Chưa thanh toán" />
                        <ComboBoxItem Content="Đã thanh toán" />
                    </ComboBox>
                </StackPanel>

                <Button Content="Xem bảng lương"
                        Command="{Binding XemBangLuongCommand}"
                        Style="{StaticResource Primary}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,12" />

                <Button Content="Ca làm việc"
                        Tag="MoTrang:CaLamViec"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,12" />

                <Button Content="Nhân sự"
                        Tag="MoTrang:NhanSu"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,12" />
            </WrapPanel>
        </Border>

        <!-- Bảng lương -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="24,18"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Bảng lương theo nhân viên"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock
                            Text="Tiền công theo ca và hoa hồng được trình bày riêng. Đơn vị tiền: VNĐ."
                            Foreground="{StaticResource Muted}"
                            TextWrapping="Wrap"
                            Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <DataGrid
                        x:Name="BangLuongGrid"
                        ItemsSource="{Binding BangLuongTheoCa}"
                        SelectedItem="{Binding NhanVienDuocChon, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        FrozenColumnCount="2"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Mã nhân viên"
                                Binding="{Binding MaNV}"
                                Width="130" />

                            <DataGridTextColumn
                                Header="Họ tên nhân viên"
                                Binding="{Binding HoTenNV}"
                                Width="210" />

                            <DataGridTextColumn
                                Header="Chức vụ"
                                Binding="{Binding TenChucVu}"
                                Width="160" />

                            <DataGridTextColumn
                                Header="Số ca thực tế"
                                Binding="{Binding SoCaThucTe}"
                                Width="130" />

                            <DataGridTextColumn
                                Header="Tiền công theo ca"
                                Binding="{Binding TienCongTheoCa,
                                    StringFormat={}{0:N0}}"
                                Width="170" />

                            <DataGridTextColumn
                                Header="Số lượt dịch vụ"
                                Binding="{Binding SoLuotDichVu}"
                                Width="140" />

                            <DataGridTextColumn
                                Header="Hoa hồng dịch vụ"
                                Binding="{Binding TienHoaHong,
                                    StringFormat={}{0:N0}}"
                                Width="170" />

                            <DataGridTextColumn
                                Header="Phụ cấp"
                                Binding="{Binding PhuCap,
                                    StringFormat={}{0:N0}}"
                                Width="140" />

                            <DataGridTextColumn
                                Header="Thưởng"
                                Binding="{Binding TienThuong,
                                    StringFormat={}{0:N0}}"
                                Width="140" />

                            <DataGridTextColumn
                                Header="Khấu trừ"
                                Binding="{Binding KhauTru,
                                    StringFormat={}{0:N0}}"
                                Width="140" />

                            <DataGridTextColumn
                                Header="Thực nhận"
                                Binding="{Binding ThucNhan,
                                    StringFormat={}{0:N0}}"
                                Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight"
                                                Value="SemiBold" />
                                        <Setter Property="Foreground"
                                                Value="{StaticResource AccentDark}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Header="Trạng thái"
                                Binding="{Binding TrangThaiThanhToan}"
                                Width="170" />

                            <DataGridTextColumn
                                Header="Ngày thanh toán"
                                Binding="{Binding NgayThanhToan,
                                    StringFormat={}{0:dd/MM/yyyy}}"
                                Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Trạng thái chưa có dữ liệu -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="480"
                        Margin="24,60,24,24">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding HasItems,
                                            ElementName=BangLuongGrid}"
                                        Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock
                            Text="Chưa có bảng lương"
                            FontSize="20"
                            FontWeight="SemiBold"
                            TextAlignment="Center" />

                        <TextBlock
                            Text="Chọn kỳ lương để xem tiền công theo ca và hoa hồng dịch vụ của nhân viên."
                            Foreground="{StaticResource Muted}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>