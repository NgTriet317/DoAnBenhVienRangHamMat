<!-- Màn hình chọn lượt chụp được giao cho người dùng, giới hạn vào quản lý ảnh của lượt đó. -->
<UserControl x:Class="RangHamMat.Views.AnhXquangDuocGiao" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource HospitalPanel}" Margin="0,0,0,12"><StackPanel>
   <DockPanel><Button Content="Tải lại" Click="Reload_Click" DockPanel.Dock="Right"/><TextBlock Text="Ảnh X-quang được giao" Style="{StaticResource HospitalHeading}"/></DockPanel>
   <TextBlock Text="Chọn lần khám có dịch vụ chụp được giao cho bạn. Chỉ quản lý ảnh, không thay chỉ định hoặc kết quả điều trị." TextWrapping="Wrap" Foreground="#64748B" Margin="0,8"/>
   <!-- Visit_Changed mở ảnh theo mã lần khám được chọn và giữ cùng ngữ cảnh người thao tác. -->
   <ComboBox x:Name="VisitPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Visit_Changed" AutomationProperties.Name="Lượt X-quang được giao"/>
  </StackPanel></Border>
  <!-- Vùng chứa điều khiển ảnh của lượt đang chọn; được xóa khi tải lại danh sách. -->
  <ContentControl x:Name="ImageHost" Grid.Row="1"/>
  <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="#9A3412" Margin="0,8,0,0"/>
 </Grid>
</UserControl>
