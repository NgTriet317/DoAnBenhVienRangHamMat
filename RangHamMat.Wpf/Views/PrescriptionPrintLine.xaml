<!-- Dòng thuốc nhúng trong FlowDocument; code-behind điền snapshot trước khi WPF đo và chia trang. -->
<UserControl x:Class="RangHamMat.Views.PrescriptionPrintLine" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" Foreground="#203B50" Background="#F7FAFC" Language="vi-VN" Focusable="False">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/></Style>
 </UserControl.Resources>
 <Border BorderBrush="#DCE7EE" BorderThickness="0,0,0,1">
  <!-- Độ rộng bốn cột khớp hàng tiêu đề: số thứ tự, thuốc/hàm lượng, số lượng/đơn vị và số ngày. -->
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="NumberText" FontSize="11" LineHeight="16.5" FontWeight="SemiBold" Foreground="#167D8D" Margin="7,10,4,8"/>
   <!-- Tên và hàm lượng cho phép xuống dòng; hàm lượng được ẩn khi nguồn không có giá trị. -->
   <StackPanel Grid.Column="1" Margin="7,8,8,8"><TextBlock x:Name="NameText" FontSize="14" LineHeight="21" FontWeight="SemiBold" Foreground="#173C54"/><TextBlock x:Name="StrengthText" FontSize="11" LineHeight="16.5" Foreground="#63798C" Margin="0,3,0,0"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="4,5,4,6"><TextBlock x:Name="QuantityText" FontSize="18" LineHeight="27" FontWeight="SemiBold" Foreground="#173C54" TextAlignment="Center"/><TextBlock x:Name="UnitText" FontSize="10" LineHeight="15" Foreground="#63798C" TextAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="3" Margin="4,7,4,6"><TextBlock x:Name="DaysText" FontSize="16" LineHeight="24" FontWeight="SemiBold" Foreground="#173C54" TextAlignment="Center"/><TextBlock Text="ngày" FontSize="10" LineHeight="15" Foreground="#63798C" TextAlignment="Center"/></StackPanel>
  </Grid>
 </Border>
</UserControl>
