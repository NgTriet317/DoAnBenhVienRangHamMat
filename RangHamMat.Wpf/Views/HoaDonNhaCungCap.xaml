<UserControl x:Class="RangHamMat.Views.HoaDonNhaCungCap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FC">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HdInk" Color="#17324B"/>
        <SolidColorBrush x:Key="HdMute" Color="#718498"/>
        <SolidColorBrush x:Key="HdBorder" Color="#DAE6F1"/>
        <Style x:Key="HdKhung" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource HdBorder}"/>
        </Style>
        <Style x:Key="HdNhan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HdMute}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="HdNhap" TargetType="TextBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD9E8"/>
            <Setter Property="Background" Value="#FAFCFF"/>
        </Style>
        <Style x:Key="HdChon" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD9E8"/>
        </Style>
        <Style x:Key="HdDanhSach" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Nen" Background="#FAFCFF" BorderBrush="#E4ECF4" BorderThickness="1" CornerRadius="12" Padding="13,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nen" Property="Background" Value="#F0F6FF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Nen" Property="Background" Value="#E9F3FF"/><Setter TargetName="Nen" Property="BorderBrush" Value="#337FCF"/><Setter TargetName="Nen" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="15,13,15,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#163856" CornerRadius="16" Padding="21,17" Margin="0,0,0,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HỒ SƠ MUA HÀNG · CHỨNG TỪ NGUỒN" Foreground="#A7D3F6" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Hóa đơn nhà cung cấp" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,4"/>
                    <TextBlock Text="Lưu hóa đơn mua hàng, xác nhận chứng từ trước khi ghi sổ phiếu nhập kho." Foreground="#D2E2F0" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻  Làm mới" Click="LamMoi_Click" Padding="14,9" Margin="0,0,9,0"/>
                    <Button Content="+  Hóa đơn mới" Click="TaoMoi_Click" Background="#E1F0FF" Foreground="#16589C" Padding="17,9" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource HdKhung}" Padding="15,12">
                <StackPanel><TextBlock Text="TỔNG HÓA ĐƠN" Style="{StaticResource HdNhan}"/><TextBlock x:Name="lblTong" Text="0" Foreground="{StaticResource HdInk}" FontSize="24" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource HdKhung}" Padding="15,12">
                <StackPanel><TextBlock Text="CHỜ XÁC NHẬN" Style="{StaticResource HdNhan}"/><TextBlock x:Name="lblCho" Text="0" Foreground="#BD7917" FontSize="24" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource HdKhung}" Padding="15,12">
                <StackPanel><TextBlock Text="ĐÃ XÁC NHẬN" Style="{StaticResource HdNhan}"/><TextBlock x:Name="lblDaXacNhan" Text="0" Foreground="#187855" FontSize="24" FontWeight="Bold"/></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="295"/><ColumnDefinition Width="13"/><ColumnDefinition Width="3*" MinWidth="470"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource HdKhung}" Padding="16" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,13">
                        <TextBlock Text="DANH SÁCH HÓA ĐƠN" Foreground="#708397" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Tra cứu theo nhà cung cấp" Foreground="{StaticResource HdInk}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,9"/>
                        <TextBox x:Name="txtTim" Style="{StaticResource HdNhap}" ToolTip="Tìm số hóa đơn hoặc tên nhà cung cấp" TextChanged="BoLoc_Changed"/>
                        <TextBlock Text="Tìm số hóa đơn, nhà cung cấp hoặc người lập" Foreground="#8C9BA9" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nhà cung cấp" Style="{StaticResource HdNhan}"/>
                            <ComboBox x:Name="cboLocNCC" Style="{StaticResource HdChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectionChanged="BoLoc_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Trạng thái" Style="{StaticResource HdNhan}"/>
                            <ComboBox x:Name="cboLocTrangThai" Style="{StaticResource HdChon}" SelectionChanged="BoLoc_Changed" SelectedIndex="0">
                                <ComboBoxItem Content="Tất cả"/>
                                <ComboBoxItem Content="Nháp"/>
                                <ComboBoxItem Content="Đã xác nhận"/>
                                <ComboBoxItem Content="Hủy"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="lstHoaDon" Grid.Row="2" Margin="0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource HdDanhSach}" SelectionChanged="HoaDon_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SoHoaDonNCC}" Foreground="#193952" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="7,3" Margin="7,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF1DA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã xác nhận"><Setter Property="Background" Value="#E1F4E9"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Hủy"><Setter Property="Background" Value="#FCE8E7"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#A26B0D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="Đã xác nhận"><Setter Property="Foreground" Value="#15784F"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="Hủy"><Setter Property="Foreground" Value="#B44640"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding TenNCC}" Foreground="#516B81" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding NgayHienThi}" Foreground="#8294A5" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TongTienHienThi}" Foreground="#153D5E" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="lblSoKetQua" Grid.Row="3" Text="0 hóa đơn" Foreground="#73889B" FontSize="12" Margin="2,10,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource HdKhung}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#ECF5FF" Padding="20,16" BorderBrush="#DAE8F6" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BIỂU MẪU HÓA ĐƠN NGUỒN" Foreground="#3C78AF" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="lblCheDo" Text="Thêm hóa đơn mới" Foreground="#153C5D" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="lblTrangThai" Text="Nháp" Foreground="#22679B" FontWeight="SemiBold"/></Border>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,14">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Số hóa đơn nhà cung cấp *" Style="{StaticResource HdNhan}"/>
                                    <TextBox x:Name="txtSoHoaDon" Style="{StaticResource HdNhap}" MaxLength="255"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày hóa đơn *" Style="{StaticResource HdNhan}"/>
                                    <DatePicker x:Name="dpNgayHoaDon" Height="39" BorderBrush="#CBD9E8"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Nhà cung cấp *" Style="{StaticResource HdNhan}"/>
                            <ComboBox x:Name="cboNhaCungCap" Style="{StaticResource HdChon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" Margin="0,0,0,14" IsTextSearchEnabled="True" TextSearch.TextPath="Ten"/>
                            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Tổng tiền hóa đơn (VNĐ) *" Style="{StaticResource HdNhan}"/>
                                    <TextBox x:Name="txtTongTien" Style="{StaticResource HdNhap}" ToolTip="Ví dụ: 1250000"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Người lập" Style="{StaticResource HdNhan}"/>
                                    <TextBox x:Name="txtNguoiLap" Style="{StaticResource HdNhap}" IsReadOnly="True" Background="#EFF4F9"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Ghi chú / mô tả nội dung mua hàng" Style="{StaticResource HdNhan}"/>
                            <TextBox x:Name="txtGhiChu" Style="{StaticResource HdNhap}" MinHeight="94" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,13"/>
                            <Border Background="#F5F8FC" CornerRadius="11" Padding="14,12" BorderBrush="#E1E9F1" BorderThickness="1" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="LIÊN KẾT PHIẾU NHẬP" Foreground="#6F8499" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="lblPhieuLienKet" Text="Chưa có phiếu nhập tham chiếu" Foreground="#274762" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Lưu nháp để chỉnh sửa; xác nhận để dùng làm chứng từ nguồn ghi sổ phiếu nhập. Hóa đơn đã xác nhận không cho sửa." Foreground="#72879B" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="17,14" BorderBrush="#E1E9F1" BorderThickness="0,1,0,0" Background="#FCFDFE">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button x:Name="btnLuu" Content="Lưu nháp" Click="LuuNhap_Click" Padding="15,9" Margin="0,0,8,6" Background="#E0EFFC" Foreground="#155F9F" FontWeight="SemiBold"/>
                            <Button x:Name="btnXacNhan" Content="Xác nhận hóa đơn" Click="XacNhan_Click" Padding="15,9" Margin="0,0,8,6" Background="#177759" Foreground="White" FontWeight="SemiBold"/>
                            <Button x:Name="btnHuy" Content="Hủy hóa đơn" Click="Huy_Click" Padding="15,9" Margin="0,0,0,6" Background="#FDEDEB" Foreground="#A83A35"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
