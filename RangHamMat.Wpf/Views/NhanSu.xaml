<!-- Giao diện NhanSu: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl x:Class="RangHamMat.Views.NhanSu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Tài nguyên NhanSuTabStyle (Style) áp dụng cho TabItem. -->
        <Style x:Key="NhanSuTabStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Tài nguyên NhanSuDataGridStyle (Style) áp dụng cho DataGrid. -->
        <Style x:Key="NhanSuDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Tài nguyên FormLabel (Style) áp dụng cho TextBlock. -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Tài nguyên FormTextBox (Style) áp dụng cho TextBox. -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Bác sĩ và nhân sự" Style="{StaticResource Title}"/>
                <TextBlock Text="Quản lý nhân viên, bác sĩ, chức vụ và thông tin làm việc."
                           Style="{StaticResource Subtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            
        </Grid>
        

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- NHÂN VIÊN -->
            <TabItem Header="Nhân viên" Style="{StaticResource NhanSuTabStyle}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Danh sách -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="22,20,22,15">
                                <TextBlock Text="Danh sách nhân viên" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Nhấp đúp để xem toàn bộ thông tin nhân viên."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="22,0,22,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ô nhập txtTimNhanVien. Chuyển sự kiện đến txtTimNhanVien_TextChanged trong code-behind. -->
                                <TextBox x:Name="txtTimNhanVien" Height="40" Padding="10,0"
                                         VerticalContentAlignment="Center" TextChanged="txtTimNhanVien_TextChanged"/>

                                <!-- Trường lựa chọn cboLocTrangThaiNhanVien. Chuyển sự kiện đến cboLocTrangThaiNhanVien_SelectionChanged trong code-behind. -->
                                <ComboBox x:Name="cboLocTrangThaiNhanVien" Grid.Column="2"
                                          Height="40" SelectedIndex="0" SelectionChanged="cboLocTrangThaiNhanVien_SelectionChanged">
                                    <ComboBoxItem Content="Tất cả"/>
                                    <ComboBoxItem Content="Đang làm việc"/>
                                    <ComboBoxItem Content="Tạm nghỉ"/>
                                    <ComboBoxItem Content="Đã nghỉ"/>
                                </ComboBox>
                            </Grid>

                            <Grid Grid.Row="2" >
                                <!-- Danh sách dgvNhanVien. -->
                                <DataGrid x:Name="dgvNhanVien" Background="White" Tag="Table:NHAN_VIEN" Style="{StaticResource NhanSuDataGridStyle}" MouseDoubleClick="dgvNhanVien_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNV}" Width="120"/>
                                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding HoTen}" Width="*"/>
                                        <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}" Width="125"/>
                                        <DataGridTextColumn Header="Chức vụ" Binding="{Binding MaChucVu}" Width="115"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=dgvNhanVien}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Chưa có nhân viên" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Text="Nhập thông tin ở biểu mẫu bên phải để thêm mới."
                                               Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Form thêm -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="20,19,20,15">
                                <TextBlock Text="Thêm nhân viên" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Nhập thông tin cơ bản để tạo hồ sơ."
                                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20,3,20,18">
                                    <!-- Thông tin hiển thị lblHoTen — Họ và tên *. -->
                                    <TextBlock x:Name="lblHoTen" Text="Họ và tên *" Style="{StaticResource FormLabel}"/>
                                    <!-- Ô nhập txtHoTen. Chuyển sự kiện đến txtHoTen_TextChanged trong code-behind. -->
                                    <TextBox x:Name="txtHoTen" Style="{StaticResource FormTextBox}" TextChanged="txtHoTen_TextChanged"/>

                                    <TextBlock Text="Giới tính" Style="{StaticResource FormLabel}"/>
                                    <!-- Trường lựa chọn cboGioiTinh. -->
                                    <ComboBox x:Name="cboGioiTinh" Height="40" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Nam"/>
                                        <ComboBoxItem Content="Nữ"/>
                                        <ComboBoxItem Content="Khác"/>
                                    </ComboBox>

                                    <TextBlock Text="Ngày sinh *" Style="{StaticResource FormLabel}"/>
                                    <!-- Trường lựa chọn dpNgaySinh. -->
                                    <DatePicker x:Name="dpNgaySinh" Height="40" Margin="0,0,0,14"/>

                                    <TextBlock Text="Số điện thoại *" Style="{StaticResource FormLabel}"/>
                                    <!-- Ô nhập txtSDT. -->
                                    <TextBox x:Name="txtSDT" Style="{StaticResource FormTextBox}"/>

                                    <TextBlock Text="Chức vụ *" Style="{StaticResource FormLabel}"/>
                                    <!-- Trường lựa chọn cboChucVu. -->
                                    <ComboBox x:Name="cboChucVu" DisplayMemberPath="TenChucVu" SelectedValuePath="MaChucVu" SelectedValue="{Binding MaChucVu,Mode=TwoWay}" Height="40" Margin="0,0,0,14"/>

                                    <TextBlock Text="Chuyên khoa" Style="{StaticResource FormLabel}"/>
                                    <!-- Trường lựa chọn cboChuyenKhoa. -->
                                    <ComboBox x:Name="cboChuyenKhoa" DisplayMemberPath="TenCK" SelectedValuePath="MaCK" SelectedValue="{Binding MaCK, Mode=TwoWay}" Height="40" Margin="0,0,0,14"/>

                                    <TextBlock Text="Bằng cấp" Style="{StaticResource FormLabel}"/>
                                    <!-- Ô nhập txtBangCap. -->
                                    <TextBox x:Name="txtBangCap" Style="{StaticResource FormTextBox}"/>

                                    <TextBlock Text="Ngày vào làm *" Style="{StaticResource FormLabel}"/>
                                    <!-- Trường lựa chọn dpNgayVaoLam. -->
                                    <DatePicker x:Name="dpNgayVaoLam" Height="40" Margin="0,0,0,14"/>

                                    <TextBlock Text="Trạng thái" Style="{StaticResource FormLabel}"/>
                                    <!-- Trường lựa chọn cboTrangThai. -->
                                    <ComboBox x:Name="cboTrangThai" Height="40" SelectedIndex="0" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Đang làm việc"/>
                                        <ComboBoxItem Content="Tạm nghỉ"/>
                                        <ComboBoxItem Content="Đã nghỉ"/>
                                    </ComboBox>

                                    <TextBlock Text="Địa chỉ" Style="{StaticResource FormLabel}"/>
                                    <!-- Ô nhập txtDiaChi. -->
                                    <TextBox x:Name="txtDiaChi" MinHeight="70" Padding="10"
                                             AcceptsReturn="True" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="20,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nút thao tác btnLamMoiNhanVien — Làm mới. Chuyển sự kiện đến btnLamMoiNhanVien_Click trong code-behind. -->
                                <Button x:Name="btnLamMoiNhanVien" Content="Làm mới" Height="42" Click="btnLamMoiNhanVien_Click"/>
                                <!-- Nút thao tác btnThemNhanVien — Thêm nhân viên. Chuyển sự kiện đến btnThemNhanVien_Click trong code-behind. -->
                                <Button x:Name="btnThemNhanVien" Grid.Column="2" Content="Thêm nhân viên"
                                        Style="{StaticResource Primary}" Height="42" Click="btnThemNhanVien_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- CHỨC VỤ -->
            <TabItem Header="Chức vụ" Style="{StaticResource NhanSuTabStyle}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="22,20,22,15">
                                <TextBlock Text="Danh mục chức vụ" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Danh sách chức vụ đang sử dụng trong hệ thống."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Danh sách dgvChucVu. -->
                            <DataGrid x:Name="dgvChucVu" Grid.Row="1" Tag="Table:dgvChucVu"
                                      Style="{StaticResource NhanSuDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã chức vụ" Binding="{Binding MaChucVu}" Width="150"/>
                                    <DataGridTextColumn Header="Tên chức vụ" Binding="{Binding TenChucVu}" Width="220"/>
                                    <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Thêm chức vụ" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>

                            <TextBlock Text="Mã chức vụ (tự sinh)" Style="{StaticResource FormLabel}"/>
                            <!-- Ô nhập txtMaChucVu — Tự động. -->
                            <TextBox x:Name="txtMaChucVu" Style="{StaticResource FormTextBox}" IsReadOnly="True" Text="Tự động"/>

                            <TextBlock Text="Tên chức vụ *" Style="{StaticResource FormLabel}"/>
                            <!-- Ô nhập txtTenChucVu. -->
                            <TextBox x:Name="txtTenChucVu" Style="{StaticResource FormTextBox}"/>

                            <TextBlock Text="Mô tả" Style="{StaticResource FormLabel}"/>
                            <!-- Ô nhập txtMoTaChucVu. -->
                            <TextBox x:Name="txtMoTaChucVu" MinHeight="120" Padding="10"
                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nút thao tác btnLamMoiChucVu — Làm mới. Chuyển sự kiện đến btnLamMoiChucVu_Click trong code-behind. -->
                                <Button x:Name="btnLamMoiChucVu" Content="Làm mới" Height="42" Click="btnLamMoiChucVu_Click"/>
                                <!-- Nút thao tác btnThemChucVu — Thêm chức vụ. Chuyển sự kiện đến btnThemChucVu_Click trong code-behind. -->
                                <Button x:Name="btnThemChucVu" Grid.Column="2" Content="Thêm chức vụ"
                                        Style="{StaticResource Primary}" Height="42" Click="btnThemChucVu_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>