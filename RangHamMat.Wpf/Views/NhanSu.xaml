<!-- AI bổ sung: trigger viền đỏ/tooltip cho lỗi nhập liệu trên control hiện hữu trong XAML. -->
<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của NhanSu.xaml; các vùng liên quan: Nhân viên, dgvNhanVien, Chức vụ, dgvChucVu. -->
<!-- AI hỗ trợ: bổ sung chú thích cho quản lý nhân viên/chức vụ. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl x:Class="RangHamMat.Views.NhanSu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:input="clr-namespace:RangHamMat.Controls">

    <UserControl.Resources>
        <!-- Style NhanSuTabStyle cho TabItem: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
        <Style x:Key="NhanSuTabStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Style NhanSuDataGridStyle cho DataGrid: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
        <Style x:Key="NhanSuDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Style FormLabel cho TextBlock: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Style FormTextBox cho TextBox: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        <Style.Triggers><Trigger Property="input:KiemTraNhapLieu.HasError" Value="True"><Setter Property="BorderBrush" Value="#B42318"/><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(input:KiemTraNhapLieu.Error)}"/></Trigger></Style.Triggers></Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Bác sĩ và nhân sự" Style="{StaticResource Title}"/>
                <TextBlock Text="Quản lý nhân viên, bác sĩ, chức vụ và thông tin làm việc."
                           Style="{StaticResource Subtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            
        </Grid>
        

        <!-- AI tạo: vùng thông báo nhập sai/lưu dữ liệu hiện hữu trong XAML, giữ form để người dùng sửa. -->
        <TextBlock x:Name="FormError" Grid.Row="1" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- NHÂN VIÊN -->
            <!-- Nhóm Nhân viên: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
            <TabItem Header="Nhân viên" Style="{StaticResource NhanSuTabStyle}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Danh sách -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="22,20,22,15">
                                <TextBlock Text="Danh sách nhân viên" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Nhấp đúp để xem toàn bộ thông tin nhân viên."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="22,0,22,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtTimNhanVien" Height="40" Padding="10,0"
                                         VerticalContentAlignment="Center"/>

                                <ComboBox x:Name="cboLocTrangThaiNhanVien" Grid.Column="2"
                                          Height="40" SelectedIndex="0">
                                    <ComboBoxItem Content="Tất cả"/>
                                    <ComboBoxItem Content="Đang làm việc"/>
                                    <ComboBoxItem Content="Tạm nghỉ"/>
                                    <ComboBoxItem Content="Đã nghỉ"/>
                                </ComboBox>
                            </Grid>

                            <Grid Grid.Row="2" >
                                <!-- Bảng dgvNhanVien: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. Tag Table:NHAN_VIEN cho workspace biết bảng khi mở chi tiết bằng nhấp đúp. -->
                                <DataGrid x:Name="dgvNhanVien" Background="White" Tag="Table:NHAN_VIEN" Style="{StaticResource NhanSuDataGridStyle}" MouseDoubleClick="dgvNhanVien_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNV}" Width="120"/>
                                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding HoTen}" Width="*"/>
                                        <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}" Width="125"/>
                                        <DataGridTextColumn Header="Chức vụ" Binding="{Binding MaChucVu}" Width="115"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <!-- Style mặc định cho StackPanel: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=dgvNhanVien}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Chưa có nhân viên" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Text="Nhập thông tin ở biểu mẫu bên phải để thêm mới."
                                               Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Form thêm -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="20,19,20,15">
                                <TextBlock Text="Thêm nhân viên" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Nhập thông tin cơ bản để tạo hồ sơ."
                                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20,3,20,18">
                                    <TextBlock Text="Họ và tên *" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="txtHoTen" Tag="DB:NHAN_VIEN.HoTen" Style="{StaticResource FormTextBox}"/>

                                    <TextBlock Text="Giới tính" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cboGioiTinh" Tag="DB:NHAN_VIEN.GioiTinh" Height="40" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Nam"/>
                                        <ComboBoxItem Content="Nữ"/>
                                        <ComboBoxItem Content="Khác"/>
                                    </ComboBox>

                                    <TextBlock Text="Ngày sinh" Style="{StaticResource FormLabel}"/>
                                    <DatePicker x:Name="dpNgaySinh" Tag="DB:NHAN_VIEN.NgaySinh" Height="40" Margin="0,0,0,14"/>

                                    <TextBlock Text="Số điện thoại *" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="txtSDT" Tag="DB:NHAN_VIEN.SDT" Style="{StaticResource FormTextBox}"/>

                                    <TextBlock Text="Chức vụ *" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cboChucVu" Tag="DB:NHAN_VIEN.MaChucVu" DisplayMemberPath="TenChucVu" SelectedValuePath="MaChucVu" SelectedValue="{Binding MaChucVu,Mode=TwoWay}" Height="40" Margin="0,0,0,14"/>

                                    <TextBlock Text="Chuyên khoa" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cboChuyenKhoa" Tag="DB:NHAN_VIEN.MaCK" DisplayMemberPath="TenCK" SelectedValuePath="MaCK" SelectedValue="{Binding MaCK, Mode=TwoWay}" Height="40" Margin="0,0,0,14"/>

                                    <TextBlock Text="Bằng cấp" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="txtBangCap" Tag="DB:NHAN_VIEN.BangCap" Style="{StaticResource FormTextBox}"/>

                                    <TextBlock Text="Ngày vào làm" Style="{StaticResource FormLabel}"/>
                                    <DatePicker x:Name="dpNgayVaoLam" Tag="DB:NHAN_VIEN.NgayVaoLam" Height="40" Margin="0,0,0,14"/>

                                    <TextBlock Text="Trạng thái" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="cboTrangThai" Tag="DB:NHAN_VIEN.TrangThai" Height="40" SelectedIndex="0" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Đang làm việc"/>
                                        <ComboBoxItem Content="Tạm nghỉ"/>
                                        <ComboBoxItem Content="Đã nghỉ"/>
                                    </ComboBox>

                                    <TextBlock Text="Địa chỉ" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="txtDiaChi" Tag="DB:NHAN_VIEN.DiaChi" MinHeight="70" Padding="10"
                                             AcceptsReturn="True" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="20,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="btnLamMoiNhanVien" Content="Làm mới" Height="42"/>
                                <!-- Thao tác Thêm nhân viên: gọi btnThemNhanVien_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                <Button x:Name="btnThemNhanVien" Grid.Column="2" Content="Thêm nhân viên"
                                        Style="{StaticResource Primary}" Height="42" Click="btnThemNhanVien_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- CHỨC VỤ -->
            <!-- Nhóm Chức vụ: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
            <TabItem Header="Chức vụ" Style="{StaticResource NhanSuTabStyle}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="22,20,22,15">
                                <TextBlock Text="Danh mục chức vụ" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Danh sách chức vụ đang sử dụng trong hệ thống."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- AI sửa Tag thành Table:CHUC_VU để workspace nhận đúng bảng SQL; dgvChucVu chỉ là tên control. Các cột Binding đọc ET_CHUCVU từ ItemsSource. -->
                            <DataGrid x:Name="dgvChucVu" Grid.Row="1" Tag="Table:CHUC_VU"
                                      Style="{StaticResource NhanSuDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã chức vụ" Binding="{Binding MaChucVu}" Width="150"/>
                                    <DataGridTextColumn Header="Tên chức vụ" Binding="{Binding TenChucVu}" Width="220"/>
                                    <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Thêm chức vụ" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>

                            <TextBlock Text="Mã chức vụ (tự sinh)" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="txtMaChucVu" Tag="DB:CHUC_VU.MaChucVu" Style="{StaticResource FormTextBox}" IsReadOnly="True" ToolTip="Mã được cấp khi lưu thành công"/>

                            <TextBlock Text="Tên chức vụ *" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="txtTenChucVu" Tag="DB:CHUC_VU.TenChucVu" Style="{StaticResource FormTextBox}"/>

                            <TextBlock Text="Mô tả *" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="txtMoTaChucVu" Tag="DB:CHUC_VU.MoTa" MinHeight="120" Padding="10"
                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="btnLamMoiChucVu" Content="Làm mới" Height="42"/>
                                <!-- Thao tác Thêm chức vụ: gọi btnThemChucVu_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                                <Button x:Name="btnThemChucVu" Grid.Column="2" Content="Thêm chức vụ"
                                        Style="{StaticResource Primary}" Height="42" Click="btnThemChucVu_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
