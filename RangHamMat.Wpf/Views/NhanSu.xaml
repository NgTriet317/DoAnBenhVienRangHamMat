<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.NhanSu">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Bác sĩ và nhân sự" Style="{StaticResource Title}" />
      <TextBlock Text="Nhấp đúp vào một dòng để xem chi tiết. Chọn Thêm để tạo mới." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,20">
      <Button Content="Ca làm việc" Tag="MoTrang:CaLamViec" />
      <Button Content="Tài khoản" Tag="MoTrang:TaiKhoan" />
    </WrapPanel>
    <TabControl Grid.Row="2">
      <TabItem Header="Nhân viên">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="NHAN_VIEN" />
              <Button Content="Thêm nhân viên" Tag="MoCuaSo:NhanSu" CommandParameter="NHAN_VIEN" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Nhân viên" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:NHAN_VIEN" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_NHAN_VIEN" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã nhân viên" SortMemberPath="MaNV" Width="155" Binding="{Binding MaNV}" />
                  <DataGridTextColumn Header="Họ tên" SortMemberPath="HoTen" Width="155" Visibility="Collapsed" Binding="{Binding HoTen}" />
                  <DataGridTextColumn Header="Giới tính" SortMemberPath="GioiTinh" Width="155" Visibility="Collapsed" Binding="{Binding GioiTinh}" />
                  <DataGridTextColumn Header="Ngày sinh" SortMemberPath="NgaySinh" Width="155" Visibility="Collapsed" Binding="{Binding NgaySinh}" />
                  <DataGridTextColumn Header="Số điện thoại" SortMemberPath="SDT" Width="155" Binding="{Binding SDT}" />
                  <DataGridTextColumn Header="Địa chỉ" SortMemberPath="DiaChi" Width="155" Visibility="Collapsed" Binding="{Binding DiaChi}" />
                  <DataGridTextColumn Header="Chức vụ" SortMemberPath="MaChucVu" Width="155" Visibility="Collapsed" Binding="{Binding MaChucVu}" />
                  <DataGridTextColumn Header="Chuyên khoa" SortMemberPath="MaCK" Width="155" Visibility="Collapsed" Binding="{Binding MaCK}" />
                  <DataGridTextColumn Header="Bằng cấp" SortMemberPath="BangCap" Width="155" Visibility="Collapsed" Binding="{Binding BangCap}" />
                  <DataGridTextColumn Header="Chứng chỉ hành nghề" SortMemberPath="ChungChiHanhNghe" Width="155" Visibility="Collapsed" Binding="{Binding ChungChiHanhNghe}" />
                  <DataGridTextColumn Header="Ngày cấp chứng chỉ" SortMemberPath="NgayCapChungChi" Width="155" Visibility="Collapsed" Binding="{Binding NgayCapChungChi}" />
                  <DataGridTextColumn Header="Nơi cấp chứng chỉ" SortMemberPath="NoiCapChungChi" Width="155" Visibility="Collapsed" Binding="{Binding NoiCapChungChi}" />
                  <DataGridTextColumn Header="Hạn chứng chỉ" SortMemberPath="HanChungChi" Width="155" Visibility="Collapsed" Binding="{Binding HanChungChi}" />
                  <DataGridTextColumn Header="Ngày vào làm" SortMemberPath="NgayVaoLam" Width="155" Visibility="Collapsed" Binding="{Binding NgayVaoLam}" />
                  <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Binding="{Binding TrangThai}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_NHAN_VIEN}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có nhân viên" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:NhanSu" CommandParameter="NHAN_VIEN" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Chức vụ">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Thêm chức vụ" Tag="MoCuaSo:NhanSu" CommandParameter="CHUC_VU" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Chức vụ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:CHUC_VU" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_CHUC_VU" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã chức vụ" SortMemberPath="MaChucVu" Width="155" Binding="{Binding MaChucVu}" />
                  <DataGridTextColumn Header="Tên chức vụ" SortMemberPath="TenChucVu" Width="155" Binding="{Binding TenChucVu}" />
                  <DataGridTextColumn Header="Mô tả" SortMemberPath="MoTa" Width="155" Binding="{Binding MoTa}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_CHUC_VU}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có chức vụ" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:NhanSu" CommandParameter="CHUC_VU" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>