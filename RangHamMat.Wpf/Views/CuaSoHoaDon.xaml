<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.CuaSoHoaDon">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Hóa đơn và thanh toán · Thêm mới" Style="{StaticResource Title}" />
      <TextBlock Text="Điền lần lượt từng nhóm thông tin. Dấu * là trường bắt buộc." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <TabControl x:Name="EditorTabs" Grid.Row="1">
      <TabItem Header="Hóa đơn" Tag="Table:HOA_DON" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1220" HorizontalAlignment="Left" Margin="0,20,12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin hóa đơn" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn bệnh nhân">
                    <TextBlock Text="Bệnh nhân *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:HOA_DON.MaBN" AutomationProperties.Name="Bệnh nhân" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn lần khám">
                    <TextBlock Text="Lần khám" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:HOA_DON.MaLS" AutomationProperties.Name="Lần khám" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Thời điểm mặc định khi tạo mới.">
                    <TextBlock Text="Ngày lập" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <DatePicker Tag="DB:HOA_DON.NgayLap" AutomationProperties.Name="Ngày lập" />
                      <TextBox Grid.Column="1" Margin="8,0,0,0" Tag="Time:HOA_DON.NgayLap" AutomationProperties.Name="Giờ - Ngày lập" ToolTip="HH:mm:ss" MaxLength="8" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Số thập phân; tối đa 2 chữ số sau dấu thập phân.">
                    <TextBlock Text="Tổng tiền *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:HOA_DON.TongTien" AutomationProperties.Name="Tổng tiền" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Giá trị mặc định: 0.">
                    <TextBlock Text="Giảm giá (số tiền)" Margin="0,0,0,6" />
                    <TextBox Tag="DB:HOA_DON.GiamGia" AutomationProperties.Name="Giảm giá (số tiền)" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin quản lý" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Tự sinh khi lưu">
                    <TextBlock Text="Mã hóa đơn" Margin="0,0,0,6" />
                    <TextBox Tag="DB:HOA_DON.MaHD" AutomationProperties.Name="Mã hóa đơn" IsReadOnly="True" Text="Tự sinh" Background="{StaticResource Canvas}" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Tổng tiền trừ giảm giá; chưa có xử lý tính toán.">
                    <TextBlock Text="Thành tiền *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:HOA_DON.ThanhTien" AutomationProperties.Name="Thành tiền" IsReadOnly="True" Background="{StaticResource Canvas}" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Trạng thái *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:HOA_DON.TrangThai" AutomationProperties.Name="Trạng thái" MaxLength="50" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Chi tiết hóa đơn" Tag="Table:CHI_TIET_HOA_DON" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1220" HorizontalAlignment="Left" Margin="0,20,12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin chi tiết hóa đơn" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn hóa đơn">
                    <TextBlock Text="Hóa đơn *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:CHI_TIET_HOA_DON.MaHD" AutomationProperties.Name="Hóa đơn" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn kế hoạch điều trị">
                    <TextBlock Text="Kế hoạch điều trị" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:CHI_TIET_HOA_DON.MaKHDT" AutomationProperties.Name="Kế hoạch điều trị" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Số thập phân; tối đa 2 chữ số sau dấu thập phân.">
                    <TextBlock Text="Thành tiền *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:CHI_TIET_HOA_DON.ThanhTien" AutomationProperties.Name="Thành tiền" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Nội dung và ghi chú" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Nội dung *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:CHI_TIET_HOA_DON.NoiDung" AutomationProperties.Name="Nội dung" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin quản lý" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Tự sinh khi lưu">
                    <TextBlock Text="Mã chi tiết hóa đơn" Margin="0,0,0,6" />
                    <TextBox Tag="DB:CHI_TIET_HOA_DON.MaCTHD" AutomationProperties.Name="Mã chi tiết hóa đơn" IsReadOnly="True" Text="Tự sinh" Background="{StaticResource Canvas}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Thanh toán" Tag="Table:THANH_TOAN" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1220" HorizontalAlignment="Left" Margin="0,20,12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin thanh toán" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn hóa đơn">
                    <TextBlock Text="Hóa đơn *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:THANH_TOAN.MaHD" AutomationProperties.Name="Hóa đơn" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Thời điểm mặc định khi tạo mới.">
                    <TextBlock Text="Ngày thanh toán" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <DatePicker Tag="DB:THANH_TOAN.NgayThanhToan" AutomationProperties.Name="Ngày thanh toán" />
                      <TextBox Grid.Column="1" Margin="8,0,0,0" Tag="Time:THANH_TOAN.NgayThanhToan" AutomationProperties.Name="Giờ - Ngày thanh toán" ToolTip="HH:mm:ss" MaxLength="8" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Số thập phân; tối đa 2 chữ số sau dấu thập phân.">
                    <TextBlock Text="Số tiền *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:THANH_TOAN.SoTien" AutomationProperties.Name="Số tiền" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Phương thức *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:THANH_TOAN.PhuongThuc" AutomationProperties.Name="Phương thức" MaxLength="255" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Người thu" Margin="0,0,0,6" />
                    <TextBox Tag="DB:THANH_TOAN.NguoiThu" AutomationProperties.Name="Người thu" MaxLength="255" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Nội dung và ghi chú" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ghi chú" Margin="0,0,0,6" />
                    <TextBox Tag="DB:THANH_TOAN.GhiChu" AutomationProperties.Name="Ghi chú" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin quản lý" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Tự sinh khi lưu">
                    <TextBlock Text="Mã thanh toán" Margin="0,0,0,6" />
                    <TextBox Tag="DB:THANH_TOAN.MaTT" AutomationProperties.Name="Mã thanh toán" IsReadOnly="True" Text="Tự sinh" Background="{StaticResource Canvas}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="0,18,0,0">
      <WrapPanel>
        <Button Content="Quay lại danh sách" Tag="DongCuaSo" />
        <Button Content="Lưu thông tin" IsEnabled="False" Style="{StaticResource Primary}" ToolTip="Bản giao diện chưa kết nối lưu dữ liệu" />
        <Button Content="Về màn hình chính" Tag="VeTrangChu" />
        <TextBlock Text="Bản giao diện • Chưa lưu dữ liệu" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0,0,0" />
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>