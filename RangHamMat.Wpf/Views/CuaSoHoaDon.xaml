<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của CuaSoHoaDon.xaml; các vùng liên quan: ChargeGrid. -->
<!-- AI hỗ trợ: bổ sung chú thích cho biểu mẫu lập hóa đơn nháp theo lần khám. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl x:Class="RangHamMat.Views.CuaSoHoaDon" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RangHamMat.Views">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
 <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries><views:InvoiceMoneyConverter x:Key="InvoiceMoney"/></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Lập hóa đơn theo lần khám" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Chỉ lấy dịch vụ xác nhận và thuốc đã cấp đủ chưa nằm trên hóa đơn khác. Kiểm tra các khoản rồi lưu nháp." Style="{StaticResource HospitalMuted}"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <WrapPanel><StackPanel Width="250" Margin="0,0,14,16"><TextBlock Text="Bệnh nhân *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PatientBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Patient_Changed" AutomationProperties.Name="Bệnh nhân lập hóa đơn"/></StackPanel><StackPanel Width="260" Margin="0,0,14,16"><TextBlock Text="Lần khám đã xác nhận *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="VisitBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Visit_Changed" AutomationProperties.Name="Lần khám lập hóa đơn"/></StackPanel><StackPanel Width="250" Margin="0,0,14,16"><TextBlock Text="Nhân viên lập *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="EmployeeBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Nhân viên lập hóa đơn"/></StackPanel></WrapPanel>
   <TextBlock Text="Các khoản thu thực tế" Style="{StaticResource HospitalSection}" Margin="0,4,0,12"/>
   <!-- Bảng ChargeGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
   <DataGrid x:Name="ChargeGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="340" MinHeight="120"><DataGrid.Columns><DataGridTextColumn Header="Loại" Binding="{Binding Loai}" Width="120"/><DataGridTextColumn Header="Nội dung" Binding="{Binding NoiDung}" Width="2*"/><DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat=N3}" Width="90"/><DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaChot, Converter={StaticResource InvoiceMoney}}" Width="110"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, Converter={StaticResource InvoiceMoney}}" Width="120"/></DataGrid.Columns></DataGrid>
   <TextBlock x:Name="ChargesInfo" Style="{StaticResource HospitalMuted}" Margin="0,12,0,16"/>
   <WrapPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Giảm giá (số tiền ₫)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DiscountBox" Tag="DB:HOA_DON.GiamGia" Text="0" TextChanged="Discount_Changed" AutomationProperties.Name="Giảm giá hóa đơn"/></StackPanel><StackPanel Width="280" Margin="0,0,18,16"><TextBlock Text="Tổng phải thu" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="NetTotal" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}" FontSize="20" Margin="0,6,0,0"/></StackPanel></WrapPanel>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#8F3B32" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="2" Margin="0,18,0,0"><!-- Thao tác Quay lại: gọi Back_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button Content="Quay lại" Click="Back_Click"/><!-- Thao tác Lưu hóa đơn nháp: gọi Save_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button x:Name="SaveButton" Content="Lưu hóa đơn nháp" Click="Save_Click" Style="{StaticResource HospitalPrimary}"/></WrapPanel>
 </Grid>
</UserControl>
