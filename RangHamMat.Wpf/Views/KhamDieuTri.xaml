<!-- Giao diện KhamDieuTri: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow" clinical:ClinicalLayout.IsEnabled="True" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.KhamDieuTri" Background="#F4F7FB" Foreground="#21344B" FontSize="14" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button" BasedOn="{StaticResource HospitalSecondary}"/>
  <!-- Tài nguyên FilterLabel (Style) áp dụng cho TextBlock. -->
  <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource HospitalMuted}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <!-- Nút thao tác ReloadQueueButton — Tải lại. Chuyển sự kiện đến Reload_Click trong code-behind. -->
  <DockPanel Margin="0,0,0,12"><WrapPanel DockPanel.Dock="Right"><Button x:Name="ReloadQueueButton" Content="Tải lại" Click="Reload_Click" ToolTip="Hàng chờ tự cập nhật mỗi10 giây khi không có nháp chưa lưu."/></WrapPanel><StackPanel><TextBlock Text="Khám điều trị" Style="{StaticResource HospitalHeading}"/><TextBlock x:Name="ScopeText" Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="PageStatus" TextWrapping="Wrap" Foreground="#2563EB" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DockPanel>
  <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Padding="12" Margin="0,0,0,12"><StackPanel>
   <!-- Ô nhập SearchBox. Chuyển sự kiện đến Filter_Changed trong code-behind. -->
   <WrapPanel><StackPanel Width="230" Margin="0,0,12,4"><TextBlock Text="Tìm nhanh người bệnh / mã phiếu" Style="{StaticResource FilterLabel}"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Padding="8"/></StackPanel><StackPanel x:Name="StatusFilterPanel" Width="150" Margin="0,0,12,4"><TextBlock Text="Trạng thái" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" SelectedIndex="0"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Chờ khám"/><ComboBoxItem Content="Đang khám"/></ComboBox></StackPanel><Button Content="Đặt lại" Click="ClearFilters_Click" VerticalAlignment="Bottom"/></WrapPanel>
   <!-- Trường lựa chọn PatientFilter. Chuyển sự kiện đến PatientFilter_Changed trong code-behind. -->
   <Expander Header="Lọc theo bác sĩ, bệnh nhân và ngày" Margin="0,8,0,0"><WrapPanel Margin="0,8,0,0"><StackPanel Width="180" Margin="0,0,12,4"><TextBlock Text="Bệnh nhân" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="PatientFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="PatientFilter_Changed"/></StackPanel><StackPanel x:Name="DoctorFilterPanel" Width="185" Margin="0,0,12,4"><TextBlock Text="Bác sĩ nhận khám" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="DoctorFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="DoctorFilter_Changed"/></StackPanel><StackPanel Width="130" Margin="0,0,12,4"><TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/><DatePicker x:Name="FromDate" SelectedDateChanged="Filter_Changed"/></StackPanel><StackPanel Width="130" Margin="0,0,12,4"><TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/><DatePicker x:Name="ToDate" SelectedDateChanged="Filter_Changed"/></StackPanel></WrapPanel></Expander>
  </StackPanel></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
   <!-- Thành phần WorkTabs. Chuyển sự kiện đến WorkTab_Changed trong code-behind. -->
   <Border Style="{StaticResource HospitalPanel}" Padding="8"><TabControl x:Name="WorkTabs" SelectionChanged="WorkTab_Changed" BorderThickness="0" Background="Transparent">
    <!-- Thành phần QueueTab — Hàng chờ khám. -->
    <TabItem x:Name="QueueTab" Header="Hàng chờ khám"><Grid Margin="4,12,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <!-- Thông tin hiển thị QueueCount. -->
     <StackPanel><TextBlock x:Name="QueueCount" FontWeight="SemiBold"/><TextBlock Text="Theo giờ tiếp nhận · ai tới trước hiện trước" Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel>
     <!-- Danh sách QueueList. Chuyển sự kiện đến Queue_Changed trong code-behind. -->
     <Grid Grid.Row="1"><ListBox x:Name="QueueList" SelectionChanged="Queue_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><Border Padding="10,12" BorderBrush="#DFE8F3" BorderThickness="0,0,0,1"><StackPanel>
      <DockPanel><TextBlock Text="{Binding SoThuTu,StringFormat=Số {0}}" FontWeight="Bold" Foreground="#1D4ED8"/><TextBlock Text="{Binding TrangThai}" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#64748B"/></DockPanel>
      <TextBlock Text="{Binding HoTenBN}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding MaBN}" Foreground="#64748B"/><TextBlock Text="{Binding ThoiGianTiepNhan,StringFormat=Tiếp nhận {0:dd/MM HH:mm:ss}}" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding TenBS,StringFormat=BS. {0}}" TextWrapping="Wrap" Foreground="#64748B"/><TextBlock Text="{Binding TenPhong}" TextWrapping="Wrap" Foreground="#64748B"/>
     <!-- Thông tin hiển thị QueueEmpty — Chưa có người bệnh chờ khám trong phạm vi này.. -->
     </StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="QueueEmpty" Text="Chưa có người bệnh chờ khám trong phạm vi này." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20" IsHitTestVisible="False"/></Grid>
     <!-- Nút thao tác PreviousQueuePage — ← Trước. Chuyển sự kiện đến PreviousQueue_Click trong code-behind. -->
     <WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="PreviousQueuePage" Content="← Trước" Click="PreviousQueue_Click"/><TextBlock x:Name="QueuePageText" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="NextQueuePage" Content="Sau →" Click="NextQueue_Click"/></WrapPanel>
    </Grid></TabItem>
    <!-- Thành phần HistoryTab — Lịch sử khám. -->
    <TabItem x:Name="HistoryTab" Header="Lịch sử khám"><Grid Margin="4,12,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <!-- Thông tin hiển thị RecordCount. -->
     <StackPanel><TextBlock x:Name="RecordCount" FontWeight="SemiBold"/><TextBlock Text="Các lượt đã hoàn tất chuyên môn · chỉ xem" Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel>
     <!-- Danh sách VisitList. Chuyển sự kiện đến Visit_Changed trong code-behind. -->
     <Grid Grid.Row="1"><ListBox x:Name="VisitList" SelectionChanged="Visit_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="10,12" BorderBrush="#DFE8F3" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Patient}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Code}" Foreground="#64748B" Margin="0,6,0,0"/><TextBlock Text="{Binding When}" Foreground="#64748B"/><TextBlock Text="{Binding Diagnosis}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="ListEmpty" Text="Chưa có lịch sử khám phù hợp." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False"/></Grid>
     <!-- Thành phần VisitPages. -->
     <WrapPanel x:Name="VisitPages" Grid.Row="2" Margin="0,10,0,0"><Button x:Name="PreviousVisitPage" Content="← Trước" Click="PreviousVisit_Click"/><Button x:Name="NextVisitPage" Content="Sau →" Click="NextVisit_Click" Margin="8,0,0,0"/></WrapPanel>
    </Grid></TabItem>
   </TabControl></Border>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#D6E1F0"/>
   <!-- Thành phần DetailHost. -->
   <Grid Grid.Column="2"><ContentControl x:Name="DetailHost"/>
    <!-- Vùng bố cục DetailEmpty. -->
    <Border x:Name="DetailEmpty" Style="{StaticResource HospitalPanel}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="430"><TextBlock x:Name="EmptyHeading" Text="Chọn người bệnh trong hàng chờ" Style="{StaticResource HospitalHeading}" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="ContextNote" Text="Kiểm tra thông tin tiếp nhận rồi bấm Bắt đầu khám. Lần khám chỉ được tạo sau khi bác sĩ bắt đầu." Style="{StaticResource HospitalMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
    <!-- Vùng bố cục QueuePreview. -->
    <Border x:Name="QueuePreview" Style="{StaticResource HospitalPanel}" Visibility="Collapsed"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Tiếp nhận khám" Foreground="#1D4ED8" FontWeight="SemiBold"/><TextBlock x:Name="QueuePatientText" Style="{StaticResource HospitalHeading}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="QueueReceiptText" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
     <!-- Thành phần QueueDetailsScroll. -->
     <ScrollViewer x:Name="QueueDetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="QueueArrivalText" TextWrapping="Wrap"/>
      <TextBlock Text="Bác sĩ và nơi khám" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock x:Name="QueueDoctorText" TextWrapping="Wrap"/><TextBlock Text="Lý do đến khám" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock x:Name="QueueReasonText" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
     <!-- Nút thao tác QueueStartButton — Bắt đầu khám. Chuyển sự kiện đến StartQueue_Click trong code-behind. -->
     <Button x:Name="QueueStartButton" Grid.Row="2" Margin="0,10,0,0" Content="Bắt đầu khám" Click="StartQueue_Click" Style="{StaticResource HospitalPrimary}" HorizontalAlignment="Left" IsEnabled="False" ToolTip="Đối chiếu đúng người bệnh trước khi bắt đầu khám."/>
    </Grid></Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
