<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.KhamDieuTri">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Khám và điều trị" Style="{StaticResource Title}" />
      <TextBlock Text="Nhấp đúp vào một dòng để xem chi tiết. Chọn Thêm để tạo mới." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,20">
      <Button Content="Đơn thuốc" Tag="MoTrang:DonThuoc" />
      <Button Content="Hóa đơn" Tag="MoTrang:HoaDon" />
    </WrapPanel>
    <TabControl Grid.Row="2">
      <TabItem Header="Lịch sử khám">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="LICH_SU_KHAM_BENH" />
              <Button Content="Thêm lịch sử khám" Tag="MoCuaSo:KhamDieuTri" CommandParameter="LICH_SU_KHAM_BENH" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Lịch sử khám" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:LICH_SU_KHAM_BENH" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_LICH_SU_KHAM_BENH" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã lần khám" SortMemberPath="MaLS" Width="155" Binding="{Binding MaLS}" />
                  <DataGridTextColumn Header="Hồ sơ bệnh án" SortMemberPath="MaHS" Width="155" Binding="{Binding MaHS}" />
                  <DataGridTextColumn Header="Lịch khám" SortMemberPath="MaLich" Width="155" Binding="{Binding MaLich}" />
                  <DataGridTextColumn Header="Thời gian khám" SortMemberPath="ThoiGianKham" Width="155" Binding="{Binding ThoiGianKham}" />
                  <DataGridTextColumn Header="Triệu chứng" SortMemberPath="TrieuChung" Width="155" Binding="{Binding TrieuChung}" />
                  <DataGridTextColumn Header="Chẩn đoán" SortMemberPath="ChanDoan" Width="155" Binding="{Binding ChanDoan}" />
                  <DataGridTextColumn Header="Kế hoạch xử lý" SortMemberPath="KeHoachXuLy" Width="155" Visibility="Collapsed" Binding="{Binding KeHoachXuLy}" />
                  <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Visibility="Collapsed" Binding="{Binding GhiChu}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_LICH_SU_KHAM_BENH}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có lịch sử khám" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:KhamDieuTri" CommandParameter="LICH_SU_KHAM_BENH" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Tình trạng bệnh" Visibility="Collapsed" Tag="Child:TINH_TRANG_BENH">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Thêm tình trạng bệnh" Tag="MoCuaSo:KhamDieuTri" CommandParameter="TINH_TRANG_BENH" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Tình trạng bệnh" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:TINH_TRANG_BENH" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_TINH_TRANG_BENH" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã tình trạng bệnh" SortMemberPath="MaTTB" Width="155" Binding="{Binding MaTTB}" />
                  <DataGridTextColumn Header="Lần khám" SortMemberPath="MaLS" Width="155" Binding="{Binding MaLS}" />
                  <DataGridTextColumn Header="Tình trạng" SortMemberPath="TinhTrang" Width="155" Binding="{Binding TinhTrang}" />
                  <DataGridTextColumn Header="Chẩn đoán" SortMemberPath="ChanDoan" Width="155" Binding="{Binding ChanDoan}" />
                  <DataGridTextColumn Header="Mức độ" SortMemberPath="MucDo" Width="155" Binding="{Binding MucDo}" />
                  <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Binding="{Binding GhiChu}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_TINH_TRANG_BENH}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có tình trạng bệnh" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:KhamDieuTri" CommandParameter="TINH_TRANG_BENH" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Kế hoạch điều trị">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="KE_HOACH_DIEU_TRI" />
              <Button Content="Thêm kế hoạch điều trị" Tag="MoCuaSo:KhamDieuTri" CommandParameter="KE_HOACH_DIEU_TRI" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Kế hoạch điều trị" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:KE_HOACH_DIEU_TRI" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_KE_HOACH_DIEU_TRI" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã kế hoạch điều trị" SortMemberPath="MaKHDT" Width="155" Binding="{Binding MaKHDT}" />
                  <DataGridTextColumn Header="Lần khám" SortMemberPath="MaLS" Width="155" Binding="{Binding MaLS}" />
                  <DataGridTextColumn Header="Bệnh nhân" SortMemberPath="MaBN" Width="155" Binding="{Binding MaBN}" />
                  <DataGridTextColumn Header="Bác sĩ" SortMemberPath="MaBS" Width="155" Binding="{Binding MaBS}" />
                  <DataGridTextColumn Header="Ngày lập" SortMemberPath="NgayLap" Width="155" Binding="{Binding NgayLap}" />
                  <DataGridTextColumn Header="Ngày bắt đầu" SortMemberPath="NgayBatDau" Width="155" Binding="{Binding NgayBatDau}" />
                  <DataGridTextColumn Header="Ngày dự kiến kết thúc" SortMemberPath="NgayDuKienKetThuc" Width="155" Visibility="Collapsed" Binding="{Binding NgayDuKienKetThuc}" />
                  <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Visibility="Collapsed" Binding="{Binding TrangThai}" />
                  <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Visibility="Collapsed" Binding="{Binding GhiChu}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_KE_HOACH_DIEU_TRI}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có kế hoạch điều trị" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:KhamDieuTri" CommandParameter="KE_HOACH_DIEU_TRI" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Chi tiết kế hoạch" Visibility="Collapsed" Tag="Child:CHI_TIET_KE_HOACH">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="CHI_TIET_KE_HOACH" />
              <Button Content="Thêm chi tiết kế hoạch" Tag="MoCuaSo:KhamDieuTri" CommandParameter="CHI_TIET_KE_HOACH" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Chi tiết kế hoạch" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:CHI_TIET_KE_HOACH" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_CHI_TIET_KE_HOACH" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã chi tiết kế hoạch" SortMemberPath="MaCTKH" Width="155" Binding="{Binding MaCTKH}" />
                  <DataGridTextColumn Header="Kế hoạch điều trị" SortMemberPath="MaKHDT" Width="155" Binding="{Binding MaKHDT}" />
                  <DataGridTextColumn Header="Dịch vụ" SortMemberPath="MaDV" Width="155" Binding="{Binding MaDV}" />
                  <DataGridTextColumn Header="Lần thứ" SortMemberPath="LanThu" Width="155" Binding="{Binding LanThu}" />
                  <DataGridTextColumn Header="Đơn giá" SortMemberPath="DonGia" Width="155" Binding="{Binding DonGia}" />
                  <DataGridTextColumn Header="Thành tiền" SortMemberPath="ThanhTien" Width="155" Binding="{Binding ThanhTien}" />
                  <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Visibility="Collapsed" Binding="{Binding TrangThai}" />
                  <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Visibility="Collapsed" Binding="{Binding GhiChu}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_CHI_TIET_KE_HOACH}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có chi tiết kế hoạch" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:KhamDieuTri" CommandParameter="CHI_TIET_KE_HOACH" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>