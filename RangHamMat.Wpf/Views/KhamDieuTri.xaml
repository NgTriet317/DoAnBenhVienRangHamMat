<UserControl x:Class="RangHamMat.Views.KhamDieuTri"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow"
             clinical:ClinicalLayout.IsEnabled="True"
             Background="#F4F7FB" Foreground="#21344B" FontSize="14"
             FontFamily="Segoe UI" Language="vi-VN"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource HospitalSecondary}"/>
            <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource HospitalMuted}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
            <Style x:Key="PreviewLabel" TargetType="TextBlock" BasedOn="{StaticResource FilterLabel}">
                <Setter Property="Foreground" Value="#64758A"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="PreviewValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#21344B"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource PreviewValue}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="ReceiptStatus" TargetType="Border">
                <Setter Property="Background" Value="#FFF5DD"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="TextElement.Foreground" Value="#946200"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TrangThai}" Value="Đang khám">
                        <Setter Property="Background" Value="#E7F1FF"/>
                        <Setter Property="TextElement.Foreground" Value="#1D5AAC"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="QueueItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="#21344B"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemSurface" Background="White" BorderBrush="#E2E9F2"
                                    BorderThickness="1" CornerRadius="9">
                                <Grid>
                                    <Border x:Name="SelectionMark" Width="3" Margin="0,12"
                                            HorizontalAlignment="Left" CornerRadius="2" Background="Transparent"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemSurface" Property="Background" Value="#F6F9FF"/>
                                    <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#BCD2EF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemSurface" Property="Background" Value="#EDF4FF"/>
                                    <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#88B2EB"/>
                                    <Setter TargetName="SelectionMark" Property="Background" Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="ItemSurface" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WorkTab" TargetType="TabItem">
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#64758A"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}"
                                    Background="Transparent" CornerRadius="7" Margin="2">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="#F0F4FA"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="#E8F1FF"/>
                                    <Setter Property="Foreground" Value="#1D5AAC"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button x:Name="ReloadQueueButton" DockPanel.Dock="Right" Click="Reload_Click"
                    Margin="16,0,0,0" VerticalAlignment="Top"
                    ToolTip="Hàng chờ tự cập nhật mỗi 10 giây khi không có nháp chưa lưu.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↻" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tải lại" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Accent}" Margin="0,0,12,0">
                        <Path Data="M 7,0 L 13,0 13,7 20,7 20,13 13,13 13,20 7,20 7,13 0,13 0,7 7,7 Z"
                              Fill="White" Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Khám và điều trị" FontSize="26" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ScopeText" Style="{StaticResource HospitalMuted}"
                           TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                <TextBlock x:Name="PageStatus" TextWrapping="Wrap" Foreground="#1D5AAC" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Border x:Name="QueueFilters" Grid.Row="1" Padding="14,12" Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource HospitalPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasContent, ElementName=DetailHost}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,4">
                        <TextBlock Text="Tìm người bệnh hoặc mã phiếu" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Padding="10,8"
                                 AutomationProperties.Name="Tìm người bệnh hoặc mã phiếu"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1">
                    <StackPanel x:Name="StatusFilterPanel" Width="155" Margin="0,0,14,4">
                        <TextBlock Text="Trạng thái" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" SelectedIndex="0"
                                  AutomationProperties.Name="Lọc trạng thái khám">
                            <ComboBoxItem Content="Tất cả"/>
                            <ComboBoxItem Content="Chờ khám"/>
                            <ComboBoxItem Content="Đang khám"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="Đặt lại" Click="ClearFilters_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </WrapPanel>
                </Grid>
                <Expander Header="Bộ lọc nâng cao" Margin="0,6,0,0">
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Width="210" Margin="0,0,14,4">
                            <TextBlock Text="Bệnh nhân" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="PatientFilter" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectionChanged="PatientFilter_Changed"/>
                        </StackPanel>
                        <StackPanel x:Name="DoctorFilterPanel" Width="210" Margin="0,0,14,4">
                            <TextBlock Text="Bác sĩ nhận khám" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="DoctorFilter" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectionChanged="DoctorFilter_Changed"/>
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,14,4">
                            <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="FromDate" SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,0,4">
                            <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="ToDate" SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                    </WrapPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Keep the three columns so ClinicalLayout can adapt to a narrow window. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource HospitalPanel}" Padding="10">
                <TabControl x:Name="WorkTabs" SelectionChanged="WorkTab_Changed"
                            BorderThickness="0" Background="Transparent" Padding="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#F7F9FC" CornerRadius="9" Padding="3">
                                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" Margin="0,12,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem x:Name="QueueTab" Header="Hàng chờ khám" Style="{StaticResource WorkTab}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="4,0,4,12">
                                <TextBlock x:Name="QueueCount" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="Ưu tiên theo thời gian tiếp nhận" Style="{StaticResource HospitalMuted}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="QueueList" SelectionChanged="Queue_Changed"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ItemContainerStyle="{StaticResource QueueItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,7">
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource ReceiptStatus}">
                                                        <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SoThuTu, StringFormat='SỐ {0:00}'}"
                                                               FontSize="12" FontWeight="Bold" Foreground="#1D5AAC"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding HoTenBN}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding MaBN}" FontSize="12" Foreground="#64758A" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding ThoiGianTiepNhan, StringFormat='Tiếp nhận {0:dd/MM · HH:mm}'}"
                                                           FontSize="12" Foreground="#43566E" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding TenBS, StringFormat='BS. {0}'}" FontSize="12"
                                                           TextWrapping="Wrap" Foreground="#64758A" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding TenPhong}" FontSize="12" TextWrapping="Wrap" Foreground="#64758A"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="QueueEmpty" Text="Chưa có người bệnh chờ khám trong phạm vi này."
                                           Style="{StaticResource HospitalMuted}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" Margin="20" IsHitTestVisible="False"/>
                            </Grid>
                            <Grid Grid.Row="2" Margin="2,10,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviousQueuePage" Content="← Trước" Click="PreviousQueue_Click"
                                        Padding="10,7" Margin="0"/>
                                <TextBlock x:Name="QueuePageText" Grid.Column="1" FontSize="12" Foreground="#64758A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                                <Button x:Name="NextQueuePage" Grid.Column="2" Content="Sau →" Click="NextQueue_Click"
                                        Padding="10,7" Margin="0"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="HistoryTab" Header="Lịch sử khám" Style="{StaticResource WorkTab}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="4,0,4,12">
                                <TextBlock x:Name="RecordCount" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Các lượt đã hoàn tất chuyên môn · chỉ xem"
                                           Style="{StaticResource HospitalMuted}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="VisitList" SelectionChanged="Visit_Changed"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource QueueItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Patient}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Code}" Foreground="#1D5AAC" FontSize="12" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding When}" Foreground="#64758A" FontSize="12" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Diagnosis}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="ListEmpty" Text="Chưa có lịch sử khám phù hợp."
                                           Style="{StaticResource HospitalMuted}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" Margin="20" IsHitTestVisible="False"/>
                            </Grid>
                            <WrapPanel x:Name="VisitPages" Grid.Row="2" Margin="2,10,2,0">
                                <Button x:Name="PreviousVisitPage" Content="← Trước" Click="PreviousVisit_Click" Padding="10,7"/>
                                <Button x:Name="NextVisitPage" Content="Sau →" Click="NextVisit_Click" Padding="10,7"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#D6E1F0"/>

            <Grid x:Name="DetailPane" Grid.Column="2">
                <ContentControl x:Name="DetailHost"/>
                <Border x:Name="DetailEmpty" Style="{StaticResource HospitalPanel}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" MaxWidth="370">
                        <Border Width="64" Height="64" CornerRadius="18" Background="#EAF2FF"
                                HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Path Data="M 4,1 L 20,1 20,25 4,25 Z M 8,8 L 16,8 M 8,13 L 16,13 M 8,18 L 13,18"
                                  Stroke="#2468CD" StrokeThickness="1.7" Width="25" Height="28" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyHeading" Text="Chọn người bệnh trong hàng chờ"
                                   FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ContextNote"
                                   Text="Xem thông tin tiếp nhận và đối chiếu người bệnh trước khi bắt đầu khám."
                                   Style="{StaticResource HospitalMuted}" FontSize="13" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- The entire preview scrolls as one document. Its height follows its content,
                     so the examination action stays immediately after the patient information. -->
                <Border x:Name="QueuePreview" Style="{StaticResource HospitalPanel}"
                        Padding="0" VerticalAlignment="Top" Visibility="Collapsed">
                    <ScrollViewer x:Name="QueueDetailsScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel>
                            <Border Background="#F5F9FF" BorderBrush="#E2EAF5" BorderThickness="0,0,0,1"
                                    CornerRadius="11,11,0,0" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="THÔNG TIN TIẾP NHẬN" Foreground="#64758A"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="QueuePatientText" FontSize="24" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding MaBN}" Foreground="#1D5AAC" FontWeight="SemiBold"
                                                       FontSize="12" Margin="0,0,12,4"/>
                                            <Border Style="{StaticResource ReceiptStatus}" Padding="8,2" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="White" BorderBrush="#DCE7F5"
                                            BorderThickness="1" CornerRadius="9" Padding="12,8" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="SỐ THỨ TỰ" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="#64758A" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding SoThuTu, StringFormat={}{0:00}}" FontSize="28"
                                                       FontWeight="SemiBold" Foreground="#1D5AAC" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Margin="20,16,20,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,16,14">
                                        <TextBlock Text="Phiếu tiếp nhận" Style="{StaticResource PreviewLabel}"/>
                                        <TextBlock x:Name="QueueReceiptText" Style="{StaticResource PreviewValue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="Tiếp nhận lúc" Style="{StaticResource PreviewLabel}"/>
                                        <TextBlock x:Name="QueueArrivalText" Style="{StaticResource PreviewValue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,16,0">
                                        <TextBlock Text="Ngày sinh" Style="{StaticResource PreviewLabel}"/>
                                        <TextBlock Text="{Binding NgaySinh, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue=Chưa cập nhật}"
                                                   Style="{StaticResource PreviewValue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Hồ sơ bệnh án" Style="{StaticResource PreviewLabel}"/>
                                        <TextBlock Text="{Binding MaHS}" Style="{StaticResource PreviewValue}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="#E7EDF5" Margin="0,16"/>
                                <TextBlock Text="Bác sĩ và nơi khám" Style="{StaticResource SectionHeading}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Bác sĩ phụ trách" Style="{StaticResource PreviewLabel}"/>
                                        <TextBlock x:Name="QueueDoctorText" Style="{StaticResource PreviewValue}"/>
                                        <TextBlock Text="{Binding MaBS}" FontSize="12" Foreground="#64758A" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Phòng khám" Style="{StaticResource PreviewLabel}"/>
                                        <TextBlock x:Name="QueueRoomText" Style="{StaticResource PreviewValue}"/>
                                        <TextBlock Text="{Binding MaPhong}" FontSize="12" Foreground="#64758A" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Dịch vụ đăng ký" Style="{StaticResource PreviewLabel}"/>
                                    <TextBlock x:Name="QueueServiceText" Style="{StaticResource PreviewValue}"/>
                                </StackPanel>

                                <Border Background="#F7F9FC" BorderBrush="#E7EDF5" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,16,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Lý do đến khám" Style="{StaticResource PreviewLabel}"/>
                                        <TextBlock x:Name="QueueReasonText" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border BorderBrush="#E2EAF5" BorderThickness="0,1,0,0" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Đối chiếu thông tin người bệnh trước khi khám."
                                               Style="{StaticResource HospitalMuted}" FontSize="12" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,18,0" MaxWidth="280"
                                               HorizontalAlignment="Left"/>
                                    <Button x:Name="QueueStartButton" Grid.Column="1" Content="Bắt đầu khám"
                                            Click="StartQueue_Click" Style="{StaticResource HospitalPrimary}"
                                            Padding="20,10" Margin="0" IsEnabled="False"
                                            ToolTip="Đối chiếu đúng người bệnh trước khi bắt đầu khám."/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
