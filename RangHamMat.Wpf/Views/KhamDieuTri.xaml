<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của KhamDieuTri.xaml. -->
<!-- AI hỗ trợ: bổ sung chú thích cho danh sách lần khám/điều trị. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.KhamDieuTri" Background="#F4F7FB" Foreground="#21344B" FontSize="13" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
  <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries><!-- Style mặc định cho Button: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalSecondary} để dùng chung template và hành vi control. -->
  <Style TargetType="Button" BasedOn="{StaticResource HospitalSecondary}"/><!-- Style VisitFilterLabel cho TextBlock: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalMuted} để dùng chung template và hành vi control. -->
  <Style x:Key="VisitFilterLabel" TargetType="TextBlock" BasedOn="{StaticResource HospitalMuted}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,5"/></Style></ResourceDictionary></UserControl.Resources>
  <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><!-- Thao tác Thêm lần khám: gọi AddVisit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button Content="Thêm lần khám" Click="AddVisit_Click" DockPanel.Dock="Right" Style="{StaticResource HospitalPrimary}"/><StackPanel><TextBlock Text="Khám điều trị" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Chọn lần khám để xem chẩn đoán, kế hoạch và dữ liệu điều trị của bệnh nhân." Style="{StaticResource HospitalMuted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Padding="16,12" Margin="0,0,0,16"><WrapPanel>
      <StackPanel Width="180" Margin="0,0,12,4"><TextBlock Text="Tìm lần khám / bệnh nhân" Style="{StaticResource VisitFilterLabel}"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Padding="8" ToolTip="Mã lần khám, bệnh nhân, triệu chứng hoặc chẩn đoán"/></StackPanel>
      <StackPanel Width="180" Margin="0,0,12,4"><TextBlock Text="Bệnh nhân" Style="{StaticResource VisitFilterLabel}"/><ComboBox x:Name="PatientFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="PatientFilter_Changed"/></StackPanel>
      <StackPanel Width="135" Margin="0,0,12,4"><TextBlock Text="Trạng thái" Style="{StaticResource VisitFilterLabel}"/><ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" SelectedIndex="0"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Nháp"/><ComboBoxItem Content="Đã xác nhận"/></ComboBox></StackPanel>
      <StackPanel Width="130" Margin="0,0,12,4"><TextBlock Text="Từ ngày" Style="{StaticResource VisitFilterLabel}"/><DatePicker x:Name="FromDate" SelectedDateChanged="Filter_Changed"/></StackPanel><StackPanel Width="130" Margin="0,0,12,4"><TextBlock Text="Đến ngày" Style="{StaticResource VisitFilterLabel}"/><DatePicker x:Name="ToDate" SelectedDateChanged="Filter_Changed"/></StackPanel>
      <!-- Thao tác Đặt lại: gọi ClearFilters_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Đặt lại" Click="ClearFilters_Click" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
    </WrapPanel></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource HospitalPanel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Danh sách lần khám" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="RecordCount" Grid.Row="1" Style="{StaticResource HospitalMuted}" Margin="0,8,0,12"/>
        <Grid Grid.Row="2"><!-- Vùng VisitList: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
        <ListBox x:Name="VisitList" SelectionChanged="Visit_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="#DFE8F3" BorderThickness="0,0,0,1"><StackPanel><DockPanel><TextBlock Text="{Binding Code}" FontWeight="SemiBold"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource HospitalStatusTemplate}" VerticalAlignment="Center" Margin="12,0,0,0" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="{Binding Patient}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding When}" Foreground="#60748D" Margin="0,6,0,0"/><TextBlock Text="{Binding Diagnosis}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="ListEmpty" Text="Chưa có lần khám phù hợp." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
      </Grid></Border>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D6E1F0"/>
      <Grid Grid.Column="2"><!-- Vùng DetailHost: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
      <ContentControl x:Name="DetailHost"/><Border x:Name="DetailEmpty" Style="{StaticResource HospitalPanel}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"><TextBlock Text="Chọn một lần khám" Style="{StaticResource HospitalHeading}" TextAlignment="Center"/><TextBlock x:Name="ContextNote" Text="Thông tin khám, tình trạng bệnh, kế hoạch, dịch vụ thực hiện và đơn thuốc sẽ xuất hiện tại đây." Style="{StaticResource HospitalMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
        <Border x:Name="NewVisitPanel" Style="{StaticResource HospitalPanel}" Visibility="Collapsed"><StackPanel MaxWidth="480" VerticalAlignment="Center"><TextBlock Text="Bắt đầu lần khám" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Chọn một lượt tiếp nhận chưa có lần khám. Mỗi lượt tiếp nhận chỉ tạo một lần khám." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,12,0,16"/><TextBlock Text="Lượt tiếp nhận" Style="{StaticResource VisitFilterLabel}"/><ComboBox x:Name="ReceiptChoice" DisplayMemberPath="Label" SelectedValuePath="Value"/><TextBlock x:Name="ReceiptNote" Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,12"/><WrapPanel><!-- Thao tác Mở lập lần khám: gọi CreateVisit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button x:Name="CreateVisitButton" Content="Mở lập lần khám" Click="CreateVisit_Click" Style="{StaticResource HospitalPrimary}"/><!-- Thao tác Lập lượt tiếp nhận: gọi Reception_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Lập lượt tiếp nhận" Click="Reception_Click"/><!-- Thao tác Hủy: gọi CancelNewVisit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Hủy" Click="CancelNewVisit_Click"/></WrapPanel></StackPanel></Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
