<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.TaiKhoan">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Tài khoản và vai trò" Style="{StaticResource Title}" />
      <TextBlock Text="Nhấp đúp vào một dòng để xem chi tiết. Chọn Thêm để tạo mới." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,20" />
    <TabControl Grid.Row="2">
      <TabItem Header="Tài khoản">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Thêm tài khoản" Tag="MoCuaSo:TaiKhoan" CommandParameter="TAI_KHOAN" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Tài khoản" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:TAI_KHOAN" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_TAI_KHOAN" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã tài khoản" SortMemberPath="MaTK" Width="155" Binding="{Binding MaTK}" />
                  <DataGridTextColumn Header="Tên đăng nhập" SortMemberPath="TenDangNhap" Width="155" Binding="{Binding TenDangNhap}" />
                  <DataGridTextColumn Header="Vai trò" SortMemberPath="MaVaiTro" Width="155" Binding="{Binding MaVaiTro}" />
                  <DataGridTextColumn Header="Nhân viên" SortMemberPath="MaNV" Width="155" Binding="{Binding MaNV}" />
                  <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Binding="{Binding TrangThai}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_TAI_KHOAN}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có tài khoản" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:TaiKhoan" CommandParameter="TAI_KHOAN" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Vai trò">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Thêm vai trò" Tag="MoCuaSo:TaiKhoan" CommandParameter="VAI_TRO" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Vai trò" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:VAI_TRO" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_VAI_TRO" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã vai trò" SortMemberPath="MaVaiTro" Width="155" Binding="{Binding MaVaiTro}" />
                  <DataGridTextColumn Header="Tên vai trò" SortMemberPath="TenVaiTro" Width="155" Binding="{Binding TenVaiTro}" />
                  <DataGridTextColumn Header="Mô tả" SortMemberPath="MoTa" Width="155" Binding="{Binding MoTa}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_VAI_TRO}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có vai trò" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:TaiKhoan" CommandParameter="VAI_TRO" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>