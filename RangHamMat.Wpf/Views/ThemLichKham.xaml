<UserControl x:Class="RangHamMat.Views.ThemLichKham"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F8FC" FontSize="14">

    <UserControl.Resources>
        <Style x:Key="LKLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#284765"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="LKTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#D9E5F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="LKComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#D9E5F1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="LKDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#D9E5F1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="LKCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0EAF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="LKValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#183B62"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <Border Grid.Row="0" Background="White" CornerRadius="16"
                BorderBrush="#E0EAF5" BorderThickness="1" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="txtTieuDeForm" Text="Thêm lịch khám mới" FontSize="26" FontWeight="Bold" Foreground="#173A61"/>
                    <TextBlock Text="Nhập thông tin bệnh nhân, sắp xếp bác sĩ và chọn thời gian khám."
                               FontSize="13" Foreground="#6A7F94" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EAF3FF" CornerRadius="12"
                        Padding="14,9" VerticalAlignment="Center">
                    <TextBlock Text="ĐIỀU PHỐI LỊCH KHÁM" Foreground="#2468CD"
                               FontSize="13" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- EditorTabs được giữ lại để AppWorkspace.ShowForm hoạt động -->
        <TabControl x:Name="EditorTabs" Grid.Row="1" Background="Transparent"
                    BorderThickness="0" SelectedIndex="0" SelectionChanged="EditorTabs_SelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="Lịch khám" Tag="Table:LICH_KHAM">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" MinWidth="480"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="3*" MinWidth="270"/>
                    </Grid.ColumnDefinitions>

                    <!-- BÊN TRÁI: FORM NHẬP -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">

                            <!-- 1. THÔNG TIN BỆNH NHÂN -->
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                        <Border Background="#E7F1FF" CornerRadius="9" Width="33" Height="33">
                                            <TextBlock Text="01" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#2468CD" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Thông tin lịch hẹn" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#173A61" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mã lịch khám *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <TextBox x:Name="txtMaLich" MaxLength="50" Tag="DB:LICH_KHAM.MaLich"
                                                     Style="{StaticResource LKTextBox}" ToolTip="Ví dụ: LK011. Mã phải duy nhất."/>
                                            </ContentControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Bệnh nhân *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <ComboBox x:Name="cboBenhNhan" Tag="DB:LICH_KHAM.MaBN"
                                                      Style="{StaticResource LKComboBox}"
                                                      DisplayMemberPath="HoTenBN" SelectedValuePath="MaBN"/>
                                            </ContentControl>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Dịch vụ khám (không bắt buộc)"
                                               Style="{StaticResource LKLabel}" Margin="0,16,0,7"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <ComboBox x:Name="cboDichVu" Tag="DB:LICH_KHAM.MaDV"
                                              DisplayMemberPath="TenDV" SelectedValuePath="MaDV"
                                              Style="{StaticResource LKComboBox}"/>
                                    </ContentControl>

                                    <TextBlock Text="Lý do khám *" Style="{StaticResource LKLabel}" Margin="0,16,0,7"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <TextBox x:Name="txtLyDoKham" FontSize="15" MaxLength="1000" Tag="DB:LICH_KHAM.LyDoKham"
                                             Height="82" Padding="12,9" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#D9E5F1" BorderThickness="1"
                                             ToolTip="Ví dụ: Đau răng hàm dưới, cần khám và tư vấn."/>
                                    </ContentControl>
                                </StackPanel>
                            </Border>

                            <!-- 2. ĐIỀU PHỐI BÁC SĨ / PHÒNG -->
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                        <Border Background="#E7F1FF" CornerRadius="9" Width="33" Height="33">
                                            <TextBlock Text="02" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#2468CD" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Phân công khám" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#173A61" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Bác sĩ phụ trách *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <ComboBox x:Name="cboBacSi" Tag="DB:LICH_KHAM.MaBS"
                                                      DisplayMemberPath="HoTen" SelectedValuePath="MaNV"
                                                      Style="{StaticResource LKComboBox}"/>
                                            </ContentControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Phòng khám *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <ComboBox x:Name="cboPhong" Tag="DB:LICH_KHAM.MaPhong"
                                                      DisplayMemberPath="TenPhong" SelectedValuePath="MaPhong"
                                                      Style="{StaticResource LKComboBox}"/>
                                            </ContentControl>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Ca khám *" Style="{StaticResource LKLabel}" Margin="0,16,0,7"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <ComboBox x:Name="cboCa" Tag="DB:LICH_KHAM.MaCa"
                                              DisplayMemberPath="TenCa" SelectedValuePath="MaCa"
                                              SelectionChanged="cboCa_SelectionChanged"
                                              Style="{StaticResource LKComboBox}"/>
                                    </ContentControl>
                                </StackPanel>
                            </Border>

                            <!-- 3. THỜI GIAN KHÁM -->
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                        <Border Background="#E7F1FF" CornerRadius="9" Width="33" Height="33">
                                            <TextBlock Text="03" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#2468CD" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Thời gian và mức độ ưu tiên" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#173A61" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Ngày khám *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <DatePicker x:Name="dpNgayKham" Tag="DB:LICH_KHAM.NgayGioKham"
                                                        Style="{StaticResource LKDatePicker}"/>
                                            </ContentControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Giờ khám * (HH:mm) - mặc định theo giờ bắt đầu ca" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <TextBox x:Name="txtGioKham" MaxLength="5"
                                                     Tag="Time:LICH_KHAM.NgayGioKham"
                                                     ToolTip="Chọn ca khám để tự lấy giờ bắt đầu; có thể sửa giờ trong ca."
                                                     Style="{StaticResource LKTextBox}"/>
                                            </ContentControl>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Thời lượng (phút) *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <TextBox x:Name="txtThoiLuong" MaxLength="3" Text="30"
                                                     Tag="DB:LICH_KHAM.ThoiLuongDuKien"
                                                     Style="{StaticResource LKTextBox}"/>
                                            </ContentControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Mức ưu tiên *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <ComboBox x:Name="cboUuTien" Tag="DB:LICH_KHAM.UuTien"
                                                      SelectedIndex="0" Style="{StaticResource LKComboBox}">
                                                <ComboBoxItem Content="Bình thường"/>
                                                <ComboBoxItem Content="Ưu tiên"/>
                                                <ComboBoxItem Content="Khẩn"/>
                                            </ComboBox>
                                            </ContentControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. HOÀN TẤT -->
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                        <Border Background="#E7F1FF" CornerRadius="9" Width="33" Height="33">
                                            <TextBlock Text="04" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#2468CD" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Trạng thái và ghi chú" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#173A61" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Trạng thái lịch khám *" Style="{StaticResource LKLabel}"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <ComboBox x:Name="cboTrangThai" Tag="DB:LICH_KHAM.TrangThai"
                                              SelectedIndex="0" Style="{StaticResource LKComboBox}">
                                        <ComboBoxItem Content="Nháp"/>
                                        <ComboBoxItem Content="Đã xác nhận"/>
                                        <ComboBoxItem Content="Chờ khám"/>
                                        <ComboBoxItem Content="Đã khám"/>
                                        <ComboBoxItem Content="Hủy"/>
                                        <ComboBoxItem Content="Đã hủy"/>
                                        <ComboBoxItem Content="Đã đổi"/>
                                        <ComboBoxItem Content="Hoàn thành"/>
                                    </ComboBox>
                                    </ContentControl>
                                    <TextBlock Text="Ghi chú nội bộ" Style="{StaticResource LKLabel}" Margin="0,16,0,7"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <TextBox x:Name="txtGhiChu" FontSize="15" MaxLength="1000" Tag="DB:LICH_KHAM.GhiChu"
                                             Height="74" Padding="12,9" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#D9E5F1" BorderThickness="1"/>
                                    </ContentControl>
                                    <StackPanel x:Name="pnlLyDoThayDoi" Visibility="Collapsed" Margin="0,14,0,0">
                                        <TextBlock Text="Lý do chỉnh sửa *" Style="{StaticResource LKLabel}"/>
                                        <TextBox x:Name="txtLyDoThayDoi" FontSize="15" Height="60" MaxLength="500"
                                                 Padding="12,7" TextWrapping="Wrap" AcceptsReturn="True"
                                                 BorderBrush="#D9E5F1" BorderThickness="1"/>
                                    </StackPanel>
                                    <TextBlock Text="Ngày tạo và ngày cập nhật sẽ được hệ thống ghi khi lưu."
                                               FontSize="13" Foreground="#718399" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- BÊN PHẢI: XEM TRƯỚC -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,1,0">
                            <Border CornerRadius="16" Padding="20" Margin="0,0,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2468CD" Offset="0"/>
                                        <GradientStop Color="#173D72" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="LỊCH KHÁM DỰ KIẾN" Foreground="#DDEBFF"
                                               FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Text, ElementName=txtMaLich, FallbackValue=—, TargetNullValue=—}"
                                               FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,11,0,4"/>
                                    <TextBlock Text="Thông tin được cập nhật theo biểu mẫu"
                                               FontSize="13" Foreground="#DDEBFF" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <TextBlock Text="Xem trước thông tin" FontSize="18" FontWeight="SemiBold"
                                               Foreground="#173A61" Margin="0,0,0,18"/>
                                    <TextBlock Text="Bệnh nhân" Style="{StaticResource LKLabel}"/>
                                    <TextBlock Text="{Binding SelectedItem.HoTenBN, ElementName=cboBenhNhan, TargetNullValue=Chưa chọn}"
                                               Style="{StaticResource LKValue}"/>
                                    <TextBlock Text="Bác sĩ" Style="{StaticResource LKLabel}"/>
                                    <TextBlock Text="{Binding SelectedItem.HoTen, ElementName=cboBacSi, TargetNullValue=Chưa chọn}"
                                               Style="{StaticResource LKValue}"/>
                                    <TextBlock Text="Phòng khám" Style="{StaticResource LKLabel}"/>
                                    <TextBlock Text="{Binding SelectedItem.TenPhong, ElementName=cboPhong, TargetNullValue=Chưa chọn}"
                                               Style="{StaticResource LKValue}"/>
                                    <TextBlock Text="Ca khám" Style="{StaticResource LKLabel}"/>
                                    <TextBlock Text="{Binding SelectedItem.TenCa, ElementName=cboCa, TargetNullValue=Chưa chọn}"
                                               Style="{StaticResource LKValue}"/>
                                    <TextBlock Text="Ngày khám" Style="{StaticResource LKLabel}"/>
                                    <TextBlock Text="{Binding SelectedDate, ElementName=dpNgayKham, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue=Chưa chọn}"
                                               Style="{StaticResource LKValue}"/>
                                    <TextBlock Text="Giờ khám" Style="{StaticResource LKLabel}"/>
                                    <TextBlock Text="{Binding Text, ElementName=txtGioKham}"
                                               Style="{StaticResource LKValue}"/>
                                    <TextBlock Text="Thời lượng dự kiến" Style="{StaticResource LKLabel}"/>
                                    <TextBlock Text="{Binding Text, ElementName=txtThoiLuong, StringFormat={}{0} phút}"
                                               Style="{StaticResource LKValue}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF8E8" BorderBrush="#F3DFAB" BorderThickness="1"
                                    CornerRadius="14" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="Lưu ý khi phân lịch" FontWeight="SemiBold"
                                               Foreground="#9B6500" FontSize="14"/>
                                    <TextBlock Text="Kiểm tra ca làm việc, thời gian của bác sĩ và tình trạng phòng trước khi xác nhận để tránh trùng lịch."
                                               Foreground="#8A6A2E" FontSize="13" TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- THANH THAO TÁC CỐ ĐỊNH -->
        <Border Grid.Row="2" Background="White" CornerRadius="14"
                BorderBrush="#E0EAF5" BorderThickness="1" Padding="18,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="* Trường bắt buộc" FontWeight="SemiBold" FontSize="13" Foreground="#284765"/>
                    <TextBlock Text="Dữ liệu được kiểm tra trước khi lưu vào SQL Server."
                               FontSize="13" Foreground="#718399" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Đóng" Click="btnDong_Click" Height="42" MinWidth="104"/>
                    <Button x:Name="btnLamMoi" Content="Làm mới" Height="42" MinWidth="104"
                            Click="btnLamMoi_Click"/>
                    <Button x:Name="btnLuuLich" Content="Lưu lịch khám" Height="42"
                            MinWidth="152" Style="{StaticResource Primary}" Click="btnLuuLich_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
