<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.ThemLichKham" Background="#F6FAFD" FontSize="14">
<UserControl.Resources>
        <Style x:Key="LKLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#284765"/>
            <Setter Property="Margin" Value="0, 0,0,7"/>
        </Style>
        <Style x:Key="LKTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#D9E5F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="LKComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#D9E5F1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="LKDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#D9E5F1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="LKCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0EAF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>
        <Style x:Key="LKValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#183B62"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
        </Style>
    </UserControl.Resources>

    

<Grid Margin="1,1,1,1">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#F0F6FF" CornerRadius="13" Padding="14,12" Margin="0,0,0,10">
    <StackPanel>
      <TextBlock x:Name="txtTieuDeForm" Text="Thêm lịch khám" Foreground="#163B63" FontSize="20" FontWeight="Bold"/>
      <TextBlock x:Name="txtMoTaForm" Text="Nhập thông tin và bấm Lưu để tạo lịch khám." FontSize="13" Foreground="#5A748F" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
  <!-- Giữ EditorTabs để tương thích AppWorkspace / các biểu mẫu khác. -->
  <TabControl x:Name="EditorTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="EditorTabs_SelectionChanged">
    <TabControl.Template>
      <ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate>
    </TabControl.Template>
    <TabItem Header="Lịch khám" Tag="Table:LICH_KHAM">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0,0,7,0" x:Name="pnlNhapLieu">

                            <!-- 1. THÔNG TIN BỆNH NHÂN -->
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                        <Border Background="#E7F1FF" CornerRadius="9" Width="33" Height="33">
                                            <TextBlock Text="01" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2468CD" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Thông tin lịch hẹn" FontSize="18" FontWeight="SemiBold" Foreground="#173A61" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel><StackPanel Grid.Column="0">
                                            <TextBlock Text="Mã lịch khám *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <TextBox x:Name="txtMaLich" MaxLength="50" Tag="DB:LICH_KHAM.MaLich"
                                                     Style="{StaticResource LKTextBox}" ToolTip="Ví dụ: LK011. Mã phải duy nhất."/>
                                            </ContentControl>
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Bệnh nhân *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <ComboBox x:Name="cboBenhNhan" Tag="DB:LICH_KHAM.MaBN"
                                                      Style="{StaticResource LKComboBox}"
                                                      DisplayMemberPath="HoTenBN" SelectedValuePath="MaBN"/>
                                            </ContentControl>
                                        </StackPanel>
                                    </StackPanel>


                                    <TextBlock Text="Dịch vụ khám (không bắt buộc)"
                                               Style="{StaticResource LKLabel}" Margin="0,16,0,7"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <ComboBox x:Name="cboDichVu" Tag="DB:LICH_KHAM.MaDV"
                                              DisplayMemberPath="TenDV" SelectedValuePath="MaDV"
                                              Style="{StaticResource LKComboBox}"/>
                                    </ContentControl>

                                    <TextBlock Text="Lý do khám *" Style="{StaticResource LKLabel}" Margin="0,16,0,7"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <TextBox x:Name="txtLyDoKham" FontSize="15" MaxLength="1000" Tag="DB:LICH_KHAM.LyDoKham"
                                             Height="82" Padding="12,9" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#D9E5F1" BorderThickness="1"
                                             ToolTip="Ví dụ: Đau răng hàm dưới, cần khám và tư vấn."/>
                                    </ContentControl>
                                </StackPanel>
                            </Border>

                            <!-- 2. ĐIỀU PHỐI BÁC SĨ / PHÒNG -->
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                        <Border Background="#E7F1FF" CornerRadius="9" Width="33" Height="33">
                                            <TextBlock Text="02" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2468CD" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Phân công khám" FontSize="18" FontWeight="SemiBold" Foreground="#173A61" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel><StackPanel>
                                            <TextBlock Text="Bác sĩ phụ trách *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <ComboBox x:Name="cboBacSi" Tag="DB:LICH_KHAM.MaBS"
                                                      DisplayMemberPath="HoTen" SelectedValuePath="MaNV"
                                                      Style="{StaticResource LKComboBox}"/>
                                            </ContentControl>
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Phòng khám *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <ComboBox x:Name="cboPhong" Tag="DB:LICH_KHAM.MaPhong"
                                                      DisplayMemberPath="TenPhong" SelectedValuePath="MaPhong"
                                                      Style="{StaticResource LKComboBox}"/>
                                            </ContentControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Ca khám *" Style="{StaticResource LKLabel}" Margin="0,16,0,7"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <ComboBox x:Name="cboCa" Tag="DB:LICH_KHAM.MaCa"
                                              DisplayMemberPath="TenCa" SelectedValuePath="MaCa"
                                              SelectionChanged="cboCa_SelectionChanged"
                                              Style="{StaticResource LKComboBox}"/>
                                    </ContentControl>
                                </StackPanel>
                            </Border>

                            <!-- 3. THỜI GIAN KHÁM -->
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                        <Border Background="#E7F1FF" CornerRadius="9" Width="33" Height="33">
                                            <TextBlock Text="03" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2468CD" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Thời gian và mức độ ưu tiên" FontSize="18" FontWeight="SemiBold" Foreground="#173A61" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel><StackPanel>
                                            <TextBlock Text="Ngày khám *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                            <DatePicker x:Name="dpNgayKham" Language="vi-VN" Tag="DB:LICH_KHAM.NgayGioKham"
                                                        Style="{StaticResource LKDatePicker}"/>
                                            </ContentControl>
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Giờ khám * (HH:mm) - mặc định theo giờ bắt đầu ca" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <TextBox x:Name="txtGioKham" MaxLength="5"
                                                     Tag="Time:LICH_KHAM.NgayGioKham"
                                                     ToolTip="Chọn ca khám để tự lấy giờ bắt đầu; có thể sửa giờ trong ca."
                                                     Style="{StaticResource LKTextBox}"/>
                                            </ContentControl>
                                        </StackPanel>
                                    </StackPanel><StackPanel Margin="0,16,0,0"><StackPanel>
                                            <TextBlock Text="Thời lượng (phút) *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <TextBox x:Name="txtThoiLuong" MaxLength="3" Text="30"
                                                     Tag="DB:LICH_KHAM.ThoiLuongDuKien"
                                                     Style="{StaticResource LKTextBox}"/>
                                            </ContentControl>
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Mức ưu tiên *" Style="{StaticResource LKLabel}"/>
                                            <ContentControl Style="{StaticResource TruongNhapLieu}">
                                             <ComboBox x:Name="cboUuTien" Tag="DB:LICH_KHAM.UuTien"
                                                      SelectedIndex="0" Style="{StaticResource LKComboBox}">
                                                <ComboBoxItem Content="Bình thường"/>
                                                <ComboBoxItem Content="Ưu tiên"/>
                                                <ComboBoxItem Content="Khẩn"/>
                                            </ComboBox>
                                            </ContentControl>
                                        </StackPanel>
                                    </StackPanel><TextBlock Text="Mức độ nghiêm trọng *" Style="{StaticResource LKLabel}" Margin="0,14,0,7"/>
                                    <ComboBox x:Name="cboMucDo" Style="{StaticResource LKComboBox}" SelectedIndex="0" SelectionChanged="cboMucDo_SelectionChanged">
                                        <ComboBoxItem Content="Thấp"/>
                                        <ComboBoxItem Content="Trung bình"/>
                                        <ComboBoxItem Content="Cao"/>
                                    </ComboBox>
                                    <TextBlock x:Name="txtYeuCauDuBi" Text="Mức Cao bắt buộc chọn bác sĩ dự bị." Foreground="#A45317" FontSize="13" Visibility="Collapsed" Margin="0,7,0,0"/>
                                    <TextBlock Text="Bác sĩ dự bị" Style="{StaticResource LKLabel}" Margin="0,14,0,7"/>
                                    <ComboBox x:Name="cboBacSiDuBi" Tag="DB:LICH_KHAM.MaBSDuBi"
                                              DisplayMemberPath="HoTen" SelectedValuePath="MaNV"
                                              Style="{StaticResource LKComboBox}"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. HOÀN TẤT -->
                            <Border Style="{StaticResource LKCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                        <Border Background="#E7F1FF" CornerRadius="9" Width="33" Height="33">
                                            <TextBlock Text="04" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2468CD" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Trạng thái và ghi chú" FontSize="18" FontWeight="SemiBold" Foreground="#173A61" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Trạng thái lịch khám *" Style="{StaticResource LKLabel}"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <ComboBox x:Name="cboTrangThai" Tag="DB:LICH_KHAM.TrangThai"
                                              SelectedIndex="0" Style="{StaticResource LKComboBox}">
                                        <ComboBoxItem Content="Nháp"/>
                                        <ComboBoxItem Content="Đã xác nhận"/>
                                        <ComboBoxItem Content="Chờ khám"/>
                                        <ComboBoxItem Content="Đã khám"/>
                                        <ComboBoxItem Content="Hủy"/>
                                        <ComboBoxItem Content="Đã hủy"/>
                                        <ComboBoxItem Content="Đã đổi"/>
                                        <ComboBoxItem Content="Hoàn thành"/>
                                    </ComboBox>
                                    </ContentControl>
                                    <TextBlock Text="Ghi chú nội bộ" Style="{StaticResource LKLabel}" Margin="0,16,0,7"/>
                                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                                     <TextBox x:Name="txtGhiChu" FontSize="15" MaxLength="1000" Tag="DB:LICH_KHAM.GhiChu"
                                             Height="74" Padding="12,9" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#D9E5F1" BorderThickness="1"/>
                                    </ContentControl>
                                    <StackPanel x:Name="pnlLyDoThayDoi" Visibility="Collapsed" Margin="0,14,0,0">
                                        <TextBlock Text="Lý do chỉnh sửa *" Style="{StaticResource LKLabel}"/>
                                        <TextBox x:Name="txtLyDoThayDoi" FontSize="15" Height="60" MaxLength="500" Padding="12,7" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#D9E5F1" BorderThickness="1"/>
                                    </StackPanel>
                                    <TextBlock Text="Ngày tạo và ngày cập nhật sẽ được hệ thống ghi khi lưu." FontSize="13" Foreground="#718399" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    

      </ScrollViewer>
    </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#E1EAF4" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,10,0,0">
    <StackPanel>
      <TextBlock x:Name="txtHuongDan" Text="* Trường bắt buộc. Dữ liệu được kiểm tra trước khi lưu." FontSize="12" Foreground="#607A92" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" MinWidth="75" Height="38" Margin="0,0,7,0"/>
        <Button x:Name="btnLamMoi" Content="Làm mới" Click="btnLamMoi_Click" MinWidth="82" Height="38" Margin="0,0,7,0"/>
        <Button x:Name="btnChinhSua" Content="Chỉnh sửa" Click="btnChinhSua_Click" Visibility="Collapsed" MinWidth="90" Height="38" Margin="0,0,7,0"/>
        <Button x:Name="btnLuuLich" Content="Lưu lịch khám" Click="btnLuuLich_Click" MinWidth="120" Height="38" Style="{StaticResource Primary}"/>
      </WrapPanel>
    </StackPanel>
  </Border>
</Grid>
</UserControl>
