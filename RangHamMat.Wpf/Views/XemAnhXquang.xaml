<Window x:Class="RangHamMat.Views.XemAnhXquang" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xem ảnh X-quang" Width="1100" Height="780" MinWidth="600" MinHeight="420" Background="#15212D" WindowStartupLocation="CenterOwner" Language="vi-VN">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Background="#FFFFFF" Margin="0" Orientation="Vertical"><TextBlock x:Name="Caption" TextWrapping="Wrap" Margin="16,12" FontSize="16" FontWeight="SemiBold"/><DockPanel Margin="16,0,16,12"><TextBlock Text="Phóng / thu" VerticalAlignment="Center"/><Slider x:Name="Zoom" Minimum="0.1" Maximum="3" Value="1" Width="260" Margin="12,0" TickFrequency="0.1"/></DockPanel></StackPanel>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="FullImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding Value,ElementName=Zoom}" ScaleY="{Binding Value,ElementName=Zoom}"/></Image.LayoutTransform></Image></ScrollViewer>
  <TextBlock Grid.Row="2" Text="Ảnh gốc của lần khám · đóng cửa sổ để trở về hồ sơ" Foreground="White" Margin="16,10"/>
 </Grid>
</Window>
