<!-- Giao diện ChiTietLichKham: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<Window x:Class="RangHamMat.Views.ChiTietLichKham"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết lịch khám" FontSize="14" Width="790" Height="650" MinWidth="650" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F5F8FD" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Tài nguyên ChiTietNhan (Style) áp dụng cho TextBlock. -->
        <Style x:Key="ChiTietNhan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7C90"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <!-- Tài nguyên ChiTietGiaTri (Style) áp dụng cho TextBlock. -->
        <Style x:Key="ChiTietGiaTri" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18385E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,19"/>
        </Style>
        <!-- Tài nguyên ChiTietThe (Style) áp dụng cho Border. -->
        <Style x:Key="ChiTietThe" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="#E0E9F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#174B8B" CornerRadius="16" Padding="22,17" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="THÔNG TIN LỊCH HẸN" Foreground="#D7E9FF" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MaLich}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,5"/>
                    <TextBlock Text="{Binding NgayGioKham, StringFormat={}{0:dd/MM/yyyy · HH:mm}}" Foreground="#E1F1FF" FontSize="16"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E7F4FF" CornerRadius="10" Padding="12,7"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding TrangThai}" Foreground="#195392" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource ChiTietThe}">
                    <StackPanel>
                        <TextBlock Text="Bệnh nhân và phân công" FontSize="19" FontWeight="Bold"
                                   Foreground="#18385E" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bệnh nhân" Style="{StaticResource ChiTietNhan}"/>
                                <TextBlock Text="{Binding TenBenhNhan}" Style="{StaticResource ChiTietGiaTri}"/>
                                <TextBlock Text="Bác sĩ phụ trách" Style="{StaticResource ChiTietNhan}"/>
                                <TextBlock Text="{Binding TenBacSi}" Style="{StaticResource ChiTietGiaTri}"/>
                                <TextBlock Text="Dịch vụ" Style="{StaticResource ChiTietNhan}"/>
                                <TextBlock Text="{Binding TenDichVu}" Style="{StaticResource ChiTietGiaTri}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Phòng khám" Style="{StaticResource ChiTietNhan}"/>
                                <TextBlock Text="{Binding TenPhong}" Style="{StaticResource ChiTietGiaTri}"/>
                                <TextBlock Text="Ca khám" Style="{StaticResource ChiTietNhan}"/>
                                <TextBlock Text="{Binding TenCa}" Style="{StaticResource ChiTietGiaTri}"/>
                                <TextBlock Text="Thời lượng" Style="{StaticResource ChiTietNhan}"/>
                                <TextBlock Text="{Binding ThoiLuongDuKien, StringFormat={}{0} phút}" Style="{StaticResource ChiTietGiaTri}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChiTietThe}">
                    <StackPanel>
                        <TextBlock Text="Nội dung và ghi chú" FontSize="19" FontWeight="Bold"
                                   Foreground="#18385E" Margin="0,0,0,15"/>
                        <TextBlock Text="Mức ưu tiên" Style="{StaticResource ChiTietNhan}"/>
                        <TextBlock Text="{Binding UuTien}" Style="{StaticResource ChiTietGiaTri}"/>
                        <TextBlock Text="Lý do khám" Style="{StaticResource ChiTietNhan}"/>
                        <TextBlock Text="{Binding LyDoKham}" Style="{StaticResource ChiTietGiaTri}"/>
                        <TextBlock Text="Ghi chú" Style="{StaticResource ChiTietNhan}"/>
                        <TextBlock Text="{Binding GhiChu}" Style="{StaticResource ChiTietGiaTri}"/>
                        <TextBlock Text="Lý do thay đổi" Style="{StaticResource ChiTietNhan}"/>
                        <TextBlock Text="{Binding LyDoThayDoi}" Style="{StaticResource ChiTietGiaTri}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChiTietThe}">
                    <StackPanel>
                        <TextBlock Text="Lịch sử thời gian" FontSize="19" FontWeight="Bold" Foreground="#18385E" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding NgayTao, StringFormat=Ngày tạo: {0:dd/MM/yyyy HH:mm}}" Foreground="#4F6680"/>
                        <TextBlock Text="{Binding NgayCapNhat, StringFormat=Ngày cập nhật: {0:dd/MM/yyyy HH:mm}, TargetNullValue=Chưa cập nhật}" Foreground="#4F6680" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" CornerRadius="13" BorderBrush="#E0E9F4"
                BorderThickness="1" Padding="13" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <!-- Thông tin hiển thị txtGhiChuSua — Có thể chỉnh sửa lịch chưa hoàn tất.. -->
                <TextBlock x:Name="txtGhiChuSua" DockPanel.Dock="Left" Foreground="#667D95"
                           VerticalAlignment="Center" Text="Có thể chỉnh sửa lịch chưa hoàn tất."/>
                <!-- Nút thao tác Đóng — Đóng. Chuyển sự kiện đến btnDong_Click trong code-behind. -->
                <Button DockPanel.Dock="Right" Content="Đóng" Width="90" Height="38"
                        Margin="10,0,0,0" Click="btnDong_Click"/>
                <!-- Nút thao tác btnSua — Chỉnh sửa. Chuyển sự kiện đến btnSua_Click trong code-behind. -->
                <Button x:Name="btnSua" DockPanel.Dock="Right" Content="Chỉnh sửa"
                        Width="120" Height="38" Style="{StaticResource Primary}"
                        Click="btnSua_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
