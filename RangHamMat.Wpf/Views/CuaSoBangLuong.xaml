<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.CuaSoBangLuong">
  <Grid Margin="24">
    <StackPanel VerticalAlignment="Center" MaxWidth="720" HorizontalAlignment="Center">
      <TextBlock Text="Lương và hoa hồng" Style="{StaticResource Title}" />
      <TextBlock Text="Thông tin lương và hoa hồng sẽ được bổ sung ở bước tiếp theo." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="16" Margin="0,12,0,24" />
      <WrapPanel>
        <Button Content="Đóng" Tag="DongCuaSo" />
        <Button Content="Về màn hình chính" Tag="VeTrangChu" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>