<Window x:Class="RangHamMat.Views.TiepNhanAI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiếp nhận AI - Tự động tạo phiếu" Width="1190" Height="835"
        MinWidth="990" MinHeight="640" WindowStartupLocation="CenterOwner"
        Background="#F3F7FB" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tiếp nhận từ trợ lý AI" FontSize="25" FontWeight="Bold" Foreground="#183B53"/>
                <TextBlock Text="Xác minh dữ liệu → Chọn phòng/bác sĩ/dịch vụ → Tạo hồ sơ &amp; phiếu khám → In hướng dẫn A5"
                           Foreground="#607488" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Làm mới danh sách" Click="LamMoi_Click"
                    Padding="16,8" Background="#E2EDF8" BorderThickness="0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="355"/>
                <ColumnDefinition Width="13"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="11" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Tra cứu bản khai AI" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Foreground="#657C8B" TextWrapping="Wrap" Margin="0,5,0,10" FontSize="12"
                                   Text="Nhập mã AI-XXXXXXXX do bệnh nhân nhận được hoặc chọn một dòng bên dưới."/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtMaTiepNhan" Padding="10,6" MinHeight="34"
                                     PreviewKeyDown="txtMaTiepNhan_PreviewKeyDown"/>
                            <Button Grid.Column="1" Content="Tra cứu" Click="TraCuuMaAI_Click"
                                    Padding="12,7" Margin="7,0,0,0" BorderThickness="0" Background="#DFEDF6"/>
                        </Grid>
                        <TextBlock x:Name="lblTraCuu" Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="#61788A" Text="Chưa chọn bản khai."/>
                    </StackPanel>
                    <DataGrid x:Name="gridPhien" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="gridPhien_SelectionChanged" CanUserAddRows="False"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã AI" Binding="{Binding MaRutGon}" Width="108"/>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="92"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="11" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Xác nhận &amp; phát hành tiếp nhận" FontWeight="Bold" FontSize="17"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,10">
                        <StackPanel>
                            <Border Background="#F0F6FD" Padding="11" CornerRadius="8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="BẢN KHAI AI (CHƯA ĐƯỢC CHẨN ĐOÁN)" FontSize="12" FontWeight="Bold" Foreground="#43647B"/>
                                    <TextBlock x:Name="txtMaPhien" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtThongTinGoc" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="txtTrieuChung" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="lblCanhBao" Foreground="#B12D2D" FontWeight="Bold"
                                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="1. Đối chiếu bệnh nhân" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                            <Border Background="#EAF3F9" CornerRadius="7" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Hệ thống tự đối chiếu theo họ tên, ngày sinh và điện thoại" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="lblKetQuaDoiChieu" Text="Đang chờ dữ liệu để đối chiếu..." Foreground="#275E78"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="panelBenhNhanCu" Margin="0,0,0,9" Visibility="Collapsed">
                                <TextBlock Text="Hồ sơ nghi trùng: chỉ cần chọn khi hệ thống chưa xác định duy nhất được bệnh nhân" Foreground="#52687C" TextWrapping="Wrap"/>
                                <Grid Margin="0,5,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtTimBenhNhan" Padding="9,6" MinHeight="34"
                                             PreviewKeyDown="txtTimBenhNhan_PreviewKeyDown"/>
                                    <Button Grid.Column="1" Content="Tìm hồ sơ" Click="TimBenhNhan_Click"
                                            Padding="12,7" Margin="7,0,0,0"/>
                                </Grid>
                                <ComboBox x:Name="cboBenhNhanCu" MinHeight="35" DisplayMemberPath="HienThi" SelectionChanged="cboBenhNhanCu_SelectionChanged"
                                          ToolTip="Chọn đúng bệnh nhân sau khi xác minh danh tính"/>
                                <TextBlock Text="Nếu có nhiều hồ sơ nghi trùng, cần chọn đúng hồ sơ; nếu thông tin định danh sai, sửa trong Hồ sơ bệnh nhân trước."
                                           FontSize="11" Foreground="#90611B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Họ và tên đã xác nhận *"/>
                                    <TextBox x:Name="txtHoTenDuyet" Padding="9,6" Margin="0,4,0,0" MinHeight="32" LostFocus="DuLieuDoiChieu_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Ngày sinh đã xác nhận *"/>
                                    <DatePicker x:Name="dpNgaySinhDuyet" Margin="0,4,0,0" MinHeight="32" SelectedDateChanged="DuLieuDoiChieu_NgaySinhChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Số điện thoại đã xác nhận *"/>
                            <TextBox x:Name="txtDienThoaiDuyet" Margin="0,4,0,8" Padding="9,6" MinHeight="32" LostFocus="DuLieuDoiChieu_LostFocus"/>
                            <TextBlock Text="Lý do đến khám đã xác nhận *"/>
                            <TextBox x:Name="txtLyDoDuyet" Margin="0,4,0,12" Padding="9,7" MinHeight="60"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="2. Xác nhận thông tin khám" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                            <TextBlock Text="Loại khám tự khai (nhân viên phải xác minh)"/>
                            <ComboBox x:Name="cboLoaiKham" Margin="0,4,0,8" MinHeight="34" SelectionChanged="cboLoaiKham_SelectionChanged">
                                <ComboBoxItem Content="Chưa xác minh loại khám" Tag="" IsSelected="True"/>
                                <ComboBoxItem Content="Khám thông thường" Tag="ThongThuong"/>
                                <ComboBoxItem Content="Khám dịch vụ (phụ thu dự kiến 30.000đ)" Tag="DichVu"/>
                            </ComboBox>
                            <CheckBox x:Name="chkXacNhanLoaiKham" Content="Tôi đã xác minh loại khám với bệnh nhân"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="Phòng khám *"/>
                            <ComboBox x:Name="cboPhong" Margin="0,4,0,8" MinHeight="34" SelectionChanged="cboPhong_SelectionChanged"/>
                            <TextBlock Text="Bác sĩ có lịch làm việc hôm nay (bắt buộc nếu khám dịch vụ)" TextWrapping="Wrap"/>
                            <ComboBox x:Name="cboBacSi" Margin="0,4,0,8" MinHeight="34" SelectionChanged="cboBacSi_SelectionChanged"/>
                            <TextBlock Text="Dịch vụ (chỉ chọn sau bác sĩ; bắt buộc nếu khám dịch vụ)" TextWrapping="Wrap"/>
                            <ComboBox x:Name="cboDichVu" Margin="0,4,0,8" MinHeight="34"/>
                            <TextBlock Text="Phụ thu khám dịch vụ được ghi vào kết quả tiếp nhận; cần đối soát với phân hệ hóa đơn trước khi thu tiền."
                                       Foreground="#995E18" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <CheckBox x:Name="chkDaDoiChieu" Content="Tôi đã xác minh đúng bệnh nhân, nội dung khai báo, loại khám và lịch phân công."
                                  Margin="0,3,0,10"/>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Mở Hồ sơ bệnh nhân" Click="MoHoSo_Click" Margin="0,0,10,0"
                                    Padding="14,10" Background="#E1EAF2" BorderThickness="0"/>
                            <Button x:Name="btnTaoPhieu" Content="Xác nhận &amp; tạo phiếu A5" Click="TaoPhieu_Click"
                                    Padding="18,10" Background="#14657F" Foreground="White" BorderThickness="0"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="lblThongBao" Margin="0,10,0,0" Foreground="#567488"
                   TextWrapping="Wrap" Text="Chỉ nhân viên có quyền tiếp nhận được phát hành phiếu khám từ bản khai AI."/>
    </Grid>
</Window>
