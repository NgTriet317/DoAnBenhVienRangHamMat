<UserControl x:Class="RangHamMat.Views.CuaSoNhaCungCap" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/DanhMucStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid MaxWidth="850">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock x:Name="txtTieuDe" Text="Thêm nhà cung cấp" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Thông tin liên hệ dùng khi đặt mua và nhập hàng. Dấu * là trường bắt buộc." Style="{StaticResource HospitalMuted}"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="Thông tin đối tác" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock Text="Tên nhà cung cấp *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,18">
     <TextBox x:Name="txtTenNCC" Tag="DB:NHA_CUNG_CAP.TenNCC" AutomationProperties.Name="Tên nhà cung cấp" MaxLength="255"/>
    </ContentControl>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Người liên hệ *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,18">
       <TextBox x:Name="txtNguoiLienHe" Tag="DB:NHA_CUNG_CAP.NguoiLienHe" AutomationProperties.Name="Người liên hệ" MaxLength="255"/>
      </ContentControl>
      <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,6">
       <TextBox x:Name="txtSDT" Tag="DB:NHA_CUNG_CAP.SDT" AutomationProperties.Name="Số điện thoại" MaxLength="50"/>
      </ContentControl><TextBlock Text="8–15 chữ số, có thể có mã quốc gia +84." Style="{StaticResource HospitalMuted}" Margin="0,0,0,18"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Email *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,18">
       <TextBox x:Name="txtEmail" Tag="DB:NHA_CUNG_CAP.Email" AutomationProperties.Name="Email" MaxLength="255"/>
      </ContentControl>
      <TextBlock Text="Trạng thái *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}">
       <ComboBox x:Name="cboTrangThai" Tag="DB:NHA_CUNG_CAP.TrangThai" AutomationProperties.Name="Trạng thái nhà cung cấp" SelectedIndex="0"><ComboBoxItem Content="Đang hoạt động"/><ComboBoxItem Content="Ngừng hoạt động"/></ComboBox>
      </ContentControl>
     </StackPanel>
    </Grid>
    <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,18">
     <TextBox x:Name="txtDiaChi" Tag="DB:NHA_CUNG_CAP.DiaChi" AutomationProperties.Name="Địa chỉ" MaxLength="255" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </ContentControl>
    <TextBlock Text="Mã nhà cung cấp" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtMaNCC" Tag="DB:NHA_CUNG_CAP.MaNCC" AutomationProperties.Name="Mã nhà cung cấp" Text="Tự sinh khi lưu" IsReadOnly="True" Margin="0,0,0,14"/>
    <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="12"><TextBlock Text="Nếu đối tác ngừng hợp tác, chọn Ngừng hoạt động để giữ nguyên thiết bị, lô hàng và hóa đơn đã liên kết." Foreground="#1D5AAC" TextWrapping="Wrap" FontSize="13"/></Border>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,18,0,0">
   <TextBlock x:Name="FormError" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy bỏ" Tag="DongCuaSo"/><Button Content="Lưu nhà cung cấp" Tag="HoSoSave" Style="{StaticResource HospitalPrimary}" IsDefault="True"/></StackPanel>
  </StackPanel>
 </Grid>
</UserControl>
