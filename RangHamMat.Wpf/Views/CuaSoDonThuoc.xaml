<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của CuaSoDonThuoc.xaml. -->
<!-- AI hỗ trợ: bổ sung chú thích cho biểu mẫu đơn thuốc và dòng thuốc. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.CuaSoDonThuoc" Loaded="Form_Loaded" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
 <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries><!-- Style RxLabel cho TextBlock: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalMuted} để dùng chung template và hành vi control. -->
 <Style x:Key="RxLabel" TargetType="TextBlock" BasedOn="{StaticResource HospitalMuted}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ResourceDictionary></UserControl.Resources>
 <Grid Background="#F4F7FB"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="EditorTitle" Text="Kê đơn thuốc mới" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Đơn được lưu nháp trước khi bác sĩ kiểm tra và xác nhận." Style="{StaticResource HospitalMuted}" Margin="0,5,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border x:Name="HeaderFields" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Lần khám *" Style="{StaticResource RxLabel}"/><!-- Trường Mã lần khám trong lịch sử khám bệnh (DON_THUOC.MaLS): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
    <ComboBox x:Name="VisitBox" Tag="DB:DON_THUOC.MaLS" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Visit_Changed" AutomationProperties.Name="Lần khám"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Bác sĩ kê đơn *" Style="{StaticResource RxLabel}"/><!-- Trường Mã bác sĩ, liên kết danh mục nhân viên (DON_THUOC.MaBS): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
    <ComboBox x:Name="DoctorBox" Tag="DB:DON_THUOC.MaBS" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Bác sĩ kê đơn"/></StackPanel>
    <StackPanel Grid.Column="4"><TextBlock Text="Ngày kê *" Style="{StaticResource RxLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><!-- Trường Ngày/giờ kê đơn thuốc (DON_THUOC.NgayKe): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
    <DatePicker x:Name="DateBox" Tag="DB:DON_THUOC.NgayKe"/><!-- Ô giờ DON_THUOC.NgayKe: nhập HH:mm, ghép với ngày của trường DB cùng tên trong BieuMauHoSo.Read trước khi lưu. -->
    <TextBox Grid.Column="1" Tag="Time:DON_THUOC.NgayKe" MaxLength="5" Margin="6,0,0,0" ToolTip="HH:mm"/></Grid></StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0"><TextBlock Text="Chẩn đoán của lần khám" Style="{StaticResource RxLabel}"/><TextBlock x:Name="DiagnosisText" Text="Chọn lần khám để xem chẩn đoán" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"><TextBlock Text="Ghi chú" Style="{StaticResource RxLabel}"/><!-- Trường Ghi chú bổ sung (DON_THUOC.GhiChu): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
    <TextBox Tag="DB:DON_THUOC.GhiChu" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,12,0,0"><TextBlock Text="Lý do thay đổi chỉ định (đơn mới)" Style="{StaticResource RxLabel}"/><!-- Trường Lý do thay đổi chỉ định đơn thuốc (DON_THUOC.LyDoThayThe): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
    <TextBox Tag="DB:DON_THUOC.LyDoThayThe" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
   </Grid></Border>
   <StackPanel x:Name="LineParentFields" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock Text="Đơn nháp *" Style="{StaticResource RxLabel}"/><!-- Trường Mã đơn thuốc (CHI_TIET_DON_THUOC.MaDT): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
   <ComboBox x:Name="ParentBox" Tag="DB:CHI_TIET_DON_THUOC.MaDT" DisplayMemberPath="Label" SelectedValuePath="Value"/></StackPanel>
   <DockPanel Margin="0,0,0,9"><!-- Thao tác + Thêm thuốc: gọi AddMedicine_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
   <Button Style="{StaticResource HospitalSecondary}" x:Name="AddButton" DockPanel.Dock="Right" Content="+ Thêm thuốc" Click="AddMedicine_Click"/><StackPanel><TextBlock Text="Thuốc kê" FontWeight="Bold" FontSize="13"/><TextBlock Text="Chọn thuốc trong danh mục và nhập đầy đủ hướng dẫn cho người bệnh." FontSize="12" Foreground="#61748B" Margin="0,4,0,0"/></StackPanel></DockPanel>
   <!-- Vùng MedicineRows: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
   <ItemsControl x:Name="MedicineRows"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Thuốc *" Style="{StaticResource RxLabel}"/><ComboBox ItemsSource="{Binding MedicineOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValue="{Binding MaThuoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Thuốc"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Liều dùng *" Style="{StaticResource RxLabel}"/><TextBox Text="{Binding LieuDung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ví dụ: 1 viên, 2 lần/ngày"/></StackPanel>
    <StackPanel Grid.Column="4"><TextBlock Text="Số ngày *" Style="{StaticResource RxLabel}"/><TextBox Text="{Binding SoNgayDung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    <StackPanel Grid.Column="6"><TextBlock Text="Số lượng *" Style="{StaticResource RxLabel}"/><TextBox Text="{Binding SoLuong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="7" Margin="0,10,0,0"><TextBlock Text="Hướng dẫn cụ thể *" Style="{StaticResource RxLabel}"/><TextBox Text="{Binding HuongDan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Đường dùng, thời điểm dùng và hướng dẫn cho người bệnh"/></StackPanel>
    <!-- Thao tác Xóa thuốc: gọi RemoveMedicine_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button Grid.Row="2" Grid.Column="6" Content="Xóa thuốc" Click="RemoveMedicine_Click" Foreground="#B91C1C" FontSize="12" Margin="0,8,0,0" MinHeight="25" Padding="7,4"/>
   </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="Đơn đã xác nhận được giữ nguyên. Khi cần đổi chỉ định, tạo đơn mới độc lập từ cùng lần khám." Style="{StaticResource HospitalMuted}" Margin="0,2,0,12"/>
   <TextBlock x:Name="FormError" Foreground="#B91C1C" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Background="#F4F7FB" BorderBrush="#DCE5F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><DockPanel><WrapPanel DockPanel.Dock="Right"><!-- Nút điều hướng DongCuaSo: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
  <Button Style="{StaticResource HospitalSecondary}" Margin="0,0,8,0" Content="Hủy bỏ" Tag="DongCuaSo"/><!-- Nút điều hướng HoSoSave: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
  <Button Content="Lưu đơn nháp" Tag="HoSoSave" Style="{StaticResource HospitalPrimary}"/></WrapPanel><TextBlock Text="Lưu đơn và các dòng thuốc vào database" Style="{StaticResource HospitalMuted}" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</UserControl>
