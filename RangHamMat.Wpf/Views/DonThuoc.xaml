<UserControl x:Class="RangHamMat.Views.DonThuoc"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow"
 clinical:ClinicalLayout.IsEnabled="True" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Background="#F4F7FB"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="Đơn thuốc" Style="{StaticResource HospitalHeading}"/>
   <TextBlock Text="Tra cứu đơn bác sĩ đã kê và bàn giao thuốc sau thanh toán. Kê đơn tại Khám điều trị." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource HospitalPanel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="FiltersPanel" Margin="0,0,0,12">
     <TextBlock Text="Tìm đơn thuốc" FontSize="12" Margin="0,0,0,4"/>
     <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" MaxLength="255" ToolTip="Mã đơn, mã hoặc tên bệnh nhân, điện thoại, bác sĩ" AutomationProperties.Name="Tìm đơn thuốc"/>
     <TextBlock Text="Bệnh nhân trên trang" FontSize="12" Margin="0,12,0,4"/>
     <ComboBox x:Name="PatientFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Patient_Changed" AutomationProperties.Name="Lọc đơn theo bệnh nhân"/>
     <TextBlock Text="Trạng thái đơn đã kê" FontSize="12" Margin="0,12,0,4"/>
     <ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" SelectedIndex="0" AutomationProperties.Name="Trạng thái đơn thuốc">
      <ComboBoxItem Content="Đã xác nhận"/><ComboBoxItem Content="Ngừng áp dụng"/>
     </ComboBox>
     <Button Content="Xóa bộ lọc" Style="{StaticResource HospitalSecondary}" Click="ClearFilters_Click" Margin="0,12,0,0"/>
     <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#A33232" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <Grid Grid.Row="1">
     <ListBox x:Name="PrescriptionList" SelectionChanged="Order_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Danh sách đơn đã kê">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10">
       <DockPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource HospitalStatusTemplate}" VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Right"/><TextBlock Text="{Binding Code, StringFormat=Đơn {0}}" FontWeight="SemiBold" FontSize="13"/></DockPanel>
       <TextBlock Text="{Binding Patient}" TextWrapping="Wrap" Margin="0,5,0,0"/>
       <TextBlock Text="{Binding Doctor, StringFormat=Bác sĩ: {0}}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#61748B"/>
       <TextBlock Text="{Binding When}" Foreground="#61748B" FontSize="12" Margin="0,5,0,0"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="ListEmpty" Text="Không có đơn đã kê phù hợp trong phạm vi được phép." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="16" Foreground="#61748B" IsHitTestVisible="False"/>
    </Grid>
    <StackPanel Grid.Row="2"><TextBlock x:Name="RecordCount" Style="{StaticResource HospitalMuted}" Margin="0,12,0,0"/>
     <WrapPanel x:Name="PrescriptionPages" Visibility="Collapsed" Margin="0,8,0,0"><Button x:Name="PreviousPrescriptionPage" Content="← Trước" Click="PreviousPrescription_Click" MinHeight="36"/><Button x:Name="NextPrescriptionPage" Content="Sau →" Click="NextPrescription_Click" MinHeight="36" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel>
   </Grid></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#D8E2EF" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
   <Grid Grid.Column="2"><ContentControl x:Name="DetailHost"/>
    <Border x:Name="DetailEmpty" Style="{StaticResource HospitalPanel}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
     <TextBlock Text="Chọn một đơn thuốc" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock x:Name="DetailEmptyText" Text="Chọn đơn để xem nội dung bác sĩ đã kê và trạng thái bàn giao." Style="{StaticResource HospitalMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel></Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
