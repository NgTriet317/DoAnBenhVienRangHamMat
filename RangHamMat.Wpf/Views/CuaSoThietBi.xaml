<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của CuaSoThietBi.xaml; các vùng liên quan: Thiết bị. -->
<!-- AI hỗ trợ: bổ sung chú thích cho biểu mẫu thiết bị. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.CuaSoThietBi">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Trang thiết bị · Thêm mới" Style="{StaticResource Title}" />
      <TextBlock Text="Điền lần lượt từng nhóm thông tin. Dấu * là trường bắt buộc." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <TabControl x:Name="EditorTabs" Grid.Row="1">
      <!-- Nhóm Thiết bị: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem Header="Thiết bị" Tag="Table:THIET_BI" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1220" HorizontalAlignment="Left" Margin="0,20,12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin thiết bị" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Tên thiết bị *" Margin="0,0,0,6" />
                    <!-- Trường TenTB (THIET_BI.TenTB): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <TextBox Tag="DB:THIET_BI.TenTB" AutomationProperties.Name="Tên thiết bị" MaxLength="255" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Loại thiết bị" Margin="0,0,0,6" />
                    <!-- Trường LoaiTB (THIET_BI.LoaiTB): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <TextBox Tag="DB:THIET_BI.LoaiTB" AutomationProperties.Name="Loại thiết bị" MaxLength="255" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Số serial" Margin="0,0,0,6" />
                    <!-- Trường Số serial thiết bị (THIET_BI.SoSerial): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <TextBox Tag="DB:THIET_BI.SoSerial" AutomationProperties.Name="Số serial" MaxLength="50" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ngày mua" Margin="0,0,0,6" />
                    <!-- Trường Ngày mua thiết bị (THIET_BI.NgayMua): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <DatePicker Tag="DB:THIET_BI.NgayMua" AutomationProperties.Name="Ngày mua" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn nhà cung cấp">
                    <TextBlock Text="Nhà cung cấp" Margin="0,0,0,6" />
                    <!-- Trường Mã nhà cung cấp (THIET_BI.MaNCC): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ComboBox Tag="DB:THIET_BI.MaNCC" AutomationProperties.Name="Nhà cung cấp" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Phòng sử dụng" Margin="0,0,0,6" />
                    <!-- Trường PhongSuDung (THIET_BI.PhongSuDung): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <TextBox Tag="DB:THIET_BI.PhongSuDung" AutomationProperties.Name="Phòng sử dụng" MaxLength="255" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Số thập phân; tối đa 3 chữ số sau dấu thập phân.">
                    <TextBlock Text="Số lượng *" Margin="0,0,0,6" />
                    <!-- Trường Số lượng thuốc/hàng hóa/dịch vụ (THIET_BI.SoLuong): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <TextBox Tag="DB:THIET_BI.SoLuong" AutomationProperties.Name="Số lượng" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Tình trạng *" Margin="0,0,0,6" />
                    <!-- Trường Tình trạng sử dụng phòng/thiết bị (THIET_BI.TinhTrang): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <TextBox Tag="DB:THIET_BI.TinhTrang" AutomationProperties.Name="Tình trạng" MaxLength="255" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ngày bảo hành" Margin="0,0,0,6" />
                    <!-- Trường NgayBaoHanh (THIET_BI.NgayBaoHanh): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <DatePicker Tag="DB:THIET_BI.NgayBaoHanh" AutomationProperties.Name="Ngày bảo hành" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Nội dung và ghi chú" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ghi chú" Margin="0,0,0,6" />
                    <!-- Trường Ghi chú bổ sung (THIET_BI.GhiChu): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <TextBox Tag="DB:THIET_BI.GhiChu" AutomationProperties.Name="Ghi chú" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin quản lý" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Tự sinh khi lưu">
                    <TextBlock Text="Mã thiết bị" Margin="0,0,0,6" />
                    <!-- Trường Mã thiết bị (THIET_BI.MaTB): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. Ô chỉ đọc, không cho nhập lại mã/giá trị nguồn. -->
                    <TextBox Tag="DB:THIET_BI.MaTB" AutomationProperties.Name="Mã thiết bị" IsReadOnly="True" Text="Tự sinh" Background="{StaticResource Canvas}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="0,18,0,0">
      <WrapPanel>
        <!-- Nút điều hướng DongCuaSo: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
        <Button Content="Quay lại danh sách" Tag="DongCuaSo" />
        <Button Content="Lưu thông tin" IsEnabled="False" Style="{StaticResource Primary}" ToolTip="Bản giao diện chưa kết nối lưu dữ liệu" />
        <!-- Nút điều hướng VeTrangChu: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
        <Button Content="Về màn hình chính" Tag="VeTrangChu" />
        <TextBlock Text="Bản giao diện • Chưa lưu dữ liệu" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0,0,0" />
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>