<Window x:Class="RangHamMat.Views.XemTruocHoaDon"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RangHamMat.Views"
 Title="Xem trước hóa đơn" Width="940" Height="820" MinWidth="700" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#E8EDF3" FontFamily="Segoe UI" Language="vi-VN">
 <Window.Resources><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/DocumentPreviewStyles.xaml"/></Window.Resources>
 <Grid Background="#E8EDF3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource DocumentToolbar}"><DockPanel>
   <Button DockPanel.Dock="Right" Content="In / Xuất PDF…" Click="Print_Click" Style="{StaticResource HospitalPrimary}" Margin="18,0,0,0"/>
   <StackPanel><TextBlock Text="Xem trước hóa đơn" FontSize="19" FontWeight="SemiBold" Foreground="#183B53"/><TextBlock Text="Kiểm tra thông tin và các khoản thanh toán trước khi in" Style="{StaticResource HospitalMuted}" Margin="0,4,0,0"/></StackPanel>
  </DockPanel></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
   <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"><Border Style="{StaticResource DocumentPaper}"><local:InvoiceDocument x:Name="InvoiceDocument" VerticalAlignment="Top"/></Border></Viewbox>
  </ScrollViewer>
  <TextBlock x:Name="PrintStatus" Grid.Row="2" Style="{StaticResource DocumentFooter}" Text="Chọn máy in hoặc Microsoft Print to PDF. Hóa đơn dài sẽ tự chia trang." AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
