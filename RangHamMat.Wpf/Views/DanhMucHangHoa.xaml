<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RangHamMat.Views.DanhMucHangHoa">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Danh mục hàng hóa" Style="{StaticResource Title}" />
          <TextBlock Text="Lớp danh mục dùng chung cho vật tư, thuốc và thiết bị theo mô hình database chuẩn hóa mới." Style="{StaticResource Subtitle}" Margin="0,2,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Background="#EEF7FF" BorderBrush="#C8E1FA" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel><TextBlock Text="Danh mục trung tâm" FontWeight="SemiBold" Foreground="#165D96" /><TextBlock Text="LOAI_HANG_HOA → HANG_HOA → THUOC / LO_HANG_HOA" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
        </Border>
      </Grid>

      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Loại hàng hóa" Foreground="#1D4ED8" /><TextBlock Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
        <Border Grid.Column="2" Background="#F0FDFA" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Mặt hàng" Foreground="#0F766E" /><TextBlock Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
        <Border Grid.Column="4" Background="#FFF7ED" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Thuốc" Foreground="#C2410C" /><TextBlock Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
        <Border Grid.Column="6" Background="#F5F3FF" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Lô hàng" Foreground="#6D28D9" /><TextBlock Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="230" /></Grid.RowDefinitions>
            <Border Padding="18,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Loại hàng hóa" Style="{StaticResource SectionTitle}" /><Button Content="+ Loại mới" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Margin="0" /></DockPanel></Border>
            <DataGrid x:Name="Grid_LOAI_HANG_HOA" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã loại" Binding="{Binding MaLoaiHH}" Width="110" />
                <DataGridTextColumn Header="Tên loại hàng hóa" Binding="{Binding TenLoaiHH}" Width="190" />
                <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="220" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="230" /></Grid.RowDefinitions>
            <Border Padding="18,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Hàng hóa dùng chung" Style="{StaticResource SectionTitle}" /><Button Content="+ Mặt hàng" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Margin="0" /></DockPanel></Border>
            <DataGrid x:Name="Grid_HANG_HOA" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã hàng" Binding="{Binding MaHH}" Width="105" />
                <DataGridTextColumn Header="Tên hàng" Binding="{Binding TenHH}" Width="180" />
                <DataGridTextColumn Header="Loại" Binding="{Binding MaLoaiHH}" Width="110" />
                <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding DonViTinh}" Width="110" />
                <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="180" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="115" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="230" /></Grid.RowDefinitions>
            <Border Padding="18,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel><StackPanel><TextBlock Text="Thuốc" Style="{StaticResource SectionTitle}" /><TextBlock Text="Chỉ lưu thuộc tính riêng; tên và đơn vị tính lấy từ HANG_HOA." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" /></StackPanel><Button Content="+ Thuốc" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Margin="8,0,0,0" /></DockPanel></Border>
            <DataGrid x:Name="Grid_THUOC" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã thuốc" Binding="{Binding MaThuoc}" Width="115" />
                <DataGridTextColumn Header="Hàng hóa" Binding="{Binding MaHH}" Width="120" />
                <DataGridTextColumn Header="Hàm lượng" Binding="{Binding HamLuong}" Width="160" />
                <DataGridTextColumn Header="Mức tồn tối thiểu" Binding="{Binding MucTonToiThieu}" Width="170" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="230" /></Grid.RowDefinitions>
            <Border Padding="18,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel><StackPanel><TextBlock Text="Lô hàng hóa" Style="{StaticResource SectionTitle}" /><TextBlock Text="Theo dõi lô cho các mặt hàng cần hạn dùng/lô sản xuất." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" /></StackPanel><Button Content="+ Lô hàng" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Margin="8,0,0,0" /></DockPanel></Border>
            <DataGrid x:Name="Grid_LO_HANG_HOA" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã lô" Binding="{Binding MaLo}" Width="100" />
                <DataGridTextColumn Header="Hàng hóa" Binding="{Binding MaHH}" Width="110" />
                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding MaNCC}" Width="125" />
                <DataGridTextColumn Header="Kho" Binding="{Binding MaKho}" Width="100" />
                <DataGridTextColumn Header="Số lô" Binding="{Binding SoLo}" Width="115" />
                <DataGridTextColumn Header="Ngày nhập" Binding="{Binding NgayNhap}" Width="120" />
                <DataGridTextColumn Header="Hạn sử dụng" Binding="{Binding HanSuDung}" Width="125" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
