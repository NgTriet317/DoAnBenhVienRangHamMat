<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của CuaSoLichKham.xaml. -->
<!-- AI hỗ trợ: bổ sung chú thích cho biểu mẫu đặt/hẹn lại lịch khám. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.CuaSoLichKham" Loaded="Form_Loaded" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
        <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock x:Name="EditorTitle" Text="Đặt lịch khám qua điện thoại" Style="{StaticResource HospitalHeading}"/>
      <TextBlock Text="Ghi nhận người đặt hẹn, thời gian, bác sĩ và phòng khám. Chỉ tiếp nhận khi bệnh nhân đến bệnh viện." Style="{StaticResource HospitalMuted}"/>
      <TextBlock x:Name="PatientPhone" Foreground="{StaticResource AccentDark}" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ItemsControl>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Mã lịch khám" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Mã lịch hẹn khám (LICH_KHAM.MaLich): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. Ô chỉ đọc, không cho nhập lại mã/giá trị nguồn. -->
            <TextBox Tag="DB:LICH_KHAM.MaLich" IsReadOnly="True" ToolTip="Tự sinh khi lưu"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Bệnh nhân" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Mã bệnh nhân (LICH_KHAM.MaBN): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <ComboBox x:Name="PatientPicker" Tag="DB:LICH_KHAM.MaBN" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Schedule_Changed"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Bác sĩ" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Mã bác sĩ, liên kết danh mục nhân viên (LICH_KHAM.MaBS): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <ComboBox x:Name="DoctorPicker" Tag="DB:LICH_KHAM.MaBS" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Schedule_Changed"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Ca làm" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Mã ca làm việc (LICH_KHAM.MaCa): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <ComboBox x:Name="ShiftPicker" Tag="DB:LICH_KHAM.MaCa" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Schedule_Changed"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Phòng" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Mã phòng (LICH_KHAM.MaPhong): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <ComboBox x:Name="RoomPicker" Tag="DB:LICH_KHAM.MaPhong" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Schedule_Changed"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Dịch vụ dự kiến" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Mã dịch vụ (LICH_KHAM.MaDV): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <ComboBox Tag="DB:LICH_KHAM.MaDV" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Schedule_Changed"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Ngày giờ khám" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="85"/>
              </Grid.ColumnDefinitions>
              <!-- Trường Ngày/giờ hẹn khám (LICH_KHAM.NgayGioKham): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
              <DatePicker x:Name="AppointmentDate" Tag="DB:LICH_KHAM.NgayGioKham" SelectedDateChanged="Schedule_Changed"/>
              <!-- Ô giờ LICH_KHAM.NgayGioKham: nhập HH:mm, ghép với ngày của trường DB cùng tên trong BieuMauHoSo.Read trước khi lưu. -->
              <TextBox x:Name="StartTime" Tag="Time:LICH_KHAM.NgayGioKham" Grid.Column="1" Margin="8,0,0,0" TextChanged="Schedule_Changed"/>
            </Grid>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Thời lượng dự kiến (phút)" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Thời lượng dự kiến của lịch hẹn tính bằng phút (LICH_KHAM.ThoiLuongDuKien): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <TextBox x:Name="Duration" Tag="DB:LICH_KHAM.ThoiLuongDuKien" Text="30" TextChanged="Schedule_Changed"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Ưu tiên" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Mức ưu tiên lịch hẹn (LICH_KHAM.UuTien): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <TextBox x:Name="Priority" Tag="DB:LICH_KHAM.UuTien" Text="0"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Lý do khám" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Lý do đến khám (LICH_KHAM.LyDoKham): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <TextBox Tag="DB:LICH_KHAM.LyDoKham" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Lý do thay đổi" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Lý do thay đổi lịch hẹn (LICH_KHAM.LyDoThayDoi): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <TextBox x:Name="ChangeReason" Tag="DB:LICH_KHAM.LyDoThayDoi" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Trạng thái nghiệp vụ của bản ghi (LICH_KHAM.TrangThai): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. Ô chỉ đọc, không cho nhập lại mã/giá trị nguồn. -->
            <TextBox Tag="DB:LICH_KHAM.TrangThai" Text="Nháp" IsReadOnly="True"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,16">
            <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}"/>
            <!-- Trường Ghi chú bổ sung (LICH_KHAM.GhiChu): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
            <TextBox x:Name="Notes" Tag="DB:LICH_KHAM.GhiChu" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
          </StackPanel>
        </ItemsControl>
        <Border x:Name="ConflictPanel" Visibility="Collapsed" Background="#FFF8EB" Padding="12" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock x:Name="ConflictText" Foreground="#854D0E" TextWrapping="Wrap"/>
            <CheckBox x:Name="OverlapAccepted" Content="Đã kiểm tra và vẫn xếp lịch chồng giờ" Margin="0,10,0,6"/>
            <TextBox x:Name="OverlapReason" ToolTip="Lý do xếp lịch chồng giờ"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Right">
          <!-- Nút điều hướng DongCuaSo: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
          <Button Content="Hủy" Tag="DongCuaSo"/>
          <!-- Nút điều hướng HoSoSave: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
          <Button x:Name="SaveButton" Content="Lưu lịch hẹn" Tag="HoSoSave" Style="{StaticResource HospitalPrimary}"/>
        </WrapPanel>
        <TextBlock x:Name="FormError" Foreground="#B42318" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
