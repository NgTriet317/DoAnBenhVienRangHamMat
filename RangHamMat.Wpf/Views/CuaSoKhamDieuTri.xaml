                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn bệnh nhân">
                    <TextBlock Text="Bệnh nhân *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:KE_HOACH_DIEU_TRI.MaBN" AutomationProperties.Name="Bệnh nhân" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn bác sĩ">
                    <TextBlock Text="Bác sĩ *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:KE_HOACH_DIEU_TRI.MaBS" AutomationProperties.Name="Bác sĩ" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Thời điểm mặc định khi tạo mới.">
                    <TextBlock Text="Ngày lập" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <DatePicker Tag="DB:KE_HOACH_DIEU_TRI.NgayLap" AutomationProperties.Name="Ngày lập" />
                      <TextBox Grid.Column="1" Margin="8,0,0,0" Tag="Time:KE_HOACH_DIEU_TRI.NgayLap" AutomationProperties.Name="Giờ - Ngày lập" ToolTip="HH:mm:ss" MaxLength="8" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ngày bắt đầu" Margin="0,0,0,6" />
                    <DatePicker Tag="DB:KE_HOACH_DIEU_TRI.NgayBatDau" AutomationProperties.Name="Ngày bắt đầu" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ngày dự kiến kết thúc" Margin="0,0,0,6" />
                    <DatePicker Tag="DB:KE_HOACH_DIEU_TRI.NgayDuKienKetThuc" AutomationProperties.Name="Ngày dự kiến kết thúc" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Nội dung và ghi chú" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ghi chú" Margin="0,0,0,6" />
                    <TextBox Tag="DB:KE_HOACH_DIEU_TRI.GhiChu" AutomationProperties.Name="Ghi chú" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin quản lý" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Tự sinh khi lưu">
                    <TextBlock Text="Mã kế hoạch điều trị" Margin="0,0,0,6" />
                    <TextBox Tag="DB:KE_HOACH_DIEU_TRI.MaKHDT" AutomationProperties.Name="Mã kế hoạch điều trị" IsReadOnly="True" Text="Tự sinh" Background="{StaticResource Canvas}" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Trạng thái *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:KE_HOACH_DIEU_TRI.TrangThai" AutomationProperties.Name="Trạng thái" MaxLength="50" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
