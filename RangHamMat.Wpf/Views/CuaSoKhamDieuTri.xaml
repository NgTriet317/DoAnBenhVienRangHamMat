                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Lần thứ *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:CHI_TIET_KE_HOACH.LanThu" AutomationProperties.Name="Lần thứ" />
