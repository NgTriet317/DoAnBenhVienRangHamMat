                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Trạng thái *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:CHI_TIET_KE_HOACH.TrangThai" AutomationProperties.Name="Trạng thái" MaxLength="50" />
