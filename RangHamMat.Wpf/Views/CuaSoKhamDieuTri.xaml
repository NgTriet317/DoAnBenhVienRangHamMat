                    <TextBlock Text="Kế hoạch điều trị *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:CHI_TIET_KE_HOACH.MaKHDT" AutomationProperties.Name="Kế hoạch điều trị" />
                  </StackPanel>
