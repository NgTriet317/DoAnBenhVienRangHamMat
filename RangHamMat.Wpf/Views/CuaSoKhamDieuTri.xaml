      <TabItem Header="Chi tiết kế hoạch" Tag="Table:CHI_TIET_KE_HOACH" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1220" HorizontalAlignment="Left" Margin="0,20,12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin chi tiết kế hoạch" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
