                <DataGrid.Columns>
                  <DataGridTextColumn Header="Dịch vụ" Binding="{Binding Label}" IsReadOnly="True" Width="2*"/>
                  <DataGridTemplateColumn Header="Người thực hiện" Width="155">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding Staff}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MaNVThucHien,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Lần" Binding="{Binding LanThu,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="48" Visibility="Collapsed"/>
                  <DataGridTextColumn Header="S.L" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="60"/>
                  <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="105"/>
                  <DataGridTextColumn Header="Thành tiền" Binding="{Binding Total}" IsReadOnly="True" Width="115"/>
                  <DataGridTextColumn Header="Nội dung / kết quả" Binding="{Binding Note,UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                  <DataGridTemplateColumn Header="Tình trạng" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding Status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Thao tác" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Xóa" Click="RemoveDraft_Click"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Chọn Thêm dịch vụ, đánh dấu dịch vụ rồi kiểm tra số lượng và đơn giá." Style="{StaticResource ClinicalHint}" Margin="0,8"/>
              <TextBlock x:Name="ProgressDraftTotal" Text="Tổng chi phí: 0 đ" Foreground="#2563A8" FontWeight="Bold" HorizontalAlignment="Right"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Right">
          <Button Content="Hủy bỏ" Tag="DongCuaSo"/>
          <Button Content="Lưu thông tin" Tag="ClinicalSave" Style="{StaticResource TreatmentPrimary}"/>
        </WrapPanel>
        <TextBlock x:Name="FormError" Foreground="#C33D3D" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Grid x:Name="ServiceOverlay" Grid.RowSpan="3" Panel.ZIndex="20" Visibility="Collapsed" Background="#880F172A">
      <Border Background="White" BorderBrush="#DAE2EC" BorderThickness="1" CornerRadius="8" Margin="20" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Đóng" Click="CloseServices_Click"/>
            <TextBlock Text="CHỌN DỊCH VỤ ĐIỀU TRỊ" FontSize="15" FontWeight="Bold" Foreground="#234C7D" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBox Grid.Row="1" x:Name="ServiceSearch" TextChanged="ServiceSearch_Changed" ToolTip="Tìm mã hoặc tên dịch vụ" Margin="0,0,0,12"/>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="175"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ServiceGroups" SelectionChanged="ServiceGroup_Changed" Background="#F8FAFC"/>
            <DataGrid Grid.Column="2" x:Name="ServiceCatalog" IsReadOnly="False" MinHeight="200">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding Label}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" IsReadOnly="True" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hủy bỏ" Click="CloseServices_Click"/>
              <Button Content="Chọn dịch vụ" Click="ChooseServices_Click" Style="{StaticResource TreatmentPrimary}"/>
            </WrapPanel>
            <TextBlock x:Name="CatalogMessage" Style="{StaticResource ClinicalHint}" VerticalAlignment="Center"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
