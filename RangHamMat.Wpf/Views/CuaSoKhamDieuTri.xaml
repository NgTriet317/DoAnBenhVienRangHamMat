      <DockPanel>
        <WrapPanel DockPanel.Dock="Right">
          <!-- Nút điều hướng DongCuaSo: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
          <Button Content="Hủy bỏ" Tag="DongCuaSo"/>
          <!-- Nút điều hướng HoSoSave: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
          <Button Content="Lưu thông tin" Tag="HoSoSave" Style="{StaticResource TreatmentPrimary}"/>
        </WrapPanel>
        <!-- Thông tin hiển thị FormError. -->
        <TextBlock x:Name="FormError" Foreground="#C33D3D" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <!-- Vùng bố cục ServiceOverlay. -->
    <Grid x:Name="ServiceOverlay" Grid.RowSpan="3" Panel.ZIndex="20" Visibility="Collapsed" Background="#880F172A">
      <Border Background="White" BorderBrush="#DAE2EC" BorderThickness="1" CornerRadius="8" Margin="20" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <!-- Thao tác Đóng: gọi CloseServices_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
            <Button DockPanel.Dock="Right" Content="Đóng" Click="CloseServices_Click"/>
            <TextBlock Text="CHỌN DỊCH VỤ ĐIỀU TRỊ" FontSize="15" FontWeight="Bold" Foreground="#234C7D" VerticalAlignment="Center"/>
          </DockPanel>
          <!-- Ô nhập ServiceSearch. Chuyển sự kiện đến ServiceSearch_Changed trong code-behind. -->
          <TextBox Grid.Row="1" x:Name="ServiceSearch" TextChanged="ServiceSearch_Changed" ToolTip="Tìm mã hoặc tên dịch vụ" Margin="0,0,0,12"/>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="175"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Vùng ServiceGroups: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
            <ListBox x:Name="ServiceGroups" SelectionChanged="ServiceGroup_Changed" Background="#F8FAFC"/>
            <!-- Bảng ServiceCatalog: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
            <DataGrid Grid.Column="2" x:Name="ServiceCatalog" IsReadOnly="False" MinHeight="200">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" MinWidth="90"/>
                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding Label}" IsReadOnly="True" Width="2*" ElementStyle="{StaticResource HospitalCellText}" MinWidth="180"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource HospitalNumber}" HeaderStyle="{StaticResource HospitalNumberHeader}" MinWidth="100"/>
                <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" IsReadOnly="True" Width="2*" ElementStyle="{StaticResource HospitalCellText}" MinWidth="180"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <WrapPanel DockPanel.Dock="Right">
              <!-- Thao tác Hủy bỏ: gọi CloseServices_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
              <Button Content="Hủy bỏ" Click="CloseServices_Click"/>
              <!-- Thao tác Chọn dịch vụ: gọi ChooseServices_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
              <Button Content="Chọn dịch vụ" Click="ChooseServices_Click" Style="{StaticResource TreatmentPrimary}"/>
            </WrapPanel>
            <!-- Thông tin hiển thị CatalogMessage. -->
            <TextBlock x:Name="CatalogMessage" Style="{StaticResource HoSoHint}" VerticalAlignment="Center"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
