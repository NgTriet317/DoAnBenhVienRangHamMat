<Window x:Class="RangHamMat.Views.CuaSoThemChungChi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm chứng chỉ hành nghề"
        Width="880" Height="650"
        MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Thêm chứng chỉ hành nghề" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Nhập đầy đủ thông tin chứng chỉ nhân viên theo chuẩn cơ sở dữ liệu."
                       Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- NỘI DUNG -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thông tin chứng chỉ" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Mã chứng chỉ (tự sinh)" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="txtMaCC" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nhân viên *" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="cboNhanVien" DisplayMemberPath="HoTen" SelectedValuePath="MaNV" Height="40" Margin="0,0,0,14"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Số chứng chỉ *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtSoChungChi" Style="{StaticResource FormTextBox}"/>

                        <TextBlock Text="Tên chứng chỉ *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtTenChungChi" Style="{StaticResource FormTextBox}"/>

                        <TextBlock Text="Nơi cấp chứng chỉ *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtNoiCap" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- CỘT PHẢI -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thời hạn &amp; Trạng thái" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Ngày cấp *" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="dpNgayCap" Height="40" Margin="0,0,0,14"/>

                        <TextBlock Text="Hạn chứng chỉ (bỏ trống nếu vô thời hạn)" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="dpHanChungChi" Height="40" Margin="0,0,0,14"/>

                        <TextBlock Text="Trạng thái *" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cboTrangThai" Height="40" SelectedIndex="0" Margin="0,0,0,14">
                            <ComboBoxItem Content="Còn hiệu lực"/>
                            <ComboBoxItem Content="Sắp hết hạn"/>
                            <ComboBoxItem Content="Hết hiệu lực"/>
                        </ComboBox>

                        <TextBlock Text="Ghi chú" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtGhiChu" MinHeight="75" Padding="10" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="0,0,0,14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Các trường đánh dấu * là bắt buộc."
                       Foreground="{StaticResource Muted}" FontSize="12"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" x:Name="btnLamMoi"
                    Content="Làm mới" Width="95" Height="40" Click="btnLamMoi_Click"/>

            <Button Grid.Column="3" x:Name="btnDong"
                    Content="Hủy bỏ" Width="95" Height="40" Click="btnDong_Click"/>

            <Button Grid.Column="5" x:Name="btnThem"
                    Content="Thêm chứng chỉ" Width="140" Height="40"
                    Style="{StaticResource Primary}" Click="btnThem_Click"/>
        </Grid>
    </Grid>
</Window>
