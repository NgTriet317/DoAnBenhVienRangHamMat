<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của ChiTietHoSo.xaml. -->
<!-- AI hỗ trợ: bổ sung chú thích cho chi tiết hồ sơ/lịch hẹn/bản ghi liên quan. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RangHamMat.Controls" xmlns:views="clr-namespace:RangHamMat.Views" x:Class="RangHamMat.Views.ChiTietHoSo">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/KieuHienThiHoSo.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
        <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/KieuHienThiHoSo.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <!-- Thông tin hiển thị DetailTitle. -->
      <TextBlock x:Name="DetailTitle" Style="{StaticResource HoSoTitle}"/>
      <TextBlock Text="Thông tin đầy đủ của bản ghi đang chọn" Style="{StaticResource HoSoHint}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource HoSoPanel}">
          <!-- Vùng DetailBody: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
          <ContentControl x:Name="DetailBody"/>
        </Border>
        <!-- Vùng bố cục PlanDetails. -->
        <StackPanel x:Name="PlanDetails" Visibility="Collapsed" Margin="0,16,0,0">
          <DockPanel Margin="0,0,0,12">
            <!-- Nút điều hướng MoCuaSo:KhamDieuTri: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
            <Button x:Name="AddStep" Content="Thêm dịch vụ dự kiến" Tag="MoCuaSo:KhamDieuTri" DockPanel.Dock="Right"/>
            <TextBlock Text="Chi tiết kế hoạch điều trị" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          </DockPanel>
          <!-- Vùng PlanSteps: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
          <ItemsControl x:Name="PlanSteps" ItemTemplate="{StaticResource CHI_TIET_KE_HOACHDetails}"/>
        </StackPanel>
        <!-- Vùng RelatedCard: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
        <ContentControl x:Name="RelatedCard" Margin="0,16,0,0"/>
        <!-- Vùng bố cục RelatedActions. -->
        <StackPanel x:Name="RelatedActions" Visibility="Collapsed" Margin="0,12,0,0">
          <TextBlock Text="Thêm thông tin liên quan" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <WrapPanel>
            <!-- Nút điều hướng MoCuaSo:KhamDieuTri: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
            <Button x:Name="AddCondition" Content="Tình trạng bệnh" Tag="MoCuaSo:KhamDieuTri"/>
            <!-- Nút điều hướng MoCuaSo:KhamDieuTri: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
            <Button x:Name="AddPlan" Content="Kế hoạch điều trị" Tag="MoCuaSo:KhamDieuTri"/>
            <!-- Nút điều hướng MoCuaSo:KhamDieuTri: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
            <Button x:Name="AddService" Content="Dịch vụ thực hiện" Tag="MoCuaSo:KhamDieuTri"/>
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="0,16,0,0">
      <!-- Nút điều hướng DongCuaSo: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
      <Button Content="Đóng" Tag="DongCuaSo"/>
      <!-- Thao tác Chỉnh sửa: gọi Edit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button x:Name="EditButton" Content="Chỉnh sửa" Click="Edit_Click"/>
      <!-- Thao tác Xác nhận: gọi Confirm_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button x:Name="ConfirmButton" Content="Xác nhận" Click="Confirm_Click" Visibility="Collapsed" Style="{StaticResource HoSoPrimary}"/>
      <!-- Thao tác Hủy lịch: gọi Cancel_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button x:Name="CancelButton" Content="Hủy lịch" Click="Cancel_Click" Visibility="Collapsed"/>
      <!-- Thao tác Tiếp nhận: gọi Reception_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button x:Name="ReceptionButton" Content="Tiếp nhận" Click="Reception_Click" Visibility="Collapsed"/>
    </WrapPanel>
  </Grid>
</UserControl>
