<!-- Giao diện ChiTietNhanSu: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<Window x:Class="RangHamMat.Views.ChiTietNhanSu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết nhân viên"
        Width="920" Height="680"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Tài nguyên DetailLabel (Style) áp dụng cho TextBlock. -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Tài nguyên DetailTextBox (Style) áp dụng cho TextBox. -->
        <Style x:Key="DetailTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Tài nguyên SectionHeader (Style) áp dụng cho TextBlock. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Chi tiết nhân viên" FontSize="26" FontWeight="Bold"/>
                <!-- Thông tin hiển thị lblHeaderHoTen. -->
                <TextBlock x:Name="lblHeaderHoTen" Text="{Binding HoTen}" FontSize="14"
                           Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" FontSize="9" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="#10B981"/>
                    <!-- Thông tin hiển thị lblHeaderTrangThai. -->
                    <TextBlock x:Name="lblHeaderTrangThai" Text="{Binding TrangThai}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- NỘI DUNG -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ======================== -->
                <!-- THÔNG TIN CÁ NHÂN -->
                <!-- ======================== -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thông tin cá nhân" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Mã nhân viên" Style="{StaticResource DetailLabel}"/>
                                <!-- Ô nhập txtMaNV. -->
                                <TextBox x:Name="txtMaNV" Text="{Binding MaNV}" IsReadOnly="True" Background="#F8FAFC" Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giới tính" Style="{StaticResource DetailLabel}"/>
                                <!-- Trường lựa chọn cboGioiTinh. -->
                                <ComboBox x:Name="cboGioiTinh" Height="40" Margin="0,0,0,14">
                                    <ComboBoxItem Content="Nam"/>
                                    <ComboBoxItem Content="Nữ"/>
                                    <ComboBoxItem Content="Khác"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Họ và tên *" Style="{StaticResource DetailLabel}"/>
                        <!-- Ô nhập txtHoTen. -->
                        <TextBox x:Name="txtHoTen"  Text="{Binding HoTen}" Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Ngày sinh *" Style="{StaticResource DetailLabel}"/>
                        <!-- Trường lựa chọn dpNgaySinh. -->
                        <DatePicker x:Name="dpNgaySinh" Height="40" Margin="0,0,0,14"/>

                        <TextBlock Text="Số điện thoại *" Style="{StaticResource DetailLabel}"/>
                        <!-- Ô nhập txtSDT. -->
                        <TextBox x:Name="txtSDT" Text="{Binding SDT}" Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Địa chỉ" Style="{StaticResource DetailLabel}"/>
                        <!-- Ô nhập txtDiaChi. -->
                        <TextBox x:Name="txtDiaChi" Text="{Binding DiaChi}" MinHeight="75"
                                 Padding="10" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"/>
                    </StackPanel>
                </Border>

                <!-- ======================== -->
                <!-- THÔNG TIN CÔNG VIỆC -->
                <!-- ======================== -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thông tin công việc" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Chức vụ *" Style="{StaticResource DetailLabel}"/>
                        <!-- Trường lựa chọn cboChucVu. -->
                        <ComboBox x:Name="cboChucVu" DisplayMemberPath="TenChucVu" SelectedValuePath="MaChucVu"
                                  Height="40" Margin="0,0,0,14"/>

                        <TextBlock Text="Chuyên khoa" Style="{StaticResource DetailLabel}"/>
                        <!-- Trường lựa chọn cboChuyenKhoa. -->
                        <ComboBox x:Name="cboChuyenKhoa" DisplayMemberPath="TenCK" SelectedValuePath="MaCK"
                                  Height="40" Margin="0,0,0,14"/>

                        <TextBlock Text="Bằng cấp" Style="{StaticResource DetailLabel}"/>
                        <!-- Ô nhập txtBangCap. -->
                        <TextBox x:Name="txtBangCap" Text="{Binding BangCap}" Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Ngày vào làm *" Style="{StaticResource DetailLabel}"/>
                        <!-- Trường lựa chọn dpNgayVaoLam. -->
                        <DatePicker x:Name="dpNgayVaoLam" Height="40" Margin="0,0,0,14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Chức năng hệ thống ==>>."
                       Foreground="{StaticResource Muted}" FontSize="12"
                       VerticalAlignment="Center"/>

            <!-- Nút thao tác btnKhoiPhuc — Khôi phục. Chuyển sự kiện đến btnKhoiPhuc_Click trong code-behind. -->
            <Button Grid.Column="1" x:Name="btnKhoiPhuc"
                    Content="Khôi phục" Width="110" Height="40"
                    Background="#99FFCC" Foreground="#009900" BorderBrush="#33FF99"
                    FontWeight="SemiBold" Click="btnKhoiPhuc_Click"/>
            
            <!-- Nút thao tác btnNghiViec — Nghỉ việc. Chuyển sự kiện đến btnNghiViec_Click trong code-behind. -->
            <Button Grid.Column="3" x:Name="btnNghiViec"
                    Content="Nghỉ việc" Width="110" Height="40"
                    Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5"
                    FontWeight="SemiBold" Click="btnNghiViec_Click"/>

            <!-- Nút thao tác btnDong — Đóng. Chuyển sự kiện đến btnDong_Click trong code-behind. -->
            <Button Grid.Column="5" x:Name="btnDong"
                    Content="Đóng" Width="95" Height="40" Click="btnDong_Click"/>

            <!-- Nút thao tác btnChinhSua — Lưu thay đổi. Chuyển sự kiện đến btnChinhSua_Click trong code-behind. -->
            <Button Grid.Column="7" x:Name="btnChinhSua"
                    Content="Lưu thay đổi" Width="130" Height="40"
                    Style="{StaticResource Primary}" Click="btnChinhSua_Click"/>
        </Grid>
    </Grid>
</Window>