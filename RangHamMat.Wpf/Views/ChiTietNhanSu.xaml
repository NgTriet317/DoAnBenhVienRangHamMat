<Window x:Class="RangHamMat.Views.ChiTietNhanSu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết nhân viên"
        Width="920" Height="680"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="DetailTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Chi tiết nhân viên" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="{Binding HoTen}" FontSize="14"
                           Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" FontSize="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TrangThai}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- NỘI DUNG -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ======================== -->
                <!-- THÔNG TIN CÁ NHÂN -->
                <!-- ======================== -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thông tin cá nhân" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Mã nhân viên" Style="{StaticResource DetailLabel}"/>
                                <TextBox Text="{Binding MaNV}" Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giới tính" Style="{StaticResource DetailLabel}"/>
                                <TextBox Text="{Binding GioiTinh}" Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Họ và tên" Style="{StaticResource DetailLabel}"/>
                        <TextBox Text="{Binding HoTen}" Style="{DynamicResource DetailTextBox}"/>

                        <TextBlock Text="Ngày sinh" Style="{StaticResource DetailLabel}"/>
                        <TextBox Text="{Binding NgaySinh, StringFormat=dd/MM/yyyy}"
                                 Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Số điện thoại" Style="{StaticResource DetailLabel}"/>
                        <TextBox Text="{Binding SDT}" Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Địa chỉ" Style="{StaticResource DetailLabel}"/>
                        <TextBox Text="{Binding DiaChi}" IsReadOnly="True" MinHeight="75"
                                 Padding="10" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Border>

                <!-- ======================== -->
                <!-- THÔNG TIN CÔNG VIỆC -->
                <!-- ======================== -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thông tin công việc" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Chức vụ" Style="{StaticResource DetailLabel}"/>
                                <TextBox Text="{Binding MaChucVu}" Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chuyên khoa" Style="{StaticResource DetailLabel}"/>
                                <TextBox Text="{Binding MaCK}" Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Bằng cấp" Style="{StaticResource DetailLabel}"/>
                        <TextBox Text="{Binding BangCap}" Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Ngày vào làm" Style="{StaticResource DetailLabel}"/>
                        <TextBox Text="{Binding NgayVaoLam, StringFormat=dd/MM/yyyy}"
                                 Style="{StaticResource DetailTextBox}"/>

                        <TextBlock Text="Trạng thái" Style="{StaticResource DetailLabel}"/>
                        <TextBox Text="{Binding TrangThai}" Style="{StaticResource DetailTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- ======================== -->
                <!-- CHỨNG CHỈ -->
                <!-- ======================== -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="22"
                        Margin="0,430,0,0">
                    <StackPanel>
                        <TextBlock Text="Thông tin chứng chỉ hành nghề"
                                   Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Chứng chỉ hành nghề"
                                           Style="{StaticResource DetailLabel}"/>
                                <TextBox Text="{Binding ChungChiHanhNghe}"
                                         Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ngày cấp"
                                           Style="{StaticResource DetailLabel}"/>
                                <TextBox Text="{Binding NgayCapChungChi, StringFormat=dd/MM/yyyy}"
                                         Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Hạn chứng chỉ"
                                           Style="{StaticResource DetailLabel}"/>
                                <TextBox Text="{Binding HanChungChi, StringFormat=dd/MM/yyyy}"
                                         Style="{StaticResource DetailTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nơi cấp chứng chỉ"
                                   Style="{StaticResource DetailLabel}"/>
                        <TextBox Text="{Binding NoiCapChungChi}"
                                 Style="{StaticResource DetailTextBox}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Thông tin được lấy từ hồ sơ nhân viên."
                       Foreground="{StaticResource Muted}" FontSize="11"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" x:Name="btnDong"
                    Content="Đóng" Width="100" Height="40"/>

            <Button Grid.Column="3" x:Name="btnChinhSua"
                    Content="Chỉnh sửa" Width="120" Height="40"
                    Style="{StaticResource Primary}"/>
        </Grid>
    </Grid>
</Window>