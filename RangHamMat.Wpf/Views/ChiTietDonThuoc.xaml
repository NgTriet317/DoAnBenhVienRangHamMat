<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của ChiTietDonThuoc.xaml. -->
<!-- AI hỗ trợ: bổ sung chú thích cho chi tiết đơn thuốc. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.ChiTietDonThuoc" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
 <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="RxVisibility"/></ResourceDictionary></UserControl.Resources>
 <Border Style="{StaticResource HospitalPanel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><WrapPanel><!-- Thao tác Danh sách đơn thuốc: gọi Back_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button Content="Danh sách đơn thuốc" Style="{StaticResource HospitalSecondary}" Click="Back_Click"/><TextBlock Text=" / " VerticalAlignment="Center" Style="{StaticResource HospitalMuted}"/><TextBlock Text="{Binding Code}" VerticalAlignment="Center" Style="{StaticResource HospitalMuted}"/></WrapPanel><DockPanel Margin="0,12,0,0"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource HospitalStatusTemplate}" VerticalAlignment="Center" DockPanel.Dock="Right"/><TextBlock Text="{Binding Code, StringFormat=Đơn thuốc {0}}" Style="{StaticResource HospitalHeading}"/></DockPanel></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,16"><!-- Thao tác Sửa nháp: gọi Edit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button x:Name="EditButton" Content="Sửa nháp" Style="{StaticResource HospitalSecondary}" Click="Edit_Click" Visibility="{Binding IsDraft, Converter={StaticResource RxVisibility}}" Margin="0,0,8,8"/><!-- Thao tác Xác nhận đơn: gọi Confirm_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button x:Name="ConfirmButton" Content="Xác nhận đơn" Style="{StaticResource HospitalPrimary}" Click="Confirm_Click" Visibility="{Binding IsDraft, Converter={StaticResource RxVisibility}}" Margin="0,0,8,8"/><!-- Thao tác Hủy nháp: gọi Cancel_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button x:Name="CancelButton" Content="Hủy nháp" Style="{StaticResource HospitalSecondary}" Click="Cancel_Click" Visibility="{Binding IsDraft, Converter={StaticResource RxVisibility}}" Margin="0,0,8,8"/><!-- Thao tác Kê đơn mới từ lần khám: gọi New_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button x:Name="OpenEditorButton" Content="Mở khu kê đơn" Click="OpenEditor_Click" Margin="0,0,8,8"/><Button x:Name="NewButton" Content="Kê đơn mới từ lần khám" Style="{StaticResource HospitalSecondary}" Click="New_Click" Margin="0,0,8,8"/><!-- Thao tác In đơn: gọi Print_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button Content="In đơn" Style="{StaticResource HospitalSecondary}" Click="Print_Click" Visibility="{Binding CanPrint, Converter={StaticResource RxVisibility}}" Margin="0,0,8,8"/><!-- Thao tác Dịch vụ thực hiện: gọi Services_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button x:Name="ServicesButton" Content="Dịch vụ thực hiện" Style="{StaticResource HospitalSecondary}" Click="Services_Click" Margin="0,0,8,8"/><!-- Thao tác Hóa đơn / thanh toán: gọi Invoice_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button x:Name="InvoiceButton" Content="Hóa đơn / thanh toán" Style="{StaticResource HospitalSecondary}" Click="Invoice_Click" Margin="0,0,0,8"/></WrapPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Background="#F7F9FC" CornerRadius="0" Padding="16" Margin="0,0,0,16" BorderBrush="#D9E2ED" BorderThickness="0,1,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Bệnh nhân" Style="{StaticResource HospitalMuted}"/><!-- Thao tác {Binding Patient}: gọi Patient_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button Content="{Binding Patient}" Style="{StaticResource HospitalSecondary}" Click="Patient_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/><TextBlock Text="{Binding Phone}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Lần khám" Style="{StaticResource HospitalMuted}"/><!-- Thao tác {Binding Visit, StringFormat=Lần khám {0}}: gọi Visit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button Content="{Binding Visit, StringFormat=Lần khám {0}}" Style="{StaticResource HospitalSecondary}" Click="Visit_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/><TextBlock Text="{Binding VisitWhen}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="Bác sĩ kê đơn" Style="{StaticResource HospitalMuted}"/><TextBlock Text="{Binding Doctor}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0"><TextBlock Text="Ngày kê" Style="{StaticResource HospitalMuted}"/><TextBlock Text="{Binding When}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0"><TextBlock Text="Chẩn đoán của lần khám" Style="{StaticResource HospitalMuted}"/><TextBlock Text="{Binding Diagnosis}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
   </Grid></Border>
   <TextBlock Text="Thuốc kê" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <!-- Bảng chi tiết: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
   <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="46" ColumnHeaderHeight="48" MinHeight="80" MaxHeight="420" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#DCE5F0" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Thuốc / hàm lượng" Binding="{Binding Label}" Width="2*" MinWidth="160" ElementStyle="{StaticResource HospitalCellText}"/><DataGridTextColumn Header="Liều dùng" Binding="{Binding LieuDung}" Width="*" MinWidth="130" ElementStyle="{StaticResource HospitalCellText}"/><DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80" MinWidth="80" ElementStyle="{StaticResource HospitalNumber}" HeaderStyle="{StaticResource HospitalNumberHeader}"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="75" MinWidth="75" ElementStyle="{StaticResource HospitalCellText}"/><DataGridTextColumn Header="Số ngày" Binding="{Binding SoNgayDung}" Width="75" MinWidth="75" ElementStyle="{StaticResource HospitalNumber}" HeaderStyle="{StaticResource HospitalNumberHeader}"/><DataGridTextColumn Header="Hướng dẫn" Binding="{Binding HuongDan}" Width="2*" MinWidth="180" ElementStyle="{StaticResource HospitalCellText}"/></DataGrid.Columns></DataGrid>
   <TextBlock Text="{Binding LinesNote}" Style="{StaticResource HospitalMuted}" Margin="0,8,0,0"/>
   <TextBlock Text="Ghi chú" Style="{StaticResource HospitalMuted}" Margin="0,16,0,5"/><TextBlock Text="{Binding Note}" TextWrapping="Wrap"/><TextBlock Text="Lý do thay đổi chỉ định" Style="{StaticResource HospitalMuted}" Margin="0,16,0,5"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
   <TextBlock Text="Đơn thuốc thuộc lần khám. Đơn đã xác nhận được giữ nguyên; khi đổi chỉ định, kê một đơn mới độc lập." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
  </StackPanel></ScrollViewer>
  <TextBlock x:Name="Feedback" Grid.Row="3" TextWrapping="Wrap" Foreground="#2468CD" FontSize="12" Margin="0,12,0,0"/>
 </Grid></Border>
</UserControl>
