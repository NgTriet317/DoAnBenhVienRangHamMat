<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RangHamMat.Views.DichVuThucHien" FontFamily="Segoe UI" Language="vi-VN"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="Làm mới" Click="Reload_Click"/><Button x:Name="AddButton" Content="Ghi nhận dịch vụ" Click="Add_Click" Style="{StaticResource HospitalPrimary}"/></WrapPanel>
      <StackPanel><TextBlock Text="Dịch vụ thực hiện" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Ghi nhận dịch vụ theo lần khám; xác nhận để đưa vào hóa đơn." Style="{StaticResource HospitalMuted}" Margin="0,4,12,0"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Margin="0,0,0,12" Padding="16,12">
      <WrapPanel>
        <StackPanel Width="240" Margin="0,0,14,6"><TextBlock Text="Tìm dịch vụ / bệnh nhân / nhân viên" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" AutomationProperties.Name="Tìm dịch vụ, bệnh nhân hoặc nhân viên"/></StackPanel>
        <StackPanel Width="220" Margin="0,0,14,6"><TextBlock Text="Bệnh nhân" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PatientFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Patient_Changed" AutomationProperties.Name="Lọc bệnh nhân"/></StackPanel>
        <StackPanel Width="220" Margin="0,0,14,6"><TextBlock Text="Lần khám" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="VisitFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Visit_Changed" AutomationProperties.Name="Lọc lần khám"/></StackPanel>
        <StackPanel Width="160" Margin="0,0,14,6"><TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" SelectedIndex="0" AutomationProperties.Name="Lọc trạng thái dịch vụ"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Nháp"/><ComboBoxItem Content="Đã xác nhận"/><ComboBoxItem Content="Hủy"/><ComboBoxItem Content="Ngừng áp dụng"/></ComboBox></StackPanel>
        <Button Content="Đặt lại" Click="Clear_Click" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
      </WrapPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource HospitalPanel}" Padding="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="16,12"><TextBlock Text="Dịch vụ đã ghi nhận" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RecordCount" DockPanel.Dock="Right" Style="{StaticResource HospitalMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        <Grid Grid.Row="1">
          <DataGrid x:Name="Grid_DICH_VU_THUC_HIEN" SelectionChanged="Service_Changed" ScrollViewer.HorizontalScrollBarVisibility="Auto" FrozenColumnCount="1" AutomationProperties.Name="Danh sách dịch vụ thực hiện">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="65"/>
              <DataGridTextColumn Header="Bệnh nhân" Binding="{Binding PatientId}" Width="85"/>
              <DataGridTextColumn Header="Lần khám" Binding="{Binding VisitId}" Width="85"/>
              <DataGridTextColumn Header="Dịch vụ" Binding="{Binding Service}" Width="2*" MinWidth="200"/>
              <DataGridTextColumn Header="Người thực hiện" Binding="{Binding Doctor}" Width="180"/>
              <DataGridTextColumn Header="Thời gian" Binding="{Binding When}" Width="150"/>
              <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat={}{0:0.##}}" Width="85"/>
              <DataGridTextColumn Header="Đơn giá" Binding="{Binding PriceText}" Width="115"/>
              <DataGridTextColumn Header="Thành tiền" Binding="{Binding AmountText}" Width="125"/>
              <DataGridTemplateColumn Header="Trạng thái" Width="145" CellTemplate="{StaticResource HospitalStatusTemplate}" SortMemberPath="Status"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="ListEmpty" Text="Chưa có dịch vụ phù hợp. Chọn lần khám rồi ghi nhận dịch vụ." Style="{StaticResource HospitalMuted}" Margin="24" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="ServiceDetail" Grid.Row="3" Style="{StaticResource HospitalPanel}" Margin="0,12,0,0" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260"><StackPanel>
        <DockPanel><TextBlock Text="{Binding Service}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource HospitalStatusTemplate}" HorizontalAlignment="Right"/></DockPanel>
        <TextBlock x:Name="PatientContext" Style="{StaticResource HospitalMuted}" Margin="0,6,0,12"/>
        <WrapPanel><TextBlock Text="Bước kế hoạch: " Style="{StaticResource HospitalMuted}"/><TextBlock Text="{Binding Step}"/><TextBlock Text="Thành tiền: " Style="{StaticResource HospitalMuted}" Margin="20,0,0,0"/><TextBlock Text="{Binding AmountText}" FontWeight="SemiBold"/></WrapPanel>
        <TextBlock Text="Kết quả thực hiện" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBlock Text="{Binding Result}" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,14,0,0"><Button x:Name="EditButton" Content="Sửa nháp" Click="Edit_Click" Margin="0,0,8,6"/><Button x:Name="ConfirmButton" Content="Xác nhận dịch vụ" Click="Confirm_Click" Style="{StaticResource HospitalPrimary}" Margin="0,0,8,6"/><Button Content="Hồ sơ bệnh nhân" Click="Patient_Click" Margin="0,0,8,6"/><Button Content="Mở lần khám" Click="Treatment_Click" Margin="0,0,8,6"/><Button Content="Đơn thuốc lần khám" Click="Prescription_Click" Margin="0,0,8,6"/><Button Content="Hóa đơn / thanh toán" Click="Invoice_Click" Margin="0,0,8,6"/></WrapPanel>
        <TextBlock x:Name="BillingNote" Style="{StaticResource HospitalMuted}" Margin="0,10,0,0"/>
      </StackPanel></ScrollViewer>
    </Border>
    <TextBlock x:Name="Feedback" Grid.Row="4" Foreground="#B42318" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </Grid>
</UserControl>
