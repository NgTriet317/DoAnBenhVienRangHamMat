<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của NhatKy.xaml; các vùng liên quan: AuditGrid. -->
<!-- AI hỗ trợ: bổ sung chú thích cho nhật ký hoạt động. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.NhatKy">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Nhật ký hệ thống" Style="{StaticResource Title}" />
      <TextBlock Text="Theo dõi truy cập, phân quyền và các thay đổi thông tin." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,20">
      <TextBlock Text="Loại hoạt động" VerticalAlignment="Center" Margin="0,0,12,0" />
      <ComboBox x:Name="ActivityFilter" Width="240" SelectedIndex="0" SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="Tất cả hoạt động" />
        <ComboBoxItem Content="Đăng nhập" />
        <ComboBoxItem Content="Đăng xuất" />
        <ComboBoxItem Content="Phân quyền" />
        <ComboBoxItem Content="Thay đổi thông tin" />
      </ComboBox>
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <!-- Bảng AuditGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
        <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Thời gian" Binding="{Binding ThoiGian}" Width="180" />
            <DataGridTextColumn Header="Tài khoản" Binding="{Binding TaiKhoan}" Width="150" />
            <DataGridTextColumn Header="Hoạt động" Binding="{Binding HoatDong}" Width="170" />
            <DataGridTextColumn Header="Phân hệ" Binding="{Binding PhanHe}" Width="160" />
            <DataGridTextColumn Header="Đối tượng" Binding="{Binding DoiTuong}" Width="180" />
            <DataGridTextColumn Header="Nội dung thay đổi" Binding="{Binding NoiDung}" Width="300" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Chưa có hoạt động được ghi nhận." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}">
          <TextBlock.Style>
            <!-- Style mặc định cho TextBlock: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=AuditGrid}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</UserControl>