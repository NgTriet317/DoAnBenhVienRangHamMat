<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.NhatKy" Loaded="Page_Loaded" Background="#F5F7FB">
 <UserControl.Resources>
  <Style x:Key="AuditDetailLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
  <Style x:Key="AuditDetailValue" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="Statistics" Margin="0,0,0,6"/><TextBlock Text="Nhật ký thao tác" Style="{StaticResource Title}"/><TextBlock Text="Ghi nhận thay đổi dữ liệu ở các phân hệ, đăng nhập thành công/thất bại và đăng xuất. Thời gian hiển thị UTC+7." TextWrapping="Wrap"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,14,0,8">
   <StackPanel Margin="0,0,8,8"><TextBlock Text="Từ ngày (UTC+7)"/><DatePicker x:Name="FromDate" Width="140"/></StackPanel>
   <StackPanel Margin="0,0,8,8"><TextBlock Text="Đến hết ngày (UTC+7)"/><DatePicker x:Name="ToDate" Width="140"/></StackPanel>
   <StackPanel Margin="0,0,8,8"><TextBlock Text="Từ giờ"/><TextBox x:Name="FromTime" Text="00:00" Width="95"/></StackPanel><StackPanel Margin="0,0,8,8"><TextBlock Text="Đến hết phút"/><TextBox x:Name="ToTime" Text="23:59" Width="95"/></StackPanel><StackPanel Margin="0,0,8,8"><TextBlock Text="Tài khoản / nhân viên"/><TextBox x:Name="AccountFilter" Width="150"/></StackPanel>
   <StackPanel Margin="0,0,8,8"><TextBlock Text="Phân hệ / bảng"/><TextBox x:Name="ModuleFilter" Width="160"/></StackPanel>
   <StackPanel Margin="0,0,8,8"><TextBlock Text="Hành động"/><ComboBox x:Name="ActionFilter" Width="210" DisplayMemberPath="Ten" SelectedValuePath="Ma"/></StackPanel>
   <StackPanel Margin="0,0,8,8"><TextBlock Text="Kết quả"/><TextBox x:Name="ResultFilter" Width="150"/></StackPanel>
   <StackPanel Margin="0,0,8,8"><TextBlock Text="Mã đối tượng"/><TextBox x:Name="ObjectFilter" Width="150"/></StackPanel>
   <Button Content="Tải lại" Click="Reload_Click" Margin="0,15,8,8" Padding="10,5"/><Button Content="Xóa lọc" Click="Clear_Click" Margin="0,15,8,8" Padding="10,5"/>
  </WrapPanel>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="240"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="320" MaxWidth="410"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="AuditGrid" IsReadOnly="True" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" AutoGeneratedColumns="Grid_ColumnsGenerated" SelectionChanged="Row_Changed" SelectionMode="Single" EnableRowVirtualization="True"/>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,14"><TextBlock Text="Chi tiết thao tác" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
      <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" ToolTip="Bỏ chọn bản ghi" AutomationProperties.Name="Đóng chi tiết" Click="ClearSelection_Click" HorizontalAlignment="Right" Padding="6" MinHeight="28" Width="28" Margin="0" BorderThickness="0" Background="Transparent"/>
     </Grid>
     <StackPanel x:Name="DetailEmpty" Grid.Row="1" VerticalAlignment="Center" Margin="12,20">
      <Border Background="{StaticResource AccentSoft}" CornerRadius="30" Width="60" Height="60" Margin="0,0,0,16"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Chọn một thao tác" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextAlignment="Center"/>
      <TextBlock Text="Thông tin người thực hiện và nội dung thay đổi sẽ xuất hiện tại đây." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
     </StackPanel>
     <ScrollViewer x:Name="DetailContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
      <StackPanel Margin="0,0,6,0">
       <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,18">
        <StackPanel><TextBlock x:Name="DetailAction" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}" TextWrapping="Wrap"/>
         <Border x:Name="DetailStatus" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,10,0,0"><TextBlock x:Name="DetailOutcome" FontSize="12" FontWeight="SemiBold"/></Border>
        </StackPanel>
       </Border>
       <TextBlock Text="NGƯỜI THỰC HIỆN" Style="{StaticResource AuditDetailLabel}"/>
       <TextBlock x:Name="DetailPerson" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
       <TextBlock x:Name="DetailAccount" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"/>
       <TextBlock Text="Thời gian" Style="{StaticResource AuditDetailLabel}"/><TextBlock x:Name="DetailTime" Style="{StaticResource AuditDetailValue}"/>
       <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,16"/>
       <TextBlock Text="Phân hệ" Style="{StaticResource AuditDetailLabel}"/><TextBlock x:Name="DetailModule" Style="{StaticResource AuditDetailValue}"/>
       <TextBlock Text="Đối tượng được tác động" Style="{StaticResource AuditDetailLabel}"/><TextBlock x:Name="DetailObject" Style="{StaticResource AuditDetailValue}"/>
       <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,16"/>
       <TextBlock Text="Nội dung thay đổi" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,8"/>
       <TextBlock x:Name="Detail" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <ItemsControl x:Name="DetailChanges">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
          <StackPanel><TextBlock Text="{Binding Ten}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,0,0,8"/>
           <TextBlock Text="Trước thay đổi" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
           <Border Background="#FFF4F4" CornerRadius="5" Padding="8"><TextBlock Text="{Binding Truoc}" Foreground="#814343" TextWrapping="Wrap"/></Border>
           <TextBlock Text="Sau thay đổi" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,4"/>
           <Border Background="#EDF8F2" CornerRadius="5" Padding="8"><TextBlock Text="{Binding Sau}" Foreground="#246247" TextWrapping="Wrap"/></Border>
          </StackPanel>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <Expander Header="Thông tin tham chiếu" Margin="0,8,0,0" Foreground="{StaticResource Muted}">
        <StackPanel Margin="0,10,0,0"><TextBlock Text="Mã nhật ký" Style="{StaticResource AuditDetailLabel}"/><TextBlock x:Name="DetailId" Style="{StaticResource AuditDetailValue}"/>
         <TextBlock Text="Mã phiên" Style="{StaticResource AuditDetailLabel}"/><TextBlock x:Name="DetailSession" Style="{StaticResource AuditDetailValue}"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,10,0,0"><WrapPanel><Button Content="Trang trước" Click="Previous_Click" Padding="10,5"/><TextBlock x:Name="PageLabel" Margin="12,6"/><Button Content="Trang sau" Click="Next_Click" Padding="10,5"/><ComboBox x:Name="PageSize" Width="70" Margin="10,0" SelectedIndex="1" SelectionChanged="Size_Changed"><ComboBoxItem Content="25"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox></WrapPanel><TextBlock x:Name="Message" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</UserControl>
