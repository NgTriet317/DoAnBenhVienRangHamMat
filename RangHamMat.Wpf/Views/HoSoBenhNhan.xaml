<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của HoSoBenhNhan.xaml; các vùng liên quan: Thông tin, Hồ sơ bệnh án, Lịch hẹn, Lịch sử khám, HistoryGrid. -->
<!-- AI hỗ trợ: bổ sung chú thích cho hồ sơ bệnh nhân. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow" clinical:ClinicalLayout.IsEnabled="True" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RangHamMat.Controls" xmlns:views="clr-namespace:RangHamMat.Views" x:Class="RangHamMat.Views.HoSoBenhNhan" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
  <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries><ui:RecordValueConverter x:Key="ProfileRecordValue"/></ResourceDictionary></UserControl.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource HospitalPanel}" Margin="0,0,0,12"><DockPanel><Border DockPanel.Dock="Left" Background="#EAF2FF" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"><Path Data="M16,3 A5,5 0 1 1 16,13 A5,5 0 1 1 16,3 M6,28 C6,16 26,16 26,28" Stroke="#2468CD" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="28" Stretch="Uniform"/></Border><!-- Thao tác Sửa thông tin: gọi EditPatient_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button x:Name="EditPatientButton" DockPanel.Dock="Right" Content="Sửa thông tin" Click="EditPatient_Click" Style="{StaticResource HospitalSecondary}"/><StackPanel><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=HoTenBN}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PatientSummary" Style="{StaticResource HospitalMuted}" Margin="0,5,0,0"/><TextBlock x:Name="PatientSafetySummary" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Background="Transparent" CornerRadius="0" Padding="0,2,0,0" Margin="0,0,0,12"><StackPanel><WrapPanel><!-- Thao tác Tiếp nhận trực tiếp: gọi Reception_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button x:Name="ReceptionButton" Content="Tiếp nhận trực tiếp" Click="Reception_Click" Style="{StaticResource HospitalPrimary}" Margin="0,0,8,4"/><!-- Thao tác Đặt lịch qua điện thoại: gọi PhoneAppointment_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button x:Name="PhoneButton" Content="Đặt lịch qua điện thoại" Click="PhoneAppointment_Click" Style="{StaticResource HospitalSecondary}" Margin="0,0,8,4"/><!-- Thao tác Dịch vụ thực hiện: gọi Services_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button x:Name="ServicesButton" Content="Dịch vụ thực hiện" Click="Services_Click" Margin="0,0,8,4"/><!-- Thao tác Hóa đơn / thanh toán: gọi Invoice_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button x:Name="InvoiceButton" Content="Hóa đơn / thanh toán" Click="Invoice_Click" Margin="0,0,0,4"/></WrapPanel><TextBlock x:Name="ArrivalHint" Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
    <TabControl x:Name="ProfileTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <!-- Nhóm Thông tin: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem x:Name="InformationTab" Header="Thông tin bệnh nhân"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0"><Border Style="{StaticResource HospitalPanel}"><StackPanel><TextBlock Text="Thông tin bệnh nhân" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><UniformGrid Columns="2"><StackPanel Margin="0,0,16,16"><TextBlock Text="Mã bệnh nhân" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=MaBN}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Họ và tên" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=HoTenBN}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Ngày sinh" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=NgaySinh}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Giới tính" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=GioiTinh}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Số điện thoại" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=SDT}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Trạng thái" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=TrangThai}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Địa chỉ" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=DiaChi}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Nhóm máu" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=NhomMau}" TextWrapping="Wrap"/></StackPanel></UniformGrid><StackPanel Margin="0,0,16,16"><TextBlock Text="Mã bảo hiểm y tế" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=MaBHYT}" TextWrapping="Wrap"/></StackPanel><TextBlock Text="Thông tin y tế ban đầu" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,16"/><StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Tiền sử bệnh" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=TienSuBenh}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Dị ứng" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=DiUng}" TextWrapping="Wrap"/></StackPanel></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <!-- Nhóm Hồ sơ bệnh án: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem x:Name="MedicalTab" Header="Hồ sơ bệnh án"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0"><Border Style="{StaticResource HospitalPanel}"><StackPanel><DockPanel Margin="0,0,0,16"><WrapPanel DockPanel.Dock="Right"><!-- Thao tác Lập hồ sơ bệnh án: gọi CreateMedical_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button x:Name="CreateMedicalButton" Content="Lập hồ sơ bệnh án" Click="CreateMedical_Click" Style="{StaticResource HospitalPrimary}"/><!-- Thao tác Sửa hồ sơ bệnh án: gọi EditMedical_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button x:Name="EditMedicalButton" Content="Sửa hồ sơ bệnh án" Click="EditMedical_Click" Style="{StaticResource HospitalSecondary}"/></WrapPanel><TextBlock Text="Hồ sơ bệnh án" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><Border x:Name="MedicalEmpty" Background="#F4F7FB" Padding="16" CornerRadius="6"><TextBlock Text="Chưa có hồ sơ bệnh án. Lập hồ sơ trước khi tiếp nhận bệnh nhân đến trực tiếp hoặc theo lịch hẹn." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap"/></Border><StackPanel x:Name="MedicalFields"><UniformGrid Columns="2"><StackPanel Margin="0,0,16,16"><TextBlock Text="Mã hồ sơ" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=MaHS}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Ngày lập" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=NgayLap}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Lý do khám ban đầu" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=LyDoKhamBanDau}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Trạng thái hồ sơ" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=TrangThai}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Ghi chú" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=GhiChu}" TextWrapping="Wrap"/></StackPanel></UniformGrid><TextBlock Text="Một bệnh nhân có một hồ sơ bệnh án; các lần khám mới tiếp tục được ghi nhận trong hồ sơ này." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <!-- Nhóm Lịch hẹn: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem x:Name="AppointmentsTab" Header="Lịch sử lịch hẹn"><views:LichKham x:Name="PatientAppointments" Margin="0,12,0,0"/></TabItem>
      <!-- Nhóm Lịch sử khám: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem x:Name="HistoryTab" Header="Lịch sử khám"><Grid Margin="0,12,0,0">
        <Border x:Name="HistoryListPanel" Style="{StaticResource HospitalPanel}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><!-- Thao tác Mở Khám điều trị: gọi Treatment_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button x:Name="OpenTreatmentButton" DockPanel.Dock="Right" Content="Mở Khám điều trị" Click="Treatment_Click" Style="{StaticResource HospitalSecondary}"/><StackPanel><TextBlock Text="Các lần khám của bệnh nhân" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Chọn một lần khám để xem tình trạng, kế hoạch, dịch vụ và đơn thuốc." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel></DockPanel>
          <Grid Grid.Row="1"><!-- Bảng HistoryGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
          <DataGrid x:Name="HistoryGrid" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="History_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" RowHeight="48" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5EBF3"><DataGrid.Columns><DataGridTemplateColumn Header="Lần khám / thời gian" Width="145" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock FontWeight="SemiBold"><Run Text="Lần khám "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding When}" FontSize="12" Foreground="#687B91" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Bác sĩ" Binding="{Binding Doctor}" Width="*" MinWidth="100" ElementStyle="{StaticResource HospitalCellText}"/><DataGridTextColumn Header="Tiếp nhận" Binding="{Binding Arrival}" Width="105" MinWidth="105" ElementStyle="{StaticResource HospitalCellText}"/><DataGridTemplateColumn Header="Trạng thái" Width="138" MinWidth="138" CellTemplate="{StaticResource HospitalStatusTemplate}" SortMemberPath="Status"/></DataGrid.Columns></DataGrid><TextBlock x:Name="HistoryEmpty" Text="Chưa có lần khám. Tiếp nhận bệnh nhân rồi tạo lần khám từ lượt tiếp nhận." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" MaxWidth="360" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
          <StackPanel Grid.Row="2"><TextBlock x:Name="HistoryCount" Style="{StaticResource HospitalMuted}" Margin="0,12,0,0"/><WrapPanel x:Name="HistoryPages" Visibility="Collapsed" Margin="0,8,0,0"><Button x:Name="PreviousHistoryPage" Content="← Trước" Click="PreviousHistory_Click" MinHeight="36"/><Button x:Name="NextHistoryPage" Content="Sau →" Click="NextHistory_Click" MinHeight="36" Margin="8,0,0,0"/></WrapPanel></StackPanel>
        </Grid></Border>
        <!-- Vùng VisitHost: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
        <ContentControl x:Name="VisitHost" Visibility="Collapsed"/>
      </Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
