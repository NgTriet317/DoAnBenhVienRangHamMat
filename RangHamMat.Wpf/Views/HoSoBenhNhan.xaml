<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RangHamMat.Controls" xmlns:views="clr-namespace:RangHamMat.Views" x:Class="RangHamMat.Views.HoSoBenhNhan" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries><ui:RecordValueConverter x:Key="ProfileRecordValue"/></ResourceDictionary></UserControl.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource HospitalPanel}" Margin="0,0,0,12"><DockPanel><Border DockPanel.Dock="Left" Background="#EAF2FF" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"><Path Data="M16,3 A5,5 0 1 1 16,13 A5,5 0 1 1 16,3 M6,28 C6,16 26,16 26,28" Stroke="#2468CD" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="28" Stretch="Uniform"/></Border><Button x:Name="EditPatientButton" DockPanel.Dock="Right" Content="Sửa thông tin" Click="EditPatient_Click" Style="{StaticResource HospitalSecondary}"/><StackPanel><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=HoTenBN}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PatientSummary" Style="{StaticResource HospitalMuted}" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Background="Transparent" CornerRadius="0" Padding="0,2,0,0" Margin="0,0,0,12"><StackPanel><WrapPanel><Button x:Name="ReceptionButton" Content="Tiếp nhận trực tiếp" Click="Reception_Click" Style="{StaticResource HospitalPrimary}" Margin="0,0,8,4"/><Button x:Name="PhoneButton" Content="Đặt lịch qua điện thoại" Click="PhoneAppointment_Click" Style="{StaticResource HospitalSecondary}" Margin="0,0,8,4"/><Button x:Name="ServicesButton" Content="Dịch vụ thực hiện" Click="Services_Click" Margin="0,0,8,4"/><Button x:Name="InvoiceButton" Content="Hóa đơn / thanh toán" Click="Invoice_Click" Margin="0,0,0,4"/></WrapPanel><TextBlock x:Name="ArrivalHint" Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
    <TabControl x:Name="ProfileTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <TabItem x:Name="InformationTab" Header="Thông tin"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0"><Border Style="{StaticResource HospitalPanel}"><StackPanel><TextBlock Text="Thông tin bệnh nhân" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><UniformGrid Columns="2"><StackPanel Margin="0,0,16,16"><TextBlock Text="Mã bệnh nhân" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=MaBN}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Họ và tên" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=HoTenBN}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Ngày sinh" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=NgaySinh}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Giới tính" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=GioiTinh}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Số điện thoại" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=SDT}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Trạng thái" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=TrangThai}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Địa chỉ" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=DiaChi}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Nhóm máu" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=NhomMau}" TextWrapping="Wrap"/></StackPanel></UniformGrid><StackPanel Margin="0,0,16,16"><TextBlock Text="Mã bảo hiểm y tế" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=MaBHYT}" TextWrapping="Wrap"/></StackPanel><TextBlock Text="Thông tin y tế ban đầu" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,16"/><StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Tiền sử bệnh" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=TienSuBenh}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Dị ứng" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding Record, Converter={StaticResource ProfileRecordValue}, ConverterParameter=DiUng}" TextWrapping="Wrap"/></StackPanel></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="MedicalTab" Header="Hồ sơ bệnh án"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0"><Border Style="{StaticResource HospitalPanel}"><StackPanel><DockPanel Margin="0,0,0,16"><WrapPanel DockPanel.Dock="Right"><Button x:Name="CreateMedicalButton" Content="Lập hồ sơ bệnh án" Click="CreateMedical_Click" Style="{StaticResource HospitalPrimary}"/><Button x:Name="EditMedicalButton" Content="Sửa hồ sơ bệnh án" Click="EditMedical_Click" Style="{StaticResource HospitalSecondary}"/></WrapPanel><TextBlock Text="Hồ sơ bệnh án" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><Border x:Name="MedicalEmpty" Background="#F4F7FB" Padding="16" CornerRadius="6"><TextBlock Text="Chưa có hồ sơ bệnh án. Lập hồ sơ trước khi tiếp nhận bệnh nhân đến trực tiếp hoặc theo lịch hẹn." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap"/></Border><StackPanel x:Name="MedicalFields"><UniformGrid Columns="2"><StackPanel Margin="0,0,16,16"><TextBlock Text="Mã hồ sơ" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=MaHS}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Ngày lập" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=NgayLap}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Lý do khám ban đầu" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=LyDoKhamBanDau}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Trạng thái hồ sơ" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=TrangThai}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,16,16"><TextBlock Text="Ghi chú" Style="{StaticResource HospitalMuted}" Margin="0,0,0,5"/><TextBlock Text="{Binding MedicalRecord, Converter={StaticResource ProfileRecordValue}, ConverterParameter=GhiChu}" TextWrapping="Wrap"/></StackPanel></UniformGrid><TextBlock Text="Một bệnh nhân có một hồ sơ bệnh án; các lần khám mới tiếp tục được ghi nhận trong hồ sơ này." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="AppointmentsTab" Header="Lịch hẹn"><views:LichKham x:Name="PatientAppointments" Margin="0,12,0,0"/></TabItem>
      <TabItem x:Name="HistoryTab" Header="Lịch sử khám"><Grid Margin="0,12,0,0">
        <Border x:Name="HistoryListPanel" Style="{StaticResource HospitalPanel}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button x:Name="OpenTreatmentButton" DockPanel.Dock="Right" Content="Mở Khám điều trị" Click="Treatment_Click" Style="{StaticResource HospitalSecondary}"/><StackPanel><TextBlock Text="Các lần khám của bệnh nhân" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Chọn một lần khám để xem tình trạng, kế hoạch, dịch vụ và đơn thuốc." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel></DockPanel>
          <Grid Grid.Row="1"><DataGrid x:Name="HistoryGrid" SelectionChanged="History_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" RowHeight="48" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5EBF3"><DataGrid.Columns><DataGridTemplateColumn Header="Lần khám / thời gian" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock FontWeight="SemiBold"><Run Text="Lần khám "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding When}" FontSize="12" Foreground="#687B91" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Bác sĩ" Binding="{Binding Doctor}" Width="*" MinWidth="100"/><DataGridTextColumn Header="Tiếp nhận" Binding="{Binding Arrival}" Width="105"/><DataGridTemplateColumn Header="Trạng thái" Width="138" CellTemplate="{StaticResource HospitalStatusTemplate}" SortMemberPath="Status"/></DataGrid.Columns></DataGrid><TextBlock x:Name="HistoryEmpty" Text="Chưa có lần khám. Tiếp nhận bệnh nhân rồi tạo lần khám từ lượt tiếp nhận." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" MaxWidth="360" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
          <TextBlock x:Name="HistoryCount" Grid.Row="2" Style="{StaticResource HospitalMuted}" Margin="0,12,0,0"/>
        </Grid></Border>
        <ContentControl x:Name="VisitHost" Visibility="Collapsed"/>
      </Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
