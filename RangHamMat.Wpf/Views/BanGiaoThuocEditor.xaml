<!-- Giao diện BanGiaoThuocEditor: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow" clinical:ClinicalLayout.IsEnabled="True" x:Class="RangHamMat.Views.BanGiaoThuocEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- Tài nguyên Wrapped (Style) áp dụng cho TextBlock. -->
  <Style x:Key="Wrapped" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="3,6"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Đã thanh toán · Bàn giao thuốc" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Đối chiếu người nhận và đơn đã ký trước khi giao. Thuốc đã ghi sổ xuất khi thanh toán." TextWrapping="Wrap" Style="{StaticResource HospitalMuted}"/></StackPanel>
  <!-- Thành phần FiltersPanel. -->
  <WrapPanel x:Name="FiltersPanel" Grid.Row="1" Margin="0,12">
   <!-- Ô nhập SearchBox. -->
   <TextBox x:Name="SearchBox" Width="220" AutomationProperties.Name="Tìm tên, mã bệnh nhân, đơn hoặc hóa đơn" Margin="0,0,10,0"/>
   <!-- Trường lựa chọn StateFilter. -->
   <ComboBox x:Name="StateFilter" Width="130" SelectedValuePath="Content" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Chờ giao"/><ComboBoxItem Content="Đã giao"/><ComboBoxItem Content="Tất cả"/></ComboBox>
   <!-- Nút thao tác Tìm / tải lại — Tìm / tải lại. Chuyển sự kiện đến Reload_Click trong code-behind. -->
   <Button Content="Tìm / tải lại" Click="Reload_Click"/><Button Content="Trước" Click="Previous_Click"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="8,0"/><Button Content="Sau" Click="Next_Click"/>
   <!-- Nút thao tác Lịch sử đơn cũ — Lịch sử đơn cũ. Chuyển sự kiện đến History_Click trong code-behind. -->
   <Button Content="Lịch sử đơn cũ" Click="History_Click"/><Button x:Name="GuidanceButton" Content="Cấu hình hướng dẫn" Click="Guidance_Click"/>
  </WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="250"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <!-- Danh sách QueueList. Chuyển sự kiện đến Queue_Changed trong code-behind. -->
   <Border Style="{StaticResource HospitalPanel}" Padding="8"><ListBox x:Name="QueueList" SelectionChanged="Queue_Changed" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,8">
    <TextBlock Text="{Binding HoTenBN}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding MaBN,StringFormat=Mã BN: {0}}"/><TextBlock Text="{Binding MaDT,StringFormat=Đơn: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding TrangThai}" Foreground="#15803D"/><TextBlock Text="{Binding NgayKe,StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{StaticResource HospitalMuted}"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
   <Border Grid.Column="2" Style="{StaticResource HospitalPanel}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- Thông tin hiển thị PatientText. -->
    <StackPanel><TextBlock x:Name="PatientText" Style="{StaticResource HospitalSection}" TextWrapping="Wrap"/><TextBlock x:Name="SourceText" Margin="0,8" TextWrapping="Wrap"/>
     <!-- Nút thao tác PrintRxButton — Xem / in đơn đã ký. Chuyển sự kiện đến PrintRx_Click trong code-behind. -->
     <WrapPanel><Button x:Name="PrintRxButton" Content="Xem / in đơn đã ký" Click="PrintRx_Click"/><Button x:Name="PrintInvoiceButton" Content="Xem / in hóa đơn" Click="PrintInvoice_Click"/></WrapPanel>
    </StackPanel>
    <!-- Danh sách DrugLines. -->
    <DataGrid x:Name="DrugLines" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10" MinRowHeight="46" EnableRowVirtualization="True" VirtualizingPanel.ScrollUnit="Pixel"><DataGrid.Columns>
     <DataGridTextColumn Header="Thuốc / hàm lượng" Binding="{Binding Thuoc}" ElementStyle="{StaticResource Wrapped}" Width="*"/>
     <DataGridTextColumn Header="Lượng" Binding="{Binding Luong}" ElementStyle="{StaticResource Wrapped}" Width="85"/>
     <DataGridTextColumn Header="Liều / đường / ngày" Binding="{Binding CachDung}" ElementStyle="{StaticResource Wrapped}" Width="180"/>
     <DataGridTextColumn Header="Hướng dẫn đã ký" Binding="{Binding HuongDan}" ElementStyle="{StaticResource Wrapped}" Width="1.3*"/>
    </DataGrid.Columns></DataGrid>
    <!-- Thành phần ReceiverChecked — Đã đối chiếu người nhận với họ tên, ngày sinh và mã bệnh nhân. -->
    <StackPanel Grid.Row="2"><CheckBox x:Name="ReceiverChecked" Content="Đã đối chiếu người nhận với họ tên, ngày sinh và mã bệnh nhân" Checked="Checks_Changed" Unchecked="Checks_Changed" Margin="0,4"/>
     <!-- Thành phần GuidanceChecked — Đã kiểm tra đúng đơn và hướng dẫn sử dụng theo chỉ định đã ký. -->
     <CheckBox x:Name="GuidanceChecked" Content="Đã kiểm tra đúng đơn và hướng dẫn sử dụng theo chỉ định đã ký" Checked="Checks_Changed" Unchecked="Checks_Changed" Margin="0,4,0,10"/>
     <!-- Nút thao tác GiveButton — Xác nhận đã giao. Chuyển sự kiện đến Give_Click trong code-behind. -->
     <Button x:Name="GiveButton" Content="Xác nhận đã giao" Click="Give_Click" HorizontalAlignment="Left" Style="{StaticResource HospitalPrimary}"/>
    </StackPanel>
   </Grid></Border>
  </Grid>
  <!-- Thông tin hiển thị StatusText. -->
  <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</UserControl>
