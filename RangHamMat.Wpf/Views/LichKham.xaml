<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RangHamMat.Controls" x:Class="RangHamMat.Views.LichKham">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="Background" Value="#F3F7FC"/>
            <Setter Property="BorderBrush" Value="#D6E3F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#D9ECFF"/>
                                <Setter Property="BorderBrush" Value="#4A90E2"/>
                                <Setter Property="Foreground" Value="#0D4F9A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3ECF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3ECF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2F80ED"/>
            <Setter Property="BorderBrush" Value="#2F80ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryAction" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#24527A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CFE0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F6FAFD">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" CornerRadius="20" Padding="22" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Điều phối lịch khám" FontSize="28" FontWeight="Bold" Foreground="#183B56"/>
                    <TextBlock Text="Quản lý lịch hẹn, phân công bác sĩ và theo dõi tình trạng khám trong ngày." FontSize="13" Margin="0,6,0,0" Foreground="#6C7A89"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Phiếu hướng dẫn" Tag="MoTrang:PhieuHuongDan" Style="{StaticResource SecondaryAction}"/>
                    <Button Content="Thêm lịch khám" Click="btnThemLichKham_Click" Style="{StaticResource PrimaryAction}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

            <!-- Left filter panel -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,0">

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Bộ lọc nhanh" FontSize="17" FontWeight="SemiBold" Foreground="#183B56" Margin="0,0,0,14"/>

                            <TextBlock Text="Tìm theo mã lịch khám" FontWeight="SemiBold" Foreground="#35516B"/>
                            <TextBox x:Name="txtTimKiem" Height="44" Margin="0,6,0,12" Padding="10,7" FontSize="14" VerticalContentAlignment="Center" TextChanged="BoLoc_Changed" ToolTip="Chỉ tìm bằng mã lịch khám (ví dụ: LK001)."/>

                            <TextBlock Text="Trạng thái" FontWeight="SemiBold" Foreground="#35516B"/>
                            <ComboBox x:Name="cboTrangThai" Height="38" Margin="0,6,0,12" SelectionChanged="BoLoc_Changed">
                                <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                <ComboBoxItem Content="Nháp"/>
                                <ComboBoxItem Content="Đã xác nhận"/>
                                <ComboBoxItem Content="Chờ khám"/>
                                <ComboBoxItem Content="Đã khám"/>
                                <ComboBoxItem Content="Hủy"/>
                                <ComboBoxItem Content="Đã hủy"/>
                                <ComboBoxItem Content="Đã đổi"/>
                                <ComboBoxItem Content="Hoàn thành"/>
                            </ComboBox>

                            <TextBlock Text="Bác sĩ" FontWeight="SemiBold" Foreground="#35516B"/>
                            <ComboBox x:Name="cboBacSi" Height="38" Margin="0,6,0,12" SelectionChanged="BoLoc_Changed" DisplayMemberPath="HoTen" SelectedValuePath="MaNV"/>

                            <TextBlock Text="Phòng khám" FontWeight="SemiBold" Foreground="#35516B"/>
                            <ComboBox x:Name="cboPhong" Height="38" Margin="0,6,0,12" SelectionChanged="BoLoc_Changed" DisplayMemberPath="TenPhong" SelectedValuePath="MaPhong"/>

                            <TextBlock Text="Ngày khám" FontWeight="SemiBold" Foreground="#35516B"/>
                            <DatePicker x:Name="dpNgayKham" Height="38" Margin="0,6,0,16" SelectedDateChanged="NgayLoc_Changed"/>

                            <WrapPanel>
                                <Button Content="Lọc" Width="110" Style="{StaticResource PrimaryAction}" Click="btnLoc_Click"/>
                                <Button Content="Đặt lại" Width="110" Style="{StaticResource SecondaryAction}" Click="btnDatLai_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Tổng quan lịch khám" FontSize="17" FontWeight="SemiBold" Foreground="#183B56" Margin="0,0,0,14"/>

                            <Border Background="#EEF6FF" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Tổng lịch khám" Foreground="#5B6B79"/>
                                    <TextBlock Text="{Binding ElementName=lstLichKham, Path=Items.Count}" FontSize="24" FontWeight="Bold" Foreground="#0F5AA3"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F3FBF6" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Đã xác nhận" Foreground="#5B6B79"/>
                                    <TextBlock Text="0" FontSize="20" FontWeight="Bold" Foreground="#1E8E5A" x:Name="txtDaXacNhan"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF8EA" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Chờ xử lý" Foreground="#5B6B79"/>
                                    <TextBlock Text="0" FontSize="20" FontWeight="Bold" Foreground="#C48700" x:Name="txtChoXuLy"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF1F1" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Đã hủy" Foreground="#5B6B79"/>
                                    <TextBlock Text="0" FontSize="20" FontWeight="Bold" Foreground="#D64545" x:Name="txtDaHuy"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Center card list -->
            <Grid Grid.Column="1" x:Name="CardsView">
                <Border Background="White" CornerRadius="20" Padding="18" BorderBrush="#E3ECF5" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Danh sách lịch khám · Nhấp đúp vào thẻ để xem chi tiết" FontSize="20" FontWeight="SemiBold" Foreground="#183B56" VerticalAlignment="Center"/>

                        </DockPanel>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="lstLichKham" FontSize="14" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectedIndex="0" MouseDoubleClick="lstLichKham_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="16" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EEF6FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Time -->
                                                <Border Background="#EAF4FF" CornerRadius="14" Padding="10" Margin="0,0,12,0">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NgayGioKham, StringFormat=dd/MM}" FontSize="14" FontWeight="SemiBold" Foreground="#2B5C88" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding NgayGioKham, StringFormat=HH:mm}" FontSize="26" FontWeight="Bold" Foreground="#0D4F9A" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Main info -->
                                                <StackPanel Grid.Column="1">
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Border Background="#F1F6FB" CornerRadius="10" Padding="8,4" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding MaLich}" FontSize="14" FontWeight="SemiBold" Foreground="#35516B"/>
                                                        </Border>
                                                        <Border Background="#FFF4E8" CornerRadius="10" Padding="8,4">
                                                            <TextBlock Text="{Binding UuTien}" FontSize="14" FontWeight="SemiBold" Foreground="#A86400"/>
                                                        </Border>
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding TenBenhNhan, StringFormat=Bệnh nhân: {0}}" FontSize="18" FontWeight="Bold" Foreground="#183B56"/>
                                                    <TextBlock Text="{Binding TenBacSi, StringFormat=Bác sĩ: {0}}" FontSize="14" Margin="0,4,0,0" Foreground="#4E6477"/>
                                                    <TextBlock Text="{Binding TenPhong, StringFormat=Phòng: {0}}" FontSize="14" Margin="0,2,0,0" Foreground="#4E6477"/>
                                                    <TextBlock Text="{Binding LyDoKham, StringFormat=Lý do: {0}}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5F7386"/>
                                                </StackPanel>

                                                <!-- Status -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <Border Background="#EAF8EE" CornerRadius="12" Padding="10,5" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TrangThai}" FontSize="14" FontWeight="SemiBold" Foreground="#1D7F4E"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding TenDichVu, StringFormat=Dịch vụ: {0}}" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Right" Foreground="#5F7386"/>
                                                    <TextBlock Text="{Binding TenCa, StringFormat=Ca khám: {0}}" FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="#5F7386"/>
                                                    <TextBlock Text="{Binding ThoiLuongDuKien, StringFormat=Thời lượng: {0} phút}" FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="#5F7386"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=lstLichKham}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Chưa có lịch khám" FontSize="22" FontWeight="SemiBold" Foreground="#183B56" TextAlignment="Center"/>

                                <TextBlock Text="Hãy thêm lịch khám mới hoặc điều chỉnh bộ lọc để xem dữ liệu." Margin="0,10,0,18" Foreground="#71808E" TextAlignment="Center"/>

                                <Button Content="Thêm lịch khám" Click="btnThemLichKham_Click" Style="{StaticResource PrimaryAction}" Width="180"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>