<!-- Giao diện LichKham: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:RangHamMat.Controls"
    x:Class="RangHamMat.Views.LichKham">
<UserControl.Resources>
        <!-- Tài nguyên BoolToVisibility (BooleanToVisibilityConverter) dùng lại qua khóa XAML. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Tài nguyên FilterButton (Style) áp dụng cho RadioButton. -->
        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="Background" Value="#F3F7FC"/>
            <Setter Property="BorderBrush" Value="#D6E3F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#D9ECFF"/>
                                <Setter Property="BorderBrush" Value="#4A90E2"/>
                                <Setter Property="Foreground" Value="#0D4F9A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tài nguyên CardBorder (Style) áp dụng cho Border. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3ECF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Tài nguyên StatCard (Style) áp dụng cho Border. -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3ECF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Tài nguyên PrimaryAction (Style) áp dụng cho Button. -->
        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2F80ED"/>
            <Setter Property="BorderBrush" Value="#2F80ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tài nguyên SecondaryAction (Style) áp dụng cho Button. -->
        <Style x:Key="SecondaryAction" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#24527A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CFE0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    

  <Grid Background="#F6FAFD">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toàn bộ bộ lọc nằm ngang phía trên danh sách và biểu mẫu. -->
    <Border Grid.Row="1" Background="White" CornerRadius="16" BorderBrush="#E3ECF5"
            BorderThickness="1" Padding="13,10" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Bộ lọc lịch khám" FontWeight="SemiBold" FontSize="15" Foreground="#183B56" Margin="0,0,0,8"/>
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <StackPanel Width="170" Margin="0,0,10,8">
            <TextBlock Text="Mã lịch khám" FontSize="12" Foreground="#49627C" Margin="0,0,0,4"/>
            <!-- Ô nhập txtTimKiem. Chuyển sự kiện đến BoLoc_Changed trong code-behind. -->
            <TextBox x:Name="txtTimKiem" Height="36" Padding="8,5" FontSize="13" TextChanged="BoLoc_Changed"
                     ToolTip="Chỉ tìm kiếm bằng mã lịch khám."/>
          </StackPanel>
          <StackPanel Width="170" Margin="0,0,10,8">
            <TextBlock Text="Trạng thái" FontSize="12" Foreground="#49627C" Margin="0,0,0,4"/>
            <!-- Trường lựa chọn cboTrangThai. Chuyển sự kiện đến BoLoc_Changed trong code-behind. -->
            <ComboBox x:Name="cboTrangThai" Height="36" SelectionChanged="BoLoc_Changed">
              <ComboBoxItem Content="Tất cả" IsSelected="True"/>
              <ComboBoxItem Content="Nháp"/>
              <ComboBoxItem Content="Cần phân công lại"/>
              <ComboBoxItem Content="Cần bổ sung dự bị"/>
              <ComboBoxItem Content="Chờ xác nhận"/>
              <ComboBoxItem Content="Đã xác nhận"/>
              <ComboBoxItem Content="Chờ khám"/>
              <ComboBoxItem Content="Đã khám"/>
              <ComboBoxItem Content="Hủy"/>
              <ComboBoxItem Content="Đã hủy"/>
              <ComboBoxItem Content="Đã đổi"/>
              <ComboBoxItem Content="Hoàn thành"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Width="170" Margin="0,0,10,8">
            <TextBlock Text="Bác sĩ" FontSize="12" Foreground="#49627C" Margin="0,0,0,4"/>
            <!-- Trường lựa chọn cboBacSi. Chuyển sự kiện đến BoLoc_Changed trong code-behind. -->
            <ComboBox x:Name="cboBacSi" Height="36" DisplayMemberPath="HoTen" SelectedValuePath="MaNV"
                      SelectionChanged="BoLoc_Changed"/>
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,10,8">
            <TextBlock Text="Phòng khám" FontSize="12" Foreground="#49627C" Margin="0,0,0,4"/>
            <!-- Trường lựa chọn cboPhong. Chuyển sự kiện đến BoLoc_Changed trong code-behind. -->
            <ComboBox x:Name="cboPhong" Height="36" DisplayMemberPath="TenPhong" SelectedValuePath="MaPhong"
                      SelectionChanged="BoLoc_Changed"/>
          </StackPanel>
          <StackPanel Width="145" Margin="0,0,10,8">
            <TextBlock Text="Ngày khám" FontSize="12" Foreground="#49627C" Margin="0,0,0,4"/>
            <!-- Trường lựa chọn dpNgayKham. Chuyển sự kiện đến NgayLoc_Changed trong code-behind. -->
            <DatePicker x:Name="dpNgayKham" Height="36" SelectedDateChanged="NgayLoc_Changed"/>
          </StackPanel>
          <!-- Nút thao tác Lọc — Lọc. Chuyển sự kiện đến btnLoc_Click trong code-behind. -->
          <Button Content="Lọc" Style="{StaticResource PrimaryAction}" Margin="0,15,7,8" Click="btnLoc_Click"/>
          <!-- Nút thao tác Đặt lại — Đặt lại. Chuyển sự kiện đến btnDatLai_Click trong code-behind. -->
          <Button Content="Đặt lại" Style="{StaticResource SecondaryAction}" Margin="0,15,0,8" Click="btnDatLai_Click"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Trái: danh sách; phải: biểu mẫu thêm/xem/sửa ngay tại trang. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="55*" MinWidth="390"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="45*" MinWidth="370"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="16" BorderBrush="#E3ECF5" BorderThickness="1" Padding="13">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Danh sách lịch khám" FontSize="18" FontWeight="SemiBold" Foreground="#183B56"/>
            <WrapPanel Margin="0,5,0,0">
              <TextBlock Foreground="#5C758D" Text="Tổng: " FontSize="12"/>
              <TextBlock Text="{Binding ElementName=lstLichKham, Path=Items.Count}" FontSize="12" FontWeight="SemiBold" Foreground="#1559A0" Margin="0,0,13,0"/>
              <TextBlock Text="Đã xác nhận: " FontSize="12" Foreground="#5C758D"/>
              <!-- Thông tin hiển thị txtDaXacNhan — 0. -->
              <TextBlock x:Name="txtDaXacNhan" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="#24804D" Margin="0,0,13,0"/>
              <TextBlock Text="Cần xử lý: " FontSize="12" Foreground="#5C758D"/>
              <!-- Thông tin hiển thị txtChoXuLy — 0. -->
              <TextBlock x:Name="txtChoXuLy" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="#AD6900" Margin="0,0,13,0"/>
              <TextBlock Text="Đã hủy: " FontSize="12" Foreground="#5C758D"/>
              <!-- Thông tin hiển thị txtDaHuy — 0. -->
              <TextBlock x:Name="txtDaHuy" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="#B93F43"/>
            </WrapPanel>
          </StackPanel>
          <Grid Grid.Row="1">
            <!-- Danh sách lstLichKham. Chuyển sự kiện đến lstLichKham_SelectionChanged trong code-behind. -->
            <ListBox x:Name="lstLichKham" FontSize="14" Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="lstLichKham_SelectionChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <!-- Vùng bố cục SelectedBorder. -->
                        <Border x:Name="SelectedBorder" Background="Transparent" Padding="2" CornerRadius="12">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedBorder" Property="Background" Value="#C9E4FF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FBFDFF" BorderBrush="#DFE9F5" BorderThickness="1" CornerRadius="12"
                          Padding="10" Margin="0,0,0,9">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Background="#EAF3FF" CornerRadius="10" Padding="6" Margin="0,0,10,0" VerticalAlignment="Top">
                        <StackPanel>
                          <TextBlock Text="{Binding NgayGioKham, StringFormat=dd/MM}" FontSize="12" HorizontalAlignment="Center" Foreground="#245A8A"/>
                          <TextBlock Text="{Binding NgayGioKham, StringFormat=HH:mm}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#185697"/>
                        </StackPanel>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <WrapPanel Margin="0,0,0,5">
                          <TextBlock Text="{Binding TenBenhNhan}" FontWeight="Bold" FontSize="16" Foreground="#173B5F" Margin="0,0,8,3"/>
                          <TextBlock Text="{Binding MaLich}" Foreground="#54758E" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,3"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding TenBacSi, StringFormat=Bác sĩ: {0}}" Foreground="#48657C" FontSize="13"/>
                        <TextBlock Text="{Binding TenPhong, StringFormat=Phòng: {0}}" Foreground="#48657C" FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding TenCa, StringFormat=Ca: {0}}" Foreground="#607990" FontSize="12" Margin="0,2,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                          <Border CornerRadius="8" Padding="9,4" Margin="0,0,6,4">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#E4F0FF"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding TinhTrangDieuPhoi}" Value="Cần phân công lại"><Setter Property="Background" Value="#FECACA"/></DataTrigger>
                                  <DataTrigger Binding="{Binding TinhTrangDieuPhoi}" Value="Cần bổ sung dự bị"><Setter Property="Background" Value="#FEF08A"/></DataTrigger>
                                  <DataTrigger Binding="{Binding TinhTrangDieuPhoi}" Value="Chờ xác nhận"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                                  <DataTrigger Binding="{Binding TinhTrangDieuPhoi}" Value="Đã xác nhận"><Setter Property="Background" Value="#D1FAE5"/></DataTrigger>
                                  <DataTrigger Binding="{Binding TinhTrangDieuPhoi}" Value="Hoàn thành"><Setter Property="Background" Value="#BBF7D0"/></DataTrigger>
                                  <DataTrigger Binding="{Binding TinhTrangDieuPhoi}" Value="Đã khám"><Setter Property="Background" Value="#CCFBF1"/></DataTrigger>
                                  <DataTrigger Binding="{Binding TinhTrangDieuPhoi}" Value="Hủy"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                  <DataTrigger Binding="{Binding TinhTrangDieuPhoi}" Value="Đã hủy"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TinhTrangDieuPhoi}" Foreground="#324C63" FontSize="12" FontWeight="SemiBold"/>
                          </Border>
                          <Border Background="#F5F0FF" CornerRadius="8" Padding="8,4" Margin="0,0,4,4">
                            <TextBlock Text="{Binding MucDoNghiemTrong, StringFormat=Mức độ: {0}}" Foreground="#68459B" FontSize="12"/>
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasItems, ElementName=lstLichKham}" Value="False">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Chưa có lịch khám phù hợp" FontSize="17" FontWeight="SemiBold" Foreground="#173B5F" TextAlignment="Center"/>
              <TextBlock Text="Thử thay đổi bộ lọc hoặc thêm lịch mới." Foreground="#70859B" TextAlignment="Center" Margin="0,7,0,10"/>
              <!-- Nút thao tác AddAppointmentButton — + Thêm lịch khám. Chuyển sự kiện đến btnThemLichKham_Click trong code-behind. -->
              <Button x:Name="AddAppointmentButton" Content="+ Thêm lịch khám" Style="{StaticResource PrimaryAction}" Click="btnThemLichKham_Click"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="16" BorderBrush="#DFE9F5" BorderThickness="1" Padding="13">
        <Grid>
          <!-- Thành phần pnlBieuMau. -->
          <ContentControl x:Name="pnlBieuMau" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
