<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của LichKham.xaml; các vùng liên quan: Appointments. -->
<!-- AI hỗ trợ: bổ sung chú thích cho lịch khám theo hồ sơ/toàn cục. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.LichKham" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
        <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <WrapPanel DockPanel.Dock="Right">
        <!-- Nút điều hướng MoCuaSo:BenhNhan: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
        <Button x:Name="AddPatientButton" Content="Thêm bệnh nhân" Tag="MoCuaSo:BenhNhan" CommandParameter="BENH_NHAN"/>
        <!-- Thao tác Đặt lịch qua điện thoại: gọi Create_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Đặt lịch qua điện thoại" Click="Create_Click" Style="{StaticResource HospitalPrimary}"/>
      </WrapPanel>
      <StackPanel>
        <TextBlock Text="Lịch hẹn khám" Style="{StaticResource HospitalHeading}"/>
        <TextBlock Text="Lịch được ghi nhận khi bệnh nhân gọi điện; tiếp nhận theo lịch khi đến bệnh viện." Style="{StaticResource HospitalMuted}"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Margin="0,0,0,16">
      <WrapPanel>
        <StackPanel Width="230" Margin="0,0,12,0">
          <TextBlock Text="Tìm bệnh nhân hoặc lịch hẹn" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="SearchBox" TextChanged="Filter_Changed"/>
        </StackPanel>
        <StackPanel Width="160" Margin="0,0,12,0">
          <TextBlock Text="Ngày hẹn" Style="{StaticResource FieldLabel}"/>
          <DatePicker x:Name="DayFilter" SelectedDateChanged="Filter_Changed"/>
        </StackPanel>
        <StackPanel Width="170">
          <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="StatusFilter" SelectedIndex="0" SelectionChanged="Filter_Changed">
            <ComboBoxItem Content="Tất cả"/>
            <ComboBoxItem Content="Nháp"/>
            <ComboBoxItem Content="Đã xác nhận"/>
            <ComboBoxItem Content="Chờ khám"/>
            <ComboBoxItem Content="Hoàn thành"/>
            <ComboBoxItem Content="Hủy"/>
            <ComboBoxItem Content="Đã đổi"/>
          </ComboBox>
        </StackPanel>
        <!-- Thao tác Xóa bộ lọc: gọi Clear_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Xóa bộ lọc" Click="Clear_Click" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="310"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="2*" MinWidth="280"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource HospitalPanel}" Padding="0">
        <Grid>
          <!-- Bảng Appointments: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
          <DataGrid x:Name="Appointments" SelectionChanged="Selection_Changed">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Ngày, giờ" Binding="{Binding When}" Width="125"/>
              <DataGridTextColumn Header="Bệnh nhân" Binding="{Binding Patient}" Width="*"/>
              <DataGridTextColumn Header="Bác sĩ" Binding="{Binding Doctor}" Width="*"/>
              <DataGridTemplateColumn Header="Trạng thái" Width="138" CellTemplate="{StaticResource HospitalStatusTemplate}" SortMemberPath="Status"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="EmptyList" Text="Chưa có lịch hẹn phù hợp." Style="{StaticResource HospitalMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Line}"/>
      <Border Grid.Column="2" Style="{StaticResource HospitalPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <TextBlock x:Name="EmptyDetail" Text="Chọn lịch hẹn để xem thông tin và tiếp nhận." Style="{StaticResource HospitalMuted}" VerticalAlignment="Center"/>
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
              <TextBlock Text="Thông tin lịch hẹn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="{Binding Patient}" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Phone}" Style="{StaticResource HospitalMuted}" Margin="0,4,0,16"/>
              <TextBlock Text="{Binding When}" Foreground="{StaticResource AccentDark}" FontWeight="SemiBold"/>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HospitalStatusTemplate}" VerticalAlignment="Center" Margin="0,8,0,16"/>
              <TextBlock Text="Bác sĩ / phòng" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Doctor}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Room}" Margin="0,4,0,16"/>
              <TextBlock Text="Dịch vụ dự kiến" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Service}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <TextBlock Text="Lý do khám" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <WrapPanel>
                <!-- Thao tác Chỉnh sửa / hẹn lại: gọi Edit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                <Button x:Name="EditButton" Content="Chỉnh sửa / hẹn lại" Click="Edit_Click"/>
                <!-- Thao tác Xác nhận: gọi Confirm_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                <Button x:Name="ConfirmButton" Content="Xác nhận" Click="Confirm_Click"/>
              </WrapPanel>
              <WrapPanel Margin="0,12,0,0">
                <!-- Thao tác Tiếp nhận khi đến viện: gọi Receive_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                <Button x:Name="ReceiveButton" Content="Tiếp nhận khi đến viện" Click="Receive_Click" Style="{StaticResource HospitalPrimary}"/>
                <!-- Thao tác Mở hồ sơ: gọi Patient_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
                <Button Content="Mở hồ sơ" Click="Patient_Click"/>
              </WrapPanel>
              <!-- Thao tác Hủy lịch hẹn: gọi Cancel_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
              <Button x:Name="CancelButton" Content="Hủy lịch hẹn" Click="Cancel_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              <TextBlock x:Name="Feedback" Foreground="#B42318" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    <TextBlock x:Name="RecordCount" Grid.Row="3" Style="{StaticResource HospitalMuted}" Margin="0,10,0,0"/>
  </Grid>
</UserControl>
