<!-- Giao diện XuatKho: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl x:Class="RangHamMat.Views.XuatKho"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FC">
    <UserControl.Resources>
        <!-- Tài nguyên XuatInk (SolidColorBrush) dùng lại qua khóa XAML. -->
        <SolidColorBrush x:Key="XuatInk" Color="#173450"/>
        <!-- Tài nguyên XuatLabel (Style) áp dụng cho TextBlock. -->
        <Style x:Key="XuatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7F94"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <!-- Tài nguyên XuatInput (Style) áp dụng cho TextBox. -->
        <Style x:Key="XuatInput" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <!-- Tài nguyên XuatCombo (Style) áp dụng cho ComboBox. -->
        <Style x:Key="XuatCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Tài nguyên XuatRow (Style) áp dụng cho ListBoxItem. -->
        <Style x:Key="XuatRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Vùng bố cục Frame. -->
                        <Border x:Name="Frame" CornerRadius="11" Background="#FBFCFF" Padding="12" BorderThickness="1" BorderBrush="#E4EBF3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#EEF5FF"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#347EC4"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#F2F7FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tài nguyên XuatGrid (Style) áp dụng cho DataGrid. -->
        <Style x:Key="XuatGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="39"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10,8,10,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="14" Background="#E9F0F9" Padding="17,13" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PHIẾU CẤP PHÁT VẬT TƯ" Foreground="#54738E" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="Xuất kho · Lập phiếu trực tiếp" Foreground="{StaticResource XuatInk}" FontWeight="Bold" FontSize="21" Margin="0,3,0,0"/>
                    <TextBlock Text="Chọn lô đang còn tồn, lưu nháp để kiểm tra hoặc ghi sổ để trừ tồn kho." Foreground="#688197" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút thao tác ↻ Làm mới — ↻ Làm mới. Chuyển sự kiện đến TaiLai_Click trong code-behind. -->
                    <Button Content="↻ Làm mới" Click="TaiLai_Click" Padding="13,9" Margin="0,0,8,0"/>
                    <!-- Nút thao tác + Phiếu xuất mới — + Phiếu xuất mới. Chuyển sự kiện đến TaoMoi_Click trong code-behind. -->
                    <Button Content="+ Phiếu xuất mới" Click="TaoMoi_Click" Padding="14,9" Background="#E2EEFB" Foreground="#135D9A"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="310"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="420"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DEE6EF" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="DANH SÁCH PHIẾU XUẤT" Foreground="#557591" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Chọn một phiếu để xem / sửa bên phải" Foreground="{StaticResource XuatInk}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,12"/>
                        <!-- Ô nhập txtTimLenh. Chuyển sự kiện đến TimKiem_Changed trong code-behind. -->
                        <TextBox x:Name="txtTimLenh" Style="{StaticResource XuatInput}" TextChanged="TimKiem_Changed" ToolTip="Tìm theo phiếu, kho, nơi nhận, người lập, vật tư"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,11,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <!-- Trường lựa chọn cboKhoLoc. Chuyển sự kiện đến BoLoc_Changed trong code-behind. -->
                        <StackPanel><TextBlock Text="Kho xuất" Style="{StaticResource XuatLabel}"/><ComboBox x:Name="cboKhoLoc" Style="{StaticResource XuatCombo}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectionChanged="BoLoc_Changed"/></StackPanel>
                        <!-- Trường lựa chọn cboTrangThaiLoc. Chuyển sự kiện đến BoLoc_Changed trong code-behind. -->
                        <StackPanel Grid.Column="2"><TextBlock Text="Trạng thái" Style="{StaticResource XuatLabel}"/><ComboBox x:Name="cboTrangThaiLoc" Style="{StaticResource XuatCombo}" SelectedIndex="0" SelectionChanged="BoLoc_Changed"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Nháp"/><ComboBoxItem Content="Đã ghi sổ"/><ComboBoxItem Content="Hủy"/></ComboBox></StackPanel>
                    </Grid>
                    <!-- Danh sách lstPhieuXuat. Chuyển sự kiện đến ChonPhieu_SelectionChanged trong code-behind. -->
                    <ListBox Grid.Row="2" x:Name="lstPhieuXuat" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource XuatRow}" SelectionChanged="ChonPhieu_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SoPhieu}" Foreground="#173450" FontSize="14" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding NgayHienThi}" Foreground="#71859C" FontSize="11"/></Grid>
                                    <TextBlock Text="{Binding TenDich}" Foreground="#A16A28" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TenKho}" Foreground="#60778D" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding TrangThai}" Foreground="#A46725" FontSize="11" FontWeight="SemiBold"/></Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Thông tin hiển thị lblTongPhieu — 0 phiếu. -->
                    <TextBlock x:Name="lblTongPhieu" Grid.Row="3" Text="0 phiếu" Foreground="#71859C" FontSize="12" Margin="0,8,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DEE6EF" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FFF3E3" CornerRadius="14,14,0,0" Padding="20,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="BÀN LẬP PHIẾU CẤP PHÁT" Foreground="#9C703B" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="lblTieuDe" Text="Phiếu xuất mới" Foreground="#714718" FontWeight="Bold" FontSize="19" Margin="0,4,0,0"/></StackPanel>
                            <!-- Thông tin hiển thị lblTrangThai — Mới. -->
                            <TextBlock Grid.Column="1" x:Name="lblTrangThai" Text="Mới" Foreground="#A86925" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,15,18,13">
                            <TextBlock Text="01  THÔNG TIN XUẤT KHO" Foreground="#1D67A7" FontSize="12" FontWeight="Bold" Margin="0,0,0,11"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <!-- Trường lựa chọn cboKhoMoi. Chuyển sự kiện đến KhoMoi_SelectionChanged trong code-behind. -->
                                <StackPanel><TextBlock Text="Kho xuất *" Style="{StaticResource XuatLabel}"/><ComboBox x:Name="cboKhoMoi" Style="{StaticResource XuatCombo}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectionChanged="KhoMoi_SelectionChanged"/></StackPanel>
                                <!-- Trường lựa chọn cboNguoiLap. -->
                                <StackPanel Grid.Column="2"><TextBlock Text="Nhân viên xuất (tài khoản đang đăng nhập)" Style="{StaticResource XuatLabel}"/><ComboBox x:Name="cboNguoiLap" Style="{StaticResource XuatCombo}" DisplayMemberPath="Ten" SelectedValuePath="Ma" IsEnabled="False"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <!-- Trường lựa chọn cboLoaiNhan. Chuyển sự kiện đến LoaiNhan_SelectionChanged trong code-behind. -->
                                <StackPanel><TextBlock Text="Loại nơi nhận" Style="{StaticResource XuatLabel}"/><ComboBox x:Name="cboLoaiNhan" Style="{StaticResource XuatCombo}" SelectionChanged="LoaiNhan_SelectionChanged" SelectedIndex="0"><ComboBoxItem Content="Sử dụng nội bộ" Tag="NoiBo"/><ComboBoxItem Content="Khoa" Tag="Khoa"/><ComboBoxItem Content="Phòng" Tag="Phong"/></ComboBox></StackPanel>
                                <!-- Trường lựa chọn cboNoiNhan. -->
                                <StackPanel Grid.Column="2"><TextBlock Text="Đơn vị nhận" Style="{StaticResource XuatLabel}"/><ComboBox x:Name="cboNoiNhan" Style="{StaticResource XuatCombo}" DisplayMemberPath="Ten" SelectedValuePath="Ma"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Ngày giờ tạo phiếu" Style="{StaticResource XuatLabel}"/><TextBlock x:Name="lblNgayXuatMoi" Text="Tự động lấy khi lưu phiếu mới" Foreground="#714718" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                                <!-- Ô nhập txtLyDoMoi. -->
                                <StackPanel Grid.Column="2"><TextBlock Text="Lý do xuất *" Style="{StaticResource XuatLabel}"/><TextBox x:Name="txtLyDoMoi" Style="{StaticResource XuatInput}"/></StackPanel>
                            </Grid>
                            <!-- Ô nhập txtGhiChuMoi. -->
                            <TextBlock Text="Ghi chú phiếu" Style="{StaticResource XuatLabel}" Margin="0,12,0,5"/><TextBox x:Name="txtGhiChuMoi" Style="{StaticResource XuatInput}" Height="55" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Border Background="#E9F2FC" Height="1" Margin="0,18,0,16"/>
                            <TextBlock Text="02  CHỌN VẬT TƯ TỪ LÔ CÒN TỒN" Foreground="#1D67A7" FontSize="12" FontWeight="Bold" Margin="0,0,0,11"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <!-- Trường lựa chọn cboHangMoi. Chuyển sự kiện đến HangMoi_SelectionChanged trong code-behind. -->
                                <StackPanel><TextBlock Text="Vật tư / thuốc" Style="{StaticResource XuatLabel}"/><ComboBox x:Name="cboHangMoi" Style="{StaticResource XuatCombo}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectionChanged="HangMoi_SelectionChanged"/></StackPanel>
                                <!-- Trường lựa chọn cboLoMoi. Chuyển sự kiện đến LoMoi_SelectionChanged trong code-behind. -->
                                <StackPanel Grid.Column="2"><TextBlock Text="Lô hàng đã nhập" Style="{StaticResource XuatLabel}"/><ComboBox x:Name="cboLoMoi" Style="{StaticResource XuatCombo}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectionChanged="LoMoi_SelectionChanged"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <!-- Ô nhập txtSoLuongMoi. -->
                                <StackPanel><TextBlock Text="Số lượng xuất *" Style="{StaticResource XuatLabel}"/><TextBox x:Name="txtSoLuongMoi" Style="{StaticResource XuatInput}" ToolTip="Ví dụ 1 hoặc 1,5"/></StackPanel>
                                <!-- Ô nhập txtGhiChuDong. -->
                                <StackPanel Grid.Column="2"><TextBlock Text="Ghi chú dòng" Style="{StaticResource XuatLabel}"/><TextBox x:Name="txtGhiChuDong" Style="{StaticResource XuatInput}"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <!-- Thông tin hiển thị lblTonLo — Chọn lô để xem tồn khả dụng. -->
                                <TextBlock x:Name="lblTonLo" Text="Chọn lô để xem tồn khả dụng" Foreground="#627F9A" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <!-- Nút thao tác btnThemDong — + Thêm dòng. Chuyển sự kiện đến ThemDong_Click trong code-behind. -->
                                <Button Grid.Column="1" x:Name="btnThemDong" Content="+ Thêm dòng" Click="ThemDong_Click" Padding="15,9" Background="#E3EFFB" Foreground="#0D5B9C"/>
                            </Grid>
                            <TextBlock Text="03  DANH SÁCH VẬT TƯ CẤP PHÁT" Foreground="#1D67A7" FontSize="12" FontWeight="Bold" Margin="0,19,0,10"/>
                            <!-- Danh sách gridDongMoi. -->
                            <DataGrid x:Name="gridDongMoi" Style="{StaticResource XuatGrid}" Height="190" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vật tư" Binding="{Binding TenHang}" Width="2*" MinWidth="160"/>
                                    <DataGridTextColumn Header="Số lô" Binding="{Binding TenLo}" Width="1.2*" MinWidth="90"/>
                                    <DataGridTextColumn Header="SL" Binding="{Binding SoLuongHienThi}" Width="0.7*" MinWidth="70"/>
                                    <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="0.7*" MinWidth="60"/>
                                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="1.2*" MinWidth="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <!-- Nút thao tác btnXoaDong — Xóa dòng đã chọn. Chuyển sự kiện đến XoaDong_Click trong code-behind. -->
                                <Button x:Name="btnXoaDong" Content="Xóa dòng đã chọn" Click="XoaDong_Click" Padding="12,8" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Tổng lượng: " Foreground="#6A7E94" VerticalAlignment="Center"/><TextBlock x:Name="lblTongSL" Text="0" Foreground="#A5661C" FontSize="19" FontWeight="Bold"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Phiếu Nháp không trừ tồn. Khi ghi sổ, hệ thống kiểm tra lượng tồn theo từng lô trên SQL Server." Foreground="#8091A4" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#F7FAFE" BorderBrush="#E6EDF5" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="17,13">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <!-- Thông tin hiển thị lblHuongDan — Tạo phiếu mới hoặc chọn phiếu Nháp để chỉnh sửa.. -->
                            <TextBlock x:Name="lblHuongDan" Text="Tạo phiếu mới hoặc chọn phiếu Nháp để chỉnh sửa." Foreground="#667B91" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Nút thao tác btnSua — Chỉnh sửa. Chuyển sự kiện đến Sua_Click trong code-behind. -->
                                <Button x:Name="btnSua" Content="Chỉnh sửa" Click="Sua_Click" Padding="14,9" Margin="0,0,8,0"/>
                                <!-- Nút thao tác btnLuuNhap — Lưu nháp. Chuyển sự kiện đến LuuNhap_Click trong code-behind. -->
                                <Button x:Name="btnLuuNhap" Content="Lưu nháp" Click="LuuNhap_Click" Padding="14,9" Margin="0,0,8,0"/>
                                <!-- Nút thao tác btnGhiSo — Ghi sổ phiếu. Chuyển sự kiện đến GhiSo_Click trong code-behind. -->
                                <Button x:Name="btnGhiSo" Content="Ghi sổ phiếu" Click="GhiSo_Click" Padding="14,9" Background="#1866B7" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
