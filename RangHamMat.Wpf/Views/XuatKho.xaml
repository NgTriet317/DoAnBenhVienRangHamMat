<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RangHamMat.Views.XuatKho">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Xuất kho" Style="{StaticResource Title}" />
        <TextBlock Text="Lập phiếu xuất cho khoa, phòng hoặc lần khám; mỗi phiếu có nhiều dòng hàng hóa." Style="{StaticResource Subtitle}" Margin="0,2,0,0" />
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Top">
        <Border Background="#FFF7ED" CornerRadius="9" Padding="12,8" Margin="0,0,8,0"><TextBlock Text="Khoa / Phòng / Lần khám" Foreground="#C2410C" FontWeight="SemiBold" /></Border>
        <Border Background="#ECFDF5" CornerRadius="9" Padding="12,8"><TextBlock Text="Phiếu đã ghi sổ không sửa trực tiếp" Foreground="#047857" FontWeight="SemiBold" /></Border>
      </WrapPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="350" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FFFDF9" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="14" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Phiếu xuất mới" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Nhập thông tin người nhận trước, sau đó thêm các dòng hàng ở bên phải." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="Kho xuất *" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox Margin="0,0,0,12"><ComboBoxItem Content="Chọn kho" /></ComboBox>
            <TextBlock Text="Nhân viên lập *" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox Margin="0,0,0,12"><ComboBoxItem Content="Chọn nhân viên" /></ComboBox>
            <TextBlock Text="Phạm vi nhận" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="Khoa" /><ComboBoxItem Content="Phòng" /><ComboBoxItem Content="Lần khám" /></ComboBox>
            <TextBlock Text="Khoa" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox Margin="0,0,0,12"><ComboBoxItem Content="Không chọn đồng thời với phòng" /></ComboBox>
            <TextBlock Text="Phòng" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox Margin="0,0,0,12"><ComboBoxItem Content="Không chọn đồng thời với khoa" /></ComboBox>
            <TextBlock Text="Lần khám (nếu có)" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox Margin="0,0,0,12"><ComboBoxItem Content="Không bắt buộc" /></ComboBox>
            <TextBlock Text="Lý do xuất *" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBox MinHeight="68" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="Ghi chú" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBox MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,16" />
            <Button Content="Tạo phiếu xuất" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="1.1*" /><RowDefinition Height="18" /><RowDefinition Height="0.9*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="18,15" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Lịch sử phiếu xuất" Style="{StaticResource SectionTitle}" /><TextBlock Text="Tìm nhanh theo kho, nơi nhận hoặc trạng thái." Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
                <TextBox Grid.Column="1" Margin="8,0" />
                <ComboBox Grid.Column="2" SelectedIndex="0"><ComboBoxItem Content="Tất cả trạng thái" /><ComboBoxItem Content="Nháp" /><ComboBoxItem Content="Đã ghi sổ" /></ComboBox>
              </Grid>
            </Border>
            <DataGrid x:Name="Grid_PHIEU_XUAT" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phiếu xuất" Binding="{Binding MaPX}" Width="120" />
                <DataGridTextColumn Header="Kho" Binding="{Binding MaKho}" Width="100" />
                <DataGridTextColumn Header="Người lập" Binding="{Binding MaNV}" Width="110" />
                <DataGridTextColumn Header="Khoa" Binding="{Binding MaKhoa}" Width="100" />
                <DataGridTextColumn Header="Phòng" Binding="{Binding MaPhong}" Width="105" />
                <DataGridTextColumn Header="Lần khám" Binding="{Binding MaLS}" Width="105" />
                <DataGridTextColumn Header="Ngày xuất" Binding="{Binding NgayXuat}" Width="120" />
                <DataGridTextColumn Header="Lý do" Binding="{Binding LyDo}" Width="190" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120" />
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="190" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FBFEFD" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="14" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="18,14" BorderBrush="#D1FAE5" BorderThickness="0,0,0,1"><DockPanel><StackPanel><TextBlock Text="Hàng hóa trong phiếu đang chọn" Style="{StaticResource SectionTitle}" /><TextBlock Text="Tồn kho được tính từ phiếu nhập và phiếu xuất đã ghi sổ." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" /></StackPanel><Button Content="+ Thêm dòng" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Margin="8,0,0,0" /></DockPanel></Border>
            <DataGrid x:Name="Grid_CHI_TIET_PHIEU_XUAT" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã chi tiết" Binding="{Binding MaCTPX}" Width="120" />
                <DataGridTextColumn Header="Phiếu xuất" Binding="{Binding MaPX}" Width="110" />
                <DataGridTextColumn Header="Hàng hóa" Binding="{Binding MaHH}" Width="125" />
                <DataGridTextColumn Header="Lô hàng" Binding="{Binding MaLo}" Width="115" />
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="105" />
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="260" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
