<UserControl x:Class="RangHamMat.Views.ChamCong"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CCButton" TargetType="Button">
            <Setter Property="Background" Value="#244D57"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CCInput" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E4E2"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#F4F3EE">
        <Grid Margin="0,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#132E34" Padding="28,22" CornerRadius="0,0,18,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NHÂN SỰ / CHẤM CÔNG" FontWeight="Bold" FontSize="11" Foreground="#C7A96F"/>
                        <TextBlock Text="Chấm công theo ca" Foreground="White" FontSize="29" FontWeight="Bold" Margin="0,6,0,3"/>
                        <TextBlock Text="Chấm đúng ngày và trước giờ kết thúc ca • 0,5 công/ca • Không cần quản lý duyệt" Foreground="#B5CAC9" FontSize="13"/>
                    </StackPanel>
                    <Button x:Name="btnTaiLai" Grid.Column="1" Content="Tải lại" Style="{StaticResource CCButton}"
                            VerticalAlignment="Center" Click="btnTaiLai_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="22,18,6,0" Background="White" CornerRadius="12" Padding="17"
                    BorderBrush="#DFE8E4" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="10"/><ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/><ColumnDefinition Width="164"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kỳ chấm công" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <ComboBox x:Name="cboThang" Grid.Column="1" Height="35" SelectionChanged="cboThang_SelectionChanged">
                        <ComboBoxItem Content="01"/><ComboBoxItem Content="02"/><ComboBoxItem Content="03"/><ComboBoxItem Content="04"/>
                        <ComboBoxItem Content="05"/><ComboBoxItem Content="06"/><ComboBoxItem Content="07"/><ComboBoxItem Content="08"/>
                        <ComboBoxItem Content="09"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
                    </ComboBox>
                    <TextBox x:Name="txtNam" Grid.Column="3" Style="{StaticResource CCInput}" TextChanged="txtNam_TextChanged"/>
                    <TextBox x:Name="txtTimKiem" Grid.Column="5" Style="{StaticResource CCInput}" TextChanged="txtTimKiem_TextChanged"
                             ToolTip="Tìm mã hoặc tên nhân viên"/>
                    <ComboBox x:Name="cboTrangThai" Grid.Column="7" Height="35" SelectionChanged="cboTrangThai_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Tất cả trạng thái"/>
                        <ComboBoxItem Content="Chưa chấm công"/>
                        <ComboBoxItem Content="Đã chấm công"/>
                        <ComboBoxItem Content="Đã ghi nhận vắng"/>
                        <ComboBoxItem Content="Không hợp lệ"/>
                    </ComboBox>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="22,13,6,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#DFECE8" Padding="16,12" CornerRadius="10">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Tổng ca:  "/><TextBlock x:Name="lblTongCa" Text="0" FontWeight="Bold" FontSize="17"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FFF0D9" Padding="16,12" CornerRadius="10">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Chưa chấm:  "/><TextBlock x:Name="lblChuaCham" Text="0" FontWeight="Bold" FontSize="17"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#E4EBF6" Padding="16,12" CornerRadius="10">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Đã chấm:  "/><TextBlock x:Name="lblDaCham" Text="0" FontWeight="Bold" FontSize="17"/></StackPanel>
                </Border>
            </Grid>
            <!-- Hai vùng tách riêng: ca có thể thao tác và ca chỉ xem. -->
            <Grid Grid.Row="3" Margin="22,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="4*" MinWidth="320"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="155"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*" MinHeight="155"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="13" BorderThickness="1" BorderBrush="#A3CDC0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Padding="16,12" Background="#E9F4EF" CornerRadius="12,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ca có thể chấm công" Foreground="#185D4B" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock x:Name="lblCaDuocCham" Text="0 ca có thể thao tác" FontSize="12" Foreground="#396E60" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="gridDuocCham" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                                      RowHeight="41" ColumnHeaderHeight="38" HeadersVisibility="Column" BorderThickness="0"
                                      MinHeight="0" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True"
                                      SelectionChanged="gridChamCong_SelectionChanged" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0EF">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding NgayLam, StringFormat=dd/MM}" Width="75"/>
                                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding HoTen}" Width="2*" MinWidth="120"/>
                                    <DataGridTextColumn Header="Ca" Binding="{Binding MaCa}" Width="65"/>
                                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding GioBatDau}" Width="80"/>
                                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding GioKetThuc}" Width="80"/>
                                    <DataGridTextColumn Header="Công dự kiến" Binding="{Binding CongDuKien, StringFormat=N2}" Width="100"/>
                                    <DataGridTemplateColumn Header="Thao tác" Width="118">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Chấm công" Style="{StaticResource CCButton}"
                                                        Width="98" Height="29" Padding="7,3" Margin="0"
                                                        CommandParameter="{Binding MaLLV}" Click="btnChamTrongDanhSach_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="Chỉ hiển thị ca đủ điều kiện tại thời điểm hiện tại (theo giờ máy chủ)."
                                       Foreground="#487567" Margin="16,7" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="White" CornerRadius="13" BorderThickness="1" BorderBrush="#DEE3E3">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Padding="16,12" Background="#F0F1F2" CornerRadius="12,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ca không thể thao tác" FontSize="16" FontWeight="Bold" Foreground="#4F5960"/>
                                    <TextBlock Text="Đã chấm, hết giờ, chưa đến lượt hoặc không đủ điều kiện"
                                               FontSize="11" Foreground="#758087" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Giữ tên gridChamCong để phần đồng bộ DongBoNhanSu.cs đang có tiếp tục hoạt động. -->
                            <DataGrid x:Name="gridChamCong" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                                      RowHeight="39" ColumnHeaderHeight="38" HeadersVisibility="Column" BorderThickness="0"
                                      MinHeight="0" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True"
                                      SelectionChanged="gridChamCong_SelectionChanged" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0EF">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding NgayLam, StringFormat=dd/MM}" Width="75"/>
                                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding HoTen}" Width="2*" MinWidth="120"/>
                                    <DataGridTextColumn Header="Ca" Binding="{Binding MaCa}" Width="65"/>
                                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding GioKetThuc}" Width="86"/>
                                    <DataGridTextColumn Header="Phút trễ" Binding="{Binding SoPhutDiTre}" Width="70"/>
                                    <DataGridTextColumn Header="Công thực nhận" Binding="{Binding CongThucNhan, StringFormat=N2}" Width="106"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="125"/>
                                    <DataGridTextColumn Header="Lý do không thể thao tác" Binding="{Binding LyDoKhongCham}" Width="230"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" x:Name="lblSoDong" Text="0 ca đang hiển thị" Foreground="#627673" FontSize="12" Margin="16,7"/>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Column="2" Background="#FFFDF6" BorderBrush="#E9DFC9" BorderThickness="1"
                        CornerRadius="13" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CHI TIẾT CA" FontSize="11" FontWeight="Bold" Foreground="#A77A3A"/>
                            <TextBlock x:Name="lblNhanVien" Text="Chọn một ca làm việc" FontSize="18" FontWeight="Bold"
                                       Margin="0,8,0,5" TextWrapping="Wrap" Foreground="#18383B"/>
                            <TextBlock x:Name="lblThongTinCa" Text="—" Margin="0,0,0,15" Foreground="#6E7E79" TextWrapping="Wrap"/>
                            <Border Background="#F1F1E8" Padding="13" CornerRadius="9" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Khung giờ ca làm" Foreground="#667B77" FontSize="11"/>
                                    <TextBlock x:Name="lblKhungGio" Text="—" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#22484B" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Thời điểm ghi nhận" Foreground="#667B77" FontSize="12"/>
                            <TextBlock x:Name="lblGhiNhan" Text="Chưa chấm công" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,14"/>
                            <TextBlock x:Name="lblCanhBao" TextWrapping="Wrap" Foreground="#97552F"
                                       FontSize="12" Margin="0,0,0,15"/>
                            <Button x:Name="btnChamCong" Content="Chấm công ca này" Click="btnChamCong_Click"
                                    Style="{StaticResource CCButton}" Margin="0,0,0,10" IsEnabled="False"/>
                            <TextBlock Text="Ca đầu tiên được chấm sớm trong ngày; ca sau chấm khi ca trước kết thúc. Đúng giờ: 0,5 công; trễ 1–60 phút: 0,25 công; trễ trên 60 phút: 0 công. Hết giờ kết thúc ca: khóa chấm công."
                                       TextWrapping="Wrap" Foreground="#718078" FontSize="11"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <TextBlock Grid.Row="4" x:Name="lblThongBao" Margin="24,12,6,0" Foreground="#506765" TextWrapping="Wrap" FontSize="12"
                       Text="Chấm công cá nhân; BQL được xem toàn bộ nhưng không duyệt."/>
        </Grid>
    </Grid>
</UserControl>
