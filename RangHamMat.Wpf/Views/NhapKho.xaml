<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RangHamMat.Views.NhapKho">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="Nhập kho theo chứng từ" Style="{StaticResource Title}" />
      <TextBlock Text="Luồng mới tách hóa đơn nhà cung cấp, phiếu nhập thực tế và chi tiết hàng nhập để dễ truy vết." Style="{StaticResource Subtitle}" />

      <Border Background="#F8FBFF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#DBEAFE" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="BƯỚC 1" Foreground="#1D4ED8" FontWeight="Bold" FontSize="12" /><TextBlock Text="Hóa đơn nhà cung cấp" FontWeight="SemiBold" FontSize="17" Margin="0,5,0,0" /><TextBlock Text="Ghi chứng từ mua hàng." Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel></Border>
          <TextBlock Grid.Column="1" Text="→" FontSize="28" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="BƯỚC 2" Foreground="#0369A1" FontWeight="Bold" FontSize="12" /><TextBlock Text="Phiếu nhập" FontWeight="SemiBold" FontSize="17" Margin="0,5,0,0" /><TextBlock Text="Xác định kho và ngày thực nhập." Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel></Border>
          <TextBlock Grid.Column="3" Text="→" FontSize="28" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Grid.Column="4" Background="#ECFDF5" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="BƯỚC 3" Foreground="#047857" FontWeight="Bold" FontSize="12" /><TextBlock Text="Chi tiết hàng nhập" FontWeight="SemiBold" FontSize="17" Margin="0,5,0,0" /><TextBlock Text="Ghi số lượng, đơn giá và lô." Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel></Border>
        </Grid>
      </Border>

      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="245" /></Grid.RowDefinitions>
            <Border Padding="18,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="1. Hóa đơn nhập" Style="{StaticResource SectionTitle}" /><Button Content="+ Hóa đơn NCC" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="0" /></DockPanel></Border>
            <DataGrid x:Name="Grid_HOA_DON_NHAP" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã HĐ nhập" Binding="{Binding MaHDN}" Width="115" />
                <DataGridTextColumn Header="Số HĐ NCC" Binding="{Binding SoHoaDonNCC}" Width="135" />
                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding MaNCC}" Width="125" />
                <DataGridTextColumn Header="Người lập" Binding="{Binding MaNV}" Width="115" />
                <DataGridTextColumn Header="Ngày hóa đơn" Binding="{Binding NgayHoaDon}" Width="135" />
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien}" Width="130" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120" />
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="180" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="245" /></Grid.RowDefinitions>
            <Border Padding="18,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="2. Phiếu nhập thực tế" Style="{StaticResource SectionTitle}" /><Button Content="+ Phiếu nhập" DockPanel.Dock="Right" Margin="0" /></DockPanel></Border>
            <DataGrid x:Name="Grid_PHIEU_NHAP" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phiếu nhập" Binding="{Binding MaPN}" Width="120" />
                <DataGridTextColumn Header="Hóa đơn nhập" Binding="{Binding MaHDN}" Width="125" />
                <DataGridTextColumn Header="Kho" Binding="{Binding MaKho}" Width="105" />
                <DataGridTextColumn Header="Người lập" Binding="{Binding MaNV}" Width="110" />
                <DataGridTextColumn Header="Ngày nhập" Binding="{Binding NgayNhap}" Width="120" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120" />
                <DataGridTextColumn Header="Lý do" Binding="{Binding LyDo}" Width="165" />
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="180" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}" Padding="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="260" /></Grid.RowDefinitions>
          <Border Padding="20,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="3. Chi tiết phiếu nhập" Style="{StaticResource SectionTitle}" /><TextBlock Text="Đơn giá được giữ tại thời điểm nhập; thành tiền tính từ số lượng × đơn giá." Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
              <TextBox Grid.Column="1" Margin="12,0" ToolTip="Tìm hàng hóa hoặc lô" />
              <Button Grid.Column="2" Content="+ Thêm dòng hàng" Style="{StaticResource Primary}" Margin="0" />
            </Grid>
          </Border>
          <DataGrid x:Name="Grid_CHI_TIET_PHIEU_NHAP" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Mã chi tiết" Binding="{Binding MaCTPN}" Width="120" />
              <DataGridTextColumn Header="Phiếu nhập" Binding="{Binding MaPN}" Width="120" />
              <DataGridTextColumn Header="Hàng hóa" Binding="{Binding MaHH}" Width="125" />
              <DataGridTextColumn Header="Lô hàng" Binding="{Binding MaLo}" Width="120" />
              <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="110" />
              <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia}" Width="140" />
              <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="260" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
