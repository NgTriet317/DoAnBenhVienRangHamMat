<UserControl x:Class="RangHamMat.Views.NhapKho"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8F7">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Muc" Color="#193E36"/>
        <SolidColorBrush x:Key="Phu" Color="#698079"/>
        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#D7E6DF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Nhan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Phu}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="O" TargetType="TextBox">
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Chon" TargetType="ComboBox">
            <Setter Property="Height" Value="37"/>
        </Style>
        <Style x:Key="Bang" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FCFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="PhieuItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Vien" BorderBrush="#D7E6DF" BorderThickness="1" Background="#FAFCFB" CornerRadius="10" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Vien" Property="Background" Value="#E3F4EC"/><Setter TargetName="Vien" Property="BorderBrush" Value="#1D9A74"/><Setter TargetName="Vien" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Vien" Property="Background" Value="#EDF8F2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12,8,12,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#155647" CornerRadius="14" Padding="20,14" Margin="0,0,0,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TIẾP NHẬN VẬT TƯ VÀ THUỐC" Foreground="#A8DED0" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Bàn lập phiếu nhập kho" Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,3,0,4"/>
                    <TextBlock Text="Mỗi dòng nhập tạo lô mới · Ghi sổ sau khi kiểm tra hàng thực nhận" Foreground="#DCEFE9" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻ Làm mới" Click="TaiLai_Click" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="+ Tạo phiếu mới" Click="TaoMoi_Click" Background="#E2F8EF" Foreground="#135C46" FontWeight="Bold" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="295"/><ColumnDefinition Width="14"/><ColumnDefinition Width="3*" MinWidth="500"/></Grid.ColumnDefinitions>
            <!-- Trái: 40% sổ phiếu, không mở dialog. -->
            <Border Grid.Column="0" Style="{StaticResource The}" Padding="15" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="DANH SÁCH PHIẾU" Foreground="#168263" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Tra cứu chứng từ tiếp nhận" Foreground="{StaticResource Muc}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <TextBox x:Name="txtTimPhieu" Style="{StaticResource O}" ToolTip="Tìm mã phiếu, tên kho hoặc nhà cung cấp" TextChanged="LocPhieu_Changed"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Kho" Style="{StaticResource Nhan}"/><ComboBox x:Name="cboKhoLoc" DisplayMemberPath="Ten" SelectedValuePath="Ma" Style="{StaticResource Chon}" SelectionChanged="LocPhieu_Changed"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Trạng thái" Style="{StaticResource Nhan}"/><ComboBox x:Name="cboTrangThaiLoc" Style="{StaticResource Chon}" SelectedIndex="0" SelectionChanged="LocPhieu_Changed"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Nháp"/><ComboBoxItem Content="Đã ghi sổ"/></ComboBox></StackPanel>
                    </Grid>
                    <ListBox x:Name="lstPhieu" Grid.Row="2" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PhieuItem}" SelectionChanged="ChonPhieu_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MaPhieu}" FontWeight="Bold" Foreground="#193E36" FontSize="14"/>
                                <Border Grid.Column="1" Background="#E3F4EC" CornerRadius="6" Padding="7,3"><TextBlock Text="{Binding TrangThai}" Foreground="#14795C" FontSize="10" FontWeight="Bold"/></Border>
                            </Grid>
                            <TextBlock Text="{Binding TenKho}" Foreground="#365D50" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding NhaCungCap}" Foreground="#698079" Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding NgayNhap}" Foreground="#698079" Margin="0,3,0,0" FontSize="11"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="lblDemPhieu" Foreground="#6B8179" FontSize="12" Text="0 phiếu" Margin="0,0,0,8"/>
                        <Button x:Name="btnGhiSoCu" Content="Ghi sổ phiếu nháp đã chọn" Click="GhiSoCu_Click" Padding="11,9" Background="#E9F5EF" Foreground="#176649" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Phải: 60% form nhập hoặc chi tiết phiếu. -->
            <Border Grid.Column="2" Style="{StaticResource The}" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="formTaoMoi" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,18,20,22">
                            <Border Background="#EAF5EF" CornerRadius="8" Padding="11,7" HorizontalAlignment="Left" Margin="0,0,0,12"><TextBlock x:Name="lblCheDoNhap" Text="TẠO PHIẾU NHẬP MỚI · MỖI DÒNG MỘT LÔ MỚI" Foreground="#158263" FontWeight="Bold" FontSize="11"/></Border>
                            <TextBlock Text="01   Thông tin chứng từ nguồn" Foreground="{StaticResource Muc}" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12"><TextBlock Text="Hóa đơn nhà cung cấp *" Style="{StaticResource Nhan}"/><ComboBox x:Name="cboHoaDon" Style="{StaticResource Chon}" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectionChanged="HoaDon_SelectionChanged"/></StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Nhà cung cấp" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblNCCMoi" Text="Chọn hóa đơn" FontWeight="SemiBold" Foreground="{StaticResource Muc}" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="Kho nhận *" Style="{StaticResource Nhan}"/><ComboBox x:Name="cboKhoMoi" Style="{StaticResource Chon}" DisplayMemberPath="Ten" SelectedValuePath="Ma"/></StackPanel>
                                <StackPanel Grid.Row="2"><TextBlock Text="Ngày nhập *" Style="{StaticResource Nhan}"/><DatePicker x:Name="dpNgayNhap" Height="37"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Người lập" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblNguoiLapMoi" Text="Theo tài khoản đăng nhập" Foreground="{StaticResource Muc}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Lý do nhập *" Style="{StaticResource Nhan}" Margin="0,14,0,0"/>
                            <TextBox x:Name="txtLyDo" Style="{StaticResource O}"/>
                            <TextBlock Text="Ghi chú" Style="{StaticResource Nhan}" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtGhiChu" Style="{StaticResource O}"/>
                            <Border Height="1" Background="#DDEAE4" Margin="0,18,0,15"/>
                            <TextBlock Text="02   Khai báo lô mới và vật tư nhập" Foreground="{StaticResource Muc}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Mỗi dòng phải có số lô mới; không chọn lại lô đã tồn tại trong kho." Foreground="#6B8179" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Vật tư / thuốc *" Style="{StaticResource Nhan}"/><ComboBox x:Name="cboHangMoi" Style="{StaticResource Chon}" DisplayMemberPath="Ten" SelectedValuePath="Ma"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Số lô mới *" Style="{StaticResource Nhan}"/><TextBox x:Name="txtSoLo" Style="{StaticResource O}" MaxLength="255"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Hạn sử dụng (nếu có)" Style="{StaticResource Nhan}"/><DatePicker x:Name="dpHanSuDung" Height="37"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Số lượng *" Style="{StaticResource Nhan}"/><TextBox x:Name="txtSoLuong" Style="{StaticResource O}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Đơn giá (VNĐ) *" Style="{StaticResource Nhan}"/><TextBox x:Name="txtDonGia" Style="{StaticResource O}"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Đơn vị tính và tổng tiền tính theo mặt hàng" Foreground="#698079" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="+ Thêm dòng hàng" Click="ThemDong_Click" Padding="13,8" Background="#DDF2E9" Foreground="#166F55" FontWeight="Bold"/></Grid>
                            <DataGrid x:Name="gridDongMoi" Style="{StaticResource Bang}" Height="200" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vật tư" Binding="{Binding TenHang}" Width="2*" MinWidth="130"/>
                                    <DataGridTextColumn Header="Lô mới" Binding="{Binding SoLo}" Width="1.1*" MinWidth="80"/>
                                    <DataGridTextColumn Header="HSD" Binding="{Binding HanSuDungHienThi}" Width="1*" MinWidth="85"/>
                                    <DataGridTextColumn Header="SL" Binding="{Binding SoLuongHienThi}" Width="0.7*"/>
                                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding ThanhTienHienThi}" Width="1.1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Xóa dòng đang chọn" Click="XoaDong_Click" HorizontalAlignment="Left" Padding="12,7"/><TextBlock Grid.Column="1" x:Name="lblTongTienMoi" Text="Tổng tiền: 0 đ" VerticalAlignment="Center" Foreground="#147254" FontSize="17" FontWeight="Bold"/></Grid>
                            <Border Height="1" Background="#DDEAE4" Margin="0,16,0,15"/>
                            <TextBlock Text="03   Hoàn tất tiếp nhận" Foreground="{StaticResource Muc}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Lưu nháp không làm tăng tồn; Ghi sổ sẽ xác nhận toàn bộ phiếu nhập cùng các lô mới." Foreground="#5B7B6D" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="btnLuuNhap" Content="Lưu nháp" Click="LuuNhap_Click" Padding="19,10" Margin="0,0,10,0" Background="#EDF4F0" Foreground="#1A6650"/><Button x:Name="btnGhiSoMoi" Content="Ghi sổ phiếu nhập" Click="GhiSoMoi_Click" Padding="20,10" Background="#148263" Foreground="White" FontWeight="Bold"/></StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="panelXemPhieu" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,22">
                            <Border Background="#EAF5EF" CornerRadius="8" Padding="11,7" HorizontalAlignment="Left" Margin="0,0,0,12"><TextBlock Text="ĐỐI CHIẾU PHIẾU NHẬP ĐÃ LẬP" Foreground="#158263" FontWeight="Bold" FontSize="11"/></Border>
                            <TextBlock x:Name="lblTieuDeCu" Text="Chi tiết phiếu nhập" FontSize="21" Foreground="{StaticResource Muc}" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,14"><TextBlock Text="Nhà cung cấp" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblNCC" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Số hóa đơn" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblSoHoaDon" Text="—" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,14"><TextBlock Text="Kho tiếp nhận" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblKho" Text="—" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Người lập" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblNhanVien" Text="—" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock Text="Ngày nhập" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblNgayNhap" Text="—" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Trạng thái" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblTrangThai" Text="—" Foreground="#168263" FontWeight="Bold"/></StackPanel>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3"><TextBlock Text="Lý do" Style="{StaticResource Nhan}"/><TextBlock x:Name="lblLyDo" Text="—" TextWrapping="Wrap"/></StackPanel>
                            </Grid>
                            <Border Height="1" Background="#DDEAE4" Margin="0,18,0,14"/>
                            <TextBlock Text="DANH SÁCH LÔ HÀNG ĐÃ KHAI BÁO" Foreground="#168263" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <DataGrid x:Name="gridHangNhap" Style="{StaticResource Bang}" Height="235"><DataGrid.Columns>
                                <DataGridTextColumn Header="Vật tư" Binding="{Binding TenHang}" Width="2*"/>
                                <DataGridTextColumn Header="Lô" Binding="{Binding TenLo}" Width="1.1*"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding SoLuongHienThi}" Width="0.8*"/>
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaHienThi}" Width="1.1*"/>
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTienHienThi}" Width="1.1*"/>
                            </DataGrid.Columns></DataGrid>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="lblSoDong" Foreground="#698079"/><TextBlock Grid.Column="1" x:Name="lblTongTien" Foreground="#168263" FontSize="20" FontWeight="Bold"/></Grid>
                            <TextBlock x:Name="lblTongSL" Foreground="#698079" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                <Button x:Name="btnSuaNhap" Content="Chỉnh sửa phiếu Nháp" Click="SuaNhap_Click" Background="#EAF5EF" Foreground="#176649" Padding="14,10" Margin="0,0,10,0" Visibility="Collapsed"/>
                                <Button x:Name="btnGhiSoPhieu" Content="Ghi sổ phiếu nháp" Click="GhiSoCu_Click" Background="#148263" Foreground="White" Padding="16,10" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock Text="Phiếu đã ghi sổ chỉ được xem, không được sửa để bảo toàn dữ liệu kho." Foreground="#6B8179" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
