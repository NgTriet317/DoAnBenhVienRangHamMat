<Window x:Class="RangHamMat.Views.CauHinhMayChu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình kết nối SQL Server" Style="{StaticResource WindowBase}"
        Width="800" Height="730" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Loaded="CauHinhMayChu_Loaded" Closed="CauHinhMayChu_Closed">
    <Grid Background="{StaticResource Canvas}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AccentDark}" Padding="30,25">
            <StackPanel>
                <TextBlock Text="KẾT NỐI CƠ SỞ DỮ LIỆU" Foreground="#CDDCFA"
                           FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="Chọn máy chủ SQL Server" Foreground="White"
                           FontSize="27" FontWeight="SemiBold" Margin="0,7,0,8"/>
                <TextBlock Text="Ứng dụng sẽ tự dò SQL Server trên máy hiện tại. Bạn cũng có thể nhập máy chủ trong mạng nội bộ."
                           Foreground="#E3ECF8" TextWrapping="Wrap" FontSize="14"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22,26,12">
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1. Máy chủ và cơ sở dữ liệu" FontSize="18"
                                   FontWeight="SemiBold" Margin="0,0,0,17"/>
                        <TextBlock Text="SQL Server instance" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cboMayChu" IsEditable="True" IsTextSearchEnabled="False"
                                      VerticalContentAlignment="Center" MinHeight="42"
                                      AutomationProperties.Name="Tên SQL Server"/>
                            <Button Grid.Column="1" x:Name="btnDoMayChu" Content="Dò máy chủ"
                                    Margin="10,0,0,0" Click="DoMayChu_Click"/>
                        </Grid>
                        <TextBlock Text="Ví dụ: . , .\SQLEXPRESS , TENMAY\SQLEXPRESS , 192.168.1.5,1433"
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,17"/>
                        <TextBlock Text="Database" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cboDatabase" IsEditable="True" MinHeight="42"
                                      VerticalContentAlignment="Center" AutomationProperties.Name="Tên database"/>
                            <Button Grid.Column="1" x:Name="btnLayDatabase" Content="Tải danh sách"
                                    Margin="10,0,0,0" Click="LayDatabase_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2. Xác thực SQL Server" FontSize="18"
                                   FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <CheckBox x:Name="chkWindows" IsChecked="True"
                                  Content="Sử dụng tài khoản Windows hiện tại (khuyến nghị)"
                                  Checked="XacThuc_Changed" Unchecked="XacThuc_Changed"/>
                        <Grid x:Name="pnlTaiKhoan" Visibility="Collapsed" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tên đăng nhập SQL" Margin="0,0,0,7"/>
                                <TextBox x:Name="txtTaiKhoan" AutomationProperties.Name="Tài khoản SQL"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mật khẩu SQL" Margin="0,0,0,7"/>
                                <PasswordBox x:Name="txtMatKhau" MinHeight="42"
                                             AutomationProperties.Name="Mật khẩu SQL"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Thông tin kết nối sẽ được bảo vệ bằng Windows DPAPI trong AppData của tài khoản này, không ghi vào mã nguồn."
                                   Foreground="{StaticResource Muted}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Trạng thái kết nối" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBlock x:Name="txtTrangThai" Text="Đang chuẩn bị dò SQL Server..."
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="26,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnHuy" Content="Thoát" HorizontalAlignment="Left"
                        Click="Thoat_Click"/>
                <Button Grid.Column="1" x:Name="btnTuDong" Content="Tự tìm kết nối"
                        Margin="0,0,10,0" Click="TuDong_Click"/>
                <Button Grid.Column="2" x:Name="btnKiemTra" Content="Kiểm tra"
                        Margin="0,0,10,0" Click="KiemTra_Click"/>
                <Button Grid.Column="3" x:Name="btnLuu" Content="Lưu và tiếp tục"
                        Margin="0" Style="{StaticResource Primary}" Click="Luu_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
