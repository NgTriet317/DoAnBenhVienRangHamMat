<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.NhaCungCap">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Nhà cung cấp" Style="{StaticResource Title}" />
      <TextBlock Text="Nhấp đúp vào một dòng để xem chi tiết. Chọn Thêm để tạo mới." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,20" />
    <TabControl Grid.Row="2">
      <TabItem Header="Nhà cung cấp">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="NHA_CUNG_CAP" />
              <Button Content="Thêm nhà cung cấp" Tag="MoCuaSo:NhaCungCap" CommandParameter="NHA_CUNG_CAP" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Nhà cung cấp" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:NHA_CUNG_CAP" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_NHA_CUNG_CAP" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã nhà cung cấp" SortMemberPath="MaNCC" Width="155" Binding="{Binding MaNCC}" />
                  <DataGridTextColumn Header="Tên nhà cung cấp" SortMemberPath="TenNCC" Width="155" Binding="{Binding TenNCC}" />
                  <DataGridTextColumn Header="Số điện thoại" SortMemberPath="SDT" Width="155" Binding="{Binding SDT}" />
                  <DataGridTextColumn Header="Email" SortMemberPath="Email" Width="155" Binding="{Binding Email}" />
                  <DataGridTextColumn Header="Địa chỉ" SortMemberPath="DiaChi" Width="155" Binding="{Binding DiaChi}" />
                  <DataGridTextColumn Header="Người liên hệ" SortMemberPath="NguoiLienHe" Width="155" Binding="{Binding NguoiLienHe}" />
                  <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Visibility="Collapsed" Binding="{Binding TrangThai}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_NHA_CUNG_CAP}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có nhà cung cấp" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:NhaCungCap" CommandParameter="NHA_CUNG_CAP" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>