<!-- Giao diện NhaCungCap: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl x:Class="RangHamMat.Views.NhaCungCap"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/DanhMucStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- Tài nguyên DetailValue (Style) áp dụng cho TextBlock. -->
  <Style x:Key="DetailValue" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <!-- Tài nguyên SupplierStatus (DataTemplate) dùng lại qua khóa XAML. -->
  <DataTemplate x:Key="SupplierStatus">
   <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,5" CornerRadius="5">
    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0F3F7"/><Style.Triggers><DataTrigger Binding="{Binding TrangThai}" Value="Đang hoạt động"><Setter Property="Background" Value="#E9F5EE"/></DataTrigger><DataTrigger Binding="{Binding TrangThai}" Value="Ngừng hoạt động"><Setter Property="Background" Value="#F8EEEE"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <TextBlock Text="{Binding TrangThai}" FontSize="12" FontWeight="SemiBold">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#43566E"/><Style.Triggers><DataTrigger Binding="{Binding TrangThai}" Value="Đang hoạt động"><Setter Property="Foreground" Value="#176344"/></DataTrigger><DataTrigger Binding="{Binding TrangThai}" Value="Ngừng hoạt động"><Setter Property="Foreground" Value="#795050"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Border>
  </DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{StaticResource HospitalCanvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <!-- Nút thao tác Thêm nhà cung cấp — Thêm nhà cung cấp. Chuyển sự kiện đến Them_Click trong code-behind. -->
   <Button DockPanel.Dock="Right" Content="Thêm nhà cung cấp" Style="{StaticResource HospitalPrimary}" Click="Them_Click"/>
   <StackPanel><TextBlock Text="Nhà cung cấp" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Tra cứu đối tác và thông tin liên hệ phục vụ mua sắm, nhập hàng." Style="{StaticResource HospitalMuted}"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Padding="20,14" Margin="0,0,0,16">
   <UniformGrid Columns="3">
    <!-- Thông tin hiển thị txtTongSo — 0. -->
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="txtTongSo" Text="0" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="nhà cung cấp" Margin="12,0,0,0" Style="{StaticResource HospitalMuted}" VerticalAlignment="Center"/></StackPanel>
    <!-- Thông tin hiển thị txtHoatDong — 0. -->
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="txtHoatDong" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="#176344" VerticalAlignment="Center"/><TextBlock Text="đang hoạt động" Margin="12,0,0,0" Foreground="#176344" FontSize="12" VerticalAlignment="Center"/></StackPanel>
    <!-- Thông tin hiển thị txtNgungHoatDong — 0. -->
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="txtNgungHoatDong" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="#795050" VerticalAlignment="Center"/><TextBlock Text="ngừng hoạt động" Margin="12,0,0,0" Foreground="#795050" FontSize="12" VerticalAlignment="Center"/></StackPanel>
   </UniformGrid>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource HospitalPanel}" Padding="16,12" Margin="0,0,0,16">
   <StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="185"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <!-- Ô nhập txtTimKiem. Chuyển sự kiện đến BoLoc_ThayDoi trong code-behind. -->
     <StackPanel><TextBlock Text="Tìm mã, tên, người liên hệ, điện thoại hoặc email" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtTimKiem" TextChanged="BoLoc_ThayDoi" AutomationProperties.Name="Tìm nhà cung cấp"/></StackPanel>
     <!-- Trường lựa chọn cboTrangThai. Chuyển sự kiện đến BoLoc_ThayDoi trong code-behind. -->
     <StackPanel Grid.Column="2"><TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cboTrangThai" SelectionChanged="BoLoc_ThayDoi" AutomationProperties.Name="Lọc trạng thái nhà cung cấp"/></StackPanel>
     <!-- Nút thao tác Bỏ bộ lọc — Bỏ bộ lọc. Chuyển sự kiện đến BoLoc_Click trong code-behind. -->
     <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0"><Button Content="Bỏ bộ lọc" Click="BoLoc_Click"/><Button Content="Tải lại" Click="TaiLai_Click" Margin="0"/></StackPanel>
    </Grid>
    <!-- Thông tin hiển thị txtLoi. -->
    <TextBlock x:Name="txtLoi" Foreground="#B42318" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="3" SizeChanged="NoiDung_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="CotChiTiet" Width="320"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="HangCach" Height="0"/><RowDefinition x:Name="HangChiTiet" Height="0"/></Grid.RowDefinitions>
   <!-- Vùng bố cục VungDanhSach. -->
   <Border x:Name="VungDanhSach" Grid.RowSpan="3" Style="{StaticResource HospitalPanel}" Padding="0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="16,14"><TextBlock Text="Danh bạ nhà cung cấp" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Chọn một dòng để xem chi tiết" Style="{StaticResource HospitalMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
     <!-- Danh sách Grid_NHA_CUNG_CAP. Chuyển sự kiện đến DanhSach_SelectionChanged trong code-behind. -->
     <DataGrid x:Name="Grid_NHA_CUNG_CAP" Grid.Row="1" RowHeight="86" SelectionChanged="DanhSach_SelectionChanged" AutomationProperties.Name="Danh sách nhà cung cấp">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Nhà cung cấp" Width="*" MinWidth="210" SortMemberPath="TenNCC">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding TenNCC}" VerticalAlignment="Center"><TextBlock Text="{Binding TenNCC}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MaNCC}" Style="{StaticResource HospitalMuted}" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Thông tin liên hệ" Width="*" MinWidth="185" SortMemberPath="NguoiLienHe">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DienThoai}" FontWeight="SemiBold"/><TextBlock Text="{Binding Email}" Style="{StaticResource HospitalMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="150" MinWidth="150" CellTemplate="{StaticResource SupplierStatus}"/>
      </DataGrid.Columns>
     </DataGrid>
     <!-- Vùng bố cục KhongCoDuLieu. -->
     <StackPanel x:Name="KhongCoDuLieu" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"><TextBlock Text="Không tìm thấy nhà cung cấp" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Thử thay từ khóa, bỏ bộ lọc hoặc thêm nhà cung cấp mới." Style="{StaticResource HospitalMuted}" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel>
     <!-- Thông tin hiển thị txtSoDong — Đang tải danh sách…. -->
     <Border Grid.Row="2" Padding="16,12" BorderBrush="{StaticResource HospitalBorder}" BorderThickness="0,1,0,0"><TextBlock x:Name="txtSoDong" Text="Đang tải danh sách…" Style="{StaticResource HospitalMuted}"/></Border>
    </Grid>
   </Border>
   <!-- Vùng bố cục VungChiTiet. -->
   <Border x:Name="VungChiTiet" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource HospitalPanel}" Padding="18">
    <Grid>
     <!-- Thông tin hiển thị ChuaChon — Chọn một nhà cung cấp để xem thông tin liên hệ và cập nhật hồ sơ.. -->
     <TextBlock x:Name="ChuaChon" Text="Chọn một nhà cung cấp để xem thông tin liên hệ và cập nhật hồ sơ." Style="{StaticResource HospitalMuted}" VerticalAlignment="Center" TextAlignment="Center"/>
     <!-- Vùng bố cục ChiTiet. -->
     <Grid x:Name="ChiTiet" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,0,8,0">
        <StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding TenNCC}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding MaNCC}" Style="{StaticResource HospitalMuted}" Margin="0,6,0,12"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SupplierStatus}"/></StackPanel>
        <TextBlock Text="Người liên hệ" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding NguoiLienHe}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding DienThoai}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Email}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding DiaChi}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Dữ liệu liên kết" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ThongTinLienKet}" Style="{StaticResource DetailValue}"/>
       </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Margin="0,14,0,0">
       <!-- Nút thao tác Cập nhật — Cập nhật. Chuyển sự kiện đến Sua_Click trong code-behind. -->
       <WrapPanel><Button Content="Cập nhật" Click="Sua_Click" Style="{StaticResource HospitalPrimary}"/><Button Content="Sao chép" Click="SaoChep_Click" ToolTip="Sao chép thông tin liên hệ" AutomationProperties.Name="Sao chép thông tin liên hệ"/><Button Content="Xóa" Click="Xoa_Click" IsEnabled="{Binding ChoXoa}" ToolTip="{Binding HuongDanXoa}" Margin="0"/></WrapPanel>
       <TextBlock Text="{Binding HuongDanXoa}" Style="{StaticResource HospitalMuted}" Margin="0,10,0,0"/>
       <!-- Thông tin hiển thị txtThongBao. -->
       <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="#176344" FontSize="12" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
