<UserControl x:Class="RangHamMat.Views.XinNghiViec"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}">
  <UserControl.Resources>
    <Style x:Key="FormLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="FormNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Resources>

  <Grid MaxWidth="1500" Margin="8,4,8,12" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Background="{StaticResource AccentSoft}" CornerRadius="14" Padding="24,18" Margin="0,0,0,18">
      <Grid>
        <StackPanel>
          <TextBlock Text="Đơn từ nhân sự" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/>
          <TextBlock Text="Nhập thông tin bên trái, kiểm tra nội dung bên phải rồi gửi đơn để chờ duyệt."
                     Foreground="{StaticResource Muted}" FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="tabDonTu" Grid.Row="1" BorderThickness="0" Background="Transparent">
      <TabItem Header="Đơn xin nghỉ phép">
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>

          <!-- Bên trái (70%): nhập liệu -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="2,0,8,8">
                <TextBlock Text="Thông tin xin nghỉ phép" FontSize="21" FontWeight="SemiBold"/>
                <Border Background="#F5F8FB" BorderBrush="#DEE5EB" BorderThickness="1"
                        CornerRadius="10" Padding="16" Margin="0,15,0,18">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <TextBlock Text="QUỸ PHÉP NĂM" FontWeight="Bold" FontSize="13" Foreground="#344759"/>
                      <TextBlock x:Name="txtNamQuyPhep" Text="2026" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#4C647D"/>
                    </DockPanel>
                    <UniformGrid Columns="4" Margin="0,13,0,0">
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="ĐƯỢC HƯỞNG" FontSize="10" Foreground="#738396"/>
                        <TextBlock x:Name="txtPhepDuocHuong" Text="—" FontSize="19" FontWeight="Bold" Foreground="#1D3347"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="ĐÃ NGHỈ" FontSize="10" Foreground="#738396"/>
                        <TextBlock x:Name="txtPhepDaNghi" Text="—" FontSize="19" FontWeight="Bold" Foreground="#1D3347"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="ĐÃ ĐẶT" FontSize="10" Foreground="#738396"/>
                        <TextBlock x:Name="txtPhepDaDat" Text="—" FontSize="19" FontWeight="Bold" Foreground="#1D3347"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="CÒN LẠI" FontSize="10" Foreground="#53766C"/>
                        <TextBlock x:Name="txtPhepCon" Text="—" FontSize="19" FontWeight="Bold" Foreground="#146C60"/>
                      </StackPanel>
                    </UniformGrid>
                    <Border Height="1" Background="#DFE6EC" Margin="0,12,0,10"/>
                    <TextBlock x:Name="txtDuKienPhep" Text="Chọn loại nghỉ và ngày để xem số ngày dự kiến."
                               FontSize="12" Foreground="#52687D" TextWrapping="Wrap"/>
                    <TextBlock Text="Mỗi ngày phép năm có ca hợp lệ trừ 1 ngày; hưởng 0,5 công kể cả có 2 ca."
                               FontSize="11" Foreground="#738396" Margin="0,7,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="Các trường có dấu * là bắt buộc. Chỉ được nghỉ từ 7 ngày sau hôm nay trở đi." Style="{StaticResource FormNote}" Margin="0,7,0,25"/>
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Họ tên nhân viên *" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtHoTenNghiPhep" MaxLength="50" IsReadOnly="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Loại nghỉ phép *" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="cboLoaiNghi" SelectedIndex="0">
                      <ComboBoxItem Content="-- Chọn loại nghỉ phép --"/>
                      <ComboBoxItem Content="Nghỉ phép năm"/>
                      <ComboBoxItem Content="Nghỉ ốm"/>
                      <ComboBoxItem Content="Nghỉ việc riêng"/>
                      <ComboBoxItem Content="Nghỉ không hưởng lương"/>
                      <ComboBoxItem Content="Khác"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Từ ngày *" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="dpTuNgay"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Đến ngày *" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="dpDenNgay"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Lý do nghỉ phép *" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtLyDoNghiPhep" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="112" Margin="0,0,0,20"/>
                <TextBlock Text="Người tiếp nhận / bàn giao công việc" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtBanGiaoNghiPhep" MaxLength="200" Margin="0,0,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Nhập lại" Click="LamMoiNghiPhep_Click" Style="{StaticResource Quiet}"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Bên phải (30%): xem trước và gửi đơn -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Background="#F8FAFF" Padding="18,21">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Xem trước đơn" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/>
                <TextBlock Text="Cập nhật theo thông tin đang nhập" Style="{StaticResource FormNote}" Margin="0,6,0,14"/>
              </StackPanel>
              <Border Grid.Row="1" Background="{StaticResource AccentSoft}" CornerRadius="7" Padding="10,7" Margin="0,0,0,14">
                <TextBlock x:Name="txtTrangThaiNghiPhep" Text="Bản nháp · Chưa gửi" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}" TextWrapping="Wrap"/>
              </Border>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,18">
                  <StackPanel>
                    <TextBlock Text="ĐƠN XIN NGHỈ PHÉP" FontWeight="Bold" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="txtXemTruocNghiPhep" TextWrapping="Wrap" FontSize="14" LineHeight="24" Foreground="{StaticResource Ink}"/>
                  </StackPanel>
                </Border>
              </ScrollViewer>
              <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <Button x:Name="btnGuiNghiPhep" Content="Gửi đơn xin nghỉ phép" Style="{StaticResource Primary}"
                        Margin="0" HorizontalAlignment="Stretch" Click="GuiNghiPhep_Click"/>
                <TextBlock Text="Đơn gửi đi sẽ ở trạng thái Chờ duyệt." Style="{StaticResource FormNote}" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Đơn xin nghỉ việc">
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>

          <!-- Bên trái (70%): nhập liệu -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="2,0,8,8">
                <TextBlock Text="Thông tin xin nghỉ việc" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Phải đăng ký trước tối thiểu 7 ngày. Ngày nghỉ việc dự kiến và lý do là bắt buộc." Style="{StaticResource FormNote}" Margin="0,7,0,25"/>
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Họ tên nhân viên *" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtHoTenNghiViec" MaxLength="50" IsReadOnly="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Ngày dự kiến nghỉ việc *" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="dpNgayNghiViec"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Lý do xin nghỉ việc *" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtLyDoNghiViec" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="120" Margin="0,0,0,20"/>
                <TextBlock Text="Kế hoạch bàn giao / ghi chú" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtBanGiaoNghiViec" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="108" Margin="0,0,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Nhập lại" Click="LamMoiNghiViec_Click" Style="{StaticResource Quiet}"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Bên phải (30%): xem trước và gửi đơn -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Background="#F8FAFF" Padding="18,21">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Xem trước đơn" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/>
                <TextBlock Text="Cập nhật theo thông tin đang nhập" Style="{StaticResource FormNote}" Margin="0,6,0,14"/>
              </StackPanel>
              <Border Grid.Row="1" Background="{StaticResource AccentSoft}" CornerRadius="7" Padding="10,7" Margin="0,0,0,14">
                <TextBlock x:Name="txtTrangThaiNghiViec" Text="Bản nháp · Chưa gửi" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}" TextWrapping="Wrap"/>
              </Border>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,18">
                  <StackPanel>
                    <TextBlock Text="ĐƠN XIN NGHỈ VIỆC" FontWeight="Bold" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="txtXemTruocNghiViec" TextWrapping="Wrap" FontSize="14" LineHeight="24" Foreground="{StaticResource Ink}"/>
                  </StackPanel>
                </Border>
              </ScrollViewer>
              <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <Button x:Name="btnGuiNghiViec" Content="Gửi đơn xin nghỉ việc" Style="{StaticResource Primary}"
                        Margin="0" HorizontalAlignment="Stretch" Click="GuiNghiViec_Click"/>
                <TextBlock Text="Gửi đơn không tự động cập nhật trạng thái nhân viên." Style="{StaticResource FormNote}" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
