<UserControl x:Class="RangHamMat.Views.CuaSoBaoTri"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/BaoTriStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock x:Name="txtTieuDe" Text="Thêm lần bảo trì" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Chọn thiết bị và nhân viên phụ trách. Các trường có dấu * là bắt buộc." Style="{StaticResource HospitalMuted}"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="Thiết bị và phụ trách" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Thiết bị *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,16">
       <ComboBox x:Name="cboThietBi" Tag="DB:BAO_TRI_THIET_BI.MaTB" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Thiết bị"/>
      </ContentControl>
      <TextBlock Text="Ngày bắt đầu *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,16">
       <DatePicker x:Name="dpBatDau" Tag="DB:BAO_TRI_THIET_BI.NgayBatDau" AutomationProperties.Name="Ngày bắt đầu"/>
      </ContentControl>
      <TextBlock Text="Chi phí (đồng) *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,16">
       <TextBox x:Name="txtChiPhi" Text="0" Tag="DB:BAO_TRI_THIET_BI.ChiPhi" AutomationProperties.Name="Chi phí"/>
      </ContentControl>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Nhân viên phụ trách *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,16">
       <ComboBox x:Name="cboNhanVien" Tag="DB:BAO_TRI_THIET_BI.MaNV" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Nhân viên phụ trách"/>
      </ContentControl>
      <TextBlock Text="Ngày kết thúc / giờ (24 giờ)" Style="{StaticResource FieldLabel}"/>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><ContentControl Style="{StaticResource TruongNhapLieu}">
       <DatePicker x:Name="dpKetThuc" Tag="DB:BAO_TRI_THIET_BI.NgayKetThuc" AutomationProperties.Name="Ngày kết thúc"/>
      </ContentControl><ContentControl Style="{StaticResource TruongNhapLieu}" Grid.Column="2">
       <TextBox x:Name="txtGioKetThuc" Text="00:00" Tag="Time:BAO_TRI_THIET_BI.NgayKetThuc" AutomationProperties.Name="Giờ kết thúc" ToolTip="Giờ kết thúc HH:mm, từ 00:00 đến 23:59."/>
      </ContentControl></Grid>
      <TextBlock Text="Ngày bảo trì tiếp theo" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,16">
       <DatePicker x:Name="dpTiepTheo" Tag="DB:BAO_TRI_THIET_BI.NgayBaoTriTiepTheo" AutomationProperties.Name="Ngày bảo trì tiếp theo"/>
      </ContentControl>
     </StackPanel>
    </Grid>
    <TextBlock Text="Nội dung bảo trì *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,16">
     <TextBox x:Name="txtNoiDung" Tag="DB:BAO_TRI_THIET_BI.NoiDung" AutomationProperties.Name="Nội dung bảo trì" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto"/>
    </ContentControl>
    <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}" Margin="0,0,0,16">
     <TextBox x:Name="txtGhiChu" Tag="DB:BAO_TRI_THIET_BI.GhiChu" AutomationProperties.Name="Ghi chú" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto"/>
    </ContentControl>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Trạng thái *" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}">
      <ComboBox x:Name="cboTrangThai" Tag="DB:BAO_TRI_THIET_BI.TrangThai" SelectedIndex="0" AutomationProperties.Name="Trạng thái"><ComboBoxItem Content="Nháp"/><ComboBoxItem Content="Đang thực hiện"/><ComboBoxItem Content="Hoàn thành"/><ComboBoxItem Content="Đã xác nhận"/><ComboBoxItem Content="Hủy"/></ComboBox>
     </ContentControl></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Mã lần bảo trì" Style="{StaticResource FieldLabel}"/><TextBox Tag="DB:BAO_TRI_THIET_BI.MaBT" Text="Tự sinh khi lưu" IsReadOnly="True" Background="{StaticResource HospitalCanvas}" AutomationProperties.Name="Mã lần bảo trì"/></StackPanel>
    </Grid>
    <TextBlock Text="Khi hoàn thành / xác nhận, cần có ngày kết thúc. Lần đã kết thúc được giữ nguyên để tra cứu." Style="{StaticResource HospitalMuted}" Margin="0,14,0,14"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <TextBlock x:Name="FormError" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy bỏ" Tag="DongCuaSo"/><Button Content="Lưu lần bảo trì" Tag="HoSoSave" Style="{StaticResource HospitalPrimary}" IsDefault="True"/></StackPanel>
  </StackPanel>
 </Grid>
</UserControl>
