<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của ChiTietKhamDieuTri.xaml; các vùng liên quan: Khám chung, Tình trạng bệnh, Kế hoạch điều trị, StepGrid, StepExecutionGrid, Dịch vụ thực hiện, Đơn thuốc. -->
<!-- AI hỗ trợ: bổ sung chú thích cho chi tiết lần khám và điều trị. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.ChiTietKhamDieuTri" Background="#F4F7FB" FontSize="13" Foreground="#21344B" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
      <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries>
      <!-- Style mặc định cho DataGrid: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
      <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="40"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E4EBF4"/><Setter Property="BorderBrush" Value="#E4EBF4"/><Setter Property="SelectionMode" Value="Single"/></Style>
      <!-- Style VisitLabel cho TextBlock: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalMuted} để dùng chung template và hành vi control. -->
      <Style x:Key="VisitLabel" TargetType="TextBlock" BasedOn="{StaticResource HospitalMuted}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
      <!-- Style mặc định cho TextBox: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
      <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#D9E3F0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
      <!-- Style mặc định cho Button: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalSecondary} để dùng chung template và hành vi control. -->
      <Style TargetType="Button" BasedOn="{StaticResource HospitalSecondary}"/>
      <!-- Template ExecutionActions: trình bày đối tượng trong Content/ItemsSource bằng các Binding, không tự truy vấn hoặc lưu SQL. -->
      <DataTemplate x:Key="ExecutionActions"><WrapPanel><!-- Thao tác Mở lần khám: gọi OpenActualVisit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Mở lần khám" Click="OpenActualVisit_Click"/><!-- Thao tác Sửa: gọi EditRow_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Sửa" Click="EditRow_Click" IsEnabled="{Binding CanEdit}"/></WrapPanel></DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><!-- Thao tác ← Quay lại: gọi Back_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
    <Button Content="← Quay lại" Click="Back_Click" DockPanel.Dock="Left"/><TextBlock Text="Hồ sơ bệnh nhân / Lần khám" Style="{StaticResource HospitalMuted}" VerticalAlignment="Center" Margin="12,0"/></DockPanel>
    <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel><!-- Thao tác Mở hồ sơ bệnh nhân: gọi OpenPatient_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Mở hồ sơ bệnh nhân" Click="OpenPatient_Click" DockPanel.Dock="Right"/><TextBlock Text="{Binding Patient}" Style="{StaticResource HospitalHeading}" TextWrapping="Wrap"/></DockPanel>
        <WrapPanel Margin="0,10,0,0"><TextBlock Text="Lần khám " FontWeight="SemiBold"/><TextBlock Text="{Binding Code}"/><TextBlock Text="{Binding When}" Margin="16,0"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource HospitalStatusTemplate}" VerticalAlignment="Center"/></WrapPanel>
        <WrapPanel Margin="0,8,0,0"><TextBlock Text="{Binding Doctor}"/><TextBlock Text="{Binding Room}" Margin="16,0"/><TextBlock Text="Lượt tiếp nhận: "/><TextBlock Text="{Binding Receipt}"/></WrapPanel>
        <WrapPanel Margin="0,12,0,0"><!-- Thao tác Dịch vụ thực hiện: gọi OpenServices_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button x:Name="ServicesButton" Content="Dịch vụ thực hiện" Click="OpenServices_Click"/><!-- Thao tác Hóa đơn / thanh toán: gọi OpenInvoice_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button x:Name="InvoiceButton" Content="Hóa đơn / thanh toán" Click="OpenInvoice_Click"/></WrapPanel>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="2" Background="White" BorderBrush="#DCE5F1">
      <!-- Nhóm Khám chung: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem Header="Khám chung"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <TextBlock Text="Thông tin lần khám" Style="{StaticResource HospitalHeading}"/>
        <UniformGrid Columns="2" Margin="0,12,0,16"><StackPanel Margin="0,0,12,0"><TextBlock Text="Tiếp nhận lúc" Style="{StaticResource VisitLabel}"/><TextBlock Text="{Binding ReceiptTime}"/></StackPanel><StackPanel><TextBlock Text="Xác nhận lúc" Style="{StaticResource VisitLabel}"/><TextBlock Text="{Binding Confirmation}"/></StackPanel></UniformGrid>
        <TextBlock Text="Lý do khám" Style="{StaticResource VisitLabel}"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Grid IsEnabled="{Binding Visit.CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12"><TextBlock Text="Bác sĩ khám" Style="{StaticResource VisitLabel}"/><ComboBox ItemsSource="{Binding Visit.Doctors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Visit.MaBS, Mode=TwoWay}"/></StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="Phòng khám" Style="{StaticResource VisitLabel}"/><ComboBox ItemsSource="{Binding Visit.Rooms}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Visit.MaPhong, Mode=TwoWay}"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Triệu chứng" Style="{StaticResource VisitLabel}"/><TextBox Text="{Binding Visit.TrieuChung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="Chẩn đoán" Style="{StaticResource VisitLabel}"/><TextBox Text="{Binding Visit.ChanDoan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90"/></StackPanel>
          <StackPanel Grid.Row="2"><TextBlock Text="Hướng xử lý" Style="{StaticResource VisitLabel}"/><TextBox Text="{Binding Visit.KeHoachXuLy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90"/></StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Ghi chú" Style="{StaticResource VisitLabel}"/><TextBox Text="{Binding Visit.GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90"/></StackPanel>
        </Grid>
        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0"><!-- Thao tác Sửa thông tin lần khám: gọi EditVisit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Sửa thông tin lần khám" Click="EditVisit_Click" IsEnabled="{Binding Visit.CanEdit}"/><!-- Thao tác Lưu khám chung: gọi SaveVisit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Lưu khám chung" Click="SaveVisit_Click" IsEnabled="{Binding Visit.CanEdit}"/><!-- Thao tác Xác nhận lần khám: gọi ConfirmVisit_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Xác nhận lần khám" Click="ConfirmVisit_Click" IsEnabled="{Binding Visit.CanEdit}" Style="{StaticResource HospitalPrimary}"/></WrapPanel>
        <TextBlock Text="Lần khám đã xác nhận được giữ nguyên. Kế hoạch, dịch vụ và đơn thuốc mới được lập thành dữ liệu liên quan độc lập." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <!-- Nhóm Tình trạng bệnh: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem Header="Tình trạng bệnh"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><!-- Thao tác Thêm tình trạng: gọi AddCondition_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Thêm tình trạng" Click="AddCondition_Click" IsEnabled="{Binding Visit.CanEdit}" HorizontalAlignment="Right" Margin="0,0,0,12"/><!-- Bảng chi tiết: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
      <DataGrid Grid.Row="1" ItemsSource="{Binding Conditions}"><DataGrid.Columns><DataGridTextColumn Header="Loại tình trạng" Binding="{Binding Type}" Width="160"/><DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Mức độ" Binding="{Binding Severity}" Width="100"/><DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*"/><DataGridTemplateColumn Header="Thao tác" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><!-- Thao tác Sửa: gọi EditRow_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Sửa" Click="EditRow_Click" IsEnabled="{Binding CanEdit}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding ConditionsNote}" Style="{StaticResource HospitalMuted}" Margin="0,12,0,0"/></Grid></TabItem>
      <!-- Nhóm Kế hoạch điều trị: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem Header="Kế hoạch điều trị"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <!-- Thao tác Thêm kế hoạch: gọi AddPlan_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Thêm kế hoạch" Click="AddPlan_Click" Style="{StaticResource HospitalPrimary}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
        <TextBlock Text="Kế hoạch của bệnh nhân — ưu tiên lần khám đang mở" Style="{StaticResource VisitLabel}"/>
        <!-- Vùng PlanList: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
        <ListBox x:Name="PlanList" ItemsSource="{Binding Plans}" SelectionChanged="Plan_Changed" MaxHeight="160"><ListBox.ItemTemplate><DataTemplate><WrapPanel Margin="8"><TextBlock Text="{Binding Code}" FontWeight="SemiBold"/><TextBlock Text="{Binding OriginVisit}" Margin="12,0"/><TextBlock Text="{Binding Created}" Margin="8,0"/><TextBlock Text="{Binding Doctor}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource HospitalStatusTemplate}" VerticalAlignment="Center" Margin="16,0"/></WrapPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <TextBlock Text="{Binding PlansNote}" Style="{StaticResource HospitalMuted}" Margin="0,8"/>
        <StackPanel x:Name="PlanHost" Visibility="Collapsed">
          <Border Style="{StaticResource HospitalPanel}" Margin="0,8,0,12"><StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><!-- Thao tác Sửa kế hoạch: gọi EditPlan_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
          <Button Content="Sửa kế hoạch" Click="EditPlan_Click" IsEnabled="{Binding CanEdit}"/><!-- Thao tác Xác nhận kế hoạch: gọi ConfirmPlan_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
          <Button Content="Xác nhận kế hoạch" Click="ConfirmPlan_Click" IsEnabled="{Binding CanConfirm}"/></WrapPanel><TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="16"/></DockPanel><WrapPanel Margin="0,8"><TextBlock Text="Bác sĩ: "/><TextBlock Text="{Binding Doctor}"/><TextBlock Text="Bắt đầu: " Margin="16,0,0,0"/><TextBlock Text="{Binding Start}"/><TextBlock Text="Dự kiến kết thúc: " Margin="16,0,0,0"/><TextBlock Text="{Binding End}"/></WrapPanel><TextBlock Text="{Binding Note}" TextWrapping="Wrap"/><TextBlock Text="{Binding Total, StringFormat='Dự kiến: {0}'}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
          <DockPanel Margin="0,0,0,8"><!-- Thao tác Thêm bước: gọi AddStep_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
          <Button Content="Thêm bước" Click="AddStep_Click" DockPanel.Dock="Right" IsEnabled="{Binding CanEdit}"/><TextBlock Text="Các bước điều trị" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <!-- Bảng StepGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
          <DataGrid x:Name="StepGrid" ItemsSource="{Binding Steps}" SelectionChanged="Step_Changed" MaxHeight="260" MinHeight="85"><DataGrid.Columns><DataGridTextColumn Header="Lần" Binding="{Binding Sequence}" Width="50"/><DataGridTextColumn Header="Dịch vụ dự kiến" Binding="{Binding Service}" Width="2*"/><DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="75"/><DataGridTextColumn Header="Đơn giá" Binding="{Binding PriceText}" Width="105"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding AmountText}" Width="110"/><DataGridTemplateColumn Header="Trạng thái" Width="138" CellTemplate="{StaticResource HospitalStatusTemplate}" SortMemberPath="Status"/><DataGridTemplateColumn Header="Thao tác" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel><!-- Thao tác Thực hiện: gọi ExecuteStep_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
          <Button Content="Thực hiện" Click="ExecuteStep_Click" IsEnabled="{Binding CanExecute}"/><!-- Thao tác Sửa: gọi EditRow_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
          <Button Content="Sửa" Click="EditRow_Click" IsEnabled="{Binding CanEdit}"/></WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
          <TextBlock Text="{Binding StepsNote}" Style="{StaticResource HospitalMuted}" Margin="0,8"/>
          <TextBlock Text="Thực hiện của bước đang chọn" FontWeight="SemiBold" Margin="0,12,0,8"/>
          <!-- Bảng StepExecutionGrid: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
          <DataGrid x:Name="StepExecutionGrid" MaxHeight="220" MinHeight="70"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding When}" Width="145"/><DataGridTextColumn Header="Lần khám thực tế" Binding="{Binding VisitId}" Width="100"/><DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="*"/><DataGridTemplateColumn Header="Trạng thái" Width="138" CellTemplate="{StaticResource HospitalStatusTemplate}" SortMemberPath="Status"/><DataGridTemplateColumn Header="Thao tác" CellTemplate="{StaticResource ExecutionActions}" Width="180"/></DataGrid.Columns></DataGrid><TextBlock x:Name="StepEmpty" Style="{StaticResource HospitalMuted}" Margin="0,8"/>
          <TextBlock Text="Tất cả dịch vụ thực hiện của kế hoạch" FontWeight="SemiBold" Margin="0,12,0,8"/>
          <TextBlock Text="Bao gồm các lần khám khác của cùng bệnh nhân. Mở lần khám thực tế để xem nguồn ghi nhận." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <!-- Bảng chi tiết: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
          <DataGrid ItemsSource="{Binding Executions}" MaxHeight="260" MinHeight="85"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding When}" Width="145"/><DataGridTextColumn Header="Dịch vụ" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Lần khám" Binding="{Binding VisitId}" Width="90"/><DataGridTextColumn Header="Bước" Binding="{Binding Step}" Width="70"/><DataGridTextColumn Header="Người thực hiện" Binding="{Binding Doctor}" Width="140"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding AmountText}" Width="105"/><DataGridTemplateColumn Header="Thao tác" CellTemplate="{StaticResource ExecutionActions}" Width="180"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding ExecutionsNote}" Style="{StaticResource HospitalMuted}" Margin="0,8"/>
        </StackPanel>
      </StackPanel></ScrollViewer></TabItem>
      <!-- Nhóm Dịch vụ thực hiện: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem Header="Dịch vụ thực hiện"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><!-- Thao tác Thêm dịch vụ thực hiện: gọi AddExecution_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Thêm dịch vụ thực hiện" Click="AddExecution_Click" HorizontalAlignment="Right" Style="{StaticResource HospitalPrimary}" Margin="0,0,0,12"/><TextBlock Text="Dịch vụ tại lần khám này" FontWeight="SemiBold" Margin="0,0,0,8"/><!-- Bảng chi tiết: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
      <DataGrid ItemsSource="{Binding Services}" MaxHeight="330" MinHeight="85"><DataGrid.Columns><DataGridTextColumn Header="Dịch vụ" Binding="{Binding Service}" Width="2*"/><DataGridTextColumn Header="Thời gian" Binding="{Binding When}" Width="145"/><DataGridTextColumn Header="Người thực hiện" Binding="{Binding Doctor}" Width="140"/><DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="75"/><DataGridTextColumn Header="Đơn giá" Binding="{Binding PriceText}" Width="105"/><DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="*"/><DataGridTemplateColumn Header="Trạng thái" Width="138" CellTemplate="{StaticResource HospitalStatusTemplate}" SortMemberPath="Status"/><DataGridTemplateColumn Header="Thao tác" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><!-- Thao tác Sửa: gọi EditRow_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Sửa" Click="EditRow_Click" IsEnabled="{Binding CanEdit}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Text="{Binding ServicesNote}" Style="{StaticResource HospitalMuted}" Margin="0,8"/>
        <TextBlock Text="Phát sinh ngoài kế hoạch" FontWeight="SemiBold" Margin="0,16,0,8"/><!-- Bảng chi tiết: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
        <DataGrid ItemsSource="{Binding OutsidePlan}" MinHeight="70" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn Header="Dịch vụ" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Thời gian" Binding="{Binding When}" Width="145"/><DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="*"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding AmountText}" Width="110"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding OutsideNote}" Style="{StaticResource HospitalMuted}" Margin="0,8"/></StackPanel></ScrollViewer></TabItem>
      <!-- Nhóm Đơn thuốc: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem x:Name="PrescriptionTab" Header="Đơn thuốc"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><!-- Thao tác Lập đơn thuốc: gọi AddPrescription_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Lập đơn thuốc" Click="AddPrescription_Click" DockPanel.Dock="Right" Style="{StaticResource HospitalPrimary}"/><TextBlock Text="Đơn thuốc được kê theo lần khám." Style="{StaticResource HospitalMuted}" VerticalAlignment="Center"/></DockPanel><!-- Bảng chi tiết: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
      <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}"><DataGrid.Columns><DataGridTextColumn Header="Mã đơn" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="Ngày kê" Binding="{Binding When}" Width="150"/><DataGridTextColumn Header="Bác sĩ kê" Binding="{Binding Doctor}" Width="*"/><DataGridTemplateColumn Header="Trạng thái" Width="138" CellTemplate="{StaticResource HospitalStatusTemplate}" SortMemberPath="Status"/><DataGridTemplateColumn Header="Chi tiết" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><!-- Thao tác Mở đơn thuốc: gọi OpenPrescription_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button Content="Mở đơn thuốc" Click="OpenPrescription_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding OrdersNote}" Style="{StaticResource HospitalMuted}" Margin="0,12,0,0"/></Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
