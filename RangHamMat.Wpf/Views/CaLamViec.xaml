<UserControl x:Class="RangHamMat.Views.CaLamViec"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"        
        FontFamily="Segoe UI" FontSize="13" Foreground="#242B40" Background="#F7F8FC">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Primary" Color="#5B53E8"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#EFEDFF"/>
        <SolidColorBrush x:Key="Ink" Color="#242B40"/>
        <SolidColorBrush x:Key="Muted" Color="#77829C"/>
        <SolidColorBrush x:Key="Stroke" Color="#DDE2EF"/>
        <SolidColorBrush x:Key="Pane" Color="#F0F2F8"/>
        <SolidColorBrush x:Key="Good" Color="#168460"/>
        <SolidColorBrush x:Key="GoodBg" Color="#E6F6EE"/>
        <SolidColorBrush x:Key="Warn" Color="#A96C0F"/>
        <SolidColorBrush x:Key="WarnBg" Color="#FFF2D5"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="33"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="29"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="InputText" TargetType="TextBox">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputDate" TargetType="DatePicker">
            <Setter Property="Height" Value="43"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GoodBg}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Chờ xác nhận">
                    <Setter Property="Background" Value="{StaticResource WarnBg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Good}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Chờ xác nhận">
                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Một thẻ ca làm; nội dung thuần WPF, không dùng ảnh chụp làm giao diện. -->
        <DataTemplate x:Key="ShiftCardTemplate">
            <Border x:Name="ShiftCard" Background="White" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    Tag="{Binding}">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="{Binding TimeRange}" FontSize="15" FontWeight="Medium"/>
                        <TextBlock Text="⠿" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="15"
                                   ToolTip="CA_LAM không được chuyển ngày trực tiếp"/>
                    </Grid>
                    <TextBlock Text="{Binding Type}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,5"/>
                    <Border Style="{StaticResource StatusChip}" Margin="0,0,0,9">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="10"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Assigned}" Margin="0,0,0,9">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="30" Height="30" Background="{StaticResource PrimaryLight}"
                                        CornerRadius="15" Margin="0,0,5,0">
                                    <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{StaticResource Primary}"
                                               FontWeight="SemiBold" FontSize="10"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding AssignedLabel}" Foreground="{StaticResource Good}"
                               FontWeight="SemiBold" FontSize="10" Margin="0,0,0,7"/>
                    <ItemsControl ItemsSource="{Binding Assigned}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Ellipse Fill="{StaticResource Good}" Width="5" Height="5" Margin="0,0,7,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Department}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}">
                      <StackPanel Visibility="{Binding HasRequests, Converter={StaticResource BoolVisibility}}">
                        <Border Background="{StaticResource WarnBg}" CornerRadius="4" HorizontalAlignment="Left"
                                Padding="7,2" Margin="0,2,0,5">
                            <TextBlock Text="{Binding RequestLabel}" Foreground="{StaticResource Warn}"
                                       FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Requests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Ellipse Fill="{StaticResource Warn}" Width="5" Height="5" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding Person.Name}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionButton}" Tag="{Binding}"
                                                    Click="btnDuyetCa_Click" Content="✓  Duyệt" Margin="0,0,4,0"/>
                                            <Button Style="{StaticResource ActionButton}" Tag="{Binding}"
                                                    Click="btnTuChoiCa_Click" Content="✕  Từ chối"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="✉  Đăng ký ca"
                            Tag="{Binding}" Click="btnDangKyCa_Click" Margin="0,4,0,6" Height="31"
                            Visibility="{Binding IsEmployee, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}"/>
                    <Button Style="{StaticResource ActionButton}" Content="♧  Chi tiết ca"
                            Tag="{Binding}" Click="btnChiTietCa_Click" Margin="0,4,0,0"/>
                    <Button Style="{StaticResource ActionButton}" Content="✕  Bỏ ca khỏi ngày"
                            Tag="{Binding}" Click="btnBoCaKhoiNgay_Click" Margin="0,4,0,0"
                            Visibility="{Binding IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Main content -->
        <Grid x:Name="MainCaContent" Grid.Row="1" Margin="40,20,40,16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HangTieuDeCa" Height="104"/>
                <RowDefinition Height="68"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="Lịch ca làm" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Nhân viên đăng ký ca → Quản lý duyệt / từ chối → Cập nhật lịch làm."
                               Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
                    <StackPanel x:Name="EmployeePicker" Margin="0,0,12,0" Visibility="Collapsed">
                        <TextBlock Text="Nhân viên đang xem" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboEmployee" Width="225" Height="37" Style="{StaticResource InputCombo}"
                                 DisplayMemberPath="Name"/>
                    </StackPanel>
                    <Button x:Name="btnDangKyTuan" Style="{StaticResource PrimaryButton}"
                            Content="✓  Đăng ký tuần" Click="btnDangKyTuan_Click"
                            ToolTip="Đăng ký các ca hợp lệ của tuần đang xem, bỏ qua ca đã có hoặc trùng giờ"
                            Margin="0,15,10,0" Visibility="Collapsed"/>
                    <Button x:Name="btnMyRequests" Style="{StaticResource PrimaryButton}"
                            Content="✉  Đăng ký của tôi" Click="btnXemDangKy_Click"
                            Margin="0,15,10,0" Visibility="Collapsed"/>
                    <Button x:Name="btnDongBoLichKham" Style="{StaticResource BaseButton}"
                            Content="↻  Đồng bộ lịch khám" Click="btnDongBoLichKham_Click"
                            Margin="0,15,10,0" Visibility="Collapsed"/>
                    <Button x:Name="btnExport" Style="{StaticResource BaseButton}" Content="♧  Xuất lịch"
                            Click="btnXuatLich_Click" Margin="0,15,10,0"/>
                    <Button x:Name="btnCreate" Style="{StaticResource PrimaryButton}" Content="＋  Tạo mẫu ca"
                            Margin="0,15,0,0" Click="btnMoTaoCa_Click"/>
                </StackPanel>
                <!-- Quản lý nhận thông báo nghỉ phép / nghỉ việc tại phần đầu màn hình. -->
                <Button x:Name="btnThongBaoDonXinNghi" Height="64" VerticalAlignment="Top" Margin="0,88,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,0"
                        Background="#EAF3FF" BorderBrush="#BED7F4" BorderThickness="1"
                        Cursor="Hand" Visibility="Collapsed" Click="btnThongBaoDonXinNghi_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🔔  THÔNG BÁO ĐƠN XIN NGHỈ" Foreground="#22569F"
                                       FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="txtThongBaoDonXinNghi" Text="Đang tải đơn chờ duyệt..."
                                       Foreground="#364C70" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Xem danh sách đơn  ›" FontWeight="SemiBold"
                                   FontSize="13" Foreground="#185BB4" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Statistics: 4 tiles in one rectangle -->
            <Border Grid.Row="1" CornerRadius="10" Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <UniformGrid Columns="4" Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F7F8FC" Width="36" Height="36" CornerRadius="9">
                            <TextBlock Text="▦" FontSize="19" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtShiftCount" Text="3" FontSize="24" FontWeight="SemiBold" Margin="15,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ca làm trong tuần" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F7F8FC" Width="36" Height="36" CornerRadius="9">
                            <TextBlock Text="♧" FontSize="19" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtStaffCount" Text="6" FontSize="24" FontWeight="SemiBold" Margin="15,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="nhân sự được xếp ca" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F7F8FC" Width="36" Height="36" CornerRadius="9">
                            <TextBlock Text="◷" FontSize="19" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtHours" Text="24" FontSize="24" FontWeight="SemiBold" Margin="15,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="giờ khung ca" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="#F7F8FC" Width="36" Height="36" CornerRadius="9">
                            <TextBlock Text="☑" FontSize="19" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtConfirmed" Text="3/3" FontSize="22" FontWeight="SemiBold" Margin="15,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ca đã xác nhận" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Week navigation -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="‹" Click="btnTuanTruoc_Click"/>
                    <TextBlock x:Name="txtWeekRange" Text="12 – 18 tháng 10, 2026" FontWeight="SemiBold"
                               FontSize="15" Margin="12,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="›" Click="btnTuanSau_Click" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource BaseButton}" Content="Tuần này" Click="btnTuanHienTai_Click"/>
                    <TextBlock x:Name="txtWeekNumber" Text="Tuần 42" Style="{StaticResource MutedText}"
                               Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Background="#E5E8F0" CornerRadius="9" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnWeekView" Style="{StaticResource BaseButton}" Background="White" BorderThickness="0"
                                Height="32" Content="▥  Tuần" Foreground="{StaticResource Primary}" Click="btnXemTuan_Click"/>
                        <Button x:Name="btnListView" Style="{StaticResource BaseButton}" Background="Transparent" BorderThickness="0"
                                Height="32" Content="Danh sách" Foreground="{StaticResource Muted}" Click="btnXemDanhSach_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search + filters -->
            <Grid Grid.Row="3" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="232" Height="39">
                        <TextBox x:Name="txtSearch" Style="{StaticResource InputText}" Height="39"
                                 Padding="12,7" TextChanged="BoLoc_ThayDoi"
                                 ToolTip="Tìm theo tên ca hoặc nhân sự"/>
                        <TextBlock Text="⌕   Tìm ca, nhân sự..." Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="cboDepartment" Style="{StaticResource InputCombo}" Height="39" Width="148"
                              Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="BoLoc_ThayDoi">
                        <ComboBoxItem Content="Tất cả bộ phận"/>
                        <ComboBoxItem Content="Chăm sóc khách hàng"/>
                        <ComboBoxItem Content="Kinh doanh"/>
                        <ComboBoxItem Content="Điều trị"/>
                    </ComboBox>
                    <ComboBox x:Name="cboLocation" Style="{StaticResource InputCombo}" Height="39" Width="150"
                              Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="BoLoc_ThayDoi">
                        <ComboBoxItem Content="Tất cả địa điểm"/>
                        <ComboBoxItem Content="Trụ sở chính"/>
                        <ComboBoxItem Content="Chi nhánh 2"/>
                    </ComboBox>
                    <ComboBox x:Name="cboStatus" Style="{StaticResource InputCombo}" Height="39" Width="147"
                              Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="BoLoc_ThayDoi">
                        <ComboBoxItem Content="Tất cả trạng thái"/>
                        <ComboBoxItem Content="Đã xác nhận"/>
                        <ComboBoxItem Content="Chờ xác nhận"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="txtVisibleCount" Text="Hiển thị các mẫu ca trong tuần" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Week calendar -->
            <Grid Grid.Row="4" x:Name="WeekView">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                            CanContentScroll="False">
                <ItemsControl x:Name="WeekItems" MinWidth="1120" ItemsSource="{Binding Days}"
                              Height="{Binding ActualHeight, ElementName=WeekView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="DayDropZone" Background="{StaticResource Pane}" CornerRadius="12"
                                    BorderThickness="1" BorderBrush="{StaticResource Stroke}"
                                    Margin="0,0,10,0" Padding="10,15" AllowDrop="True"
                                    Tag="{Binding}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Margin="2,0,2,18">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DayName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding DateLabel}" Style="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="11"/>
                                        </StackPanel>
                                        <Border Background="White" CornerRadius="7" Width="25" Height="25" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Count}" Foreground="{StaticResource Muted}"
                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Shifts}" ItemTemplate="{StaticResource ShiftCardTemplate}"/>
                                            <Button Content="⚙  Cài đặt ca" Style="{StaticResource BaseButton}" BorderThickness="0"
                                                    Background="Transparent" FontWeight="Normal" Foreground="{StaticResource Primary}"
                                                    FontSize="11" Tag="{Binding Date}" Click="btnCaiDatCa_Click"
                                                    Visibility="{Binding IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <!-- Alternative list mode -->
            <Border Grid.Row="4" x:Name="ListView" Visibility="Collapsed" Background="White"
                    CornerRadius="10" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <DataGrid x:Name="ShiftGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" BorderThickness="0" GridLinesVisibility="None"
                          RowHeight="55" ColumnHeaderHeight="48" AlternatingRowBackground="#F7F8FC"
                          SelectionMode="Single" MouseDoubleClick="dgvCaLamViec_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ngày làm việc" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="1.2*"/>
                        <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeRange}" Width="1.2*"/>
                        <DataGridTextColumn Header="Tên ca" Binding="{Binding Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="Địa điểm" Binding="{Binding Location}" Width="1.5*"/>
                        <DataGridTextColumn Header="Đã xếp" Binding="{Binding AssignedCount}" Width="*"/>
                        <DataGridTextColumn Header="Yêu cầu" Binding="{Binding RequestCount}" Width="*"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1.3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Grid Grid.Row="5" VerticalAlignment="Center">
                <TextBlock x:Name="txtFootHint" Style="{StaticResource MutedText}"/>
                <TextBlock Text="Múi giờ GMT+7" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <!-- Right-side shift detail sheet -->
        <Grid x:Name="DetailOverlay" Grid.Row="1" Panel.ZIndex="20" Visibility="Collapsed">
            <Border Background="#700E1630" MouseDown="NenChiTiet_MouseDown"/>
            <Border Width="500" HorizontalAlignment="Right" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="98"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="24,20">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,25,0">
                                <TextBlock Text="Chi tiết khung giờ Ca" FontSize="21" FontWeight="Bold"/>
                                <TextBlock x:Name="txtDetailSubtitle" Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" BorderThickness="0" Click="btnDongChiTiet_Click"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailContent" Margin="24,24,24,28">
                            <Grid Margin="0,0,0,18">
                                <TextBlock Text="Thông tin khung giờ Ca" FontWeight="SemiBold"/>
                                <Border Style="{StaticResource StatusChip}" HorizontalAlignment="Right" Padding="8,5">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="11"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Tên khung giờ Ca" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource InputText}" IsReadOnly="True" Margin="0,0,0,17"/>
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Ngày làm việc" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Date, StringFormat=dd/MM/yyyy, Mode=OneWay}" Style="{StaticResource InputText}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Giờ làm việc" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding TimeRange, Mode=OneWay}" Style="{StaticResource InputText}" IsReadOnly="True"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Nghỉ giữa ca" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BreakTime, Mode=OneWay}" Style="{StaticResource InputText}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Địa điểm" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Location, Mode=OneWay}" Style="{StaticResource InputText}" IsReadOnly="True" ToolTip="Phòng được phân riêng cho từng nhân viên khi duyệt"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource PrimaryLight}" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                                <TextBlock Text="{Binding DurationCaption}" Foreground="{StaticResource Primary}" FontSize="12"/>
                            </Border>
                            <TextBlock Text="Ghi chú công việc" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Note, Mode=OneWay}" Style="{StaticResource InputText}"
                                     Height="68" TextWrapping="Wrap" IsReadOnly="True" Margin="0,0,0,20"/>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,17"/>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Nhân viên đã được xếp ca" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AssignedLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Assigned}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F9FC" CornerRadius="9" Padding="11" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource PrimaryLight}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        
                                                        <TextBlock Text="{Binding Department}" Style="{StaticResource MutedText}" FontSize="10"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Center">
                                                    <TextBlock Text="Đã xác nhận" Foreground="{StaticResource Good}" FontSize="10"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,2,0,16"/>
                            <StackPanel Visibility="{Binding IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Yêu cầu đăng ký · Chờ duyệt" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RequestLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Requests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F9FC" CornerRadius="9" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="29" Height="29" CornerRadius="15" Background="{StaticResource PrimaryLight}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Person.Initials}" FontSize="10" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{StaticResource Primary}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Person.Name}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Person.Department}" Style="{StaticResource MutedText}" FontSize="10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Content="✓ Duyệt" Style="{StaticResource PrimaryButton}"
                                                            FontSize="11" Height="33" Tag="{Binding}" Click="btnDuyetCa_Click" Margin="0,0,5,0"/>
                                                    <Button Content="✕ Từ chối" Style="{StaticResource BaseButton}"
                                                            FontSize="11" Height="33" Tag="{Binding}" Click="btnTuChoiCa_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Lịch sử duyệt / từ chối" FontWeight="SemiBold" Margin="0,18,0,9"/>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F9FC" Padding="10" CornerRadius="7" Margin="0,0,0,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Person.Name}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Primary}"
                                                               Margin="12,0,0,0" FontWeight="SemiBold" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ReviewCaption}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding ReviewNote}" Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- My registrations dialog (employee) -->
        <Grid x:Name="MyRequestsOverlay" Grid.RowSpan="2" Panel.ZIndex="35" Visibility="Collapsed">
            <Border Background="#840E1630" MouseDown="NenDanhSachDangKy_MouseDown"/>
            <Border Width="570" MaxHeight="680" Background="White" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="83"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="23,15">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Đăng ký ca của tôi (tuần đang xem)" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="txtMyRequestCount" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Click="btnDongDanhSachDangKy_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="23,9">
                        <StackPanel>
                            <TextBlock x:Name="EmptyMyRequests" Text="Nhân viên này chưa có yêu cầu đăng ký."
                                       Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,16"/>
                            <ItemsControl x:Name="MyRequestsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                                Background="#F8F9FC" CornerRadius="9" Padding="13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Shift.Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <Border Background="{StaticResource PrimaryLight}" CornerRadius="5"
                                                            HorizontalAlignment="Right" Padding="8,4">
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Primary}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}"
                                                           Margin="0,7,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SubmittedCaption}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding ReviewCaption}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding ReviewNote}" Foreground="{StaticResource Ink}" Margin="0,4,0,0"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                                <Button Content="Hủy yêu cầu chờ duyệt" Style="{StaticResource BaseButton}"
                                                        HorizontalAlignment="Left" Margin="0,10,0,0" Tag="{Binding}"
                                                        Click="btnHuyDangKy_Click"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#F8F9FC" Padding="23,10" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Đóng" HorizontalAlignment="Right"
                                Click="btnDongDanhSachDangKy_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Reason is mandatory when rejecting a request -->
        <Grid x:Name="RejectOverlay" Grid.RowSpan="2" Panel.ZIndex="45" Visibility="Collapsed">
            <Border Background="#840E1630" MouseDown="NenTuChoi_MouseDown"/>
            <Border Background="White" Width="490" CornerRadius="14" Padding="25"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Từ chối đăng ký ca" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="txtRejectTitle" Style="{StaticResource MutedText}"
                               Margin="0,7,0,18" TextWrapping="Wrap"/>
                    <TextBlock Text="Lý do từ chối *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtRejectReason" Style="{StaticResource InputText}" Height="94"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource BaseButton}" Content="Hủy" Click="btnDongTuChoi_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Xác nhận từ chối" Click="btnXacNhanTuChoi_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Create-shift modal -->
        <Grid x:Name="CreateOverlay" Grid.RowSpan="2" Panel.ZIndex="30" Visibility="Collapsed">
            <Border Background="#840E1630" MouseDown="NenTaoCa_MouseDown"/>
            <Border Width="600" MaxHeight="735" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" CornerRadius="15" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="24,18">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,27,0">
                                <TextBlock Text="Tạo khung giờ ca mới" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="Tạo MẪU GIỜ vào CA_LAM. Ngày và phòng chỉ được lưu khi có LICH_LAM_VIEC."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Content="×" BorderThickness="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="btnDongTaoCa_Click"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,24,24,24">
                            <TextBlock Text="Mã ca tự sinh · Chỉ giờ/trạng thái/ghi chú được lưu trong CA_LAM" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="Tên ca làm *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cbCreateName" Style="{StaticResource InputCombo}" SelectedIndex="0"
                                      SelectionChanged="ThongTinTaoCa_Changed">
                                <ComboBoxItem Content="Ca hành chính"/>
                                <ComboBoxItem Content="Ca chiều"/>
                                <ComboBoxItem Content="Ca sáng"/>
                                <ComboBoxItem Content="Ca tối"/>
                            </ComboBox>
                            <TextBlock Text="CA_LAM không có ngày, phòng, tên ca hay sức chứa. Tên gợi nhớ lưu trong GhiChu."
                                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,9,0,19"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Tuần hiển thị (không lưu)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cbCreateDay" Style="{StaticResource InputCombo}" SelectedIndex="0"
                                              SelectionChanged="cboNgayTaoCa_SelectionChanged">
                                        <ComboBoxItem Content="Thứ 2"/>
                                        <ComboBoxItem Content="Thứ 3"/>
                                        <ComboBoxItem Content="Thứ 4"/>
                                        <ComboBoxItem Content="Thứ 5"/>
                                        <ComboBoxItem Content="Thứ 6"/>
                                        <ComboBoxItem Content="Thứ 7"/>
                                        <ComboBoxItem Content="Chủ nhật"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Ngày xem trước (không lưu)" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="dpCreateDate" Style="{StaticResource InputDate}"
                                                SelectedDateChanged="dpNgayTaoCa_SelectedDateChanged"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Giờ bắt đầu *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtCreateStart" Style="{StaticResource InputText}" Text="09:00"
                                             TextChanged="ThongTinTaoCa_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Giờ kết thúc *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtCreateEnd" Style="{StaticResource InputText}" Text="17:00"
                                             TextChanged="ThongTinTaoCa_Changed"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,20" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Loại ca" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cbCreateType" Style="{StaticResource InputCombo}" SelectedIndex="0"
                                              SelectionChanged="ThongTinTaoCa_Changed">
                                        <ComboBoxItem Content="Ca hành chính"/>
                                        <ComboBoxItem Content="Ca chiều"/>
                                        <ComboBoxItem Content="Ca sáng"/>
                                        <ComboBoxItem Content="Ca tối"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Địa điểm" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cbCreateLocation" Style="{StaticResource InputCombo}" SelectedIndex="0"
                                              SelectionChanged="ThongTinTaoCa_Changed">
                                        <ComboBoxItem Content="Trụ sở chính"/>
                                        <ComboBoxItem Content="Chi nhánh 2"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Số nhân sự tối đa *" Style="{StaticResource FieldLabel}" Visibility="Collapsed"/>
                            <TextBox x:Name="txtCreateCapacity" Style="{StaticResource InputText}" Text="4" Visibility="Collapsed"
                                     MaxLength="3" Margin="0,0,0,18"/>
                            <Border Background="{StaticResource PrimaryLight}" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="txtCreatePreview" Text="☑  Ca trống mới · Thứ 6, 16/10"
                                               Foreground="{StaticResource Primary}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="txtCreatePreviewSub" Text="09:00 – 17:00 · 8 giờ · 0 nhân sự · Chưa lưu"
                                               Style="{StaticResource MutedText}" Margin="22,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#FBFCFF" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="24,0">
                        <Grid>
                            <TextBlock Text="* Thông tin bắt buộc" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource BaseButton}" Content="Hủy" Click="btnDongTaoCa_Click" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="✓  Lưu mẫu ca" Click="btnLuuCaLam_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Chọn ca làm đã có trong CA_LAM cho một ngày -->
        <Grid x:Name="SetShiftOverlay" Grid.RowSpan="2" Panel.ZIndex="50" Visibility="Collapsed">
            <Border Background="#840E1630" MouseDown="NenCaiDatCa_MouseDown"/>
            <Border Width="440" Background="White" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Cài đặt ca làm" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="txtNgayCaiDat" Style="{StaticResource MutedText}" Margin="0,8,0,18"/>
                    <TextBlock Text="Chọn ca có sẵn" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cboCaCoSan" Style="{StaticResource InputCombo}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Hủy" Style="{StaticResource BaseButton}" Click="btnDongCaiDatCa_Click" Margin="0,0,8,0"/>
                        <Button Content="Lưu ca" Style="{StaticResource PrimaryButton}" Click="btnLuuCaiDatCa_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hộp thoại chọn phòng khi duyệt đăng ký ca -->
        <Grid x:Name="ApproveOverlay" Grid.RowSpan="2" Panel.ZIndex="60" Visibility="Collapsed">
            <Border Background="#840E1630"/>
            <Border Width="470" Background="White" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Duyệt đăng ký và phân phòng" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="txtThongTinDuyet" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <TextBlock Text="Chọn phòng khám *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cboPhongDuyet" Style="{StaticResource InputCombo}"
                              DisplayMemberPath="TenPhong" SelectedValuePath="MaPhong"/>
                    <TextBlock Text="Một phòng hoặc một nhân viên không được trùng khung giờ với lịch đã duyệt."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Hủy" Style="{StaticResource BaseButton}" Click="btnDongDuyet_Click" Margin="0,0,8,0"/>
                        <Button Content="Xác nhận duyệt" Style="{StaticResource PrimaryButton}" Click="btnXacNhanDuyet_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- View danh sách duyệt/lịch sử đơn nghỉ được mở bên trong Ca làm. -->
        <Grid x:Name="DonXinNghiOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#F6F8FC" Visibility="Collapsed">
            <ContentControl x:Name="NoiDungDonXinNghi"/>
        </Grid>
    </Grid>
</UserControl>
