<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:RangHamMat.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.CaLamViec">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Ca làm việc và nghỉ phép" Style="{StaticResource Title}" />
      <TextBlock Text="Nhấp đúp vào một dòng để xem chi tiết. Chọn Thêm để tạo mới." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,20">
      <RadioButton Content="Bảng dữ liệu" GroupName="ViewMode" IsChecked="True" Checked="ViewMode_Changed" Tag="Table" Style="{StaticResource ViewSwitch}" />
      <RadioButton Content="Lịch theo tuần" GroupName="ViewMode" Checked="ViewMode_Changed" Tag="Schedule" Style="{StaticResource ViewSwitch}" />
    </WrapPanel>
    <TabControl Grid.Row="2" x:Name="TableView">
      <TabItem Header="Ca làm">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Thêm ca làm" Tag="MoCuaSo:CaLamViec" CommandParameter="CA_LAM" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Ca làm" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:CA_LAM" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_CA_LAM" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã ca làm" SortMemberPath="MaCa" Width="155" Binding="{Binding MaCa}" />
                  <DataGridTextColumn Header="Giờ bắt đầu" SortMemberPath="GioBatDau" Width="155" Binding="{Binding GioBatDau}" />
                  <DataGridTextColumn Header="Giờ kết thúc" SortMemberPath="GioKetThuc" Width="155" Binding="{Binding GioKetThuc}" />
                  <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Binding="{Binding GhiChu}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_CA_LAM}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có ca làm" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:CaLamViec" CommandParameter="CA_LAM" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Lịch làm việc">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Thêm lịch làm việc" Tag="MoCuaSo:CaLamViec" CommandParameter="LICH_LAM_VIEC" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Lịch làm việc" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:LICH_LAM_VIEC" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_LICH_LAM_VIEC" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã lịch làm việc" SortMemberPath="MaLLV" Width="155" Binding="{Binding MaLLV}" />
                  <DataGridTextColumn Header="Nhân viên" SortMemberPath="MaNV" Width="155" Binding="{Binding MaNV}" />
                  <DataGridTextColumn Header="Ca làm" SortMemberPath="MaCa" Width="155" Binding="{Binding MaCa}" />
                  <DataGridTextColumn Header="Ngày làm" SortMemberPath="NgayLam" Width="155" Binding="{Binding NgayLam}" />
                  <DataGridTextColumn Header="Phòng khám" SortMemberPath="MaPhong" Width="155" Binding="{Binding MaPhong}" />
                  <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Binding="{Binding TrangThai}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_LICH_LAM_VIEC}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có lịch làm việc" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:CaLamViec" CommandParameter="LICH_LAM_VIEC" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Đơn xin nghỉ">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="DON_XIN_NGHI" />
              <Button Content="Thêm đơn xin nghỉ" Tag="MoCuaSo:CaLamViec" CommandParameter="DON_XIN_NGHI" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Đơn xin nghỉ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:DON_XIN_NGHI" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_DON_XIN_NGHI" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã đơn xin nghỉ" SortMemberPath="MaDonNghi" Width="155" Binding="{Binding MaDonNghi}" />
                  <DataGridTextColumn Header="Nhân viên" SortMemberPath="MaNV" Width="155" Binding="{Binding MaNV}" />
                  <DataGridTextColumn Header="Từ ngày" SortMemberPath="TuNgay" Width="155" Binding="{Binding TuNgay}" />
                  <DataGridTextColumn Header="Đến ngày" SortMemberPath="DenNgay" Width="155" Binding="{Binding DenNgay}" />
                  <DataGridTextColumn Header="Lý do" SortMemberPath="LyDo" Width="155" Binding="{Binding LyDo}" />
                  <DataGridTextColumn Header="Ngày gửi" SortMemberPath="NgayGui" Width="155" Binding="{Binding NgayGui}" />
                  <DataGridTextColumn Header="Trạng thái duyệt" SortMemberPath="TrangThaiDuyet" Width="155" Visibility="Collapsed" Binding="{Binding TrangThaiDuyet}" />
                  <DataGridTextColumn Header="Nhân viên duyệt" SortMemberPath="MaNVDuyet" Width="155" Visibility="Collapsed" Binding="{Binding MaNVDuyet}" />
                  <DataGridTextColumn Header="Ngày duyệt" SortMemberPath="NgayDuyet" Width="155" Visibility="Collapsed" Binding="{Binding NgayDuyet}" />
                  <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Visibility="Collapsed" Binding="{Binding GhiChu}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_DON_XIN_NGHI}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có đơn xin nghỉ" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:CaLamViec" CommandParameter="DON_XIN_NGHI" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Phân công thay thế">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="PHAN_CONG_THAY_THE" />
              <Button Content="Thêm phân công thay thế" Tag="MoCuaSo:CaLamViec" CommandParameter="PHAN_CONG_THAY_THE" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Phân công thay thế" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:PHAN_CONG_THAY_THE" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_PHAN_CONG_THAY_THE" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã phân công thay thế" SortMemberPath="MaPCTT" Width="155" Binding="{Binding MaPCTT}" />
                  <DataGridTextColumn Header="Đơn xin nghỉ" SortMemberPath="MaDonNghi" Width="155" Binding="{Binding MaDonNghi}" />
                  <DataGridTextColumn Header="Lịch làm việc gốc" SortMemberPath="MaLLVGoc" Width="155" Binding="{Binding MaLLVGoc}" />
                  <DataGridTextColumn Header="Nhân viên thay thế" SortMemberPath="MaNVThayThe" Width="155" Binding="{Binding MaNVThayThe}" />
                  <DataGridTextColumn Header="Lịch làm việc thay thế" SortMemberPath="MaLLVThayThe" Width="155" Binding="{Binding MaLLVThayThe}" />
                  <DataGridTextColumn Header="Ngày xử lý" SortMemberPath="NgayXuLy" Width="155" Binding="{Binding NgayXuLy}" />
                  <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Visibility="Collapsed" Binding="{Binding TrangThai}" />
                  <DataGridTextColumn Header="Lý do thay thế" SortMemberPath="LyDoThayThe" Width="155" Visibility="Collapsed" Binding="{Binding LyDoThayThe}" />
                  <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Visibility="Collapsed" Binding="{Binding GhiChu}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_PHAN_CONG_THAY_THE}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có phân công thay thế" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:CaLamViec" CommandParameter="PHAN_CONG_THAY_THE" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <ui:ScheduleView Mode="Shifts" Grid.Row="2" Visibility="Collapsed" ItemsSource="{Binding Items, ElementName=Grid_LICH_LAM_VIEC}" ShiftsSource="{Binding Items, ElementName=Grid_CA_LAM}" x:Name="Schedule" />
  </Grid>
</UserControl>