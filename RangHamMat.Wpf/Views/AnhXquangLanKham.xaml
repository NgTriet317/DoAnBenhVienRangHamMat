<!-- Ảnh X-quang thuộc một lần khám; code-behind nạp nguồn, kiểm tra quyền và điều khiển trạng thái thao tác. -->
<UserControl x:Class="RangHamMat.Views.AnhXquangLanKham" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="330" MaxHeight="500"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource HospitalPanel}" Margin="0,0,0,12"><StackPanel>
   <DockPanel><Button Content="Tải lại danh sách" Click="Reload_Click" DockPanel.Dock="Right"/><TextBlock Text="Ảnh X-quang theo lần khám" Style="{StaticResource HospitalHeading}"/></DockPanel>
   <TextBlock x:Name="IdentityText" TextWrapping="Wrap" Margin="0,8,0,4"/>
   <!-- Chọn dịch vụ liên kết và ghi chú trước khi tải ảnh; vùng nhập bị khóa khi chỉ xem lịch sử. -->
   <StackPanel x:Name="UploadFields"><TextBlock Text="Gắn với dịch vụ chụp" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="ServicePicker" DisplayMemberPath="Label" SelectedValuePath="Value" MinWidth="220" AutomationProperties.Name="Dịch vụ chụp liên kết ảnh"/>
    <!-- Phân công kỹ thuật viên theo dịch vụ chụp; Assign_Click xử lý yêu cầu qua tầng nghiệp vụ. -->
    <StackPanel x:Name="AssignmentPanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock Text="Giao tải ảnh cho kỹ thuật viên" Style="{StaticResource FieldLabel}"/>
     <WrapPanel><ComboBox x:Name="TechnicianPicker" DisplayMemberPath="HoTen" SelectedValuePath="MaNV" MinWidth="220" AutomationProperties.Name="Nhân viên kỹ thuật được phân công"/><Button x:Name="AssignButton" Content="Giao dịch vụ chụp đã chọn" Click="Assign_Click" Margin="8,0,0,0"/></WrapPanel>
     <TextBlock Text="Chọn dịch vụ chụp đã ghi nhận ở bước Thực hiện; phân công ảnh giữ nguyên chứng từ dịch vụ." TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,0"/>
    </StackPanel>
    <TextBlock Text="Ghi chú cho ảnh tải lên" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/><TextBox x:Name="ImageNote" MaxLength="500" MinHeight="42" TextWrapping="Wrap" AcceptsReturn="True"/>
    <WrapPanel Margin="0,8,0,0"><Button x:Name="UploadButton" Content="Chọn ảnh và tải lên…" Click="Upload_Click" Style="{StaticResource HospitalPrimary}"/><TextBlock Text="JPG / JPEG / PNG / DICOM · tối đa 20 MiB" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
    <TextBlock Text="DICOM (.dcm, .dicom) được tự động chuyển sang PNG để hiển thị. Tệp nhiều khung sử dụng khung đầu tiên." TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,0"/>
   </StackPanel>
  </StackPanel></Border>
  <!-- Danh sách metadata bên trái và ảnh xem trước bên phải dùng chung lựa chọn ImageList. -->
  <Grid Grid.Row="1" Height="420" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="190"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="240"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource HospitalPanel}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <!-- Hiện metadata của ảnh đã ẩn khi được phép; nội dung ảnh ẩn không được đưa vào vùng xem trước. -->
    <CheckBox x:Name="ShowHidden" Content="Hiện cả metadata ảnh đã ẩn" Checked="Hidden_Changed" Unchecked="Hidden_Changed" Margin="4,4,4,10"/>
    <ListBox x:Name="ImageList" Grid.Row="1" SelectionChanged="Image_Changed" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Danh sách ảnh của lần khám"><ListBox.ItemTemplate><DataTemplate><Border Padding="8,10" BorderBrush="#DFE7EF" BorderThickness="0,0,0,1"><StackPanel>
      <TextBlock Text="{Binding Anh.TenTepGoc}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Anh.NgayTao,StringFormat=dd/MM/yyyy HH:mm:ss}" Foreground="#64748B"/><TextBlock Text="{Binding NguoiTai}" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding Anh.TrangThai}" Foreground="#1D4ED8" Margin="0,4,0,0"/>
    </StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource HospitalPanel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Xem trước ảnh được chọn" Style="{StaticResource HospitalSection}"/><TextBlock x:Name="SelectedCaption" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8"/></StackPanel>
    <Border Grid.Row="1" Background="#18232E" CornerRadius="8" MinHeight="150"><Image x:Name="SelectedPreview" Stretch="Uniform" MaxHeight="420" Margin="8" AutomationProperties.Name="Ảnh thu nhỏ đã kiểm toàn vẹn"/></Border>
    <!-- Xem lớn và ẩn ảnh đi qua code-behind để đọc lại quyền; ẩn vẫn giữ ảnh trong kho và lịch sử. -->
    <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="ViewButton" Content="Xem lớn / phóng thu" Click="View_Click"/><Button x:Name="HideButton" Content="Ẩn ảnh" Click="Hide_Click" Margin="8,0,0,0"/></WrapPanel>
   </Grid></Border>
  </Grid>
  <!-- Vùng thông báo kết quả, lỗi quyền hoặc lỗi truy cập kho ảnh. -->
  <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#9A3412" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
 </ScrollViewer>
</UserControl>
