<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RangHamMat.Views.ChinhSachLuong">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Chính sách lương và hoa hồng" Style="{StaticResource Title}" />
        <TextBlock Text="Quản lý phiên bản chính sách theo chức vụ và khoảng hiệu lực; bảng lương hiện có sẽ tham chiếu chính sách phù hợp." Style="{StaticResource Subtitle}" Margin="0,2,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Content="Mở bảng lương" Tag="MoTrang:BangLuong" VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="14" Padding="18">
        <StackPanel>
          <TextBlock Text="Phiên bản chính sách" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Lọc theo chức vụ và thời gian hiệu lực." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16" />
          <TextBlock Text="Chức vụ" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ComboBox SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="Tất cả chức vụ" /></ComboBox>
          <TextBlock Text="Trạng thái" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ComboBox SelectedIndex="0" Margin="0,0,0,16"><ComboBoxItem Content="Đang hiệu lực" /><ComboBoxItem Content="Chờ duyệt" /><ComboBoxItem Content="Hết hiệu lực" /></ComboBox>

          <Border Background="White" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,10">
            <StackPanel><TextBlock Text="Chính sách đang áp dụng" Foreground="#4338CA" FontWeight="SemiBold" /><TextBlock Text="Chưa có dữ liệu" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="Phiên bản và khoảng hiệu lực sẽ hiển thị tại đây." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
          </Border>
          <Border Background="#FFF7ED" CornerRadius="10" Padding="13" Margin="0,0,0,16"><TextBlock Text="Mỗi thay đổi chính sách nên tạo phiên bản mới để không ảnh hưởng lịch sử bảng lương." Foreground="#9A3412" TextWrapping="Wrap" /></Border>
          <Button Content="+ Tạo chính sách mới" Style="{StaticResource Primary}" Margin="0" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="14" Padding="18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Lương cơ bản" Foreground="#4F46E5" /><TextBlock Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Số ca định mức" Foreground="#4F46E5" /><TextBlock Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Cơ sở hoa hồng" Foreground="#4F46E5" /><TextBlock Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Grid.Column="6"><TextBlock Text="Tỷ lệ hoa hồng" Foreground="#4F46E5" /><TextBlock Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="20,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Danh sách chính sách" Style="{StaticResource SectionTitle}" /><TextBlock Text="Các phiên bản cũ vẫn được giữ để đối chiếu lịch sử." Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
                <TextBox Grid.Column="1" Margin="10,0" ToolTip="Tìm tên chính sách hoặc phiên bản" />
                <ComboBox Grid.Column="2" SelectedIndex="0"><ComboBoxItem Content="Mới nhất trước" /><ComboBoxItem Content="Cũ nhất trước" /></ComboBox>
              </Grid>
            </Border>
            <DataGrid x:Name="Grid_CHINH_SACH_LUONG" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã chính sách" Binding="{Binding MaCSL}" Width="130" />
                <DataGridTextColumn Header="Chức vụ" Binding="{Binding MaChucVu}" Width="120" />
                <DataGridTextColumn Header="Tên chính sách" Binding="{Binding TenChinhSach}" Width="190" />
                <DataGridTextColumn Header="Phiên bản" Binding="{Binding PhienBan}" Width="110" />
                <DataGridTextColumn Header="Ngày hiệu lực" Binding="{Binding NgayHieuLuc}" Width="130" />
                <DataGridTextColumn Header="Ngày hết hiệu lực" Binding="{Binding NgayHetHieuLuc}" Width="150" />
                <DataGridTextColumn Header="Lương cơ bản" Binding="{Binding LuongCoBan}" Width="140" />
                <DataGridTextColumn Header="Số ca định mức" Binding="{Binding SoCaDinhMuc}" Width="135" />
                <DataGridTextColumn Header="Cơ sở hoa hồng" Binding="{Binding CoSoHoaHong}" Width="155" />
                <DataGridTextColumn Header="Tỷ lệ hoa hồng" Binding="{Binding TyLeHoaHong}" Width="145" />
                <DataGridTextColumn Header="Người duyệt" Binding="{Binding MaNVDuyet}" Width="125" />
                <DataGridTextColumn Header="Ngày duyệt" Binding="{Binding NgayDuyet}" Width="125" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
