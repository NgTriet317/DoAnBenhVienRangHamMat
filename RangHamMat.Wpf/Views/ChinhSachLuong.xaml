<UserControl x:Class="RangHamMat.Views.ChinhSachLuong"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Background="#F6F7F7">
  <UserControl.Resources>
    <Style x:Key="NhomNhap" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#4D6370"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="NhapLuong" TargetType="TextBox">
      <Setter Property="Height" Value="37"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D4DFE0"/>
    </Style>
  </UserControl.Resources>
  <Grid MinWidth="940" Margin="20,14,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#182E40" CornerRadius="13" Padding="24,18" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Chính sách lương theo chức vụ" FontWeight="Bold" FontSize="24" Foreground="White"/>
          <TextBlock Text="Cấu hình đơn giá ca, lương cơ bản tháng và hoa hồng theo phiên bản" Foreground="#BDCED7" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="btnLamMoi" Content="Tải lại" Click="LamMoi_Click" Padding="16,9" Margin="0,0,8,0"/>
          <Button x:Name="btnTaoPhienBan" Content="+ Phiên bản mới" Click="TaoPhienBan_Click"
                  Background="#E5B66F" BorderThickness="0" Foreground="#17283B" Padding="16,9" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#E2E8E8" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Các phiên bản đã lưu" FontWeight="Bold" Foreground="#173C46" FontSize="19" Margin="0,0,0,12"/>
          <TextBox x:Name="txtTimChinhSach" Grid.Row="1" Margin="0,0,0,12" Padding="9,8"
                   TextChanged="TimChinhSach_TextChanged" ToolTip="Tìm mã, tên chính sách hoặc chức vụ"/>
          <DataGrid x:Name="gridChinhSach" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                    RowHeaderWidth="0" GridLinesVisibility="None" RowHeight="39"
                    SelectionChanged="gridChinhSach_SelectionChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="CHỨC VỤ" Binding="{Binding TenChucVu}" Width="1.1*"/>
              <DataGridTextColumn Header="CHÍNH SÁCH" Binding="{Binding TenChinhSach}" Width="1.5*"/>
              <DataGridTextColumn Header="V" Binding="{Binding PhienBan}" Width="38"/>
              <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding TrangThai}" Width="85"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#E2E8E8" Padding="20,17">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel LastChildFill="False" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock x:Name="lblTieuDe" Text="Tạo chính sách mới" FontSize="20" FontWeight="Bold" Foreground="#173C46"/>
              <TextBlock x:Name="lblTrangThai" Text="BẢN NHÁP" Foreground="#27766B" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Tên chính sách *" Style="{StaticResource NhomNhap}"/>
              <TextBox x:Name="txtTenChinhSach" Style="{StaticResource NhapLuong}" MaxLength="255"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Chức vụ áp dụng *" Style="{StaticResource NhomNhap}"/>
                  <ComboBox x:Name="cboChucVuChinhSach" Height="37" Margin="0,0,0,14"
                            DisplayMemberPath="TenChucVu" SelectedValuePath="MaChucVu"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Hiệu lực từ ngày 01 *" Style="{StaticResource NhomNhap}"/>
                  <DatePicker x:Name="dpHieuLuc" Height="37" Margin="0,0,0,14"/>
                </StackPanel>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Đơn giá 1 ca (đồng)" Style="{StaticResource NhomNhap}"/>
                  <TextBox x:Name="txtDonGiaCa" Style="{StaticResource NhapLuong}" ToolTip="Để trống để dùng cách tính theo lương tháng"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Lương cơ bản tháng (đồng) *" Style="{StaticResource NhomNhap}"/>
                  <TextBox x:Name="txtLuongCoBan" Style="{StaticResource NhapLuong}"/>
                </StackPanel>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Số ca định mức (tham khảo)" Style="{StaticResource NhomNhap}"/>
                  <TextBox x:Name="txtSoCaDinhMuc" Style="{StaticResource NhapLuong}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Phụ cấp cố định (đồng)" Style="{StaticResource NhomNhap}"/>
                  <TextBox x:Name="txtPhuCap" Style="{StaticResource NhapLuong}"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="Hoa hồng trên giá trị dịch vụ đã đủ điều kiện (%)" Style="{StaticResource NhomNhap}"/>
              <TextBox x:Name="txtTyLeHoaHong" Style="{StaticResource NhapLuong}" ToolTip="Ví dụ nhập 10 để hưởng 10%"/>
              <Border Background="#EDF4F3" CornerRadius="8" Padding="13,11" Margin="0,0,0,13">
                <StackPanel>
                  <TextBlock Text="Quy tắc tính lương" FontWeight="SemiBold" Foreground="#17665D"/>
                  <TextBlock Text="1 ca được xác nhận = 0,5 công. Nếu có đơn giá ca, hệ thống nhân công với 2 × đơn giá ca. Mỗi ngày phép năm được hưởng 0,5 công theo chính sách đã thống nhất."
                             TextWrapping="Wrap" Foreground="#3B5960" Margin="0,5,0,0"/>
                  <TextBlock Text="Hoa hồng chỉ lấy từ dịch vụ đã xác nhận và hóa đơn đã thu đủ. Chính sách đã duyệt không sửa trực tiếp; tạo phiên bản mới."
                             TextWrapping="Wrap" Foreground="#3B5960" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="lblThongBao" Text="Chọn phiên bản hoặc tạo chính sách mới." TextWrapping="Wrap" Foreground="#647985"/>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnLuuNhap" Content="Lưu bản nháp" Click="LuuNhap_Click"
                    Margin="0,0,10,0" Padding="19,10" Background="#DCEAE7" Foreground="#216859" BorderThickness="0"/>
            <Button x:Name="btnDuyet" Content="Duyệt / áp dụng" Click="Duyet_Click"
                    Padding="20,10" Background="#176D62" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
