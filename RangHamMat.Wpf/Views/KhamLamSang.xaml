<UserControl xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow" clinical:ClinicalLayout.IsEnabled="True" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.KhamLamSang" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Language="vi-VN">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource HospitalPanel}" Margin="0,0,0,12"><StackPanel>
      <DockPanel><Button Content="← Quay lại" Click="Back_Click" DockPanel.Dock="Right"/><TextBlock x:Name="PatientHeader" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
      <TextBlock x:Name="ClinicalIdentity" Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="SafetyHeader" Margin="0,6,0,0" Foreground="#9A3412" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <TabControl x:Name="ClinicalTabs" Grid.Row="1">
      <TabItem Header="Khám và chẩn đoán"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ClinicalInputPanel" Margin="12">
        <TextBlock Text="Triệu chứng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SymptomsEditor" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Clinical_Changed"/>
        <TextBlock Text="Chẩn đoán do bác sĩ ghi nhận" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/><TextBox x:Name="DiagnosisEditor" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Clinical_Changed"/>
        <TextBlock Text="Xử trí / định hướng điều trị" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/><TextBox x:Name="TreatmentEditor" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Clinical_Changed"/>
        <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/><TextBox x:Name="ClinicalNote" MinHeight="45" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Clinical_Changed"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Tình trạng bệnh"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <TextBlock Text="Ghi nhận tình trạng bệnh" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Nhập tình trạng, bổ sung mô tả hoặc vị trí nếu cần rồi Thêm/Cập nhật. Có thể bấm Lưu nháp để lưu ngay nội dung đang nhập." TextWrapping="Wrap" Margin="0,6,0,12"/>
        <StackPanel x:Name="ConditionInputPanel">
          <TextBlock Text="Tình trạng *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ConditionNameEditor" MaxLength="255" TextChanged="ConditionInput_Changed"/>
          <TextBlock Text="Mô tả (không bắt buộc)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox x:Name="ConditionDetailEditor" MinHeight="60" MaxHeight="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ConditionInput_Changed"/>
          <TextBlock Text="Vị trí răng / vùng ghi nhận" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox x:Name="ConditionLocationEditor" MaxLength="100" TextChanged="ConditionInput_Changed"/>
          <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox x:Name="ConditionNoteEditor" MinHeight="40" MaxHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ConditionInput_Changed"/>
          <WrapPanel Margin="0,12,0,12"><Button x:Name="AddConditionButton" Content="Thêm tình trạng" Click="AddCondition_Click"/><Button x:Name="UpdateConditionButton" Content="Cập nhật dòng chọn" Click="UpdateCondition_Click" Margin="8,0,0,0"/><Button x:Name="DeleteConditionButton" Content="Xóa dòng chọn" Click="DeleteCondition_Click" Margin="8,0,0,0"/><Button x:Name="ClearConditionButton" Content="Bỏ nhập / Nhập mới" Click="ClearCondition_Click" Margin="8,0,0,0"/></WrapPanel>
        </StackPanel>
        <TextBlock x:Name="ConditionCount" FontWeight="SemiBold" Margin="0,4,0,8"/>
        <ListBox x:Name="ConditionList" SelectionChanged="Condition_Selected" MinHeight="120" MaxHeight="280" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" BorderBrush="#DFE8F3" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding LoaiTinhTrang}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding MoTaTinhTrang}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding ViTriRang}" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding GhiChu}" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      </StackPanel></ScrollViewer></TabItem>

      <TabItem Header="Kế hoạch điều trị"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <WrapPanel><Button x:Name="NewPlanButton" Content="Kế hoạch mới" Click="NewPlan_Click"/><Button Content="Tải lại (bỏ thay đổi chưa lưu)" Click="Reload_Click"/></WrapPanel>
        <ComboBox x:Name="PlanPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Plan_Changed" MinHeight="36" Margin="0,10,0,0"/>
        <TextBlock x:Name="PlanIdentity" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,8"/>
        <StackPanel x:Name="PlanFields">
          <WrapPanel Margin="0,10,0,0"><StackPanel Margin="0,0,12,0"><TextBlock Text="Bắt đầu dự kiến"/><DatePicker x:Name="PlanStart" SelectedDateChanged="Plan_FieldChanged"/></StackPanel><StackPanel><TextBlock Text="Kết thúc dự kiến"/><DatePicker x:Name="PlanEnd" SelectedDateChanged="Plan_FieldChanged"/></StackPanel></WrapPanel>
          <TextBlock Text="Ghi chú kế hoạch" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox x:Name="PlanNote" TextChanged="Plan_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45"/>
        </StackPanel>
        <DataGrid x:Name="PlanSteps" AutoGenerateColumns="False" MinHeight="180" MaxHeight="330" CanUserAddRows="True" CellEditEnding="Plan_Edit" Margin="0,10,0,0"><DataGrid.Columns>
          <DataGridComboBoxColumn x:Name="PlanServiceColumn" Header="Dịch vụ" SelectedValueBinding="{Binding MaDV}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200"/>
          <DataGridTextColumn Header="Buổi" Binding="{Binding LanThu, ValidatesOnExceptions=True}" Width="65"/><DataGridTextColumn Header="Lượng dự kiến" Binding="{Binding SoLuongDuKien, ValidatesOnExceptions=True}" Width="105"/>
          <DataGridTextColumn Header="Giá dự kiến" Binding="{Binding DonGiaDuKien, ValidatesOnExceptions=True}" Width="110"/><DataGridTextColumn Header="Nội dung bước" Binding="{Binding NoiDungBuoc}" Width="250"/>
        </DataGrid.Columns></DataGrid>
        <TextBlock Text="Dự kiến chưa phải dịch vụ đã thực hiện. Duyệt kế hoạch không lập hóa đơn hoặc trừ kho." Foreground="#9A3412" TextWrapping="Wrap" Margin="0,8,0,8"/>
        <WrapPanel><Button x:Name="CancelPlanButton" Content="Hủy kế hoạch nháp" Click="CancelPlan_Click"/><Button x:Name="SavePlanButton" Content="Lưu nháp kế hoạch" Click="SavePlan_Click"/><Button x:Name="ConfirmPlanButton" Content="Xác nhận kế hoạch" Click="ConfirmPlan_Click"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Tổng kết"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <TextBlock Text="Đối chiếu trước khi hoàn tất chuyên môn" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Cần triệu chứng, chẩn đoán, xử trí và tình trạng. Xử lý đơn/dịch vụ/kế hoạch còn nháp; các bước tương lai đã duyệt được để chưa thực hiện." TextWrapping="Wrap" Margin="0,10,0,16"/>
        <StackPanel x:Name="PrescriptionDecision"><CheckBox x:Name="NoPrescription" Content="Không kê thuốc" Checked="Clinical_Changed" Unchecked="Clinical_Changed"/>
          <TextBlock Text="Lý do không kê thuốc" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox x:Name="NoPrescriptionReason" MaxLength="500" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding IsChecked,ElementName=NoPrescription}" TextChanged="Clinical_Changed"/>
        </StackPanel>
        <WrapPanel Margin="0,16,0,0"><Button x:Name="OpenServicesButton" Content="Mở dịch vụ thực hiện" Click="Services_Click"/><Button x:Name="OpenPrescriptionButton" Content="Mở đơn thuốc" Click="Prescription_Click"/></WrapPanel>
        <TextBlock Text="Lưu nháp trước khi chuyển chức năng. Hoàn tất sẽ khóa nội dung chuyên môn và chuyển phiếu sang Chờ thanh toán." TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="0,10,0,0"><StackPanel><TextBlock x:Name="ClinicalError" Foreground="#B42318" TextWrapping="Wrap"/><TextBlock x:Name="ClinicalStatus" Foreground="#15803D" TextWrapping="Wrap" Margin="0,5,0,8"/>
      <WrapPanel HorizontalAlignment="Right"><Button Content="Tải lại (bỏ nháp đang nhập)" Click="Reload_Click"/><Button x:Name="SaveClinicalButton" Content="Lưu nháp" Click="Save_Click"/><Button x:Name="CompleteClinicalButton" Content="Hoàn tất chuyên môn" Click="Complete_Click" Style="{StaticResource HospitalPrimary}"/></WrapPanel>
    </StackPanel></Border>
  </Grid>
</UserControl>
