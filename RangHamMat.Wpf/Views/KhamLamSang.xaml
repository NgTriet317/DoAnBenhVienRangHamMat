<!-- Giao diện KhamLamSang: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow" clinical:ClinicalLayout.IsEnabled="True" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.KhamLamSang" Background="#F4F7FB" FontFamily="Segoe UI" FontSize="14" Foreground="#21344B" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalEditorStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
   <clinical:ClinicalDecimalConverter x:Key="ClinicalDecimal"/>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="0">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Border x:Name="ClinicalHeader" Style="{StaticResource Card}" Padding="16,14">
   <StackPanel>
    <DockPanel>
     <Button x:Name="BackToQueueButton" Content="← Hàng chờ" Click="Back_Click"
             DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0"
             ToolTip="Quay lại danh sách người bệnh sau khi lưu nội dung đang nhập."/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="42" Height="42" CornerRadius="12" Background="#EAF2FF"
              VerticalAlignment="Top" Margin="0,2,12,0">
       <Path Data="M 12,2 A 5,5 0 1 1 12,12 A 5,5 0 1 1 12,2 M 3,24 C 3,13 21,13 21,24"
             Stroke="#2468CD" StrokeThickness="1.8" Width="24" Height="26" Stretch="Uniform"
             HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1">
       <WrapPanel>
        <TextBlock Text="HỒ SƠ KHÁM BỆNH" FontSize="10" FontWeight="SemiBold"
                   Foreground="#64758A" VerticalAlignment="Center" Margin="0,0,10,3"/>
        <Border Background="#EAF2FF" CornerRadius="4" Padding="7,2" Margin="0,0,0,3">
         <TextBlock x:Name="VisitStateText" FontSize="10" Foreground="#1D5AAC" FontWeight="SemiBold"/>
        </Border>
       </WrapPanel>
       <TextBlock x:Name="PatientHeader" FontSize="22" FontWeight="SemiBold"
                  TextWrapping="Wrap" Margin="0,2,0,0"/>
       <TextBlock x:Name="PatientDemographics" FontSize="12" Foreground="#52657D"
                  TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
     </Grid>
    </DockPanel>
    <TextBlock x:Name="ClinicalIdentity" FontSize="12" Foreground="#64758A"
               TextWrapping="Wrap" Margin="0,9,0,0"/>
    <Border x:Name="ClinicalSafetyPanel" Background="#FFF8E8" BorderBrush="#F2DFB4"
            BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,10,0,0">
     <DockPanel>
      <TextBlock Text="LƯU Ý" FontSize="10" FontWeight="Bold" Foreground="#946200"
                 Margin="0,2,10,0" VerticalAlignment="Top"/>
      <TextBlock x:Name="SafetyHeader" FontSize="12" Foreground="#805911"
                 TextWrapping="Wrap" LineHeight="19"/>
     </DockPanel>
    </Border>
   </StackPanel>
  </Border>
  <!-- Thành phần ClinicalTabs. Chuyển sự kiện đến ClinicalTabs_Changed trong code-behind. -->
  <TabControl x:Name="ClinicalTabs" Grid.Row="1" Style="{StaticResource ClinicalStepTabs}" SelectionChanged="ClinicalTabs_Changed">
   <!-- Vùng bố cục ClinicalInputPanel. -->
   <TabItem Header="Khám" Tag="1" ToolTip="Ghi nhận triệu chứng, chẩn đoán và hướng xử trí.">
    <ScrollViewer x:Name="ExaminationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="ClinicalInputPanel">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="Khám và chẩn đoán" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Ghi nhận kết quả thăm khám, sau đó lưu nháp để tiếp tục điều trị."
                   Style="{StaticResource SectionDescription}"/>
        <clinical:ClinicalFieldsPanel>
         <StackPanel>
          <TextBlock Text="Triệu chứng" Style="{StaticResource FieldLabel}"/>
          <ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="SymptomsEditor" Tag="DB:LICH_SU_KHAM_BENH.TrieuChung" Style="{StaticResource ClinicalNotesInput}"
                   TextChanged="Clinical_Changed" AutomationProperties.Name="Triệu chứng"/></ContentControl>
         </StackPanel>
         <StackPanel>
          <TextBlock Text="Chẩn đoán" Style="{StaticResource FieldLabel}"/>
          <ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="DiagnosisEditor" Tag="DB:LICH_SU_KHAM_BENH.ChanDoan" Style="{StaticResource ClinicalNotesInput}"
                   TextChanged="Clinical_Changed" AutomationProperties.Name="Chẩn đoán"/></ContentControl>
         </StackPanel>
        </clinical:ClinicalFieldsPanel>
        <StackPanel Margin="0,16,0,0">
         <TextBlock Text="Xử trí / hướng điều trị" Style="{StaticResource FieldLabel}"/>
         <ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="TreatmentEditor" Tag="DB:LICH_SU_KHAM_BENH.KeHoachXuLy" Style="{StaticResource ClinicalNotesInput}"
                  MinHeight="86" TextChanged="Clinical_Changed" AutomationProperties.Name="Xử trí và hướng điều trị"/></ContentControl>
        </StackPanel>
        <Expander Header="Ghi chú thêm" Margin="0,14,0,0">
         <ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="ClinicalNote" Tag="DB:LICH_SU_KHAM_BENH.GhiChu" Style="{StaticResource ClinicalNotesInput}"
                  MinHeight="64" Margin="0,8,0,0" TextChanged="Clinical_Changed"
                  AutomationProperties.Name="Ghi chú lần khám"/></ContentControl>
        </Expander>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Điều trị" Tag="2" ToolTip="Ghi nhận tình trạng bệnh và chọn dịch vụ liên quan."><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ghi nhận tình trạng" Style="{StaticResource SectionTitle}"/><TextBlock Text="Chọn từ danh mục hoặc nhập tình trạng, rồi thêm vào danh sách của lần khám." Style="{StaticResource SectionDescription}"/>
     <!-- Vùng bố cục ConditionInputPanel. -->
     <StackPanel x:Name="ConditionInputPanel">
      <!-- Trường lựa chọn ConditionReferencePicker. Chuyển sự kiện đến Reference_Selected trong code-behind. -->
      <TextBlock Text="Chọn nhanh" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ConditionReferencePicker" DisplayMemberPath="TenTinhTrang" TextSearch.TextPath="TenTinhTrang" IsTextSearchEnabled="True" MaxDropDownHeight="360" SelectionChanged="Reference_Selected"><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1D4ED8" Background="#EFF6FF" Padding="8" Margin="0,6,0,2"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle></ComboBox>
      <!-- Ô nhập ConditionNameEditor. Chuyển sự kiện đến ConditionInput_Changed trong code-behind. -->
      <TextBlock Text="Tên tình trạng *" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="ConditionNameEditor" Tag="DB:TINH_TRANG_BENH.LoaiTinhTrang" TextChanged="ConditionInput_Changed"/></ContentControl>
      <Expander Header="Mô tả và ghi chú" Margin="0,10,0,0"><StackPanel>
       <!-- Ô nhập ConditionDetailEditor. Chuyển sự kiện đến ConditionInput_Changed trong code-behind. -->
       <TextBlock Text="Mô tả" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="ConditionDetailEditor" AutomationProperties.Name="Mô tả tình trạng (tùy chọn)" MinHeight="50" MaxHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ConditionInput_Changed"/></ContentControl>
       <!-- Ô nhập ConditionNoteEditor. Chuyển sự kiện đến ConditionInput_Changed trong code-behind. -->
       <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/><ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="ConditionNoteEditor" Tag="DB:TINH_TRANG_BENH.GhiChu" MinHeight="40" MaxHeight="70" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="ConditionInput_Changed"/></ContentControl>
      </StackPanel></Expander>
      <!-- Nút thao tác AddConditionButton — + Thêm. Chuyển sự kiện đến AddCondition_Click trong code-behind. -->
      <WrapPanel Margin="0,12,0,0"><Button x:Name="AddConditionButton" Content="+ Thêm tình trạng" Click="AddCondition_Click" Style="{StaticResource ClinicalPrimary}"/><Button x:Name="UpdateConditionButton" Content="Cập nhật" Click="UpdateCondition_Click"/><Button x:Name="DeleteConditionButton" Content="Xóa" Click="DeleteCondition_Click"/><Button x:Name="ClearConditionButton" Content="Nhập mới" Click="ClearCondition_Click"/></WrapPanel>
     </StackPanel>
     <!-- Thông tin hiển thị ConditionCount. -->
     <TextBlock x:Name="ConditionCount" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,12,0,5"/>
     <!-- Danh sách ConditionList. Chuyển sự kiện đến Condition_Selected trong code-behind. -->
     <ListBox x:Name="ConditionList" SelectionChanged="Condition_Selected" MinHeight="45" MaxHeight="150" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="8" Background="#F8FAFC" CornerRadius="6" Margin="0,2"><StackPanel><TextBlock Text="{Binding LoaiTinhTrang}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding MoTaTinhTrang}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding GhiChu}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dịch vụ theo tình trạng" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ConditionRecommendation" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,10"/>
     <!-- Thành phần RelatedServicesList. -->
     <ItemsControl x:Name="RelatedServicesList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><CheckBox IsChecked="{Binding Chon,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="ServiceChoice_Click" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"><StackPanel Margin="8,0,0,0"><TextBlock Text="{Binding DichVu.TenDV}" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel Margin="0,5,0,0"><TextBlock Text="{Binding GiaHienThi}" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,12,0"/><TextBlock Text="{Binding DichVu.MaDV}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="{Binding DichVu.NoiDungDeXuat}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <!-- Thông tin hiển thị SelectedServicesSummary. -->
     <TextBlock x:Name="SelectedServicesSummary" FontWeight="SemiBold" Margin="0,8"/><Button x:Name="UseRecommendationButton" Content="Lập kế hoạch từ dịch vụ đã chọn →" Click="UseRecommendation_Click" Style="{StaticResource ClinicalPrimary}" HorizontalAlignment="Left"/>
     <!-- Thông tin hiển thị ConditionReferenceText. -->
     <Expander Header="Định hướng tham khảo" Margin="0,12,0,0"><TextBlock x:Name="ConditionReferenceText" TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,8"/></Expander>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Kế hoạch" Tag="3" ToolTip="Lập, lưu và duyệt các bước điều trị dự kiến."><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <!-- Nút thao tác NewPlanButton — + Kế hoạch mới. Chuyển sự kiện đến NewPlan_Click trong code-behind. -->
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button x:Name="NewPlanButton" Content="+ Kế hoạch mới" Click="NewPlan_Click" DockPanel.Dock="Right"/><TextBlock Text="Kế hoạch điều trị" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="Chọn dịch vụ, số lượng và buổi điều trị; lưu kế hoạch trước khi duyệt." Style="{StaticResource SectionDescription}"/>
     <!-- Trường lựa chọn PlanPicker. Chuyển sự kiện đến Plan_Changed trong code-behind. -->
     <ComboBox x:Name="PlanPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Plan_Changed" MinHeight="36" Margin="0,8,0,0"/>
     <!-- Thông tin hiển thị PlanIdentity. -->
     <TextBlock x:Name="PlanIdentity" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,8"/>
     <!-- Vùng bố cục PlanFields. -->
     <StackPanel x:Name="PlanFields"><Expander Header="Lịch dự kiến và ghi chú"><StackPanel>
      <!-- Trường lựa chọn PlanStart. Chuyển sự kiện đến Plan_FieldChanged trong code-behind. -->
      <WrapPanel Margin="0,10"><StackPanel Margin="0,0,12,0"><TextBlock Text="Ngày bắt đầu"/><ContentControl Style="{StaticResource TruongNhapLieu}"><DatePicker x:Name="PlanStart" Tag="DB:KE_HOACH_DIEU_TRI.NgayBatDau" SelectedDateChanged="Plan_FieldChanged"/></ContentControl></StackPanel><StackPanel><TextBlock Text="Ngày kết thúc"/><ContentControl Style="{StaticResource TruongNhapLieu}"><DatePicker x:Name="PlanEnd" Tag="DB:KE_HOACH_DIEU_TRI.NgayDuKienKetThuc" SelectedDateChanged="Plan_FieldChanged"/></ContentControl></StackPanel></WrapPanel>
      <!-- Ô nhập PlanNote. Chuyển sự kiện đến Plan_TextChanged trong code-behind. -->
      <ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="PlanNote" Tag="DB:KE_HOACH_DIEU_TRI.GhiChu" TextChanged="Plan_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45"/></ContentControl>
     </StackPanel></Expander></StackPanel>
     <!-- Danh sách PlanSteps. -->
     <ContentControl Style="{StaticResource TruongNhapLieu}"><DataGrid x:Name="PlanSteps" FrozenColumnCount="0" EnableColumnVirtualization="False" AutoGenerateColumns="False" MinHeight="140" MaxHeight="360" CanUserAddRows="True" CellEditEnding="Plan_Edit" SizeChanged="PlanSteps_SizeChanged" RowDetailsVisibilityMode="VisibleWhenSelected" Margin="0,12,0,0" MinRowHeight="44" GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8FAFC"><DataGrid.Columns>
      <!-- Thành phần PlanServiceColumn — Dịch vụ. -->
      <DataGridTemplateColumn x:Name="PlanServiceColumn" Header="Dịch vụ" SortMemberPath="MaDV" Width="2*" MinWidth="140">
       <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{DynamicResource PlanServiceChoices}" SelectedValue="{Binding MaDV,Mode=OneWay}" SelectedValuePath="Value" DisplayMemberPath="Label" IsHitTestVisible="False" Focusable="False"><ComboBox.Template><ControlTemplate TargetType="ComboBox"><TextBlock Text="{Binding SelectedItem.Label,RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" VerticalAlignment="Center"/></ControlTemplate></ComboBox.Template></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate>
       <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ContentControl Style="{StaticResource TruongNhapLieu}"><ComboBox Tag="DB:CHI_TIET_KE_HOACH.MaDV" ItemsSource="{DynamicResource PlanServiceChoices}" SelectedValue="{Binding MaDV,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectionChanged="PlanService_Selected" AutomationProperties.Name="Dịch vụ trong kế hoạch"/></ContentControl></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="SL" SortMemberPath="SoLuongDuKien" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SoLuongDuKien,StringFormat=0.###}" Style="{StaticResource ClinicalTableText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox Tag="DB:CHI_TIET_KE_HOACH.SoLuongDuKien" Text="{Binding SoLuongDuKien,Converter={StaticResource ClinicalDecimal},ValidatesOnExceptions=True,UpdateSourceTrigger=PropertyChanged}"/></ContentControl></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Buổi" SortMemberPath="LanThu" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LanThu}" Style="{StaticResource ClinicalTableText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox Tag="DB:CHI_TIET_KE_HOACH.LanThu" Text="{Binding LanThu,ValidatesOnExceptions=True,UpdateSourceTrigger=PropertyChanged}"/></ContentControl></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
      <DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Đơn giá (đ)" Binding="{Binding DonGiaDuKien,StringFormat=N0}" IsReadOnly="True" Width="105"/>
      <DataGridTemplateColumn Header="Nội dung thực hiện" SortMemberPath="NoiDungBuoc" Width="2*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NoiDungBuoc}" Style="{StaticResource ClinicalTableText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox Tag="DB:CHI_TIET_KE_HOACH.NoiDungBuoc" Text="{Binding NoiDungBuoc,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/></ContentControl></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
     <!-- Ô nhập TextBox. Chuyển sự kiện đến PlanRowNote_Changed trong code-behind. -->
     </DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><Border Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=DataGrid}}" Padding="12,6,12,12"><StackPanel><TextBlock Text="Nội dung thực hiện" FontSize="12" Foreground="#64748B"/><ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox Tag="DB:CHI_TIET_KE_HOACH.NoiDungBuoc" Text="{Binding NoiDungBuoc,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly,RelativeSource={RelativeSource AncestorType=DataGrid}}" TextChanged="PlanRowNote_Changed" MinHeight="45" TextWrapping="Wrap" AcceptsReturn="True"/></ContentControl></StackPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid></ContentControl>
     <!-- Thông tin hiển thị PlanTotal. -->
     <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,12"><TextBlock x:Name="PlanTotal" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#1D4ED8"/></Border>
     <TextBlock Text="Giá lấy từ danh mục dịch vụ. Kế hoạch dự kiến chưa phát sinh khoản thu." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <!-- Nút thao tác SavePlanButton — Lưu kế hoạch. Chuyển sự kiện đến SavePlan_Click trong code-behind. -->
     <WrapPanel><Button x:Name="SavePlanButton" Content="Lưu kế hoạch" Click="SavePlan_Click" Style="{StaticResource ClinicalPrimary}"/><Button x:Name="ConfirmPlanButton" Content="Duyệt kế hoạch" Click="ConfirmPlan_Click"/><Button x:Name="RefreshPlanPricesButton" Content="Cập nhật giá" Click="RefreshPlanPrices_Click"/><Button x:Name="CancelPlanButton" Content="Hủy nháp" Click="CancelPlan_Click"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Thực hiện" Tag="4" ToolTip="Đối chiếu và xác nhận những dịch vụ đã thực hiện."><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Thực hiện kế hoạch điều trị" Style="{StaticResource SectionTitle}"/><TextBlock Text="Đối chiếu các dịch vụ đã duyệt. Chỉ xác nhận sau khi đã làm xong toàn bộ khám và điều trị trong lần khám này." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/>
    <!-- Danh sách ExecutionPlanGrid. -->
    <DataGrid x:Name="ExecutionPlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="100" MaxHeight="300"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Dịch vụ theo kế hoạch" Binding="{Binding DichVu}" Width="*" MinWidth="180"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Buổi" Binding="{Binding LanThu}" Width="60"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="SL" Binding="{Binding SoLuongDuKien}" Width="60"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Đơn giá" Binding="{Binding DonGiaDuKien,StringFormat=N0}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Trạng thái" Binding="{Binding TrangThai}" Width="160"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Nếu không có kế hoạch thủ thuật, bước này xác nhận dịch vụ khám trên phiếu tiếp nhận." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12"/>
    <!-- Thành phần ExecutionAcknowledged — Tôi xác nhận đã thực hiện xong các dịch vụ trên. -->
    <ContentControl Style="{StaticResource TruongNhapLieu}"><CheckBox x:Name="ExecutionAcknowledged" Checked="ExecutionAcknowledged_Changed" Margin="0,8"><TextBlock Text="Tôi xác nhận đã thực hiện xong các dịch vụ trên" TextWrapping="Wrap"/></CheckBox></ContentControl><Button x:Name="ExecutePlanButton" Content="Xác nhận thực hiện → Kê thuốc" Click="ExecutePlan_Click" HorizontalAlignment="Left" Style="{StaticResource ClinicalPrimary}" Margin="0,8"/>
    <!-- Thông tin hiển thị ExecutionStatusText. -->
    <TextBlock x:Name="ExecutionStatusText" TextWrapping="Wrap" Foreground="#15803D" Margin="0,10"/>
   </StackPanel></Border></ScrollViewer></TabItem>
   <!-- Thành phần PrescriptionTab — 5. Kê thuốc. -->
   <TabItem x:Name="PrescriptionTab" Header="Kê thuốc" Tag="5" ToolTip="Lập danh sách thuốc hoặc ghi nhận lý do không kê thuốc."><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <!-- Vùng bố cục PrescriptionDecision. -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel x:Name="PrescriptionDecision"><CheckBox x:Name="NoPrescription" Checked="Clinical_Changed" Unchecked="Clinical_Changed"><TextBlock Text="Không kê thuốc trong lần khám này" TextWrapping="Wrap"/></CheckBox><StackPanel Margin="0,8,0,0" Visibility="{Binding IsChecked,ElementName=NoPrescription,Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Lý do không kê thuốc" Style="{StaticResource FieldLabel}"/><ContentControl Style="{StaticResource TruongNhapLieu}"><TextBox x:Name="NoPrescriptionReason" Tag="DB:LICH_SU_KHAM_BENH.LyDoKhongKeThuoc" MinHeight="45" TextWrapping="Wrap" TextChanged="Clinical_Changed"/></ContentControl></StackPanel><TextBlock x:Name="PrescriptionStageText" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/></StackPanel></Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <!-- Nút thao tác PrescribeButton — Kê thuốc. Chuyển sự kiện đến Prescribe_Click trong code-behind. -->
     <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel><WrapPanel><Button x:Name="PrescribeButton" Content="Kê thuốc" Click="Prescribe_Click" Style="{StaticResource ClinicalPrimary}"/><Button x:Name="ReviewPrescriptionButton" Content="Sang tổng kết →" Click="ReviewPrescription_Click"/></WrapPanel><TextBlock x:Name="PrescriptionPreviewHint" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/></StackPanel></Border>
     <!-- Danh sách PrescriptionPreviewList. -->
     <Border Grid.Row="1" Style="{StaticResource Card}"><DataGrid x:Name="PrescriptionPreviewList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Thuốc" Binding="{Binding TenThuoc}" Width="210"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Hàm lượng" Binding="{Binding HamLuong}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="SL" Binding="{Binding SoLuong,StringFormat=0.###}" Width="60"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Đơn vị" Binding="{Binding DonViTinh}" Width="70"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Số ngày" Binding="{Binding SoNgayDung}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Liều dùng" Binding="{Binding LieuDung}" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Đường dùng" Binding="{Binding DuongDung}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Hướng dẫn sử dụng" Binding="{Binding HuongDan}" Width="240"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/></DataGrid.Columns></DataGrid></Border>
     <!-- Thành phần PrescriptionHost. -->
     <ContentControl x:Name="PrescriptionHost" Visibility="Collapsed"/>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="Tổng kết" Tag="6" ToolTip="Kiểm tra dịch vụ và thuốc trước khi chốt lần khám."><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Kiểm tra trước khi lập hóa đơn" Style="{StaticResource SectionTitle}"/><TextBlock Text="Kiểm tra dịch vụ đã thực hiện và thuốc đã xác nhận. Chốt lần khám sẽ ký các đơn nháp và lập hóa đơn." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/>
    <TextBlock Text="Dịch vụ đã thực hiện" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <!-- Danh sách CompletionServicesList. -->
    <DataGrid x:Name="CompletionServicesList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="100" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Dịch vụ" Binding="{Binding TenDV}" Width="260"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="SL" Binding="{Binding SoLuong,StringFormat=0.###}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Đơn giá" Binding="{Binding DonGia,StringFormat=N0}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Thành tiền" Binding="{Binding ThanhTien,StringFormat=N0}" Width="120"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Thực hiện lúc" Binding="{Binding ThoiGianThucHien,StringFormat=dd/MM/yyyy HH:mm}" Width="150"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Thuốc đã kê / chờ chốt" FontWeight="SemiBold" Margin="0,18,0,8"/>
    <!-- Danh sách CompletionDrugsList. -->
    <DataGrid x:Name="CompletionDrugsList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="100" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Thuốc" Binding="{Binding TenThuoc}" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Hàm lượng" Binding="{Binding HamLuong}" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Số lượng" Binding="{Binding SoLuong,StringFormat=0.###}" Width="75"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Đơn vị" Binding="{Binding DonViTinh}" Width="70"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Liều dùng" Binding="{Binding LieuDung}" Width="160"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Đường dùng" Binding="{Binding DuongDung}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Ngày" Binding="{Binding SoNgayDung}" Width="60"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Hướng dẫn" Binding="{Binding HuongDan}" Width="220"/><DataGridTextColumn ElementStyle="{StaticResource ClinicalTableText}" Header="Thành tiền" Binding="{Binding ThanhTien,StringFormat=N0}" Width="120"/></DataGrid.Columns></DataGrid>
    <!-- Thông tin hiển thị CompletionTotalText. -->
    <TextBlock x:Name="CompletionTotalText" FontWeight="SemiBold" FontSize="17" Foreground="#1D4ED8" TextWrapping="Wrap" Margin="0,16"/><TextBlock x:Name="CompletionInvoiceText" TextWrapping="Wrap" Foreground="#1D4ED8" Margin="0,0,0,12"/>
    <!-- Nút thao tác OpenServicesButton — Lịch sử dịch vụ ↗. Chuyển sự kiện đến Services_Click trong code-behind. -->
    <WrapPanel><Button x:Name="OpenServicesButton" Content="Lịch sử dịch vụ ↗" Click="Services_Click"/><Button x:Name="OpenInvoiceButton" Content="Hóa đơn ↗" Click="Invoice_Click"/><Button x:Name="OpenPrescriptionButton" Content="Tra cứu / bàn giao thuốc ↗" Click="Prescription_Click"/></WrapPanel>
    <TextBlock Text="Hoàn tất khóa lần khám và lập hóa đơn đúng các khoản trên. Thu tiền và giao thuốc thực hiện tại quầy." TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,14,0,0"/>
   </StackPanel></Border></ScrollViewer></TabItem>

   <!-- XrayHost_Loaded tạo điều khiển ảnh khi mở vùng này và giới hạn chỉ xem nếu lần khám không được sửa. -->
   <TabItem Header="Ảnh X-quang" Tag="X" ToolTip="Xem và quản lý ảnh X-quang của lần khám."><ContentControl x:Name="XrayHost" Loaded="XrayHost_Loaded"/></TabItem>
  </TabControl>
  <!-- Keep save/complete actions outside the scrolling step content. -->
  <Border x:Name="ClinicalFooter" Grid.Row="2" Style="{StaticResource ClinicalFooterSurface}" Padding="14,10,6,4" Margin="0">
   <StackPanel>
    <TextBlock x:Name="ClinicalError" Style="{StaticResource NoticeText}" Foreground="#B42318"
               Margin="0,0,8,6" AutomationProperties.LiveSetting="Assertive"/>
    <TextBlock x:Name="ClinicalStatus" Style="{StaticResource NoticeText}" Foreground="#176344"
               FontSize="12" Margin="0,0,8,8" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel HorizontalAlignment="Right">
     <Button x:Name="ReloadClinicalButton" Content="↻ Tải lại" Click="Reload_Click"
             ToolTip="Làm mới nội dung khám/kế hoạch; giữ nháp thuốc đang nhập"/>
     <Button x:Name="SaveClinicalButton" Content="Lưu nháp" Click="Save_Click"
             Style="{StaticResource ClinicalSaveAction}" ToolTip="Lưu nội dung khám đang nhập trước khi rời màn hình."/>
     <Button x:Name="CompleteClinicalButton" Content="Chốt và lập hóa đơn" Click="Complete_Click"
             Style="{StaticResource ClinicalPrimary}" ToolTip="Kiểm tra tổng kết trước khi chốt lần khám và lập hóa đơn."/>
    </WrapPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
