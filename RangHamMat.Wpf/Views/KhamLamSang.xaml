<UserControl xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow" clinical:ClinicalLayout.IsEnabled="True" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.KhamLamSang" Background="#F1F5F9" FontFamily="Segoe UI" FontSize="14" Foreground="#18324B" Language="vi-VN" UseLayoutRounding="True">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#DFE7EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="NoticeText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="6,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,5,8" Background="Transparent"><ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#DBEAFE"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="#1D4ED8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#EAF1FA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Padding="14"><StackPanel>
   <DockPanel><Button Content="← Hàng chờ" Click="Back_Click" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="HỒ SƠ ĐANG KHÁM" FontSize="10" FontWeight="Bold" Foreground="#64748B"/><TextBlock x:Name="PatientHeader" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel>
   <TextBlock x:Name="ClinicalIdentity" FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
   <Border Background="#FFFBEB" CornerRadius="6" Padding="8,6" Margin="0,8,0,0"><TextBlock x:Name="SafetyHeader" FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/></Border>
  </StackPanel></Border>
  <TabControl x:Name="ClinicalTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="ClinicalTabs_Changed">
   <TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></TabControl.ItemsPanel>
   <TabItem Header="1. Khám"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ClinicalInputPanel">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Khám và chẩn đoán" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="Triệu chứng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SymptomsEditor" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Clinical_Changed"/>
     <TextBlock Text="Chẩn đoán" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/><TextBox x:Name="DiagnosisEditor" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Clinical_Changed"/>
     <TextBlock Text="Xử trí / hướng điều trị" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/><TextBox x:Name="TreatmentEditor" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Clinical_Changed"/>
     <Expander Header="Ghi chú thêm" Margin="0,12,0,0"><TextBox x:Name="ClinicalNote" MinHeight="45" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Clinical_Changed"/></Expander>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="2. Điều trị"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ghi nhận tình trạng" Style="{StaticResource SectionTitle}"/>
     <StackPanel x:Name="ConditionInputPanel">
      <TextBlock Text="Chọn nhanh" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ConditionReferencePicker" DisplayMemberPath="TenTinhTrang" TextSearch.TextPath="TenTinhTrang" IsTextSearchEnabled="True" MaxDropDownHeight="360" SelectionChanged="Reference_Selected"><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1D4ED8" Background="#EFF6FF" Padding="8" Margin="0,6,0,2"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle></ComboBox>
      <TextBlock Text="Tên tình trạng *" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox x:Name="ConditionNameEditor" MaxLength="255" TextChanged="ConditionInput_Changed"/>
      <Expander Header="Mô tả và ghi chú" Margin="0,10,0,0"><StackPanel>
       <TextBlock Text="Mô tả" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ConditionDetailEditor" MinHeight="50" MaxHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ConditionInput_Changed"/>
       <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/><TextBox x:Name="ConditionNoteEditor" MinHeight="40" MaxHeight="70" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="ConditionInput_Changed"/>
      </StackPanel></Expander>
      <WrapPanel Margin="0,12,0,0"><Button x:Name="AddConditionButton" Content="+ Thêm" Click="AddCondition_Click" Style="{StaticResource HospitalPrimary}"/><Button x:Name="UpdateConditionButton" Content="Cập nhật" Click="UpdateCondition_Click"/><Button x:Name="DeleteConditionButton" Content="Xóa" Click="DeleteCondition_Click"/><Button x:Name="ClearConditionButton" Content="Nhập mới" Click="ClearCondition_Click"/></WrapPanel>
     </StackPanel>
     <TextBlock x:Name="ConditionCount" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,12,0,5"/>
     <ListBox x:Name="ConditionList" SelectionChanged="Condition_Selected" MinHeight="45" MaxHeight="150" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="8" Background="#F8FAFC" CornerRadius="6" Margin="0,2"><StackPanel><TextBlock Text="{Binding LoaiTinhTrang}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding MoTaTinhTrang}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding GhiChu}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Chọn dịch vụ điều trị" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ConditionRecommendation" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,10"/>
     <ItemsControl x:Name="RelatedServicesList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><CheckBox IsChecked="{Binding Chon,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="ServiceChoice_Click" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"><StackPanel Margin="8,0,0,0"><TextBlock Text="{Binding DichVu.TenDV}" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel Margin="0,5,0,0"><TextBlock Text="{Binding GiaHienThi}" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,12,0"/><TextBlock Text="{Binding DichVu.MaDV}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="{Binding DichVu.NoiDungDeXuat}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock x:Name="SelectedServicesSummary" FontWeight="SemiBold" Margin="0,8"/><Button x:Name="UseRecommendationButton" Content="Lập kế hoạch từ dịch vụ đã chọn →" Click="UseRecommendation_Click" Style="{StaticResource HospitalPrimary}" HorizontalAlignment="Left"/>
     <Expander Header="Định hướng tham khảo" Margin="0,12,0,0"><TextBlock x:Name="ConditionReferenceText" TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,8"/></Expander>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="3. Kế hoạch"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button x:Name="NewPlanButton" Content="+ Kế hoạch mới" Click="NewPlan_Click" DockPanel.Dock="Right"/><TextBlock Text="Kế hoạch điều trị" Style="{StaticResource SectionTitle}"/></DockPanel>
     <ComboBox x:Name="PlanPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Plan_Changed" MinHeight="36" Margin="0,8,0,0"/>
     <TextBlock x:Name="PlanIdentity" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,8"/>
     <StackPanel x:Name="PlanFields"><Expander Header="Lịch dự kiến và ghi chú"><StackPanel>
      <WrapPanel Margin="0,10"><StackPanel Margin="0,0,12,0"><TextBlock Text="Ngày bắt đầu"/><DatePicker x:Name="PlanStart" SelectedDateChanged="Plan_FieldChanged"/></StackPanel><StackPanel><TextBlock Text="Ngày kết thúc"/><DatePicker x:Name="PlanEnd" SelectedDateChanged="Plan_FieldChanged"/></StackPanel></WrapPanel>
      <TextBox x:Name="PlanNote" TextChanged="Plan_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45"/>
     </StackPanel></Expander></StackPanel>
     <DataGrid x:Name="PlanSteps" FrozenColumnCount="0" EnableColumnVirtualization="False" AutoGenerateColumns="False" MinHeight="180" MaxHeight="400" CanUserAddRows="True" CellEditEnding="Plan_Edit" SizeChanged="PlanSteps_SizeChanged" RowDetailsVisibilityMode="VisibleWhenSelected" Margin="0,12,0,0" RowHeight="44" GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F8FAFC"><DataGrid.Columns>
      <DataGridComboBoxColumn x:Name="PlanServiceColumn" Header="Dịch vụ" SelectedValueBinding="{Binding MaDV,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="2*" MinWidth="140"><DataGridComboBoxColumn.ElementStyle><Style TargetType="ComboBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><TextBlock Text="{Binding SelectedItem.Label,RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" ToolTip="{Binding SelectedItem.Label,RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style></DataGridComboBoxColumn.ElementStyle><DataGridComboBoxColumn.EditingElementStyle><Style TargetType="ComboBox"><EventSetter Event="SelectionChanged" Handler="PlanService_Selected"/></Style></DataGridComboBoxColumn.EditingElementStyle></DataGridComboBoxColumn>
      <DataGridTextColumn Header="SL" Binding="{Binding SoLuongDuKien,ValidatesOnExceptions=True,UpdateSourceTrigger=PropertyChanged}" Width="52"/><DataGridTextColumn Header="Buổi" Binding="{Binding LanThu,ValidatesOnExceptions=True}" Width="52"/>
      <DataGridTextColumn Header="Đơn giá (đ)" Binding="{Binding DonGiaDuKien,StringFormat=N0}" IsReadOnly="True" Width="105"/><DataGridTextColumn Header="Nội dung thực hiện" Binding="{Binding NoiDungBuoc}" Width="2*" MinWidth="160"/>
     </DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><Border Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=DataGrid}}" Padding="12,6,12,12"><StackPanel><TextBlock Text="Nội dung thực hiện" FontSize="12" Foreground="#64748B"/><TextBox Text="{Binding NoiDungBuoc,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly,RelativeSource={RelativeSource AncestorType=DataGrid}}" TextChanged="PlanRowNote_Changed" MinHeight="45" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid>
     <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,12"><TextBlock x:Name="PlanTotal" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#1D4ED8"/></Border>
     <TextBlock Text="Giá lấy từ danh mục dịch vụ. Kế hoạch dự kiến chưa phát sinh khoản thu." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel><Button x:Name="SavePlanButton" Content="Lưu kế hoạch" Click="SavePlan_Click" Style="{StaticResource HospitalPrimary}"/><Button x:Name="ConfirmPlanButton" Content="Duyệt kế hoạch" Click="ConfirmPlan_Click"/><Button x:Name="RefreshPlanPricesButton" Content="Cập nhật giá" Click="RefreshPlanPrices_Click"/><Button x:Name="CancelPlanButton" Content="Hủy nháp" Click="CancelPlan_Click"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="4. Thực hiện"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Thực hiện kế hoạch điều trị" Style="{StaticResource SectionTitle}"/><TextBlock Text="Đối chiếu các dịch vụ đã duyệt. Chỉ xác nhận sau khi đã làm xong toàn bộ khám và điều trị trong lần khám này." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/>
    <DataGrid x:Name="ExecutionPlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="100" MaxHeight="300"><DataGrid.Columns><DataGridTextColumn Header="Dịch vụ theo kế hoạch" Binding="{Binding DichVu}" Width="260"/><DataGridTextColumn Header="Buổi" Binding="{Binding LanThu}" Width="60"/><DataGridTextColumn Header="SL" Binding="{Binding SoLuongDuKien}" Width="60"/><DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaDuKien,StringFormat=N0}" Width="110"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="160"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Nếu không có kế hoạch thủ thuật, bước này xác nhận dịch vụ khám trên phiếu tiếp nhận." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12"/>
    <CheckBox x:Name="ExecutionAcknowledged" Content="Tôi xác nhận đã thực hiện xong các dịch vụ trên" Margin="0,8"/><Button x:Name="ExecutePlanButton" Content="Xác nhận thực hiện và chuyển kê thuốc →" Click="ExecutePlan_Click" HorizontalAlignment="Left" Style="{StaticResource HospitalPrimary}" Margin="0,8"/>
    <TextBlock x:Name="ExecutionStatusText" TextWrapping="Wrap" Foreground="#15803D" Margin="0,10"/>
   </StackPanel></Border></ScrollViewer></TabItem>
   <TabItem x:Name="PrescriptionTab" Header="5. Kê thuốc"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel x:Name="PrescriptionDecision"><CheckBox x:Name="NoPrescription" Content="Không kê thuốc trong lần khám này" Checked="Clinical_Changed" Unchecked="Clinical_Changed"/><StackPanel Margin="0,8,0,0" Visibility="{Binding IsChecked,ElementName=NoPrescription,Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Lý do không kê thuốc" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NoPrescriptionReason" MaxLength="500" MinHeight="45" TextWrapping="Wrap" TextChanged="Clinical_Changed"/></StackPanel><TextBlock x:Name="PrescriptionStageText" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/></StackPanel></Border>
    <ContentControl x:Name="PrescriptionHost" Grid.Row="1"/>
   </Grid></TabItem>
   <TabItem Header="6. Tổng kết"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Kiểm tra trước khi lập hóa đơn" Style="{StaticResource SectionTitle}"/><TextBlock Text="Dịch vụ đã thực hiện và thuốc trong các đơn hiệu lực đã ký được đọc trực tiếp từ database." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/>
    <TextBlock Text="Dịch vụ đã thực hiện" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <DataGrid x:Name="CompletionServicesList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="100" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn Header="Dịch vụ" Binding="{Binding TenDV}" Width="260"/><DataGridTextColumn Header="SL" Binding="{Binding SoLuong,StringFormat=0.###}" Width="65"/><DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia,StringFormat=N0}" Width="110"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien,StringFormat=N0}" Width="120"/><DataGridTextColumn Header="Thực hiện lúc" Binding="{Binding ThoiGianThucHien,StringFormat=dd/MM/yyyy HH:mm}" Width="150"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Thuốc đã kê và ký" FontWeight="SemiBold" Margin="0,18,0,8"/>
    <DataGrid x:Name="CompletionDrugsList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="100" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn Header="Thuốc" Binding="{Binding TenThuoc}" Width="180"/><DataGridTextColumn Header="Hàm lượng" Binding="{Binding HamLuong}" Width="100"/><DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong,StringFormat=0.###}" Width="75"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding DonViTinh}" Width="70"/><DataGridTextColumn Header="Liều dùng" Binding="{Binding LieuDung}" Width="160"/><DataGridTextColumn Header="Đường dùng" Binding="{Binding DuongDung}" Width="110"/><DataGridTextColumn Header="Ngày" Binding="{Binding SoNgayDung}" Width="60"/><DataGridTextColumn Header="Hướng dẫn" Binding="{Binding HuongDan}" Width="220"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien,StringFormat=N0}" Width="120"/></DataGrid.Columns></DataGrid>
    <TextBlock x:Name="CompletionTotalText" FontWeight="SemiBold" FontSize="17" Foreground="#1D4ED8" TextWrapping="Wrap" Margin="0,16"/><TextBlock x:Name="CompletionInvoiceText" TextWrapping="Wrap" Foreground="#1D4ED8" Margin="0,0,0,12"/>
    <WrapPanel><Button x:Name="OpenServicesButton" Content="Lịch sử dịch vụ ↗" Click="Services_Click"/><Button x:Name="OpenInvoiceButton" Content="Hóa đơn ↗" Click="Invoice_Click"/><Button x:Name="OpenPrescriptionButton" Content="Tra cứu / bàn giao thuốc ↗" Click="Prescription_Click"/></WrapPanel>
    <TextBlock Text="Hoàn tất khóa lần khám và lập hóa đơn đúng các khoản trên. Thu tiền và giao thuốc thực hiện tại quầy." TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,14,0,0"/>
   </StackPanel></Border></ScrollViewer></TabItem>

  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#DFE7EF" BorderThickness="0,1,0,0" Padding="12,10"><StackPanel>
   <TextBlock x:Name="ClinicalError" Style="{StaticResource NoticeText}" Foreground="#B42318" TextWrapping="Wrap"/><TextBlock x:Name="ClinicalStatus" Style="{StaticResource NoticeText}" Foreground="#15803D" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,6"/>
   <WrapPanel HorizontalAlignment="Right"><Button x:Name="ReloadClinicalButton" Content="Tải lại" Click="Reload_Click" ToolTip="Làm mới nội dung khám/kế hoạch; giữ nháp thuốc đang nhập"/><Button x:Name="SaveClinicalButton" Content="Lưu khám" Click="Save_Click" Style="{StaticResource HospitalPrimary}"/><Button x:Name="CompleteClinicalButton" Content="Hoàn tất và lập hóa đơn" Click="Complete_Click"/></WrapPanel>
  </StackPanel></Border>
 </Grid>
</UserControl>
