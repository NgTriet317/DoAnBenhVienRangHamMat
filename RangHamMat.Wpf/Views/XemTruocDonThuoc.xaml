<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của XemTruocDonThuoc.xaml. -->
<!-- AI hỗ trợ: bổ sung chú thích cho xem trước/in đơn thuốc. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<Window x:Class="RangHamMat.Views.XemTruocDonThuoc" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xem trước đơn thuốc" Width="860" Height="760" MinWidth="700" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#E2E8F0">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="16,12"><!-- Thao tác In đơn…: gọi Print_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
  <Button DockPanel.Dock="Right" Content="In đơn…" Click="Print_Click" Padding="18,7"/><TextBlock Text="Xem trước đơn thuốc" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><Border x:Name="PrintablePage" Background="White" Width="740" Padding="32" Margin="18" HorizontalAlignment="Center"><StackPanel>
   <TextBlock Text="BỆNH VIỆN RĂNG HÀM MẶT" FontWeight="Bold" FontSize="15" TextAlignment="Center"/>
   <TextBlock Text="ĐƠN THUỐC" FontWeight="Bold" FontSize="22" TextAlignment="Center" Margin="0,10,0,8"/>
   <TextBlock Text="{Binding Code}" Foreground="#1D4ED8" FontWeight="Bold" TextAlignment="Center"/>
   <Border BorderBrush="#1D4ED8" BorderThickness="0,0,0,2" Margin="0,14,0,18"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Người bệnh" Foreground="#64748B"/><TextBlock Text="{Binding Patient}" FontWeight="SemiBold" Margin="0,4,0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding Phone}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Ngày kê" Foreground="#64748B"/><TextBlock Text="{Binding When}" FontWeight="SemiBold" Margin="0,4,0,8"/><TextBlock Text="{Binding Doctor}" TextWrapping="Wrap"/></StackPanel></Grid>
   <TextBlock Text="Chẩn đoán" FontWeight="Bold" Margin="0,16,0,4"/><TextBlock Text="{Binding Diagnosis}" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <Border Background="#334155" Padding="9,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="Thuốc" Foreground="White" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="Liều / số ngày" Foreground="White" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="Số lượng" Foreground="White" FontWeight="Bold"/><TextBlock Grid.Column="3" Text="Hướng dẫn" Foreground="White" FontWeight="Bold"/></Grid></Border>
   <ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" Padding="9,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,8,0"/><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding LieuDung}" TextWrapping="Wrap"/><TextBlock Text="{Binding SoNgayDung, StringFormat={}{0} ngày}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding SoLuong}"/><TextBlock Text="{Binding Unit}" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding HuongDan}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,14,0,0"/>
   <StackPanel HorizontalAlignment="Right" Margin="0,28,0,0"><TextBlock Text="BÁC SĨ KÊ ĐƠN" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="{Binding Doctor}" TextAlignment="Center" Margin="0,18,0,0"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="#64748B" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
  </StackPanel></Border></ScrollViewer>
  <TextBlock x:Name="PrintStatus" Grid.Row="2" Text="Chọn In đơn để chọn máy in hoặc xuất PDF bằng trình điều khiển máy in." TextWrapping="Wrap" Margin="16,10" FontSize="11"/>
 </Grid>
</Window>
