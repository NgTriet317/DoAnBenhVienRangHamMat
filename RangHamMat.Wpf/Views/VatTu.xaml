<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.VatTu">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Vật tư, lô hàng và kho" Style="{StaticResource Title}" />
            <TextBlock Text="Nhấp đúp vào một dòng để xem chi tiết. Chọn Thêm để tạo mới." Style="{StaticResource Subtitle}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,20">
            <Button Content="Nhập xuất" Tag="MoTrang:NhapXuatVatTu" />
        </WrapPanel>
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Mặt hàng" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="128" FontSize="25" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Sắp hết" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="07" FontSize="25" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Sắp hết hạn" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="03" FontSize="25" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Giá trị tồn" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="0 VND" FontSize="23" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="3" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Cảnh báo tồn kho" FontWeight="SemiBold"/>
                    <TextBlock Text="07 mặt hàng dưới ngưỡng tối thiểu" Margin="0,10,0,0" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Cảnh báo hạn dùng" FontWeight="SemiBold"/>
                    <TextBlock Text="03 lô vật tư cần kiểm tra" Margin="0,10,0,0" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
        </Grid>
        <TabControl Grid.Row="4">
            <TabItem Header="Vật tư">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Thêm vật tư" Tag="MoCuaSo:VatTu" CommandParameter="VAT_TU" Style="{StaticResource Primary}" />
                        </WrapPanel>
                        <TextBlock Text="Vật tư" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
                        <Grid>
                            <DataGrid Tag="Table:VAT_TU" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_VAT_TU" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã vật tư" SortMemberPath="MaVT" Width="155" Binding="{Binding MaVT}" />
                                    <DataGridTextColumn Header="Tên vật tư" SortMemberPath="TenVT" Width="155" Binding="{Binding TenVT}" />
                                    <DataGridTextColumn Header="Đơn vị tính" SortMemberPath="DonViTinh" Width="155" Binding="{Binding DonViTinh}" />
                                    <DataGridTextColumn Header="Loại vật tư" SortMemberPath="MaLVT" Width="155" Binding="{Binding MaLVT}" />
                                    <DataGridTextColumn Header="Mức tồn tối thiểu" SortMemberPath="MucTonToiThieu" Width="155" Binding="{Binding MucTonToiThieu}" />
                                    <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Binding="{Binding TrangThai}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=Grid_VAT_TU}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chưa có vật tư" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                                <Button Content="Thêm mới" Tag="MoCuaSo:VatTu" CommandParameter="VAT_TU" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Thuốc">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Thêm thuốc" Tag="MoCuaSo:VatTu" CommandParameter="VAT_TU|Thuoc" Style="{StaticResource Primary}" />
                        </WrapPanel>
                        <TextBlock Text="Thuốc" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
                        <Grid>
                            <DataGrid Tag="Table:VAT_TU" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_VAT_TU_Thuoc" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã vật tư" SortMemberPath="MaVT" Width="155" Binding="{Binding MaVT}" />
                                    <DataGridTextColumn Header="Tên vật tư" SortMemberPath="TenVT" Width="155" Binding="{Binding TenVT}" />
                                    <DataGridTextColumn Header="Đơn vị tính" SortMemberPath="DonViTinh" Width="155" Binding="{Binding DonViTinh}" />
                                    <DataGridTextColumn Header="Loại vật tư" SortMemberPath="MaLVT" Width="155" Binding="{Binding MaLVT}" />
                                    <DataGridTextColumn Header="Mức tồn tối thiểu" SortMemberPath="MucTonToiThieu" Width="155" Binding="{Binding MucTonToiThieu}" />
                                    <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Binding="{Binding TrangThai}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=Grid_VAT_TU_Thuoc}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chưa có thuốc" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                                <Button Content="Thêm thuốc" Tag="MoCuaSo:VatTu" CommandParameter="VAT_TU|Thuoc" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Loại vật tư">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Thêm loại vật tư" Tag="MoCuaSo:VatTu" CommandParameter="LOAI_VAT_TU" Style="{StaticResource Primary}" />
                        </WrapPanel>
                        <TextBlock Text="Loại vật tư" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
                        <Grid>
                            <DataGrid Tag="Table:LOAI_VAT_TU" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_LOAI_VAT_TU" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã loại vật tư" SortMemberPath="MaLVT" Width="155" Binding="{Binding MaLVT}" />
                                    <DataGridTextColumn Header="Tên loại vật tư" SortMemberPath="TenLVT" Width="155" Binding="{Binding TenLVT}" />
                                    <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Binding="{Binding GhiChu}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=Grid_LOAI_VAT_TU}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chưa có loại vật tư" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                                <Button Content="Thêm mới" Tag="MoCuaSo:VatTu" CommandParameter="LOAI_VAT_TU" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Lô vật tư">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="LO_VAT_TU" />
                            <Button Content="Thêm lô vật tư" Tag="MoCuaSo:VatTu" CommandParameter="LO_VAT_TU" Style="{StaticResource Primary}" />
                        </WrapPanel>
                        <TextBlock Text="Lô vật tư" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
                        <Grid>
                            <DataGrid Tag="Table:LO_VAT_TU" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_LO_VAT_TU" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã lô vật tư" SortMemberPath="MaLo" Width="155" Binding="{Binding MaLo}" />
                                    <DataGridTextColumn Header="Vật tư" SortMemberPath="MaVT" Width="155" Binding="{Binding MaVT}" />
                                    <DataGridTextColumn Header="Nhà cung cấp" SortMemberPath="MaNCC" Width="155" Binding="{Binding MaNCC}" />
                                    <DataGridTextColumn Header="Kho" SortMemberPath="MaKho" Width="155" Binding="{Binding MaKho}" />
                                    <DataGridTextColumn Header="Ngày nhập" SortMemberPath="NgayNhap" Width="155" Binding="{Binding NgayNhap}" />
                                    <DataGridTextColumn Header="Hạn sử dụng" SortMemberPath="HanSuDung" Width="155" Binding="{Binding HanSuDung}" />
                                    <DataGridTextColumn Header="Số lượng nhập" SortMemberPath="SoLuongNhap" Width="155" Visibility="Collapsed" Binding="{Binding SoLuongNhap}" />
                                    <DataGridTextColumn Header="Đơn giá nhập" SortMemberPath="DonGiaNhap" Width="155" Visibility="Collapsed" Binding="{Binding DonGiaNhap}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=Grid_LO_VAT_TU}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chưa có lô vật tư" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                                <Button Content="Thêm mới" Tag="MoCuaSo:VatTu" CommandParameter="LO_VAT_TU" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Kho">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Thêm kho" Tag="MoCuaSo:VatTu" CommandParameter="KHO" Style="{StaticResource Primary}" />
                        </WrapPanel>
                        <TextBlock Text="Kho" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
                        <Grid>
                            <DataGrid Tag="Table:KHO" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_KHO" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã kho" SortMemberPath="MaKho" Width="155" Binding="{Binding MaKho}" />
                                    <DataGridTextColumn Header="Tên kho" SortMemberPath="TenKho" Width="155" Binding="{Binding TenKho}" />
                                    <DataGridTextColumn Header="Nhân viên phụ trách" SortMemberPath="MaNV" Width="155" Binding="{Binding MaNV}" />
                                    <DataGridTextColumn Header="Loại kho" SortMemberPath="LoaiKho" Width="155" Binding="{Binding LoaiKho}" />
                                    <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Binding="{Binding TrangThai}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=Grid_KHO}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chưa có kho" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                                <Button Content="Thêm mới" Tag="MoCuaSo:VatTu" CommandParameter="KHO" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>