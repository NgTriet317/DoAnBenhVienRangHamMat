<!-- Giao diện BaoTri: bố cục khai báo trong XAML; code-behind điều phối dữ liệu, quyền và sự kiện. -->
<UserControl x:Class="RangHamMat.Views.BaoTri"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/BaoTriStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- Tài nguyên HienKhiDung (BooleanToVisibilityConverter) dùng lại qua khóa XAML. -->
  <BooleanToVisibilityConverter x:Key="HienKhiDung"/>
  <!-- Tài nguyên DetailValue (Style) áp dụng cho TextBlock. -->
  <Style x:Key="DetailValue" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <!-- Tài nguyên MaintenanceStatusText (Style) áp dụng cho TextBlock. -->
  <Style x:Key="MaintenanceStatusText" TargetType="TextBlock" BasedOn="{StaticResource HospitalStatusText}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Chưa xác nhận"><Setter Property="Foreground" Value="#805911"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Đã hoàn thành"><Setter Property="Foreground" Value="#176344"/></DataTrigger></Style.Triggers></Style>
  <!-- Tài nguyên MaintenanceStatusSurface (Style) áp dụng cho Border. -->
  <Style x:Key="MaintenanceStatusSurface" TargetType="Border" BasedOn="{StaticResource HospitalStatusSurface}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Chưa xác nhận"><Setter Property="Background" Value="#FFF5DD"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Đã hoàn thành"><Setter Property="Background" Value="#E9F5EE"/></DataTrigger></Style.Triggers></Style>
  <!-- Tài nguyên MaintenanceStatus (DataTemplate) dùng lại qua khóa XAML. -->
  <DataTemplate x:Key="MaintenanceStatus"><Border Style="{StaticResource MaintenanceStatusSurface}" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Style="{StaticResource MaintenanceStatusText}"/></Border></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{StaticResource HospitalCanvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <!-- Nút thao tác Tải lại — Tải lại. Chuyển sự kiện đến TaiLai_Click trong code-behind. -->
   <Button DockPanel.Dock="Right" Content="Tải lại" Click="TaiLai_Click" VerticalAlignment="Top"/>
   <StackPanel><TextBlock Text="Bảo trì thiết bị" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Lập phiếu từ thiết bị hư hại, xác nhận và theo dõi thực hiện theo từng serial." Style="{StaticResource HospitalMuted}"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Padding="20,14" Margin="0,0,0,12">
   <UniformGrid Columns="4">
    <StackPanel><TextBlock Text="Tổng số phiếu" Style="{StaticResource HospitalMuted}"/><TextBlock x:Name="txtTongSo" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel><TextBlock Text="Chưa xác nhận" Foreground="#805911" FontSize="12"/><TextBlock x:Name="txtChuaXacNhan" Text="0" Foreground="#805911" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel><TextBlock Text="Đang thực hiện" Foreground="#1D5AAC" FontSize="12"/><TextBlock x:Name="txtDangThucHien" Text="0" Foreground="#1D5AAC" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel><TextBlock Text="Đã hoàn thành" Foreground="#176344" FontSize="12"/><TextBlock x:Name="txtHoanThanh" Text="0" Foreground="#176344" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
   </UniformGrid>
  </Border>
  <!-- Thông tin hiển thị txtLoi. -->
  <TextBlock Grid.Row="2" x:Name="txtLoi" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
  <!-- Thành phần CacDanhSach. -->
  <TabControl x:Name="CacDanhSach" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
   <!-- Thông tin hiển thị txtHangDoi — Thiết bị hư hại. -->
   <TabItem><TabItem.Header><TextBlock x:Name="txtHangDoi" Text="Thiết bị hư hại"/></TabItem.Header>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource HospitalPanel}" Padding="16,12" Margin="0,0,0,12">
      <WrapPanel>
       <!-- Ô nhập txtTimThietBi. Chuyển sự kiện đến TimThietBi_ThayDoi trong code-behind. -->
       <StackPanel Width="310" Margin="0,0,16,8"><TextBlock Text="Tìm serial, mã thiết bị, tên hoặc phòng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtTimThietBi" TextChanged="TimThietBi_ThayDoi" AutomationProperties.Name="Tìm thiết bị hư hại theo serial"/></StackPanel>
       <!-- Nút thao tác btnLapPhieu — Lập phiếu cho thiết bị đã chọn. Chuyển sự kiện đến Them_Click trong code-behind. -->
       <Button x:Name="btnLapPhieu" Content="Lập phiếu cho thiết bị đã chọn" IsEnabled="False" Style="{StaticResource HospitalPrimary}" Click="Them_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
      </WrapPanel>
     </Border>
     <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Padding="0">
      <Grid>
       <!-- Danh sách GridThietBiHu. Chuyển sự kiện đến ThietBi_SelectionChanged trong code-behind. -->
       <DataGrid x:Name="GridThietBiHu" FrozenColumnCount="2" RowHeight="56" SelectionChanged="ThietBi_SelectionChanged" AutomationProperties.Name="Thiết bị hư hại chờ bảo trì">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Mã thiết bị" Binding="{Binding MaTB}" Width="120" ElementStyle="{StaticResource HospitalCellText}"/>
         <DataGridTextColumn Header="Serial" Binding="{Binding SoSerial}" Width="190" MinWidth="140" ElementStyle="{StaticResource HospitalCellText}"/>
         <DataGridTextColumn Header="Tên thiết bị" Binding="{Binding TenThietBi}" Width="*" MinWidth="200" ElementStyle="{StaticResource HospitalCellText}"/>
         <DataGridTextColumn Header="Phòng sử dụng" Binding="{Binding TenPhong}" Width="*" MinWidth="170" ElementStyle="{StaticResource HospitalCellText}"/>
         <DataGridTextColumn Header="Tình trạng" Binding="{Binding TinhTrang}" Width="125" ElementStyle="{StaticResource HospitalCellText}"/>
        </DataGrid.Columns>
       </DataGrid>
       <!-- Vùng bố cục KhongCoThietBi. -->
       <StackPanel x:Name="KhongCoThietBi" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed"><TextBlock Text="Không có thiết bị hư hại đang chờ" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Thiết bị đã có phiếu chưa kết thúc sẽ được theo dõi trong Lịch sử bảo trì." Style="{StaticResource HospitalMuted}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
      </Grid>
     </Border>
     <!-- Thông tin hiển thị txtSoThietBi. -->
     <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="txtSoThietBi" Style="{StaticResource HospitalMuted}"/><TextBlock Text="Chọn đúng serial để lập phiếu. Mỗi thiết bị chỉ có một phiếu đang xử lý." Style="{StaticResource HospitalMuted}" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Lịch sử bảo trì">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Border Style="{StaticResource HospitalPanel}" Padding="16,12" Margin="0,0,0,12">
      <StackPanel>
       <WrapPanel>
        <!-- Ô nhập txtTimKiem. Chuyển sự kiện đến BoLoc_ThayDoi trong code-behind. -->
        <StackPanel Width="230" Margin="0,0,12,8"><TextBlock Text="Tìm serial, mã phiếu, tên hoặc nhân viên" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtTimKiem" AutomationProperties.Name="Tìm lịch sử bảo trì theo serial" TextChanged="BoLoc_ThayDoi"/></StackPanel>
        <!-- Trường lựa chọn dpTuNgay. Chuyển sự kiện đến BoLoc_ThayDoi trong code-behind. -->
        <StackPanel Width="130" Margin="0,0,12,8"><TextBlock Text="Bắt đầu từ ngày" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="dpTuNgay" AutomationProperties.Name="Bắt đầu từ ngày" SelectedDateChanged="BoLoc_ThayDoi"/></StackPanel>
        <!-- Trường lựa chọn dpDenNgay. Chuyển sự kiện đến BoLoc_ThayDoi trong code-behind. -->
        <StackPanel Width="130" Margin="0,0,12,8"><TextBlock Text="Đến ngày" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="dpDenNgay" AutomationProperties.Name="Đến ngày" SelectedDateChanged="BoLoc_ThayDoi"/></StackPanel>
        <!-- Trường lựa chọn cboTrangThai. Chuyển sự kiện đến BoLoc_ThayDoi trong code-behind. -->
        <StackPanel Width="175" Margin="0,0,12,8"><TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cboTrangThai" AutomationProperties.Name="Lọc trạng thái bảo trì" SelectionChanged="BoLoc_ThayDoi"/></StackPanel>
        <!-- Nút thao tác Bỏ bộ lọc — Bỏ bộ lọc. Chuyển sự kiện đến BoLoc_Click trong code-behind. -->
        <Button Content="Bỏ bộ lọc" Click="BoLoc_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
       </WrapPanel>
       <!-- Thành phần chkDenHan — Chỉ xem thiết bị đến / quá hạn bảo trì. -->
       <CheckBox x:Name="chkDenHan" Content="Chỉ xem thiết bị đến / quá hạn bảo trì" ToolTip="Theo lịch hẹn của phiếu mới nhất chưa hủy trên mỗi thiết bị." Margin="0,2,0,4" Checked="BoLoc_ThayDoi" Unchecked="BoLoc_ThayDoi"/>
      </StackPanel>
     </Border>
     <Grid Grid.Row="1" SizeChanged="NoiDung_SizeChanged">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="CotChiTiet" Width="300"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="HangCach" Height="0"/><RowDefinition x:Name="HangChiTiet" Height="0"/></Grid.RowDefinitions>
      <!-- Vùng bố cục VungDanhSach. -->
      <Border x:Name="VungDanhSach" Grid.RowSpan="3" Style="{StaticResource HospitalPanel}" Padding="0">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Các lần bảo trì · Chọn dòng để xem và xử lý" FontSize="15" FontWeight="SemiBold" Margin="16,14"/>
        <!-- Danh sách Grid_BAO_TRI_THIET_BI. Chuyển sự kiện đến DanhSach_SelectionChanged trong code-behind. -->
        <DataGrid Grid.Row="1" x:Name="Grid_BAO_TRI_THIET_BI" FrozenColumnCount="2" RowHeight="62" SelectionChanged="DanhSach_SelectionChanged" AutomationProperties.Name="Danh sách lịch sử bảo trì">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaBT}" SortMemberPath="MaBT" Width="100" MinWidth="85" ElementStyle="{StaticResource HospitalCellText}"/>
          <DataGridTextColumn Header="Serial" Binding="{Binding SoSerial}" SortMemberPath="SoSerial" Width="155" MinWidth="130" ElementStyle="{StaticResource HospitalCellText}"/>
          <DataGridTemplateColumn Header="Thiết bị / phòng" SortMemberPath="TenThietBi" Width="*" MinWidth="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" ToolTip="{Binding ThietBiDayDu}"><TextBlock Text="{Binding TenThietBi}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TenPhong}" Style="{StaticResource HospitalMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Bắt đầu" Binding="{Binding NgayBatDau, StringFormat=dd/MM/yyyy}" SortMemberPath="NgayBatDau" Width="105" ElementStyle="{StaticResource HospitalCellText}"/>
          <DataGridTemplateColumn Header="Trạng thái" SortMemberPath="Status" Width="160" CellTemplate="{StaticResource MaintenanceStatus}"/>
          <DataGridTextColumn Header="Chi phí (đ)" Binding="{Binding ChiPhi, StringFormat={}{0:N2}}" SortMemberPath="ChiPhi" Width="120" ElementStyle="{StaticResource HospitalNumber}" HeaderStyle="{StaticResource HospitalNumberHeader}"/>
         </DataGrid.Columns>
        </DataGrid>
        <!-- Vùng bố cục KhongCoDuLieu. -->
        <StackPanel x:Name="KhongCoDuLieu" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"><TextBlock Text="Không có phiếu bảo trì phù hợp" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Thử bỏ bộ lọc hoặc lập phiếu từ danh sách thiết bị hư hại." Style="{StaticResource HospitalMuted}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
        <!-- Thông tin hiển thị txtSoDong. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource HospitalBorder}" BorderThickness="0,1,0,0" Padding="16,12"><TextBlock x:Name="txtSoDong" Style="{StaticResource HospitalMuted}"/></Border>
       </Grid>
      </Border>
      <!-- Vùng bố cục VungChiTiet. -->
      <Border x:Name="VungChiTiet" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource HospitalPanel}" Padding="18">
       <Grid>
        <!-- Thông tin hiển thị ChuaChon — Chọn một phiếu để xem serial, nội dung, người phụ trách và các bước thực hiện.. -->
        <TextBlock x:Name="ChuaChon" Text="Chọn một phiếu để xem serial, nội dung, người phụ trách và các bước thực hiện." Style="{StaticResource HospitalMuted}" VerticalAlignment="Center" TextAlignment="Center"/>
        <!-- Vùng bố cục ChiTiet. -->
        <Grid x:Name="ChiTiet" Visibility="Collapsed">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding MaBT}" FontSize="17" FontWeight="SemiBold"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MaintenanceStatus}" Margin="0,7,0,0"/></StackPanel>
         <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,8,0">
           <TextBlock Text="Serial thiết bị" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SoSerial}" Style="{StaticResource DetailValue}" FontWeight="SemiBold" FontSize="17" Foreground="#1D5AAC"/>
           <TextBlock Text="Thiết bị" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ThietBiDayDu}" Style="{StaticResource DetailValue}"/>
           <TextBlock Text="Phòng sử dụng" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding TenPhong}" Style="{StaticResource DetailValue}"/>
           <TextBlock Text="Nhân viên phụ trách" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding NhanVien}" Style="{StaticResource DetailValue}"/>
           <TextBlock Text="Bắt đầu / kết thúc" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ThoiGian}" Style="{StaticResource DetailValue}"/>
           <TextBlock Text="Xác nhận lúc" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ThoiDiemXacNhan}" Style="{StaticResource DetailValue}"/>
           <TextBlock Text="Bắt đầu thực hiện lúc" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ThoiDiemThucHien}" Style="{StaticResource DetailValue}"/>
           <TextBlock Text="Nội dung bảo trì" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding NoiDung}" Style="{StaticResource DetailValue}"/>
           <TextBlock Text="Chi phí" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ChiPhi, StringFormat={}{0:N2} đ}" Style="{StaticResource DetailValue}" FontWeight="SemiBold"/>
           <TextBlock Text="Bảo trì tiếp theo" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LichTiepTheo}" Style="{StaticResource DetailValue}"/>
           <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding GhiChu}" Style="{StaticResource DetailValue}"/>
          </StackPanel>
         </ScrollViewer>
         <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <WrapPanel>
           <!-- Nút thao tác Sửa nội dung — Sửa nội dung. Chuyển sự kiện đến Sua_Click trong code-behind. -->
           <Button Content="Sửa nội dung" Visibility="{Binding ChoSua, Converter={StaticResource HienKhiDung}}" Click="Sua_Click"/>
           <!-- Nút thao tác Xác nhận — Xác nhận. Chuyển sự kiện đến ChuyenTrangThai_Click trong code-behind. -->
           <Button Content="Xác nhận" Visibility="{Binding ChoXacNhan, Converter={StaticResource HienKhiDung}}" Tag="Đã xác nhận" Click="ChuyenTrangThai_Click" Style="{StaticResource HospitalPrimary}"/>
           <!-- Nút thao tác Hủy phiếu — Hủy phiếu. Chuyển sự kiện đến ChuyenTrangThai_Click trong code-behind. -->
           <Button Content="Hủy phiếu" Visibility="{Binding ChoHuy, Converter={StaticResource HienKhiDung}}" Tag="Hủy" Click="ChuyenTrangThai_Click"/>
           <!-- Nút thao tác Bắt đầu thực hiện — Bắt đầu thực hiện. Chuyển sự kiện đến ChuyenTrangThai_Click trong code-behind. -->
           <Button Content="Bắt đầu thực hiện" Visibility="{Binding ChoBatDau, Converter={StaticResource HienKhiDung}}" Tag="Đang thực hiện" Click="ChuyenTrangThai_Click" Style="{StaticResource HospitalPrimary}"/>
           <!-- Nút thao tác Hoàn thành — Hoàn thành. Chuyển sự kiện đến ChuyenTrangThai_Click trong code-behind. -->
           <Button Content="Hoàn thành" Visibility="{Binding ChoHoanThanh, Converter={StaticResource HienKhiDung}}" Tag="Đã hoàn thành" Click="ChuyenTrangThai_Click" Style="{StaticResource HospitalPrimary}"/>
          </WrapPanel>
          <TextBlock Text="{Binding HuongDan}" Style="{StaticResource HospitalMuted}" Margin="0,8,0,0"/>
         </StackPanel>
        </Grid>
       </Grid>
      </Border>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
