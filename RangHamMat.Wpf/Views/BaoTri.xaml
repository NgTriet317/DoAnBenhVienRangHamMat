<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của BaoTri.xaml; các vùng liên quan: Bảo trì, Grid_BAO_TRI_THIET_BI. -->
<!-- AI hỗ trợ: bổ sung chú thích cho bảo trì thiết bị. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.BaoTri">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Bảo trì thiết bị" Style="{StaticResource Title}" />
            <TextBlock Text="Nhấp đúp vào một dòng để xem chi tiết. Chọn Thêm để tạo mới." Style="{StaticResource Subtitle}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,20" />
        <TabControl Grid.Row="2">
            <!-- Nhóm Bảo trì: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
            <TabItem Header="Bảo trì">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- tiêu đề + nút -->
                        <RowDefinition Height="Auto" />
                        <!-- UniformGrid -->
                        <RowDefinition Height="Auto" />
                        <!-- bộ lọc -->
                        <RowDefinition Height="Auto" />
                        <!-- DataGrid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Đến hạn" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="04" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Đang xử lý" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="02" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Hoàn tất tháng này" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="18" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
                        <WrapPanel>
                            <StackPanel Width="155" Margin="0,0,12,0">
                                <TextBlock Text="Từ ngày" Margin="0,0,0,4"/>
                                <DatePicker Height="0"/>
                            </StackPanel>
                            <StackPanel Width="155" Margin="0,0,12,0">
                                <TextBlock Text="Đến ngày" Margin="0,0,0,4"/>
                                <DatePicker Height="0"/>
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,18,0">
                                <TextBlock Text="Trạng thái" Margin="0,0,0,4"/>
                                <ComboBox Height="0"/>
                            </StackPanel>
                            <Button Content="Lọc danh sách" Style="{StaticResource Primary}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                            <!-- Nút điều hướng MoCuaSo:BaoTri: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
                            <Button Content="Thêm" Tag="MoCuaSo:BaoTri" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                        </WrapPanel>
                    </Border>
                    <DockPanel Grid.Row="3" Margin="0,0,0,18">
                        <WrapPanel DockPanel.Dock="Right">
                            <!-- Nút điều hướng ToggleColumns: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
                            <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="BAO_TRI_THIET_BI" />
                            <!-- Nút điều hướng MoCuaSo:BaoTri: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
                            <Button Content="Thêm bảo trì" Tag="MoCuaSo:BaoTri" CommandParameter="BAO_TRI_THIET_BI" Style="{StaticResource Primary}" />
                        </WrapPanel>
                        <TextBlock Text="Bảo trì" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0" Grid.Row="4" >
                        <Grid >
                            <!-- Bảng Grid_BAO_TRI_THIET_BI: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. Tag Table:BAO_TRI_THIET_BI cho workspace biết bảng khi mở chi tiết bằng nhấp đúp. -->
                            <DataGrid Tag="Table:BAO_TRI_THIET_BI" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_BAO_TRI_THIET_BI" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã lần bảo trì" SortMemberPath="MaBT" Width="155" Binding="{Binding MaBT}" />
                                    <DataGridTextColumn Header="Thiết bị" SortMemberPath="MaTB" Width="155" Binding="{Binding MaTB}" />
                                    <DataGridTextColumn Header="Ngày bảo trì" SortMemberPath="NgayBaoTri" Width="155" Binding="{Binding NgayBaoTri}" />
                                    <DataGridTextColumn Header="Loại bảo trì" SortMemberPath="LoaiBaoTri" Width="155" Binding="{Binding LoaiBaoTri}" />
                                    <DataGridTextColumn Header="Nội dung" SortMemberPath="NoiDung" Width="155" Binding="{Binding NoiDung}" />
                                    <DataGridTextColumn Header="Chi phí" SortMemberPath="ChiPhi" Width="155" Binding="{Binding ChiPhi}" />
                                    <DataGridTextColumn Header="Người thực hiện" SortMemberPath="NguoiThucHien" Width="155" Visibility="Collapsed" Binding="{Binding NguoiThucHien}" />
                                    <DataGridTextColumn Header="Ngày bảo trì tiếp theo" SortMemberPath="NgayBaoTriTiepTheo" Width="155" Visibility="Collapsed" Binding="{Binding NgayBaoTriTiepTheo}" />
                                    <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="155" Visibility="Collapsed" Binding="{Binding TrangThai}" />
                                    <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Visibility="Collapsed" Binding="{Binding GhiChu}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                                <StackPanel.Style>
                                    <!-- Style mặc định cho StackPanel: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=Grid_BAO_TRI_THIET_BI}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chưa có bảo trì" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                                <!-- Nút điều hướng MoCuaSo:BaoTri: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
                                <Button Content="Thêm mới" Tag="MoCuaSo:BaoTri" CommandParameter="BAO_TRI_THIET_BI" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>