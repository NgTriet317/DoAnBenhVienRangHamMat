<UserControl x:Class="RangHamMat.Views.BaoTri"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/BaoTriStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="DetailValue" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{StaticResource HospitalCanvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="Thêm lần bảo trì" Style="{StaticResource HospitalPrimary}" Click="Them_Click"/>
   <StackPanel><TextBlock Text="Lịch sử bảo trì" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Tra cứu thiết bị, theo dõi công việc và lịch bảo trì tiếp theo." Style="{StaticResource HospitalMuted}"/></StackPanel>
  </DockPanel>
  <!-- Thống kê toàn bộ lịch sử SQL; bộ lọc chỉ tác động danh sách bên dưới. -->
  <Border Grid.Row="1" Style="{StaticResource HospitalPanel}" Padding="20,14" Margin="0,0,0,16">
   <UniformGrid Columns="4">
    <StackPanel><TextBlock Text="Tổng số lần" Style="{StaticResource HospitalMuted}"/><TextBlock x:Name="txtTongSo" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel><TextBlock Text="Đang thực hiện" Foreground="#1D5AAC" FontSize="12"/><TextBlock x:Name="txtDangThucHien" Text="0" Foreground="#1D5AAC" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel><TextBlock Text="Đã hoàn tất" Foreground="#176344" FontSize="12"/><TextBlock x:Name="txtHoanThanh" Text="0" Foreground="#176344" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel ToolTip="Theo ngày hẹn của lần mới nhất chưa hủy trên mỗi thiết bị."><TextBlock Text="Thiết bị đến / quá hạn" Foreground="#925312" FontSize="12"/><TextBlock x:Name="txtDenHan" Text="0" Foreground="#925312" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
   </UniformGrid>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource HospitalPanel}" Padding="16,12" Margin="0,0,0,16">
   <StackPanel>
    <WrapPanel>
     <StackPanel Width="250" Margin="0,0,12,8"><TextBlock Text="Tìm mã, thiết bị hoặc nhân viên" Style="{StaticResource FieldLabel}"/><TextBox x:Name="txtTimKiem" AutomationProperties.Name="Tìm lịch sử bảo trì" TextChanged="BoLoc_ThayDoi"/></StackPanel>
     <StackPanel Width="130" Margin="0,0,12,8"><TextBlock Text="Bắt đầu từ ngày" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="dpTuNgay" AutomationProperties.Name="Bắt đầu từ ngày" SelectedDateChanged="BoLoc_ThayDoi"/></StackPanel>
     <StackPanel Width="130" Margin="0,0,12,8"><TextBlock Text="Đến ngày" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="dpDenNgay" AutomationProperties.Name="Đến ngày" SelectedDateChanged="BoLoc_ThayDoi"/></StackPanel>
     <StackPanel Width="175" Margin="0,0,12,8"><TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="cboTrangThai" AutomationProperties.Name="Lọc trạng thái bảo trì" SelectionChanged="BoLoc_ThayDoi"/></StackPanel>
     <Button Content="Bỏ bộ lọc" Click="BoLoc_Click" VerticalAlignment="Bottom" Margin="0,0,8,8"/><Button Content="Tải lại" Click="TaiLai_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
    </WrapPanel>
    <CheckBox x:Name="chkDenHan" Content="Chỉ xem thiết bị đến / quá hạn bảo trì" Margin="0,2,0,4" Checked="BoLoc_ThayDoi" Unchecked="BoLoc_ThayDoi"/>
    <TextBlock x:Name="txtLoi" Foreground="#B42318" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="3" SizeChanged="NoiDung_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="CotChiTiet" Width="300"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="HangCach" Height="0"/><RowDefinition x:Name="HangChiTiet" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="VungDanhSach" Grid.RowSpan="3" Style="{StaticResource HospitalPanel}" Padding="0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="16,14"><TextBlock Text="Các lần bảo trì" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Chọn một dòng để xem chi tiết" Style="{StaticResource HospitalMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <DataGrid Grid.Row="1" x:Name="Grid_BAO_TRI_THIET_BI" RowHeight="62" SelectionChanged="DanhSach_SelectionChanged" AutomationProperties.Name="Danh sách lịch sử bảo trì">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Mã lần" Binding="{Binding MaBT}" SortMemberPath="MaBT" Width="85" MinWidth="85" ElementStyle="{StaticResource HospitalCellText}"/>
       <DataGridTemplateColumn Header="Thiết bị / phòng" SortMemberPath="TenThietBi" Width="*" MinWidth="190">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" ToolTip="{Binding ThietBiDayDu}"><TextBlock Text="{Binding TenThietBi}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ViTri}" Style="{StaticResource HospitalMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="Bắt đầu" Binding="{Binding NgayBatDau, StringFormat=dd/MM/yyyy}" SortMemberPath="NgayBatDau" Width="108" MinWidth="108" ElementStyle="{StaticResource HospitalCellText}"/>
       <DataGridTextColumn Header="Chi phí (đ)" Binding="{Binding ChiPhi, StringFormat={}{0:N2}}" SortMemberPath="ChiPhi" Width="125" MinWidth="125" ElementStyle="{StaticResource HospitalNumber}" HeaderStyle="{StaticResource HospitalNumberHeader}"/>
       <DataGridTemplateColumn Header="Trạng thái" SortMemberPath="Status" Width="145" MinWidth="145" CellTemplate="{StaticResource HospitalStatusTemplate}"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel x:Name="KhongCoDuLieu" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"><TextBlock Text="Không có lần bảo trì phù hợp" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Thử bỏ bộ lọc hoặc thêm một lần bảo trì mới." Style="{StaticResource HospitalMuted}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
     <Border Grid.Row="2" BorderBrush="{StaticResource HospitalBorder}" BorderThickness="0,1,0,0" Padding="16,12"><TextBlock x:Name="txtSoDong" Style="{StaticResource HospitalMuted}"/></Border>
    </Grid>
   </Border>
   <Border x:Name="VungChiTiet" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource HospitalPanel}" Padding="18">
    <Grid>
     <TextBlock x:Name="ChuaChon" Text="Chọn một lần bảo trì để xem nội dung, người phụ trách và lịch hẹn tiếp theo." Style="{StaticResource HospitalMuted}" VerticalAlignment="Center" TextAlignment="Center"/>
     <Grid x:Name="ChiTiet" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14"><ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource HospitalStatusTemplate}"/><StackPanel><TextBlock Text="Chi tiết bảo trì" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding MaBT}" Style="{StaticResource HospitalMuted}" Margin="0,5,0,0"/></StackPanel></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,0,8,0">
        <TextBlock Text="Thiết bị" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ThietBiDayDu}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Phòng sử dụng" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding TenPhong}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Nhân viên phụ trách" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding NhanVien}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Bắt đầu / kết thúc" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ThoiGian}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Nội dung bảo trì" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding NoiDung}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Chi phí" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ChiPhi, StringFormat={}{0:N2} đ}" Style="{StaticResource DetailValue}" FontWeight="SemiBold"/>
        <TextBlock Text="Bảo trì tiếp theo" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LichTiepTheo}" Style="{StaticResource DetailValue}"/>
        <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding GhiChu}" Style="{StaticResource DetailValue}"/>
       </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,12,0,0"><WrapPanel><Button Content="Cập nhật" IsEnabled="{Binding ChoSua}" Click="Sua_Click" Style="{StaticResource HospitalPrimary}"/><Button Content="Xóa bản nháp" IsEnabled="{Binding ChoXoa}" Click="Xoa_Click"/></WrapPanel><TextBlock Text="Chỉ sửa lần chưa kết thúc; chỉ xóa bản nháp." Style="{StaticResource HospitalMuted}" Margin="0,8,0,0"/></StackPanel>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
