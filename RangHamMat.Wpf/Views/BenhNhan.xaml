<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của BenhNhan.xaml; các vùng liên quan: Grid_BENH_NHAN. -->
<!-- AI hỗ trợ: bổ sung chú thích cho danh sách bệnh nhân và hồ sơ. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow" clinical:ClinicalLayout.IsEnabled="True" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.BenhNhan" Background="#F4F7FB" FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
    <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries>
      <!-- Style PatientRow cho DataGridRow: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
      <Style x:Key="PatientRow" TargetType="DataGridRow"><Setter Property="MinHeight" Value="90"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5EBF3"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#2468CD"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Trigger></Style.Triggers></Style>
      <!-- Style PatientCell cho DataGridCell: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
      <Style x:Key="PatientCell" TargetType="DataGridCell" BasedOn="{StaticResource HospitalTableCell}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="#21344B"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#21344B"/></Trigger></Style.Triggers></Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <!-- Thao tác + Thêm bệnh nhân: gọi AddPatient_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
      <Button x:Name="AddPatientButton" DockPanel.Dock="Right" Content="+ Thêm bệnh nhân" Click="AddPatient_Click" Style="{StaticResource HospitalPrimary}"/>
      <StackPanel><TextBlock Text="Bệnh nhân" Style="{StaticResource HospitalHeading}"/><TextBlock Text="Hồ sơ bệnh nhân / Thông tin và quá trình khám" Style="{StaticResource HospitalMuted}" Margin="0,4,0,0"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="270" MaxWidth="420"/><ColumnDefinition Width="12"/><ColumnDefinition Width="7*" MinWidth="460"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource HospitalPanel}" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12"><TextBlock Text="Danh sách bệnh nhân" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Tìm mã, tên, điện thoại hoặc ngày sinh" Style="{StaticResource HospitalMuted}" Margin="0,4,0,6"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" MinHeight="34" AutomationProperties.Name="Tìm bệnh nhân theo mã, tên, điện thoại, ngày sinh"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Giới tính" Style="{StaticResource HospitalMuted}" Margin="0,0,0,4"/><ComboBox x:Name="GenderFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" MinHeight="32"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Nam"/><ComboBoxItem Content="Nữ"/><ComboBoxItem Content="Khác"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Trạng thái" Style="{StaticResource HospitalMuted}" Margin="0,0,0,4"/><ComboBox x:Name="StatusFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" MinHeight="32"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Đang theo dõi"/><ComboBoxItem Content="Ngừng theo dõi"/></ComboBox></StackPanel>
          </Grid>
          <Grid Grid.Row="2">
            <!-- Bảng Grid_BENH_NHAN: các cột Binding đọc dữ liệu từ ItemsSource; chọn dòng mở/thao tác trên bản ghi nguồn, không tự tạo một bản SQL. -->
            <DataGrid x:Name="Grid_BENH_NHAN" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Patient_SelectionChanged" HeadersVisibility="None" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0" CanUserSortColumns="False" RowStyle="{StaticResource PatientRow}" CellStyle="{StaticResource PatientCell}" HorizontalScrollBarVisibility="Disabled" RowHeight="90">
              <DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding HoTenBN}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="14"/><TextBlock Foreground="#687B91" FontSize="12" Margin="0,5,0,0"><Run Text="{Binding MaBN, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SDT, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding NgaySinhHienThi}" FontSize="12" Foreground="#687B91" Margin="0,3,0,0"/><TextBlock Text="{Binding LanKhamGanNhat}" FontSize="12" Foreground="#687B91" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding GioiTinh}" Foreground="#687B91" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ListEmpty" Text="Chưa có bệnh nhân. Thêm bệnh nhân để bắt đầu." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
          <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="RecordCount" Style="{StaticResource HospitalMuted}"/><DockPanel Margin="0,8,0,0"><!-- Thao tác ‹ Trước: gọi Previous_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
          <Button x:Name="PreviousButton" Content="‹ Trước" DockPanel.Dock="Left" Click="Previous_Click" Style="{StaticResource HospitalSecondary}"/><!-- Thao tác Sau ›: gọi Next_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
          <Button x:Name="NextButton" Content="Sau ›" DockPanel.Dock="Right" Click="Next_Click" Style="{StaticResource HospitalSecondary}"/><TextBlock x:Name="PageLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/></DockPanel></StackPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DCE5EF" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Grid Grid.Column="2">
        <Border x:Name="ProfileEmpty" Style="{StaticResource HospitalPanel}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350"><TextBlock Text="Chọn bệnh nhân" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="ProfileEmptyText" Text="Chọn một bệnh nhân ở danh sách để xem hồ sơ, lịch hẹn và lịch sử khám." Style="{StaticResource HospitalMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel></Border>
        <!-- Vùng ProfileHost: hiển thị nội dung/danh sách được code-behind hoặc Binding cung cấp; DataTemplate quyết định cách trình bày mỗi đối tượng. -->
        <ContentControl x:Name="ProfileHost" Visibility="Collapsed"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
