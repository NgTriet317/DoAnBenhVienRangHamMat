<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của CuaSoPhieuHuongDan.xaml; các vùng liên quan: Tiếp nhận và hướng dẫn. -->
<!-- AI hỗ trợ: bổ sung chú thích cho biểu mẫu phiếu hướng dẫn. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.CuaSoPhieuHuongDan">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Phiếu khám bệnh · Thêm mới" Style="{StaticResource Title}" />
      <TextBlock Text="Điền lần lượt từng nhóm thông tin. Dấu * là trường bắt buộc." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <!-- Thành phần EditorTabs. -->
    <TabControl x:Name="EditorTabs" Grid.Row="1">
      <!-- Nhóm Tiếp nhận và hướng dẫn: tách phần xem/nhập của nghiệp vụ này; đổi tab chỉ đổi nội dung đang hiển thị. -->
      <TabItem Header="Tiếp nhận và hướng dẫn" Tag="Table:PHIEU_KHAM_BENH" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1220" HorizontalAlignment="Left" Margin="0,20,12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin tiếp nhận và hướng dẫn" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn bệnh nhân">
                    <TextBlock Text="Bệnh nhân *" Margin="0,0,0,6" />
                    <!-- Trường Mã bệnh nhân (PHIEU_KHAM_BENH.MaBN): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaBN" AutomationProperties.Name="Bệnh nhân" />
                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn hồ sơ bệnh án">
                    <TextBlock Text="Hồ sơ bệnh án *" Margin="0,0,0,6" />
                    <!-- Trường Mã hồ sơ bệnh án (PHIEU_KHAM_BENH.MaHS): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaHS" AutomationProperties.Name="Hồ sơ bệnh án" />
                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn lịch khám">
                    <TextBlock Text="Lịch khám" Margin="0,0,0,6" />
                    <!-- Trường Mã lịch hẹn khám (PHIEU_KHAM_BENH.MaLich): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaLich" AutomationProperties.Name="Lịch khám" />
                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn khoa">
                    <TextBlock Text="Khoa *" Margin="0,0,0,6" />
                    <!-- Trường Mã khoa bệnh viện (PHIEU_KHAM_BENH.MaKhoa): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaKhoa" AutomationProperties.Name="Khoa" />
                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn phòng khám">
                    <TextBlock Text="Phòng khám *" Margin="0,0,0,6" />
                    <!-- Trường Mã phòng (PHIEU_KHAM_BENH.MaPhong): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaPhong" AutomationProperties.Name="Phòng khám" />
                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn bác sĩ">
                    <TextBlock Text="Bác sĩ" Margin="0,0,0,6" />
                    <!-- Trường Mã bác sĩ, liên kết danh mục nhân viên (PHIEU_KHAM_BENH.MaBS): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaBS" AutomationProperties.Name="Bác sĩ" />
                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn dịch vụ">
                    <TextBlock Text="Dịch vụ *" Margin="0,0,0,6" />
                    <!-- Trường Mã dịch vụ (PHIEU_KHAM_BENH.MaDV): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaDV" AutomationProperties.Name="Dịch vụ" />
                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Số thứ tự *" Margin="0,0,0,6" />
                    <!-- Trường Số thứ tự tiếp nhận khám (PHIEU_KHAM_BENH.SoThuTu): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <TextBox Tag="DB:PHIEU_KHAM_BENH.SoThuTu" AutomationProperties.Name="Số thứ tự" />
                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Thời điểm mặc định khi tạo mới.">
                    <TextBlock Text="Thời gian tiếp nhận" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <!-- Trường Thời điểm tiếp nhận tại bệnh viện (PHIEU_KHAM_BENH.ThoiGianTiepNhan): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                      <ContentControl Style="{StaticResource TruongNhapLieu}">
                       <DatePicker Tag="DB:PHIEU_KHAM_BENH.ThoiGianTiepNhan" AutomationProperties.Name="Thời gian tiếp nhận" />
                      </ContentControl>
                      <!-- Ô giờ PHIEU_KHAM_BENH.ThoiGianTiepNhan: nhập HH:mm, ghép với ngày của trường DB cùng tên trong BieuMauHoSo.Read trước khi lưu. -->
                      <ContentControl Style="{StaticResource TruongNhapLieu}" Margin="8,0,0,0" Grid.Column="1">
                       <TextBox Tag="Time:PHIEU_KHAM_BENH.ThoiGianTiepNhan" AutomationProperties.Name="Giờ - Thời gian tiếp nhận" ToolTip="HH:mm:ss" MaxLength="8" />
                      </ContentControl>
                    </Grid>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Lý do khám" Margin="0,0,0,6" />
                    <!-- Trường Lý do đến khám (PHIEU_KHAM_BENH.LyDoKham): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <TextBox Tag="DB:PHIEU_KHAM_BENH.LyDoKham" AutomationProperties.Name="Lý do khám" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </ContentControl>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Nội dung và ghi chú" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ghi chú" Margin="0,0,0,6" />
                    <!-- Trường Ghi chú bổ sung (PHIEU_KHAM_BENH.GhiChu): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <TextBox Tag="DB:PHIEU_KHAM_BENH.GhiChu" AutomationProperties.Name="Ghi chú" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </ContentControl>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin quản lý" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Tự sinh khi lưu">
                    <TextBlock Text="Mã phiếu khám" Margin="0,0,0,6" />
                    <!-- Trường Mã phiếu tiếp nhận khám bệnh (PHIEU_KHAM_BENH.MaPhieu): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. Ô chỉ đọc, không cho nhập lại mã/giá trị nguồn. -->
                    <TextBox Tag="DB:PHIEU_KHAM_BENH.MaPhieu" AutomationProperties.Name="Mã phiếu khám" IsReadOnly="True" Text="Tự sinh" Background="{StaticResource Canvas}" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Trạng thái *" Margin="0,0,0,6" />
                    <!-- Trường Trạng thái nghiệp vụ của bản ghi (PHIEU_KHAM_BENH.TrangThai): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
                     <TextBox Tag="DB:PHIEU_KHAM_BENH.TrangThai" AutomationProperties.Name="Trạng thái" MaxLength="50" />
                    </ContentControl>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="0,18,0,0">
      <WrapPanel>
        <!-- Nút điều hướng DongCuaSo: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
        <Button Content="Quay lại danh sách" Tag="DongCuaSo" />
        <Button Content="Lưu thông tin" IsEnabled="False" Style="{StaticResource Primary}" ToolTip="Bản giao diện chưa kết nối lưu dữ liệu" />
        <!-- Nút điều hướng VeTrangChu: AppWorkspace.Navigate bắt sự kiện Click nổi bọt, dùng CommandParameter nếu cần liên kết cha hoặc bản ghi nguồn. -->
        <Button Content="Về màn hình chính" Tag="VeTrangChu" />
        <TextBlock Text="Bản giao diện • Chưa lưu dữ liệu" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0,0,0" />
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>