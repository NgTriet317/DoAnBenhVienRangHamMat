<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.CuaSoPhieuHuongDan">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Phiếu khám bệnh · Thêm mới" Style="{StaticResource Title}" />
      <TextBlock Text="Điền lần lượt từng nhóm thông tin. Dấu * là trường bắt buộc." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <TabControl x:Name="EditorTabs" Grid.Row="1">
      <TabItem Header="Tiếp nhận và hướng dẫn" Tag="Table:PHIEU_KHAM_BENH" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1220" HorizontalAlignment="Left" Margin="0,20,12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin tiếp nhận và hướng dẫn" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn bệnh nhân">
                    <TextBlock Text="Bệnh nhân *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaBN" AutomationProperties.Name="Bệnh nhân" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn hồ sơ bệnh án">
                    <TextBlock Text="Hồ sơ bệnh án *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaHS" AutomationProperties.Name="Hồ sơ bệnh án" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn lịch khám">
                    <TextBlock Text="Lịch khám" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaLich" AutomationProperties.Name="Lịch khám" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn khoa">
                    <TextBlock Text="Khoa *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaKhoa" AutomationProperties.Name="Khoa" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn phòng khám">
                    <TextBlock Text="Phòng khám *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaPhong" AutomationProperties.Name="Phòng khám" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn bác sĩ">
                    <TextBlock Text="Bác sĩ" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaBS" AutomationProperties.Name="Bác sĩ" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Chọn dịch vụ">
                    <TextBlock Text="Dịch vụ *" Margin="0,0,0,6" />
                    <ComboBox Tag="DB:PHIEU_KHAM_BENH.MaDV" AutomationProperties.Name="Dịch vụ" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Số thứ tự *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:PHIEU_KHAM_BENH.SoThuTu" AutomationProperties.Name="Số thứ tự" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Thời điểm mặc định khi tạo mới.">
                    <TextBlock Text="Thời gian tiếp nhận" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <DatePicker Tag="DB:PHIEU_KHAM_BENH.ThoiGianTiepNhan" AutomationProperties.Name="Thời gian tiếp nhận" />
                      <TextBox Grid.Column="1" Margin="8,0,0,0" Tag="Time:PHIEU_KHAM_BENH.ThoiGianTiepNhan" AutomationProperties.Name="Giờ - Thời gian tiếp nhận" ToolTip="HH:mm:ss" MaxLength="8" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Lý do khám" Margin="0,0,0,6" />
                    <TextBox Tag="DB:PHIEU_KHAM_BENH.LyDoKham" AutomationProperties.Name="Lý do khám" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Nội dung và ghi chú" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Ghi chú" Margin="0,0,0,6" />
                    <TextBox Tag="DB:PHIEU_KHAM_BENH.GhiChu" AutomationProperties.Name="Ghi chú" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Thông tin quản lý" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />
                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Tự sinh khi lưu">
                    <TextBlock Text="Mã phiếu khám" Margin="0,0,0,6" />
                    <TextBox Tag="DB:PHIEU_KHAM_BENH.MaPhieu" AutomationProperties.Name="Mã phiếu khám" IsReadOnly="True" Text="Tự sinh" Background="{StaticResource Canvas}" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Trạng thái *" Margin="0,0,0,6" />
                    <TextBox Tag="DB:PHIEU_KHAM_BENH.TrangThai" AutomationProperties.Name="Trạng thái" MaxLength="50" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="0,18,0,0">
      <WrapPanel>
        <Button Content="Quay lại danh sách" Tag="DongCuaSo" />
        <Button Content="Lưu thông tin" IsEnabled="False" Style="{StaticResource Primary}" ToolTip="Bản giao diện chưa kết nối lưu dữ liệu" />
        <Button Content="Về màn hình chính" Tag="VeTrangChu" />
        <TextBlock Text="Bản giao diện • Chưa lưu dữ liệu" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0,0,0" />
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>