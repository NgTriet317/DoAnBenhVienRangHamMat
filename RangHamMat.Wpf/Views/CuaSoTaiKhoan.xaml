<UserControl x:Class="RangHamMat.Views.CuaSoTaiKhoan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="NhoForm" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#536B84"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
  </UserControl.Resources>
  <StackPanel Margin="19,18,19,14">
    <TextBlock x:Name="lblTieuDe" Text="Thông tin tài khoản" FontSize="19" FontWeight="Bold"
               Foreground="#173550" TextWrapping="Wrap"/>
    <TextBlock x:Name="lblHuongDan" Text="Chọn dòng để sửa hoặc nhấn Thêm để tạo mới."
               FontSize="12" TextWrapping="Wrap" Foreground="#71859B" Margin="0,5,0,16"/>

    <StackPanel x:Name="pnlTaiKhoan">
      <TextBlock Text="Mã tài khoản" Style="{StaticResource NhoForm}"/>
      <TextBox x:Name="txtMaTaiKhoan" Height="38" IsReadOnly="True"
               Background="#F1F4F8" Margin="0,0,0,11"/>
      <TextBlock Text="Tên đăng nhập *" Style="{StaticResource NhoForm}"/>
      <TextBox x:Name="txtTenDangNhap" Height="38" MaxLength="100" Margin="0,0,0,11"/>
      <TextBlock Text="Nhân viên *" Style="{StaticResource NhoForm}"/>
      <ComboBox x:Name="cboNhanVien" Height="38" Margin="0,0,0,11"/>
      <TextBlock Text="Vai trò *" Style="{StaticResource NhoForm}"/>
      <ComboBox x:Name="cboVaiTro" Height="38" Margin="0,0,0,11"/>
      <TextBlock Text="Trạng thái (tự động)" Style="{StaticResource NhoForm}"/>
      <Border BorderBrush="#DCE6F1" Background="#F5F8FC" BorderThickness="1" CornerRadius="7"
              Padding="12,10" Margin="0,0,0,11">
        <TextBlock x:Name="lblTrangThai" Text="Đang hoạt động" Foreground="#15803D"
                   FontSize="13" FontWeight="SemiBold"/>
      </Border>
      <!-- Cấu trúc SQL: CK_TAI_KHOAN_1 chỉ cho phép MaKhoa HOẶC MaPhong có giá trị. -->
      <TextBlock Text="Liên kết khoa / phòng" Style="{StaticResource NhoForm}"/>
      <WrapPanel Margin="0,1,0,11">
        <RadioButton x:Name="rbKhongLienKet" Content="Không liên kết" GroupName="PhamViTaiKhoan"
                     Checked="PhamVi_Checked" IsChecked="True" Margin="0,0,12,6"/>
        <RadioButton x:Name="rbTheoKhoa" Content="Theo khoa" GroupName="PhamViTaiKhoan"
                     Checked="PhamVi_Checked" Margin="0,0,12,6"/>
        <RadioButton x:Name="rbTheoPhong" Content="Theo phòng" GroupName="PhamViTaiKhoan"
                     Checked="PhamVi_Checked" Margin="0,0,0,6"/>
      </WrapPanel>
      <StackPanel x:Name="pnlChonKhoa" Margin="0,0,0,10">
        <TextBlock x:Name="lblChonKhoa" Text="Khoa" Style="{StaticResource NhoForm}"/>
        <ComboBox x:Name="cboKhoa" Height="38" SelectionChanged="cboKhoa_SelectionChanged"/>
      </StackPanel>
      <StackPanel x:Name="pnlChonPhong" Margin="0,0,0,10" Visibility="Collapsed">
        <TextBlock Text="Phòng thuộc khoa đã chọn" Style="{StaticResource NhoForm}"/>
        <ComboBox x:Name="cboPhong" Height="38"/>
      </StackPanel>
      <TextBlock Text="Theo phòng: chọn khoa để lọc phòng; hệ thống chỉ lưu mã phòng vì phòng đã thuộc khoa."
                 FontSize="11" Foreground="#71859B" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="Mật khẩu mới" Style="{StaticResource NhoForm}"/>
      <PasswordBox x:Name="pwdMatKhau" Height="38" MaxLength="128" Margin="0,0,0,11"/>
      <TextBlock Text="Xác nhận mật khẩu" Style="{StaticResource NhoForm}"/>
      <PasswordBox x:Name="pwdXacNhan" Height="38" MaxLength="128" Margin="0,0,0,7"/>
      <TextBlock x:Name="lblMatKhau" Text="Để trống khi sửa nếu không đổi mật khẩu."
                 Foreground="#71859B" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel x:Name="pnlVaiTro" Visibility="Collapsed">
      <!-- Bố cục ngang gọn để các nhóm quyền nằm ngay sau chi tiết vai trò. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Mã vai trò" Style="{StaticResource NhoForm}"/>
          <TextBox x:Name="txtMaVaiTro" Height="38" Background="#F1F4F8"
                   IsReadOnly="True" Margin="0,0,0,12"/>
          <TextBlock Text="Tên vai trò *" Style="{StaticResource NhoForm}"/>
          <TextBox x:Name="txtTenVaiTro" MaxLength="255" Height="38"
                   Margin="0,0,0,12"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Mô tả vai trò" Style="{StaticResource NhoForm}"/>
          <TextBox x:Name="txtMoTa" Height="105" TextWrapping="Wrap"
                   AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                   Margin="0,0,0,8"/>
          <TextBlock Text="Lưu vai trò trước, sau đó chọn quyền các phân hệ bên dưới."
                     FontSize="11" Foreground="#71859B" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </StackPanel>

    <TextBlock x:Name="lblLoi" Foreground="#B42318" TextWrapping="Wrap" FontSize="12"
               Margin="0,14,0,9"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="9"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Hoàn tác" Click="Huy_Click" Padding="8,9"/>
      <Button x:Name="btnLuu" Grid.Column="2" Style="{StaticResource Primary}"
              Content="Lưu thông tin" Padding="8,9" Click="Luu_Click"/>
    </Grid>
  </StackPanel>
</UserControl>
