<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RangHamMat.Views.ChungChiNhanVien">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Chứng chỉ nhân viên" Style="{StaticResource Title}" />
        <TextBlock Text="Quản lý nhiều chứng chỉ trên cùng một nhân viên, theo dõi ngày cấp, nơi cấp và hạn chứng chỉ." Style="{StaticResource Subtitle}" Margin="0,2,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#F4EEFF" CornerRadius="10" Padding="14,8" VerticalAlignment="Top">
        <TextBlock Text="Bảng mới · CHUNG_CHI_NHAN_VIEN" Foreground="#6D45A8" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Tổng chứng chỉ" Foreground="#6D28D9" /><TextBlock Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
      <Border Grid.Column="2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Sắp hết hạn" Foreground="#C2410C" /><TextBlock Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
      <Border Grid.Column="4" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Còn hiệu lực" Foreground="#15803D" /><TextBlock Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FCFAFF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="14" Padding="18">
        <StackPanel>
          <TextBlock Text="Tìm nhân viên" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Chọn nhân viên trước khi xem hoặc thêm chứng chỉ." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14" />
          <TextBox ToolTip="Nhập mã hoặc tên nhân viên" Margin="0,0,0,12" />
          <ComboBox SelectedIndex="0" Margin="0,0,0,16"><ComboBoxItem Content="Tất cả chuyên khoa" /></ComboBox>
          <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <StackPanel><TextBlock Text="Chưa chọn nhân viên" FontWeight="SemiBold" /><TextBlock Text="Thông tin nhân viên sẽ hiển thị tại đây." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
          </Border>
          <Button Content="Mở phân hệ nhân sự" Tag="MoTrang:NhanSu" Margin="0" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="20,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left"><TextBlock Text="Hồ sơ chứng chỉ" Style="{StaticResource SectionTitle}" /><TextBlock Text="Mỗi nhân viên có thể có nhiều chứng chỉ." Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
                <Button Content="+ Thêm chứng chỉ" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="Biểu mẫu minh họa, chưa kết nối dữ liệu" />
              </DockPanel>
            </Border>
            <DataGrid x:Name="Grid_CHUNG_CHI_NHAN_VIEN" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã chứng chỉ" Binding="{Binding MaCC}" Width="125" />
                <DataGridTextColumn Header="Nhân viên" Binding="{Binding MaNV}" Width="120" />
                <DataGridTextColumn Header="Số chứng chỉ" Binding="{Binding SoChungChi}" Width="150" />
                <DataGridTextColumn Header="Tên chứng chỉ" Binding="{Binding TenChungChi}" Width="210" />
                <DataGridTextColumn Header="Ngày cấp" Binding="{Binding NgayCap}" Width="120" />
                <DataGridTextColumn Header="Nơi cấp" Binding="{Binding NoiCap}" Width="170" />
                <DataGridTextColumn Header="Hạn chứng chỉ" Binding="{Binding HanChungChi}" Width="135" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="125" />
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="220" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F7F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="14" Padding="18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Số chứng chỉ" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBox /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Tên chứng chỉ" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBox /></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Trạng thái" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="Còn hiệu lực" /><ComboBoxItem Content="Sắp hết hạn" /><ComboBoxItem Content="Hết hiệu lực" /></ComboBox></StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
