<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RangHamMat.Views.ChungChiNhanVien">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- HEADER -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Chứng chỉ nhân viên" Style="{StaticResource Title}" />
        <TextBlock Text="Quản lý chứng chỉ hành nghề của nhân viên, bác sĩ; theo dõi thời hạn và trạng thái hiệu lực."
                   Style="{StaticResource Subtitle}" Margin="0,2,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#F4EEFF" CornerRadius="10" Padding="14,8" VerticalAlignment="Top">
        <TextBlock Text="Bảng · CHUNG_CHI_NHAN_VIEN" Foreground="#6D45A8" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <!-- STATS -->
    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="Tổng chứng chỉ" Foreground="#6D28D9" />
          <TextBlock x:Name="lblTongChungChi" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="Sắp hết hạn" Foreground="#C2410C" />
          <TextBlock x:Name="lblSapHetHan" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="Còn hiệu lực" Foreground="#15803D" />
          <TextBlock x:Name="lblConHieuLuc" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- MAIN BODY -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- CỘT TRÁI: TÌM & CHỌN NHÂN VIÊN -->
      <Border Grid.Column="0" Background="#FCFAFF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="14" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="Tìm nhân viên" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Chọn nhân viên để xem hoặc thêm chứng chỉ tương ứng." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" />
            <TextBox x:Name="txtTimNhanVien" ToolTip="Nhập mã hoặc tên nhân viên" Margin="0,0,0,10"
                     TextChanged="txtTimNhanVien_TextChanged" Height="38"/>
          </StackPanel>

          <!-- DANH SÁCH NHÂN VIÊN -->
          <ListBox x:Name="lstNhanVien" Grid.Row="1" Margin="0,0,0,12"
                   SelectionChanged="lstNhanVien_SelectionChanged"
                   DisplayMemberPath="HoTen"
                   BorderBrush="{StaticResource Line}" BorderThickness="1"/>

          <!-- CARD THÔNG TIN NHÂN VIÊN ĐANG CHỌN -->
          <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel>
              <TextBlock x:Name="lblNhanVienChonTen" Text="Tất cả nhân viên" FontWeight="SemiBold" />
              <TextBlock x:Name="lblNhanVienChonChiTiet" Text="Hiển thị toàn bộ chứng chỉ" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12"/>
              <Button x:Name="btnXemTatCa" Content="Xem tất cả nhân viên" Height="36" Click="btnXemTatCa_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- CỘT PHẢI: BẢNG CHỨNG CHỈ -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="14" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="20,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                  <TextBlock Text="Hồ sơ chứng chỉ" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Nhấp đúp chuột vào một dòng để xem chi tiết hoặc chỉnh sửa thông tin chứng chỉ."
                             Foreground="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"/>
                </StackPanel>
                <Button x:Name="btnThemChungChi" Content="+ Thêm chứng chỉ" Style="{StaticResource Primary}"
                        DockPanel.Dock="Right" Margin="8,0,0,0" Click="btnThemChungChi_Click"/>
              </DockPanel>
            </Border>

            <DataGrid x:Name="dgvChungChiNhanVien" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MouseDoubleClick="dgvChungChiNhanVien_MouseDoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã chứng chỉ" Binding="{Binding MaCC}" Width="125" />
                <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNV}" Width="110" />
                <DataGridTextColumn Header="Số chứng chỉ" Binding="{Binding SoChungChi}" Width="150" />
                <DataGridTextColumn Header="Tên chứng chỉ" Binding="{Binding TenChungChi}" Width="240" />
                <DataGridTextColumn Header="Ngày cấp" Binding="{Binding NgayCap, StringFormat=dd/MM/yyyy}" Width="120" />
                <DataGridTextColumn Header="Nơi cấp" Binding="{Binding NoiCap}" Width="180" />
                <DataGridTextColumn Header="Hạn chứng chỉ" Binding="{Binding HanChungChi, StringFormat=dd/MM/yyyy}" Width="135" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="125" />
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <!-- BỘ LỌC NHANH Ở DƯỚI -->
        <Border Grid.Row="2" Background="#F7F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Lọc số chứng chỉ" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="12"/>
              <TextBox x:Name="txtLocSoCC" Height="38" TextChanged="txtLocChungChi_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Lọc tên chứng chỉ" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="12"/>
              <TextBox x:Name="txtLocTenCC" Height="38" TextChanged="txtLocChungChi_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Lọc trạng thái" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="12"/>
              <ComboBox x:Name="cboLocTrangThai" SelectedIndex="0" Height="38" SelectionChanged="cboLocTrangThai_SelectionChanged">
                <ComboBoxItem Content="Tất cả"/>
                <ComboBoxItem Content="Còn hiệu lực" />
                <ComboBoxItem Content="Sắp hết hạn" />
                <ComboBoxItem Content="Hết hiệu lực" />
              </ComboBox>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
