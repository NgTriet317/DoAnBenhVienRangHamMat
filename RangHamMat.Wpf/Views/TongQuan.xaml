<UserControl x:Class="RangHamMat.Views.TongQuan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tổng quan hoạt động" Style="{StaticResource Title}"/>
                    <TextBlock Text="Tình hình vận hành và các việc cần chú ý hôm nay" Style="{StaticResource Subtitle}" Margin="0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,9" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="PHIÊN LÀM VIỆC" FontSize="10" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="Tổng quan hôm nay" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="LỊCH HÔM NAY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="24" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/>
                        <TextBlock Text="lượt khám" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="BỆNH NHÂN CHỜ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="08" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/>
                        <TextBlock Text="cần tiếp nhận" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="VẬT TƯ CẢNH BÁO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="05" FontSize="30" FontWeight="SemiBold" Foreground="#B56B17" Margin="0,8,0,0"/>
                        <TextBlock Text="mặt hàng cần kiểm tra" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CÔNG VIỆC HÔM NAY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="17" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/>
                        <TextBlock Text="đầu việc đang theo dõi" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="20,16,20,0">
                            <Button DockPanel.Dock="Right" Content="Mở lịch khám" Tag="MoTrang:LichKham"/>
                            <StackPanel>
                                <TextBlock Text="Lịch trong ngày" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Theo dõi thời gian, người bệnh và trạng thái cuộc hẹn" Style="{StaticResource Subtitle}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1" Margin="0,14,0,0" MinHeight="300" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời gian" Width="105"/>
                                <DataGridTextColumn Header="Bệnh nhân" Width="*"/>
                                <DataGridTextColumn Header="Bác sĩ" Width="150"/>
                                <DataGridTextColumn Header="Phòng" Width="90"/>
                                <DataGridTextColumn Header="Trạng thái" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Cần theo dõi" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Các mục cần được chú ý trong ngày" Style="{StaticResource Subtitle}" Margin="0,3,0,12"/>
                            <Border Background="#F3F7FC" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <DockPanel>
                                    <Border Width="7" Background="{StaticResource Accent}" CornerRadius="3" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Lịch khám cần xác nhận" FontWeight="SemiBold"/>
                                        <TextBlock Text="Kiểm tra các lượt đang chờ" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Background="#FFF8EF" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <DockPanel>
                                    <Border Width="7" Background="#D58A2B" CornerRadius="3" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Vật tư sắp hết" FontWeight="SemiBold"/>
                                        <TextBlock Text="Rà soát mức tồn kho" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Background="#F3F7FC" CornerRadius="6" Padding="10">
                                <DockPanel>
                                    <Border Width="7" Background="#6F7B91" CornerRadius="3" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Thiết bị đến hạn bảo trì" FontWeight="SemiBold"/>
                                        <TextBlock Text="Xem lịch bảo trì thiết bị" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Truy cập nhanh" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Mở các phân hệ thường dùng" Style="{StaticResource Subtitle}" Margin="0,3,0,12"/>
                            <Button Content="Điều phối lịch khám" Tag="MoTrang:LichKham" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                            <Button Content="Hồ sơ bệnh nhân" Tag="MoTrang:BenhNhan" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                            <Button Content="Vật tư và tồn kho" Tag="MoTrang:VatTu" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                            <Button Content="Trang thiết bị" Tag="MoTrang:ThietBi" HorizontalContentAlignment="Left" Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
