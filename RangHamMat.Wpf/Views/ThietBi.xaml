<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.ThietBi">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Trang thiết bị" Style="{StaticResource Title}" />
      <TextBlock Text="Nhấp đúp vào một dòng để xem chi tiết. Chọn Thêm để tạo mới." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,20">
      <Button Content="Bảo trì" Tag="MoTrang:BaoTri" />
    </WrapPanel>
    <TabControl Grid.Row="2">
      <TabItem Header="Thiết bị">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Hiện đủ cột" Tag="ToggleColumns" CommandParameter="THIET_BI" />
              <Button Content="Thêm thiết bị" Tag="MoCuaSo:ThietBi" CommandParameter="THIET_BI" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Thiết bị" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:THIET_BI" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_THIET_BI" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã thiết bị" SortMemberPath="MaTB" Width="155" Binding="{Binding MaTB}" />
                  <DataGridTextColumn Header="Tên thiết bị" SortMemberPath="TenTB" Width="155" Binding="{Binding TenTB}" />
                  <DataGridTextColumn Header="Loại thiết bị" SortMemberPath="LoaiTB" Width="155" Binding="{Binding LoaiTB}" />
                  <DataGridTextColumn Header="Số serial" SortMemberPath="SoSerial" Width="155" Binding="{Binding SoSerial}" />
                  <DataGridTextColumn Header="Ngày mua" SortMemberPath="NgayMua" Width="155" Binding="{Binding NgayMua}" />
                  <DataGridTextColumn Header="Nhà cung cấp" SortMemberPath="MaNCC" Width="155" Binding="{Binding MaNCC}" />
                  <DataGridTextColumn Header="Phòng sử dụng" SortMemberPath="PhongSuDung" Width="155" Visibility="Collapsed" Binding="{Binding PhongSuDung}" />
                  <DataGridTextColumn Header="Số lượng" SortMemberPath="SoLuong" Width="155" Visibility="Collapsed" Binding="{Binding SoLuong}" />
                  <DataGridTextColumn Header="Tình trạng" SortMemberPath="TinhTrang" Width="155" Visibility="Collapsed" Binding="{Binding TinhTrang}" />
                  <DataGridTextColumn Header="Ngày bảo hành" SortMemberPath="NgayBaoHanh" Width="155" Visibility="Collapsed" Binding="{Binding NgayBaoHanh}" />
                  <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="155" Visibility="Collapsed" Binding="{Binding GhiChu}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_THIET_BI}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có thiết bị" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:ThietBi" CommandParameter="THIET_BI" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>