<UserControl x:Class="RangHamMat.Views.NhapXuatVatTu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SoMuc" Color="#152C43"/>
        <SolidColorBrush x:Key="SoPhu" Color="#66788A"/>
        <SolidColorBrush x:Key="SoVien" Color="#DDE5EE"/>
        <Style x:Key="SoNhan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoPhu}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SoGiaTri" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoMuc}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SoKhung" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource SoVien}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="SoChonLoai" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#47637E"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#1664B6"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SoPhieuList" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Vien" Background="#FAFCFE" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="11" Padding="12,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Vien" Property="BorderBrush" Value="#91B5DC"/><Setter TargetName="Vien" Property="Background" Value="#F1F7FD"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Vien" Property="BorderBrush" Value="#3279BC"/><Setter TargetName="Vien" Property="BorderThickness" Value="2"/><Setter TargetName="Vien" Property="Background" Value="#EAF4FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoChiTietGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="39"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="TabMauNghiepVu" TargetType="TabItem">
            <Setter Property="Foreground" Value="#526C86"/>
            <Setter Property="Background" Value="#F1F6FC"/>
            <Setter Property="BorderBrush" Value="#D9E7F5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="KhungTab" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="22,12" Margin="0,0,10,8">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KhungTab" Property="Background" Value="#DFECFD"/>
                                <Setter Property="Foreground" Value="#155DAC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="KhungTab" Property="Background" Value="#165FB7"/>
                                <Setter TargetName="KhungTab" Property="BorderBrush" Value="#165FB7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,12,18,18">
        <TabControl x:Name="tabNghiepVu" SelectionChanged="TabNghiepVu_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource TabMauNghiepVu}">
            <TabItem Header="Sổ chứng từ" FontSize="14" FontWeight="SemiBold">
    <Grid Margin="20,15,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh công việc tối: điều hướng chứng từ, không giống giao diện thẻ KPI của Trang thiết bị / Vật tư. -->
        <Border Grid.Row="0" Background="#152C43" CornerRadius="16" Padding="22,17" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PHÂN HỆ NHẬP / XUẤT VẬT TƯ" Foreground="#91C5EE" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Text="Sổ chứng từ nhập – xuất" Foreground="White" FontWeight="Bold" FontSize="24" Margin="0,4,0,6"/>

                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻  Làm mới" Click="TaiLai_Click" Margin="0,0,8,0" Padding="13,9"/>
                    <Button Content="▤  Hóa đơn NCC" Click="MoHoaDon_Click" Margin="0,0,8,0" Padding="13,9" Background="#E5F0FF" Foreground="#175C9F"/>
                    <Button Content="↓  Nhập kho" Click="MoNhap_Click" Margin="0,0,8,0" Padding="13,9" Background="#DCEFFC" Foreground="#144D80"/>
                    <Button Content="↑  Xuất kho" Click="MoXuat_Click" Padding="13,9" Background="#FFF0DB" Foreground="#95510E"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="390"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- Danh sách theo dạng sổ thời gian, không dùng bảng dữ liệu toàn trang. -->
            <Border Grid.Column="0" Style="{StaticResource SoKhung}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="17,16,17,12">
                        <TextBlock Text="DANH SÁCH CHỨNG TỪ" Foreground="#66788A" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Chọn một phiếu để xem toàn bộ chi tiết" Foreground="#152C43" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,10"/>
                        <TextBox x:Name="txtTimKiem" TextChanged="BoLoc_Changed" ToolTip="Tìm số phiếu, kho, người lập, lý do hoặc mặt hàng" Height="40" Padding="9,7" FontSize="14"/>
                        <TextBlock Text="Tìm theo tên kho, người lập, hàng hóa hoặc số phiếu" Foreground="#8091A3" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="17,0,17,12">
                        <TextBlock Text="LOẠI PHIẾU" Foreground="#526C86" FontSize="13" FontWeight="Bold" Margin="0,0,0,9"/>
                        <WrapPanel Margin="0,0,0,15">
                            <RadioButton x:Name="rbTatCa" Content="Tất cả phiếu" Tag="TatCa" IsChecked="True" GroupName="LoaiPhieu" Style="{StaticResource SoChonLoai}" Checked="LocLoai_Checked"/>
                            <RadioButton x:Name="rbNhap" Content="Phiếu nhập" Tag="Nhap" GroupName="LoaiPhieu" Style="{StaticResource SoChonLoai}" Checked="LocLoai_Checked"/>
                            <RadioButton x:Name="rbXuat" Content="Phiếu xuất" Tag="Xuat" GroupName="LoaiPhieu" Style="{StaticResource SoChonLoai}" Checked="LocLoai_Checked"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kho" Style="{StaticResource SoNhan}" FontSize="13"/>
                                <ComboBox x:Name="cboKho" DisplayMemberPath="Ten" SelectedValuePath="Ma" SelectionChanged="BoLoc_Changed" Height="38" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Trạng thái" Style="{StaticResource SoNhan}" FontSize="13"/>
                                <ComboBox x:Name="cboTrangThai" SelectionChanged="BoLoc_Changed" Height="38" FontSize="14" SelectedIndex="0">
                                    <ComboBoxItem Content="Tất cả"/>
                                    <ComboBoxItem Content="Nháp"/>
                                    <ComboBoxItem Content="Đã ghi sổ"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <ListBox x:Name="lstPhieu" Grid.Row="2" BorderThickness="0" Background="Transparent" Margin="10,0,8,0" Padding="7,2" ItemContainerStyle="{StaticResource SoPhieuList}" SelectionChanged="ChonPhieu_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SoPhieu}" Foreground="#18324B" FontSize="14" FontWeight="Bold"/>
                                        <Border Grid.Column="1" CornerRadius="7" Padding="8,3">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E2F3EC"/><Style.Triggers><DataTrigger Binding="{Binding Loai}" Value="Xuất kho"><Setter Property="Background" Value="#FFF0DB"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding Loai}" FontWeight="SemiBold" FontSize="10">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#187A55"/><Style.Triggers><DataTrigger Binding="{Binding Loai}" Value="Xuất kho"><Setter Property="Foreground" Value="#AB6817"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding TenKho}" Foreground="#334A60" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding NgayHienThi}" Foreground="#71849A" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TrangThai}" Foreground="#5C6F83" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="3" Background="#F4F7FB" BorderBrush="{StaticResource SoVien}" BorderThickness="0,1,0,0" Padding="16,11">
                        <TextBlock x:Name="lblSoPhieu" Text="0 chứng từ" Foreground="#566D82" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Bản xem chứng từ: dùng không gian rộng như tờ phiếu xuất/nhập in giấy. -->
            <Border Grid.Column="2" Style="{StaticResource SoKhung}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="vienLoaiPhieu" Background="#177E66"/>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="panelChuaChon" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="▤" FontSize="53" Foreground="#96B3CB" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chọn một chứng từ" FontSize="21" FontWeight="SemiBold" Foreground="#19334A" HorizontalAlignment="Center" Margin="0,8,0,5"/>
                            <TextBlock Text="Thông tin kho, người lập và các dòng hàng sẽ hiện tại đây. Không cần mở cửa sổ chi tiết." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SoPhu}" FontSize="13"/>
                        </StackPanel>
                        <Grid x:Name="panelChiTiet" Visibility="Collapsed" Margin="22,16,22,17">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CHỨNG TỪ LUÂN CHUYỂN KHO" Foreground="#8494A4" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="lblTieuDe" Text="PHIẾU NHẬP KHO" Foreground="{StaticResource SoMuc}" FontSize="24" FontWeight="Bold" Margin="0,3,0,3"/>
                                    <TextBlock x:Name="lblMaPhieu" Text="—" Foreground="#6C8194" FontSize="12"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#EEF4FA" CornerRadius="9" Padding="12,8" VerticalAlignment="Top">
                                    <TextBlock x:Name="lblTrangThai" Text="—" Foreground="#30546E" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Background="#F5F8FB" CornerRadius="10" Padding="16,13" Margin="0,0,0,13">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="Kho thực hiện" Style="{StaticResource SoNhan}"/><TextBlock x:Name="lblKho" Style="{StaticResource SoGiaTri}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Người lập" Style="{StaticResource SoNhan}"/><TextBlock x:Name="lblNhanVien" Style="{StaticResource SoGiaTri}"/></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="Ngày chứng từ" Style="{StaticResource SoNhan}"/><TextBlock x:Name="lblNgay" Style="{StaticResource SoGiaTri}"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="Tham chiếu / nơi nhận" Style="{StaticResource SoNhan}"/><TextBlock x:Name="lblDoiTac" Style="{StaticResource SoGiaTri}"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"><TextBlock Text="Lý do" Style="{StaticResource SoNhan}"/><TextBlock x:Name="lblLyDo" Style="{StaticResource SoGiaTri}" FontWeight="Normal"/></StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="CHI TIẾT HÀNG HÓA" Foreground="#19334A" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblSoDong" Grid.Column="1" Text="0 dòng" Foreground="#6F8395" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <DataGrid Grid.Row="3" x:Name="gridChiTiet" Style="{StaticResource SoChiTietGrid}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mặt hàng" Binding="{Binding TenHang}" Width="2*" MinWidth="145"/>
                                    <DataGridTextColumn Header="Lô hàng" Binding="{Binding TenLo}" Width="1*" MinWidth="85"/>
                                    <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat={}{0:N3}}" Width="0.85*" MinWidth="75"/>
                                    <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="0.6*" MinWidth="56"/>
                                    <DataGridTextColumn Header="Đơn giá nhập" Binding="{Binding DonGiaHienThi}" Visibility="Collapsed" Width="1*" MinWidth="90"/>
                                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTienHienThi}" Visibility="Collapsed" Width="1*" MinWidth="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="4" BorderBrush="#DDE5EE" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,11,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="lblGhiChu" Foreground="#637689" FontSize="12" TextWrapping="Wrap" MaxWidth="400"/>
                                        <TextBlock Text="Phiếu đã ghi sổ tác động đến tồn kho; phiếu nháp chưa tính vào tồn." Foreground="#8594A4" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="lblTongSoLuong" Text="0 đơn vị" Foreground="#637689" FontSize="12" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="lblThanhTien" Text="—" Foreground="#14664F" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
            </TabItem>
            <TabItem Header="▤   Hóa đơn nhà cung cấp" FontSize="14" FontWeight="SemiBold">
                <ContentControl x:Name="viewHoaDon" Margin="6,8,6,0"/>
            </TabItem>
            <TabItem Header="↓   Phiếu nhập" FontSize="14" FontWeight="SemiBold">
                <ContentControl x:Name="viewNhap" Margin="6,8,6,0"/>
            </TabItem>
            <TabItem Header="↑   Phiếu xuất" FontSize="14" FontWeight="SemiBold">
                <ContentControl x:Name="viewXuat" Margin="6,8,6,0"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
