<UserControl x:Class="RangHamMat.Views.TroLyAI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BongBongChat" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#EAF0F6"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="MaxWidth" Value="720"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LaNguoiDung}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Background" Value="#DCEEF9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="#F3F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="20,16"
                BorderBrush="#DBE3EC" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="btnMoi" DockPanel.Dock="Right"
                        Content="Cuộc trò chuyện mới" Click="LamMoi_Click"
                        Padding="12,7" Background="#E7EEF5"
                        Foreground="#183952" BorderThickness="0"/>
                <StackPanel>
                    <TextBlock Text="Trợ lý AI tiếp nhận" FontSize="22"
                               FontWeight="SemiBold" Foreground="#15354E"/>
                    <TextBlock Text="Trò chuyện AI trong ứng dụng WPF"
                               Margin="0,5,0,0" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ListBox Grid.Row="1" x:Name="lstTinNhan" Margin="16,10"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Style="{StaticResource BongBongChat}">
                            <StackPanel>
                                <TextBlock Text="{Binding NguoiGui}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#486276"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding NoiDung}" TextWrapping="Wrap"
                                           FontSize="14" Foreground="#162C3D"/>
                                <!-- Lựa chọn trả lời nhanh của chính tin nhắn AI -->
                                <ItemsControl ItemsSource="{Binding LuaChon}"
                                              Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Nhan}"
                                                    Click="LuaChon_Click"
                                                    MinHeight="34"
                                                    Padding="12,7"
                                                    Margin="0,0,8,8"
                                                    BorderThickness="1"
                                                    BorderBrush="#ABCEDA"
                                                    Background="White"
                                                    Foreground="#155B75"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Background="White" Padding="16"
                BorderBrush="#DBE3EC" BorderThickness="0,1,0,0">
            <StackPanel>
                <Border x:Name="panelReview" Visibility="Collapsed"
                        Background="#EEF6F8" BorderBrush="#B6D7DF"
                        BorderThickness="1" CornerRadius="10" Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Bản khai AI gửi nhân viên" FontWeight="SemiBold"
                                   Foreground="#15354E" FontSize="15"/>
                        <TextBlock x:Name="txtReview" Margin="0,7,0,10"
                                   TextWrapping="Wrap" Foreground="#263D4D"/>
                        <TextBlock Text="Khi bấm gửi, thông tin bạn khai sẽ được lưu để nhân viên bệnh viện kiểm tra và tiếp nhận. Chưa có phiếu khám hay số thứ tự."
                                   TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button x:Name="btnConfirmReceipt" Content="Gửi bản khai cho nhân viên"
                                    Click="GuiBanKhai_Click" Padding="14,8"
                                    Margin="0,0,8,6" Background="#16708B" Foreground="White"
                                    BorderThickness="0"/>
                            <Button x:Name="btnEditIntake" Content="Sửa thông tin" Click="SuaThongTin_Click"
                                    Padding="14,8" Margin="0,0,8,6"/>
                            <Button x:Name="btnStaffHelp" Content="Gửi thông tin &amp; gặp nhân viên" Click="GapNhanVien_Click"
                                    Padding="14,8" Margin="0,0,8,6"/>

                        </WrapPanel>
                        <TextBlock x:Name="txtReceipt" TextWrapping="Wrap"
                                   Foreground="#155B45" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtNhap" Grid.Column="0" FontSize="15"
                             MinHeight="54" MaxHeight="130" Padding="12,10"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             AcceptsReturn="True" KeyDown="Nhap_KeyDown"
                             ToolTip="Enter để gửi, Shift+Enter để xuống dòng"/>
                    <Button x:Name="btnGui" Grid.Column="1" Content="Gửi"
                            Click="Gui_Click" MinWidth="84" Margin="12,0,0,0"
                            Padding="18,10" Background="#16708B"
                            Foreground="White" BorderThickness="0"/>
                </Grid>
                <TextBlock x:Name="txtTrangThai" Margin="4,8,0,0"
                           Text="Đang tải cấu hình AI..." Foreground="#64748B"
                           TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
