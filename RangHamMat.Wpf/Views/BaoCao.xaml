<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:RangHamMat.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.BaoCao">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Báo cáo và thống kê" Style="{StaticResource Title}" />
      <TextBlock Text="Chuyển giữa bảng và đồ thị. Nguồn bệnh viện và thu–chi kho được trình bày độc lập." Style="{StaticResource Subtitle}" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,18">
      <RadioButton Content="Bảng dữ liệu" GroupName="ReportMode" IsChecked="True" Checked="ViewMode_Changed" Tag="Table" Style="{StaticResource ViewSwitch}" />
      <RadioButton Content="Đồ thị" GroupName="ReportMode" Checked="ViewMode_Changed" Tag="Charts" Style="{StaticResource ViewSwitch}" />
    </WrapPanel>
    <TabControl Grid.Row="2" x:Name="TableView">
      <TabItem Header="Hóa đơn bệnh viện">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Báo cáo sẽ hiển thị khi có dữ liệu." Foreground="{StaticResource Muted}" Margin="0,12,0,20" />
          <DataGrid Grid.Row="1" Tag="Table:HOA_DON" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow" x:Name="Grid_HOA_DON">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Mã hóa đơn" SortMemberPath="MaHD" Width="160" Binding="{Binding MaHD}" />
              <DataGridTextColumn Header="Bệnh nhân" SortMemberPath="MaBN" Width="160" Binding="{Binding MaBN}" />
              <DataGridTextColumn Header="Lần khám" SortMemberPath="MaLS" Width="160" Binding="{Binding MaLS}" />
              <DataGridTextColumn Header="Ngày lập" SortMemberPath="NgayLap" Width="160" Binding="{Binding NgayLap}" />
              <DataGridTextColumn Header="Tổng tiền" SortMemberPath="TongTien" Width="160" Binding="{Binding TongTien}" />
              <DataGridTextColumn Header="Giảm giá (số tiền)" SortMemberPath="GiamGia" Width="160" Binding="{Binding GiamGia}" />
              <DataGridTextColumn Header="Thành tiền" SortMemberPath="ThanhTien" Width="160" Binding="{Binding ThanhTien}" />
              <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="160" Binding="{Binding TrangThai}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Thu bệnh viện">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Báo cáo sẽ hiển thị khi có dữ liệu." Foreground="{StaticResource Muted}" Margin="0,12,0,20" />
          <DataGrid Grid.Row="1" Tag="Table:THANH_TOAN" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow" x:Name="Grid_THANH_TOAN">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Mã thanh toán" SortMemberPath="MaTT" Width="160" Binding="{Binding MaTT}" />
              <DataGridTextColumn Header="Hóa đơn" SortMemberPath="MaHD" Width="160" Binding="{Binding MaHD}" />
              <DataGridTextColumn Header="Ngày thanh toán" SortMemberPath="NgayThanhToan" Width="160" Binding="{Binding NgayThanhToan}" />
              <DataGridTextColumn Header="Số tiền" SortMemberPath="SoTien" Width="160" Binding="{Binding SoTien}" />
              <DataGridTextColumn Header="Phương thức" SortMemberPath="PhuongThuc" Width="160" Binding="{Binding PhuongThuc}" />
              <DataGridTextColumn Header="Người thu" SortMemberPath="NguoiThu" Width="160" Binding="{Binding NguoiThu}" />
              <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="160" Binding="{Binding GhiChu}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Thu–chi kho">
        <TabControl Margin="0,18,0,0">
          <TabItem Header="Thu kho">
            <Grid Margin="0,20,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,18">
                <WrapPanel DockPanel.Dock="Right">
              </WrapPanel>
                <TextBlock Text="Chứng từ thu kho" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
              </DockPanel>
              <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
                <Grid>
                  <DataGrid Tag="Table:HOA_DON_KHO" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_HOA_DON_KHO" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Mã hóa đơn kho" SortMemberPath="MaHDK" Width="155" Binding="{Binding MaHDK}" />
                      <DataGridTextColumn Header="Giao dịch kho" SortMemberPath="MaGD" Width="155" Binding="{Binding MaGD}" />
                      <DataGridTextColumn Header="Phương thức thanh toán" SortMemberPath="PhuongThucThanhToan" Width="155" Binding="{Binding PhuongThucThanhToan}" />
                      <DataGridTextColumn Header="Đơn giá" SortMemberPath="DonGia" Width="155" Binding="{Binding DonGia}" />
                      <DataGridTextColumn Header="Thành tiền" SortMemberPath="ThanhTien" Width="155" Binding="{Binding ThanhTien}" />
                      <DataGridTextColumn Header="Ngày lập" SortMemberPath="NgayLap" Width="155" Binding="{Binding NgayLap}" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasItems, ElementName=Grid_HOA_DON_KHO}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Chưa có chứng từ thu kho" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="Chi kho">
            <Grid Margin="0,20,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,18">
                <WrapPanel DockPanel.Dock="Right">
              </WrapPanel>
                <TextBlock Text="Chứng từ chi kho" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
              </DockPanel>
              <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
                <Grid>
                  <DataGrid Tag="Table:HOA_DON_KHO" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_HOA_DON_KHO_Chi" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Mã hóa đơn kho" SortMemberPath="MaHDK" Width="155" Binding="{Binding MaHDK}" />
                      <DataGridTextColumn Header="Giao dịch kho" SortMemberPath="MaGD" Width="155" Binding="{Binding MaGD}" />
                      <DataGridTextColumn Header="Phương thức thanh toán" SortMemberPath="PhuongThucThanhToan" Width="155" Binding="{Binding PhuongThucThanhToan}" />
                      <DataGridTextColumn Header="Đơn giá" SortMemberPath="DonGia" Width="155" Binding="{Binding DonGia}" />
                      <DataGridTextColumn Header="Thành tiền" SortMemberPath="ThanhTien" Width="155" Binding="{Binding ThanhTien}" />
                      <DataGridTextColumn Header="Ngày lập" SortMemberPath="NgayLap" Width="155" Binding="{Binding NgayLap}" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasItems, ElementName=Grid_HOA_DON_KHO_Chi}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Chưa có chứng từ chi kho" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </TabItem>
      <TabItem Header="Biến động kho">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Báo cáo sẽ hiển thị khi có dữ liệu." Foreground="{StaticResource Muted}" Margin="0,12,0,20" />
          <DataGrid Grid.Row="1" Tag="Table:GIAO_DICH_KHO" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow" x:Name="Grid_GIAO_DICH_KHO">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Mã giao dịch kho" SortMemberPath="MaGD" Width="160" Binding="{Binding MaGD}" />
              <DataGridTextColumn Header="Lô vật tư" SortMemberPath="MaLo" Width="160" Binding="{Binding MaLo}" />
              <DataGridTextColumn Header="Kho" SortMemberPath="MaKho" Width="160" Binding="{Binding MaKho}" />
              <DataGridTextColumn Header="Ngày giao dịch" SortMemberPath="NgayGD" Width="160" Binding="{Binding NgayGD}" />
              <DataGridTextColumn Header="Biến động số lượng lô" SortMemberPath="SoLuongLo" Width="160" Binding="{Binding SoLuongLo}" />
              <DataGridTextColumn Header="Lý do" SortMemberPath="LyDo" Width="160" Binding="{Binding LyDo}" />
              <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="160" Binding="{Binding GhiChu}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Lịch khám">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Báo cáo sẽ hiển thị khi có dữ liệu." Foreground="{StaticResource Muted}" Margin="0,12,0,20" />
          <DataGrid Grid.Row="1" Tag="Table:LICH_KHAM" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow" x:Name="Grid_LICH_KHAM">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Mã lịch khám" SortMemberPath="MaLich" Width="160" Binding="{Binding MaLich}" />
              <DataGridTextColumn Header="Bệnh nhân" SortMemberPath="MaBN" Width="160" Binding="{Binding MaBN}" />
              <DataGridTextColumn Header="Bác sĩ" SortMemberPath="MaBS" Width="160" Binding="{Binding MaBS}" />
              <DataGridTextColumn Header="Ngày giờ khám" SortMemberPath="NgayGioKham" Width="160" Binding="{Binding NgayGioKham}" />
              <DataGridTextColumn Header="Phòng khám" SortMemberPath="MaPhong" Width="160" Binding="{Binding MaPhong}" />
              <DataGridTextColumn Header="Lý do khám" SortMemberPath="LyDoKham" Width="160" Binding="{Binding LyDoKham}" />
              <DataGridTextColumn Header="Dịch vụ" SortMemberPath="MaDV" Width="160" Binding="{Binding MaDV}" />
              <DataGridTextColumn Header="Trạng thái" SortMemberPath="TrangThai" Width="160" Binding="{Binding TrangThai}" />
              <DataGridTextColumn Header="Ghi chú" SortMemberPath="GhiChu" Width="160" Binding="{Binding GhiChu}" />
              <DataGridTextColumn Header="Ngày tạo" SortMemberPath="NgayTao" Width="160" Binding="{Binding NgayTao}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Chi tiết hóa đơn" Visibility="Collapsed" Tag="Child:CHI_TIET_HOA_DON">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Thêm chi tiết hóa đơn" Tag="MoCuaSo:HoaDon" CommandParameter="CHI_TIET_HOA_DON" Style="{StaticResource Primary}" />
            </WrapPanel>
            <TextBlock Text="Chi tiết hóa đơn" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="0" Grid.Row="1">
            <Grid>
              <DataGrid Tag="Table:CHI_TIET_HOA_DON" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" x:Name="Grid_CHI_TIET_HOA_DON" ToolTip="Nhấp đúp vào dòng dữ liệu để xem chi tiết." SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã chi tiết hóa đơn" SortMemberPath="MaCTHD" Width="155" Binding="{Binding MaCTHD}" />
                  <DataGridTextColumn Header="Hóa đơn" SortMemberPath="MaHD" Width="155" Binding="{Binding MaHD}" />
                  <DataGridTextColumn Header="Kế hoạch điều trị" SortMemberPath="MaKHDT" Width="155" Binding="{Binding MaKHDT}" />
                  <DataGridTextColumn Header="Nội dung" SortMemberPath="NoiDung" Width="155" Binding="{Binding NoiDung}" />
                  <DataGridTextColumn Header="Thành tiền" SortMemberPath="ThanhTien" Width="155" Binding="{Binding ThanhTien}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,54,24,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=Grid_CHI_TIET_HOA_DON}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Chưa có chi tiết hóa đơn" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Thông tin sẽ hiển thị tại đây khi có dữ liệu." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,10,0,22" />
                <Button Content="Thêm mới" Tag="MoCuaSo:HoaDon" CommandParameter="CHI_TIET_HOA_DON" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <ScrollViewer x:Name="ChartsView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="Doanh thu bệnh viện" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Theo kỳ báo cáo • VNĐ" Style="{StaticResource Subtitle}" />
            <ui:ChartView x:Name="HospitalChart" PrimaryLabel="Doanh thu bệnh viện" IsLine="True" Height="300" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Thu–chi kho" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Thu và chi trình bày riêng • VNĐ • Không cộng vào doanh thu bệnh viện" Style="{StaticResource Subtitle}" />
            <ui:ChartView x:Name="WarehouseChart" PrimaryLabel="Thu kho" SecondaryLabel="Chi kho" Height="300" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>