                    <TextBox Tag="DB:DICH_VU.MaDV" AutomationProperties.Name="Mã dịch vụ" IsReadOnly="True" Text="Tự sinh" Background="{StaticResource Canvas}" />
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Trạng thái *" Margin="0,0,0,6" />
                    <!-- Trường Trạng thái nghiệp vụ của bản ghi (DICH_VU.TrangThai): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
                    <ContentControl Style="{StaticResource TruongNhapLieu}">
