                    </ContentControl>
                  </StackPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="Số thập phân; tối đa 2 chữ số sau dấu thập phân.">
                    <TextBlock Text="Đơn giá *" Margin="0,0,0,6" />
                    <!-- Trường Đơn giá (DICH_VU.DonGia): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
