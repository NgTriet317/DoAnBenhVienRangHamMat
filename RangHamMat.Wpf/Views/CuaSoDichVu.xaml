                <WrapPanel>
                  <StackPanel Width="270" Margin="0,0,20,20" ToolTip="">
                    <TextBlock Text="Mô tả" Margin="0,0,0,6" />
                    <!-- Trường Mô tả thông tin danh mục (DICH_VU.MoTa): cơ chế form đọc/điền control qua Tag DB khi Configure/Read, dữ liệu chỉ được ghi khi lưu form. -->
