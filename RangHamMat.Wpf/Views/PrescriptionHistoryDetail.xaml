<UserControl x:Class="RangHamMat.Views.PrescriptionHistoryDetail"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Style="{StaticResource HospitalPanel}" Padding="16">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock x:Name="SourceText" Style="{StaticResource HospitalSection}" TextWrapping="Wrap"/>
    <TextBlock x:Name="PatientText" TextWrapping="Wrap" Margin="0,8,0,4"/>
    <WrapPanel Margin="0,4,0,8">
     <Button x:Name="PrintRxButton" Content="Xem / in bản đã ký" Click="PrintRx_Click"/>
     <Button x:Name="ReloadButton" Content="Tải lại đúng đơn" Click="Reload_Click" Margin="8,0,0,0"/>
    </WrapPanel>
   </StackPanel>
   <FlowDocumentScrollViewer x:Name="PrescriptionViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
   <StackPanel Grid.Row="2">
    <Border x:Name="HandoverPanel" BorderBrush="#D8E2EF" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
     <StackPanel>
      <TextBlock Text="Bàn giao thuốc" Style="{StaticResource HospitalSection}"/>
      <TextBlock x:Name="HandoverText" TextWrapping="Wrap" Margin="0,6"/>
      <CheckBox x:Name="ReceiverChecked" Content="Đã đối chiếu họ tên, ngày sinh và mã bệnh nhân với người nhận" Checked="Checks_Changed" Unchecked="Checks_Changed" Margin="0,4"/>
      <CheckBox x:Name="GuidanceChecked" Content="Đã đối chiếu đúng đơn và hướng dẫn sử dụng theo chỉ định đã ký" Checked="Checks_Changed" Unchecked="Checks_Changed" Margin="0,4,0,8"/>
      <Button x:Name="GiveButton" Content="Xác nhận đã giao" Click="Give_Click" Style="{StaticResource HospitalPrimary}" HorizontalAlignment="Left"/>
     </StackPanel>
    </Border>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
