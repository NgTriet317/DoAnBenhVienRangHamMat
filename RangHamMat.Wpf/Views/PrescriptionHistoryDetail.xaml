<!-- Chi tiết đơn đã kê dùng DonThuocTrinhBay làm nguồn binding, kết hợp tra cứu nội dung và bàn giao thuốc. -->
<UserControl x:Class="RangHamMat.Views.PrescriptionHistoryDetail"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" Language="vi-VN" UseLayoutRounding="True">
 <UserControl.Resources><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/PrescriptionStyles.xaml"/></UserControl.Resources>
 <Border BorderBrush="#D8E4EC" BorderThickness="1" CornerRadius="12" Background="#F3F7FA">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- Mã đơn, trạng thái và mã lần khám giúp đối chiếu nguồn; nút in và tải lại gọi code-behind. -->
   <Border Background="{StaticResource RxNavy}" CornerRadius="11,11,0,0" Padding="18,16">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="34" Height="38" CornerRadius="8" Background="#2C586E" HorizontalAlignment="Left" VerticalAlignment="Top"><Path Data="{StaticResource RxTooth}" Stroke="#E6F6F7" StrokeThickness="1.5" Width="21" Height="26" Stretch="Uniform"/></Border>
      <StackPanel Grid.Column="1">
       <TextBlock Text="HỒ SƠ CHỈ ĐỊNH THUỐC" FontSize="10" Foreground="#B8D2DE" FontWeight="SemiBold"/>
       <TextBlock x:Name="SourceText" Text="{Binding TieuDe}" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
     </Grid>
     <WrapPanel Margin="46,12,0,0">
      <Border CornerRadius="5" Padding="8,4" Margin="0,0,8,4">
       <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#DDF2EE"/><Style.Triggers><DataTrigger Binding="{Binding TrangThai}" Value="Ngừng áp dụng"><Setter Property="Background" Value="#FFF0D5"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <TextBlock x:Name="PrescriptionStatus" Text="{Binding TrangThai}" Foreground="#285A54" FontSize="10" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Text="{Binding MaLanKham, StringFormat=Lần khám {0}}" Foreground="#D0E2EB" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,4"/>
     </WrapPanel>
     <WrapPanel Margin="0,10,0,0">
      <Button x:Name="PrintRxButton" Content="Xem bản in / PDF" Click="PrintRx_Click" Style="{StaticResource RxWhiteButton}" FontSize="12" Margin="0,0,8,0"/>
      <Button x:Name="ReloadButton" Content="Tải lại" Click="Reload_Click" Style="{StaticResource RxWhiteButton}" FontSize="12" Margin="0"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <!-- Vùng nội dung chỉ đọc gồm bệnh nhân, chẩn đoán và các dòng thuốc của đơn đang chọn. -->
   <ScrollViewer x:Name="PrescriptionViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16">
     <Border Style="{StaticResource RxPaperCard}" Padding="16">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Background="#EEF3F7" CornerRadius="4" Padding="7,4" Margin="8,0,0,0" VerticalAlignment="Top"><TextBlock Text="{Binding MaBenhNhan}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource RxMuted}"/></Border>
        <StackPanel><TextBlock Text="THÔNG TIN NGƯỜI BỆNH" Style="{StaticResource RxEyebrow}"/><TextBlock x:Name="PatientText" Text="{Binding TenBenhNhan}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource RxNavy}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
       </DockPanel>
       <Border BorderBrush="#E6EDF2" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,12,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock Text="NGÀY SINH" Style="{StaticResource RxEyebrow}"/><TextBlock x:Name="PatientBirthText" Text="{Binding NgaySinh}" Style="{StaticResource RxBody}" Margin="0,3,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="ĐIỆN THOẠI" Style="{StaticResource RxEyebrow}"/><TextBlock Text="{Binding DienThoaiHienThi}" Style="{StaticResource RxBody}" Margin="0,3,0,0"/></StackPanel>
         <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="BÁC SĨ KÊ ĐƠN" Style="{StaticResource RxEyebrow}"/><TextBlock x:Name="DoctorText" Text="{Binding TenBacSi}" Style="{StaticResource RxBody}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
         <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="THỜI ĐIỂM KÊ" Style="{StaticResource RxEyebrow}"/><TextBlock x:Name="PrescribedDateText" Text="{Binding NgayKe}" Style="{StaticResource RxBody}" Margin="0,3,0,0"/></StackPanel>
        </Grid>
       </Border>
      </StackPanel>
     </Border>
     <Border Background="#EAF3F6" BorderBrush="#167D8D" BorderThickness="3,0,0,0" Padding="13,11" Margin="0,14,0,19">
      <StackPanel><TextBlock Text="01   CHẨN ĐOÁN" Style="{StaticResource RxEyebrow}" Foreground="{StaticResource RxTeal}"/><TextBlock Text="{Binding ChanDoanHienThi}" Style="{StaticResource RxBody}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <DockPanel Margin="0,0,0,12">
      <Border DockPanel.Dock="Right" Background="#DFEDF2" CornerRadius="5" Padding="8,4"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RxNavy}"><Run Text="{Binding SoLoaiThuoc, Mode=OneWay}"/> loại thuốc</TextBlock></Border>
      <StackPanel><TextBlock Text="02   NỘI DUNG KÊ ĐƠN" Style="{StaticResource RxEyebrow}" Margin="0,0,0,4"/><TextBlock Text="Thuốc và cách sử dụng" Foreground="{StaticResource RxNavy}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
     </DockPanel>
     <!-- Các dòng thuốc dùng mẫu RxMedicineCard chung, giữ nguyên liều và hướng dẫn từ nguồn đơn. -->
     <ItemsControl x:Name="MedicationList" ItemsSource="{Binding CacThuoc}" ItemTemplate="{StaticResource RxMedicineCard}"/>
     <Border Background="#FBF8F1" BorderBrush="#DDC694" BorderThickness="3,0,0,0" Padding="13,12" Margin="0,4,0,0" Visibility="{Binding CoGhiChu, Converter={StaticResource RxVisible}}">
      <StackPanel><TextBlock Text="03   GHI CHÚ CỦA BÁC SĨ" Style="{StaticResource RxEyebrow}" Foreground="#8D6835"/><TextBlock Text="{Binding GhiChu}" Style="{StaticResource RxBody}" Margin="0,6,0,0"/></StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <!-- Bàn giao chỉ được bật khi quyền và hợp đồng thanh toán cho phép; hai ô xác nhận được Checks_Changed theo dõi. -->
   <Border x:Name="HandoverPanel" Grid.Row="2" Background="White" BorderBrush="#DCE7EE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="16,0,16,0">
    <Expander IsExpanded="True" HorizontalContentAlignment="Stretch">
     <Expander.Header><StackPanel Margin="4,0,0,0"><TextBlock Text="Bàn giao thuốc" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RxNavy}"/><TextBlock x:Name="HandoverText" FontSize="11" Foreground="{StaticResource RxMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Expander.Header>
     <StackPanel Margin="0,10,0,0">
      <CheckBox x:Name="ReceiverChecked" Checked="Checks_Changed" Unchecked="Checks_Changed" Margin="0,4"><TextBlock Text="Đã đối chiếu họ tên, ngày sinh và mã bệnh nhân với người nhận" FontSize="12" TextWrapping="Wrap"/></CheckBox>
      <CheckBox x:Name="GuidanceChecked" Checked="Checks_Changed" Unchecked="Checks_Changed" Margin="0,4,0,10"><TextBlock Text="Đã đối chiếu đúng đơn và hướng dẫn sử dụng theo chỉ định đã ký" FontSize="12" TextWrapping="Wrap"/></CheckBox>
      <Button x:Name="GiveButton" Content="Xác nhận đã giao" Click="Give_Click" Style="{StaticResource HospitalPrimary}" HorizontalAlignment="Left"/>
     </StackPanel>
    </Expander>
   </Border>
   <!-- Thông báo tải đơn, quyền in hoặc kết quả thao tác được cập nhật trong code-behind. -->
   <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="11" Foreground="{StaticResource RxMuted}" TextWrapping="Wrap" Margin="16,9,16,12" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Border>
</UserControl>
