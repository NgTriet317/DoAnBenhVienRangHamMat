<UserControl x:Class="RangHamMat.Views.KeDonThuocEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:clinical="clr-namespace:RangHamMat.Controls.ClinicalWorkflow" clinical:ClinicalLayout.IsEnabled="True" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F3F6FA">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="MainSurface" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="RxHeader" Margin="0,0,0,10"><TextBlock Text="Kê thuốc trong lần khám" Style="{StaticResource HospitalHeading}"/><ComboBox x:Name="VisitPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Visit_Changed" Visibility="Collapsed"/><TextBlock x:Name="PatientHeader" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="VisitHeader" TextWrapping="Wrap" Foreground="#64748B" Margin="0,4"/><Expander Header="Dị ứng và tiền sử — đối chiếu trước khi ký"><TextBlock x:Name="SafetyHeader" TextWrapping="Wrap" Foreground="#9A3412" Margin="0,8"/></Expander></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource HospitalPanel}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Danh mục thuốc theo nhóm" Style="{StaticResource HospitalSection}"/>
    <WrapPanel Margin="0,8"><StackPanel Width="240" Margin="0,0,10,6"><TextBlock Text="Nhóm thuốc" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GroupChoice" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Group_Changed"/></StackPanel><StackPanel Width="210" Margin="0,0,10,6"><TextBlock Text="Tên hoặc mã thuốc" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DrugSearch"/></StackPanel><Button x:Name="SearchButton" Content="Tìm thuốc" Click="Search_Click" VerticalAlignment="Bottom" Margin="0,18,0,6"/></WrapPanel>
    <Expander Header="Lọc thêm hàm lượng và đơn vị"><WrapPanel Margin="0,6"><StackPanel Width="180" Margin="0,0,12,0"><TextBlock Text="Hàm lượng"/><TextBox x:Name="StrengthFilter"/></StackPanel><StackPanel Width="180"><TextBlock Text="Đơn vị cấp phát"/><TextBox x:Name="FormFilter"/></StackPanel></WrapPanel></Expander>
    <DataGrid x:Name="DrugGrid" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" SelectionMode="Extended" MinHeight="100" MaxHeight="180" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Thuốc" Binding="{Binding TenThuoc}" Width="230"/><DataGridTextColumn Header="Hàm lượng" Binding="{Binding HamLuong}" Width="110"/><DataGridTextColumn Header="Nhóm" Binding="{Binding TenNhomThuoc}" Width="180"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding DonViTinh}" Width="70"/><DataGridTextColumn Header="Giá tham khảo" Binding="{Binding GiaHienThi}" Width="150"/><DataGridTextColumn Header="Tồn" Binding="{Binding TonThamKhao,StringFormat=0.###}" Width="70"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Thuốc chưa thiết lập giá cần được cập nhật trước khi lập hóa đơn. Kê đơn không giữ hoặc trừ tồn kho." TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,8"/><Button x:Name="AddSelectedButton" Content="+ Thêm thuốc đã chọn vào đơn" Click="Add_Click" HorizontalAlignment="Left"/>
   </StackPanel></Border>
   <Border Style="{StaticResource HospitalPanel}"><StackPanel><TextBlock Text="Đơn thuốc của lần khám" Style="{StaticResource HospitalSection}"/><ComboBox x:Name="OrderChoice" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Order_Changed" Margin="0,8"/><TextBlock x:Name="OrderHeader" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/><WrapPanel><Button x:Name="NewButton" Content="Đơn mới / bổ sung" Click="New_Click"/><Button x:Name="ReplaceButton" Content="Soạn đơn thay thế" Click="Replace_Click" Margin="8,0,0,0"/></WrapPanel>
    <DataGrid x:Name="RxLines" MinHeight="120" MaxHeight="240" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="Line_Edit" Margin="0,10"><DataGrid.Resources><Style x:Key="RxWrappedCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Thuốc / hàm lượng / đơn vị" Binding="{Binding TenHienThi}" ElementStyle="{StaticResource RxWrappedCell}" IsReadOnly="True" Width="230"/><DataGridTextColumn Header="Liều dùng" Binding="{Binding LieuDung,UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource RxWrappedCell}" Width="160"/><DataGridTextColumn Header="Đường dùng" Binding="{Binding DuongDung,UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="Hướng dẫn" Binding="{Binding HuongDan,UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource RxWrappedCell}" Width="230"/><DataGridTextColumn Header="Số ngày" Binding="{Binding SoNgayDung,ValidatesOnExceptions=True,UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong,ValidatesOnExceptions=True,UpdateSourceTrigger=PropertyChanged}" Width="80"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="Chọn dòng và nhấn Delete để bỏ thuốc khỏi nháp. Bác sĩ nhập liều và hướng dẫn theo người bệnh." TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
    <Expander Header="Ghi chú / lý do thay hoặc bổ sung đơn" Margin="0,10,0,0"><StackPanel><TextBlock Text="Lý do thay đơn (nếu có)"/><TextBox x:Name="ReplacementReason" TextChanged="Input_Changed" TextWrapping="Wrap"/><TextBlock Text="Ghi chú / lý do đơn bổ sung" Margin="0,8,0,0"/><TextBox x:Name="NoteEditor" TextChanged="Input_Changed" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="45"/></StackPanel></Expander>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B91C1C"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#15803D" Margin="0,4,0,6"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Hủy nháp" Click="Cancel_Click"/><Button x:Name="PrintButton" Content="Xem / in đơn đã ký" Click="Print_Click"/><Button x:Name="SaveButton" Content="Lưu nháp" Click="Save_Click"/><Button x:Name="SignButton" Content="Ký đơn thuốc" Click="Sign_Click" Style="{StaticResource HospitalPrimary}"/></WrapPanel></StackPanel>
 </Grid>
</UserControl>
