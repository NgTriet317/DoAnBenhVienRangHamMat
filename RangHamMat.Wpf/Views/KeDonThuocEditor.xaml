<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Views.KeDonThuocEditor" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F3F6FA">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid x:Name="MainSurface" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Cấu hình hướng dẫn" Click="Guidance_Click"/><Button x:Name="ReloadButton" Content="Tải lại (bỏ nháp)" Click="Reload_Click" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="Kê đơn thuốc" Style="{StaticResource HospitalHeading}"/></DockPanel>
   <ComboBox x:Name="VisitPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Visit_Changed" Margin="0,10,0,8" MinHeight="36"/><TextBlock x:Name="PatientHeader" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="VisitHeader" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SafetyHeader" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Chọn thuốc — giá/tồn là tham khảo" FontWeight="SemiBold"/><TextBlock Text="Nhóm kê đơn" Margin="0,8,0,4"/><ComboBox x:Name="GroupChoice" DisplayMemberPath="Label" SelectedValuePath="Value"/>
     <TextBlock Text="Mã hoặc tên thuốc" Margin="0,8,0,4"/><TextBox x:Name="DrugSearch"/><WrapPanel Margin="0,8,0,0"><StackPanel Width="140"><TextBlock Text="Hàm lượng"/><TextBox x:Name="StrengthFilter"/></StackPanel><StackPanel Width="145" Margin="8,0,0,0"><TextBlock Text="Đơn vị/dạng cấp phát"/><TextBox x:Name="FormFilter"/></StackPanel></WrapPanel><Button x:Name="SearchButton" Content="Tìm thuốc" Click="Search_Click" Margin="0,8,0,8"/>
    </StackPanel>
    <DataGrid x:Name="DrugGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" MinRowHeight="36"><DataGrid.Columns>
     <DataGridTextColumn Header="Thuốc" Binding="{Binding TenThuoc}" Width="180"/><DataGridTextColumn Header="Hàm lượng" Binding="{Binding HamLuong}" Width="90"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding DonViTinh}" Width="70"/><DataGridTextColumn Header="Giá" Binding="{Binding DonGiaThamKhao,StringFormat=N0}" Width="80"/><DataGridTextColumn Header="Tồn" Binding="{Binding TonThamKhao}" Width="75"/>
    </DataGrid.Columns></DataGrid><Button x:Name="AddSelectedButton" Grid.Row="2" Content="Thêm các thuốc đã chọn" Click="Add_Click" Margin="0,10,0,0"/>
   </Grid></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><ComboBox x:Name="OrderChoice" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Order_Changed" MinHeight="36"/><TextBlock x:Name="OrderHeader" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,8"/><WrapPanel Margin="0,0,0,8"><Button x:Name="NewButton" Content="Đơn mới/bổ sung" Click="New_Click"/><Button x:Name="ReplaceButton" Content="Soạn đơn thay thế" Click="Replace_Click" Margin="8,0"/><Button x:Name="ApplyGuidanceButton" Content="Áp hướng dẫn đã duyệt" Click="ApplyGuidance_Click"/><Button x:Name="UnlinkButton" Content="Bỏ mẫu, giữ chỉ định nhập" Click="Unlink_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel>
    <DataGrid x:Name="RxLines" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" MinRowHeight="38" CellEditEnding="Line_Edit"><DataGrid.Resources><Style x:Key="RxWrappedCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGrid.Resources><DataGrid.Columns>
     <DataGridTextColumn Header="Thuốc / hàm lượng / đơn vị" ElementStyle="{StaticResource RxWrappedCell}" Binding="{Binding TenHienThi}" IsReadOnly="True" Width="230"/><DataGridTextColumn Header="Liều dùng" ElementStyle="{StaticResource RxWrappedCell}" Binding="{Binding LieuDung}" Width="160"/><DataGridTextColumn Header="Đường dùng" ElementStyle="{StaticResource RxWrappedCell}" Binding="{Binding DuongDung}" Width="110"/>
     <DataGridTextColumn Header="Hướng dẫn" ElementStyle="{StaticResource RxWrappedCell}" Binding="{Binding HuongDan}" Width="240"/><DataGridTextColumn Header="Ngày" Binding="{Binding SoNgayDung,ValidatesOnExceptions=True}" Width="60"/><DataGridTextColumn Header="Lượng" Binding="{Binding SoLuong,ValidatesOnExceptions=True}" Width="70"/><DataGridTextColumn Header="Mẫu v" Binding="{Binding PhienBanHuongDan}" IsReadOnly="True" Width="65"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="Lý do thay đơn (khi có nguồn thay)"/><TextBox x:Name="ReplacementReason" TextChanged="Input_Changed" TextWrapping="Wrap"/><TextBlock Text="Ghi chú / lý do đơn bổ sung" Margin="0,8,0,0"/><TextBox x:Name="NoteEditor" TextChanged="Input_Changed" TextWrapping="Wrap"/><TextBlock Text="Kê đơn không giữ/trừ tồn. Lưu nháp cần đủ chỉ định; chỉ bản ký mới được in. Đơn cũ giữ hiệu lực tới khi ký đơn thay thế." TextWrapping="Wrap" Foreground="#475569" Margin="0,8,0,0"/></StackPanel>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="ErrorText" Foreground="#B91C1C" TextWrapping="Wrap"/><DockPanel Margin="0,8,0,0"><WrapPanel DockPanel.Dock="Right"><Button x:Name="CancelButton" Content="Hủy nháp" Click="Cancel_Click"/><Button x:Name="PrintButton" Content="Xem/in bản ký" Click="Print_Click" Margin="8,0"/><Button x:Name="SaveButton" Content="Lưu nháp" Click="Save_Click"/><Button x:Name="SignButton" Content="Ký đơn thuốc" Click="Sign_Click" Style="{StaticResource HospitalPrimary}" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></StackPanel>
 </Grid><ContentControl x:Name="GuidanceHost" Visibility="Collapsed"/></Grid>
</UserControl>
