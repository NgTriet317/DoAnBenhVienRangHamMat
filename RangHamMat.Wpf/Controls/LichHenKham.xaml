<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích bố cục XAML, nguồn binding, trường nhập và kết nối sự kiện sang code-behind của LichHenKham.xaml. -->
<!-- AI hỗ trợ: bổ sung chú thích cho Lịch ngày/tuần/tháng dựng bằng binding XAML; tính các thẻ và phát sự kiện cho màn hình cha mở/sửa/tạo lịch hoặc đổi trạng thái.. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.Controls.LichHenKham" SizeChanged="Board_SizeChanged">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/KieuHienThiHoSo.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
      <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/KieuHienThiHoSo.xaml"/></ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
      <ContextMenu x:Key="AppointmentMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="Chi tiết lịch hẹn" Click="Details_Click"/>
        <MenuItem Header="Sửa / Hẹn lại" Click="Reschedule_Click"/>
        <Separator/>
        <MenuItem Header="Nháp / Chờ xác nhận" Tag="Nháp" Click="Status_Click"/>
        <MenuItem Header="Đã xác nhận" Tag="Đã xác nhận" Click="Status_Click"/>
        <MenuItem Header="Chờ khám" Tag="Chờ khám" Click="Status_Click"/>
        <MenuItem Header="Hoàn thành" Tag="Hoàn thành" Click="Status_Click"/>
        <MenuItem Header="Hủy hẹn" Tag="Hủy" Click="Status_Click"/>
      </ContextMenu>
      <!-- Style AppointmentButton cho Button: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource BaseButton} để dùng chung template và hành vi control. -->
      <Style x:Key="AppointmentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{Binding Surface}"/><Setter Property="Foreground" Value="{Binding Ink}"/>
        <Setter Property="BorderBrush" Value="{Binding Stripe}"/><Setter Property="BorderThickness" Value="4,0,0,0"/>
        <Setter Property="Margin" Value="1,1,3,2"/><Setter Property="Padding" Value="7,4"/>
        <Setter Property="MinHeight" Value="0"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="ContextMenu" Value="{StaticResource AppointmentMenu}"/>
        <Setter Property="ToolTip" Value="{Binding AccessibilityLabel}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderThickness" Value="4,1,1,1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <!-- Template TimedAppointment: trình bày đối tượng trong Content/ItemsSource bằng các Binding, không tự truy vấn hoặc lưu SQL. -->
      <DataTemplate x:Key="TimedAppointment">
        <!-- Thao tác của nút: gọi Appointment_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Style="{StaticResource AppointmentButton}" Click="Appointment_Click" Width="{Binding Width}" Height="{Binding Height}" AutomationProperties.Name="{Binding AccessibilityLabel}">
          <StackPanel ClipToBounds="True"><TextBlock Text="{Binding Patient}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Time}" FontSize="11"/><TextBlock Text="{Binding Doctor}" TextTrimming="CharacterEllipsis" FontSize="11"/><TextBlock Text="{Binding Service}" TextTrimming="CharacterEllipsis" FontSize="11"/><TextBlock Text="{Binding Room}" TextTrimming="CharacterEllipsis" FontSize="10"/></StackPanel>
        </Button>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="White">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12">
      <DockPanel LastChildFill="True">
        <WrapPanel DockPanel.Dock="Right"><!-- Thao tác Ngày: gọi Mode_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Ngày" Tag="Day" Click="Mode_Click"/><!-- Thao tác Tuần: gọi Mode_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Tuần" Tag="Week" Click="Mode_Click"/><!-- Thao tác Tháng: gọi Mode_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Tháng" Tag="Month" Click="Mode_Click"/><!-- Thao tác ＋ Thêm lịch hẹn: gọi Add_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="＋ Thêm lịch hẹn" Click="Add_Click" Style="{StaticResource HoSoPrimary}"/></WrapPanel>
        <WrapPanel VerticalAlignment="Center"><!-- Thao tác ‹: gọi Previous_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="‹" Click="Previous_Click" AutomationProperties.Name="Khoảng trước"/><!-- Thao tác ›: gọi Next_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="›" Click="Next_Click" AutomationProperties.Name="Khoảng sau"/><!-- Thao tác Hôm nay: gọi Today_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
        <Button Content="Hôm nay" Click="Today_Click"/><TextBlock Text="{Binding PeriodTitle}" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource AccentDark}" Margin="6,0" VerticalAlignment="Center"/></WrapPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Visibility="{Binding IsTimeView, Converter={StaticResource BoolVisibility}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="HeaderScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsHitTestVisible="False">
        <Grid Width="{Binding BoardWidth}"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Background="White" Panel.ZIndex="20"><Border.RenderTransform><TranslateTransform X="{Binding HorizontalOffset, ElementName=TimeScroll}"/></Border.RenderTransform></Border><ItemsControl Grid.Column="1" ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Background="{Binding DaySurface}" Padding="4,12"><TextBlock Text="{Binding Heading}" TextAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
      </ScrollViewer>
      <ScrollViewer Grid.Row="1" x:Name="TimeScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="TimeScroll_Changed">
        <Grid Width="{Binding BoardWidth}" Height="{Binding TimeHeight}"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ItemsControl ItemsSource="{Binding TimeLabels}" Panel.ZIndex="20"><ItemsControl.RenderTransform><TranslateTransform X="{Binding HorizontalOffset, ElementName=TimeScroll}"/></ItemsControl.RenderTransform><ItemsControl.ItemTemplate><DataTemplate><Border Height="60" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Background="White"><TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Right" Margin="0,4,9,0"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Grid ClipToBounds="True" Background="{Binding DaySurface}">
              <ItemsControl ItemsSource="{Binding Slots}"><ItemsControl.ItemTemplate><DataTemplate><!-- Thao tác của nút: gọi Slot_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
              <Button Height="60" MinHeight="0" Padding="0" Margin="0" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Click="Slot_Click" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF2FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#D9E9FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <ItemsControl ItemsSource="{Binding Appointments}" ItemTemplate="{StaticResource TimedAppointment}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><!-- Style mặc định cho ContentPresenter: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
              <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle></ItemsControl>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Grid>
      </ScrollViewer>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding IsMonthView, Converter={StaticResource BoolVisibility}}">
      <Grid MinWidth="850"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <UniformGrid Columns="7"><TextBlock Text="Thứ hai" TextAlignment="Center" Padding="8"/><TextBlock Text="Thứ ba" TextAlignment="Center" Padding="8"/><TextBlock Text="Thứ tư" TextAlignment="Center" Padding="8"/><TextBlock Text="Thứ năm" TextAlignment="Center" Padding="8"/><TextBlock Text="Thứ sáu" TextAlignment="Center" Padding="8"/><TextBlock Text="Thứ bảy" TextAlignment="Center" Padding="8"/><TextBlock Text="Chủ nhật" TextAlignment="Center" Padding="8"/></UniformGrid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0" Background="{Binding DaySurface}" MinHeight="130" Padding="4"><StackPanel>
            <!-- Thao tác {Binding MonthHeading}: gọi MonthDay_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
            <Button Content="{Binding MonthHeading}" Click="MonthDay_Click" HorizontalAlignment="Right" Padding="7,4" MinHeight="0" ToolTip="Thêm lịch hẹn ngày này"/>
            <ItemsControl ItemsSource="{Binding Appointments}"><ItemsControl.ItemTemplate><DataTemplate><!-- Thao tác của nút: gọi Appointment_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
            <Button Style="{StaticResource AppointmentButton}" Click="Appointment_Click" Padding="4,3"><TextBlock Text="{Binding MonthLabel}" TextTrimming="CharacterEllipsis" FontSize="11"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <!-- Thao tác ＋: gọi MonthDay_Click trong code-behind; điều kiện và luồng xử lý được chú thích tại hàm đó. -->
            <Button Content="＋" Click="MonthDay_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" MinHeight="24" Padding="2" ToolTip="Thêm lịch hẹn"/>
          </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
