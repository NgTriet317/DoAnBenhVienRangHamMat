<!-- PHẦN AI ĐÃ THỰC HIỆN: AI đã bổ sung giải thích tài nguyên giao diện: màu/font/khoảng cách, style/template control, binding và trigger trạng thái; ghi chú cách các màn hình sử dụng tài nguyên dùng chung. -->
<!-- AI hỗ trợ: bổ sung chú thích cho tài nguyên/bố cục dùng chung TreatmentStyles. XAML khai báo giao diện và binding; các handler được giải thích trong file C# tương ứng. Nhãn này ghi nhận phần hỗ trợ/chú thích; -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ResourceDictionary.MergedDictionaries><!-- Nạp tài nguyên /RangHamMat.Wpf;component/Themes/HospitalStyles.xaml để các control dùng cùng màu, font, template và trạng thái của ứng dụng. -->
<ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/></ResourceDictionary.MergedDictionaries>
<!-- Style mặc định cho Button: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalSecondary} để dùng chung template và hành vi control. -->
<Style TargetType="Button" BasedOn="{StaticResource HospitalSecondary}"><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3,0"/></Style>
<!-- Style TreatmentPrimary cho Button: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalPrimary} để dùng chung template và hành vi control. -->
<Style x:Key="TreatmentPrimary" TargetType="Button" BasedOn="{StaticResource HospitalPrimary}"><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3,0"/></Style>
<!-- Style TreatmentSection cho Expander: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
<Style x:Key="TreatmentSection" TargetType="Expander"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,9"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<!-- Style TreatmentCard cho Expander: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
<Style x:Key="TreatmentCard" TargetType="Expander"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DCE4EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
<!-- Style mặc định cho DataGrid: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalTable} để dùng chung template và hành vi control. -->
<Style TargetType="DataGrid" BasedOn="{StaticResource HospitalTable}"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="RowHeight" Value="44"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E5EAF1"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
<!-- Style mặc định cho DataGridColumnHeader: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalTableHeader} để dùng chung template và hành vi control. -->
<Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HospitalTableHeader}"><Setter Property="Background" Value="#F1F5FA"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderThickness" Value="0"/></Style>
<!-- Style mặc định cho DataGridCell: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalTableCell} để dùng chung template và hành vi control. -->
<Style TargetType="DataGridCell" BasedOn="{StaticResource HospitalTableCell}"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="0"/></Style>
<!-- Style mặc định cho TextBox: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalTextInput} để dùng chung template và hành vi control. -->
<Style TargetType="TextBox" BasedOn="{StaticResource HospitalTextInput}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="7,5"/><Setter Property="FontSize" Value="13"/></Style>
<!-- Style mặc định cho ComboBox: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. Kế thừa {StaticResource HospitalComboInput} để dùng chung template và hành vi control. -->
<Style TargetType="ComboBox" BasedOn="{StaticResource HospitalComboInput}"><Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="13"/></Style>
<!-- Style TreatmentEditorTabs cho TabControl: các Setter định nghĩa thuộc tính hiển thị, Trigger đổi trạng thái khi hover/focus/disabled hoặc dữ liệu đổi. -->
<Style x:Key="TreatmentEditorTabs" TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
