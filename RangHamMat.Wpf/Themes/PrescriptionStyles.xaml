<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries>
 <SolidColorBrush x:Key="RxNavy" Color="#173C54"/>
 <SolidColorBrush x:Key="RxTeal" Color="#167D8D"/>
 <SolidColorBrush x:Key="RxInk" Color="#203B50"/>
 <SolidColorBrush x:Key="RxMuted" Color="#63798C"/>
 <SolidColorBrush x:Key="RxLine" Color="#DCE7EE"/>
 <BooleanToVisibilityConverter x:Key="RxVisible"/>
 <Style x:Key="RxEyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource RxMuted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="RxBody" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource RxInk}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
 <Style x:Key="RxPaperCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource RxLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
 <Style x:Key="RxWhiteButton" TargetType="Button" BasedOn="{StaticResource HospitalSecondary}"><Setter Property="Foreground" Value="{StaticResource RxNavy}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="White"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
 <Geometry x:Key="RxTooth">M12,3 C8,0 2,2 3,9 C4,14 4,21 7,22 C10,23 8,13 12,13 C16,13 14,23 17,22 C20,21 20,14 21,9 C22,2 16,0 12,3 Z M8,5 Q12,7 16,5</Geometry>
 <DataTemplate x:Key="RxMedicineCard">
  <Border Style="{StaticResource RxPaperCard}" Margin="0,0,0,12" Padding="16">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
     <Border Background="#E9F3F5" CornerRadius="6" Width="27" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left"><TextBlock Text="{Binding ThuTu}" Foreground="{StaticResource RxTeal}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" Margin="3,0,12,0"><TextBlock Text="{Binding TenThuoc}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RxNavy}" TextWrapping="Wrap"/><TextBlock Text="{Binding HamLuong}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RxMuted}" Margin="0,4,0,0" Visibility="{Binding CoHamLuong, Converter={StaticResource RxVisible}}"/></StackPanel>
     <Border Grid.Column="2" Background="#EFF6F9" CornerRadius="7" Padding="8,6" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding SoLuong}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource RxNavy}" TextAlignment="Center"/><TextBlock Text="{Binding DonViTinh}" FontSize="11" Foreground="{StaticResource RxMuted}" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid>
    <Grid Margin="37,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="LIỀU DÙNG" Style="{StaticResource RxEyebrow}"/><TextBlock Text="{Binding LieuDung}" Style="{StaticResource RxBody}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="THỜI GIAN" Style="{StaticResource RxEyebrow}" TextAlignment="Center"/><TextBlock Text="{Binding ThoiGianDung}" Style="{StaticResource RxBody}" TextAlignment="Center" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <Grid Margin="37,9,0,0" Visibility="{Binding CoDuongDung, Converter={StaticResource RxVisible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Đường dùng  " FontSize="12" Foreground="{StaticResource RxMuted}" VerticalAlignment="Top" Margin="0,3,0,0"/><Border Grid.Column="1" HorizontalAlignment="Left" Background="#F0F4F7" CornerRadius="4" Padding="8,3"><TextBlock Text="{Binding DuongDung}" Foreground="{StaticResource RxNavy}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/></Border></Grid>
    <Border Background="#F3F8FA" BorderBrush="#DFEBF0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,13,0,0"><StackPanel><TextBlock Text="HƯỚNG DẪN SỬ DỤNG" Style="{StaticResource RxEyebrow}" Foreground="{StaticResource RxTeal}"/><TextBlock Text="{Binding HuongDan}" Style="{StaticResource RxBody}" Margin="0,5,0,0"/></StackPanel></Border>
   </StackPanel>
  </Border>
 </DataTemplate>
</ResourceDictionary>
