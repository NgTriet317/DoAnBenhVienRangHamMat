<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/ClinicalWorkflowStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Scoped to the examination editor; shared input validation and button behavior are retained. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DDE6F1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#21344B"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SectionDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#64758A"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#52657D"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="NoticeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource HospitalTextInput}">
        <Setter Property="Padding" Value="10,9"/>
    </Style>
    <Style x:Key="ClinicalNotesInput" TargetType="TextBox" BasedOn="{StaticResource HospitalTextInput}">
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="MinHeight" Value="96"/>
        <Setter Property="MaxHeight" Value="180"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource HospitalSecondary}">
        <Setter Property="Margin" Value="0,0,8,6"/>
    </Style>
    <Style x:Key="ClinicalPrimary" TargetType="Button" BasedOn="{StaticResource HospitalPrimary}">
        <Setter Property="Margin" Value="0,0,8,6"/>
    </Style>
    <Style x:Key="ClinicalSaveAction" TargetType="Button" BasedOn="{StaticResource ClinicalPrimary}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedIndex, ElementName=ClinicalTabs}" Value="5">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#2468CD"/>
                <Setter Property="BorderBrush" Value="#C3D7F2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ClinicalFooterSurface" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Visibility, ElementName=ReloadClinicalButton}" Value="Collapsed"/>
                    <Condition Binding="{Binding Visibility, ElementName=SaveClinicalButton}" Value="Collapsed"/>
                    <Condition Binding="{Binding Visibility, ElementName=CompleteClinicalButton}" Value="Collapsed"/>
                    <Condition Binding="{Binding Text, ElementName=ClinicalError}" Value=""/>
                    <Condition Binding="{Binding Text, ElementName=ClinicalStatus}" Value=""/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#21344B"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ClinicalTableText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource HospitalTable}">
        <Setter Property="RowHeight" Value="NaN"/>
        <Setter Property="MinRowHeight" Value="44"/>
        <Setter Property="ColumnHeaderHeight" Value="44"/>
        <Setter Property="BorderBrush" Value="#E1E8F2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#ECF0F6"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="ClinicalStep" TargetType="TabItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#64758A"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="StepSurface" Background="Transparent" CornerRadius="7"
                            Padding="{TemplateBinding Padding}" Margin="2"
                            BorderThickness="1" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepNumber" Width="22" Height="22" CornerRadius="11"
                                    Background="#EDF1F6" Margin="0,0,7,0">
                                <TextBlock x:Name="StepNumberText" Text="{TemplateBinding Tag}"
                                           Foreground="#64758A" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StepSurface" Property="Background" Value="#F2F6FC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="StepSurface" Property="Background" Value="#EAF2FF"/>
                            <Setter TargetName="StepNumber" Property="Background" Value="#2468CD"/>
                            <Setter TargetName="StepNumberText" Property="Foreground" Value="White"/>
                            <Setter Property="Foreground" Value="#1D5AAC"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="StepSurface" Property="BorderBrush" Value="#2468CD"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ClinicalStepTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ClinicalStep}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="White" BorderBrush="#DDE6F1" BorderThickness="1"
                                CornerRadius="10" Padding="5" Margin="0,0,0,12">
                            <WrapPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                          ContentSource="SelectedContent" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
