<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.AppWorkspace" Background="{DynamicResource HospitalCanvas}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RangHamMat.Wpf;component/Themes/HospitalStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="ShellBar" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Tag="VeTrangChu" AutomationProperties.Name="Về màn hình chính" Margin="0,0,22,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Path Data="M12,2 L3,11 H6 V21 H10 V15 H14 V21 H18 V11 H21 Z" Style="{StaticResource AppIcon}" Width="18" Height="18" Margin="0,0,8,0"/>
            <TextBlock Text="Màn hình chính" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="AppTitle" Grid.Column="1" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <WrapPanel Grid.Column="2">
          <Button Content="Tải lại dữ liệu" Click="Reload_Click" ToolTip="Đọc lại dữ liệu từ SQL Server"/>
          <TextBlock x:Name="RoleLabel" Grid.Column="2" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" Margin="20,0,0,0"/>
        </WrapPanel>
      </Grid>
    </Border>
    <ContentControl x:Name="Workspace" Grid.Row="1" Margin="24,20"/>
    <Grid x:Name="ModalLayer" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" Grid.RowSpan="2" Visibility="Collapsed" Background="#660F172A" Panel.ZIndex="50">
      <Button Tag="DongCuaSo" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False"/>
      <Border Background="White" CornerRadius="8" x:Name="ModalFrame" Margin="28" MaxWidth="1160" MaxHeight="850" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Background="#F5F6F8" LastChildFill="False">
            <Button Content="✕" Tag="DongCuaSo" DockPanel.Dock="Right" AutomationProperties.Name="Đóng hộp thoại" Margin="8"/>
          </DockPanel>
          <ContentControl x:Name="ModalContent" Grid.Row="1" Margin="20,12,20,20"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
