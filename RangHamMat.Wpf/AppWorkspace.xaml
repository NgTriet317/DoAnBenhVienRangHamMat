<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.AppWorkspace" Background="{StaticResource Canvas}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="32,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Tag="VeTrangChu" AutomationProperties.Name="Về màn hình chính" Margin="0,0,22,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Path Data="M12,2 L3,11 H6 V21 H10 V15 H14 V21 H18 V11 H21 Z" Style="{StaticResource AppIcon}" Width="18" Height="18" Margin="0,0,8,0" />
            <TextBlock Text="Màn hình chính" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="AppTitle" Grid.Column="1" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="RoleLabel" Grid.Column="2" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" Margin="20,0,0,0" />
      </Grid>
    </Border>
    <ContentControl x:Name="Workspace" Grid.Row="1" Margin="32,28" />
  </Grid>
</UserControl>