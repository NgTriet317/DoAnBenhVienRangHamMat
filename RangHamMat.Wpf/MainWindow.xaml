                <TextBlock Text="Hệ thống" TextAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" />
              </StackPanel>
            </Button>
            <Button Tag="BenhNhan" Click="App_Click" Style="{StaticResource AppTile}" AutomationProperties.Name="Hồ sơ bệnh nhân" ToolTip="Mở hồ sơ bệnh nhân" CommandParameter="Khám chữa bệnh">
