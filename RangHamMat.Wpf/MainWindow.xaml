<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RangHamMat.MainWindow" Style="{StaticResource WindowBase}" Title="RHM · Không gian làm việc" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" StateChanged="Window_StateChanged" Background="{StaticResource Canvas}">
  <Grid>
    <Grid x:Name="HomeSurface">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="White" Padding="40,20" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Border Background="{StaticResource Accent}" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
              <Path Data="M6,0 H14 V6 H20 V14 H14 V20 H6 V14 H0 V6 H6 Z" Fill="White" Width="22" Height="22" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Bệnh viện Răng Hàm Mặt" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Không gian làm việc" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Vai trò đang xem" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
            <ComboBox x:Name="RolePicker" AutomationProperties.Name="Vai trò mô phỏng" SelectionChanged="RolePicker_SelectionChanged">
              <ComboBoxItem Content="Quản trị hệ thống" />
              <ComboBoxItem Content="Ban quản lý / Kế toán" />
              <ComboBoxItem Content="Người hướng dẫn bệnh nhân" />
              <ComboBoxItem Content="Bác sĩ" />
              <ComboBoxItem Content="Nhân viên kho / thiết bị" />
            </ComboBox>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,34,40,28" MaxWidth="1372">
          <TextBlock Text="Chào bạn, một ngày làm việc tốt lành." FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Bạn muốn bắt đầu công việc nào hôm nay?" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,10,0,26" />
          <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ứng dụng của bạn" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="Tìm ứng dụng" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
              <TextBox x:Name="AppSearch" TextChanged="AppSearch_TextChanged" AutomationProperties.Name="Tìm ứng dụng" />
            </StackPanel>
          </Grid>
          <WrapPanel x:Name="CategoryFilters" Margin="0,0,0,20">
            <Button Content="Tất cả" Click="Category_Click" CommandParameter="Tất cả" Margin="0,0,8,8" Style="{StaticResource Primary}" />
            <Button Content="Khám chữa bệnh" Click="Category_Click" CommandParameter="Khám chữa bệnh" Margin="0,0,8,8" Style="{StaticResource Quiet}" />
            <Button Content="Nhân sự" Click="Category_Click" CommandParameter="Nhân sự" Margin="0,0,8,8" Style="{StaticResource Quiet}" />
            <Button Content="Kho và thiết bị" Click="Category_Click" CommandParameter="Kho và thiết bị" Margin="0,0,8,8" Style="{StaticResource Quiet}" />
            <Button Content="Tài chính" Click="Category_Click" CommandParameter="Tài chính" Margin="0,0,8,8" Style="{StaticResource Quiet}" />
            <Button Content="Hệ thống" Click="Category_Click" CommandParameter="Hệ thống" Margin="0,0,8,8" Style="{StaticResource Quiet}" />
          </WrapPanel>
          <WrapPanel x:Name="AppGrid" Margin="-8,0,-8,0">
            <Button Tag="TongQuan" Click="App_Click" Style="{StaticResource AppTile}" AutomationProperties.Name="Tổng quan" ToolTip="Mở tổng quan" CommandParameter="Hệ thống">
              <StackPanel>
                <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,10">
                  <Path Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" Style="{StaticResource AppIcon}" />
                </Border>
