                </Border>
                <TextBlock Text="Danh mục dịch vụ" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Height="38" VerticalAlignment="Center" FontSize="14" />
                <TextBlock Text="Hệ thống" TextAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" />
              </StackPanel>
            </Button>
            <Button Tag="TaiKhoan" Click="App_Click" Style="{StaticResource AppTile}" AutomationProperties.Name="Tài khoản và vai trò" ToolTip="Mở tài khoản và vai trò" CommandParameter="Hệ thống">
              <StackPanel>
                <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,10">
                  <Path Data="M5,10 H19 V22 H5 Z M8,10 V6 A4,4 0 0 1 16,6 V10 M12,14 V18" Style="{StaticResource AppIcon}" />
                </Border>
                <TextBlock Text="Tài khoản và vai trò" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Height="38" VerticalAlignment="Center" FontSize="14" />
                <TextBlock Text="Hệ thống" TextAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" />
              </StackPanel>
            </Button>
            <Button Tag="NhatKy" Click="App_Click" Style="{StaticResource AppTile}" AutomationProperties.Name="Nhật ký thao tác" ToolTip="Mở nhật ký thao tác" CommandParameter="Hệ thống">
              <StackPanel>
                <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,10">
                  <Path Data="M5,3 H19 V21 H5 Z M9,7 H15 M9,11 H15 M9,15 H15 M9,18 H12" Style="{StaticResource AppIcon}" />
                </Border>
                <TextBlock Text="Nhật ký thao tác" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Height="38" VerticalAlignment="Center" FontSize="14" />
                <TextBlock Text="Hệ thống" TextAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <TextBlock x:Name="NoApps" Text="Chưa tìm thấy ứng dụng. Hãy thử tên khác hoặc chọn Tất cả." Visibility="Collapsed" Foreground="{StaticResource Muted}" Margin="8,24" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="40,14" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Button Content="Thoát ứng dụng" Click="Exit_Click" DockPanel.Dock="Right" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="AppCount" Foreground="{StaticResource Muted}" />
            <TextBlock Text="Bản giao diện • Chưa kết nối dữ liệu" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
    <ContentControl x:Name="AppHost" Visibility="Collapsed" />
  </Grid>
</Window>