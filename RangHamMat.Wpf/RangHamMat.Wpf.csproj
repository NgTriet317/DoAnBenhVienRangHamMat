<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RangHamMat</RootNamespace>
    <AssemblyName>RangHamMat.Wpf</AssemblyName>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Database\AnhXquang\*.jpg" Link="DuLieu\AnhXquang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Database\AnhXquang\*.json;..\Database\AnhXquang\*.md" Link="DuLieu\NguonAnhXquang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Database\QLBenhVienRangHamMat.sql" Link="Database\QLBenhVienRangHamMat.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Controls\QuyTacNhapLieu.xml" />
    <PackageReference Include="fo-dicom" Version="5.2.6" />
    <PackageReference Include="fo-dicom.Imaging.ImageSharp" Version="5.2.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="..\BUS\BUS.csproj" />
    <ProjectReference Include="..\ET\ET.csproj" />
    <!-- Build backend từ cùng mã nguồn, không chạy các DLL đóng gói cũ trong Git. -->
    <ProjectReference Include="..\RangHamMat.Kiosk.Api\RangHamMat.Kiosk.Api.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;PublishProfile" />
    <None Remove="AI\Config\AiSecrets.local.json" />
    <None Update="AI\Prompts\**\*.md;AI\Config\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="AI\Config\AiSecrets.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="'$(Configuration)' == 'Debug' and Exists('AI\Config\AiSecrets.local.json')" />
  </ItemGroup>
  <Target Name="CopyCurrentKioskBackend" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <CurrentKioskFiles Include="..\RangHamMat.Kiosk.Api\bin\$(Configuration)\net8.0\**\*" Exclude="..\RangHamMat.Kiosk.Api\bin\$(Configuration)\net8.0\publish\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(CurrentKioskFiles)" DestinationFiles="@(CurrentKioskFiles->'$(TargetDir)KioskServer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishCurrentKioskBackend" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <KioskPublishRuntime Condition="'$(RuntimeIdentifier)' == ''">portable</KioskPublishRuntime>
      <KioskPublishRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</KioskPublishRuntime>
      <KioskPublishDirectory>$(MSBuildProjectDirectory)\obj\KioskPublish\$(Configuration)\$(KioskPublishRuntime)\</KioskPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\RangHamMat.Kiosk.Api\RangHamMat.Kiosk.Api.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(KioskPublishDirectory);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false" RemoveProperties="PublishProfile;PublishProfileFullPath;PublishProfileRootFolder" />
    <ItemGroup>
      <PublishedKioskFiles Include="$(KioskPublishDirectory)**\*" />
      <ResolvedFileToPublish Include="@(PublishedKioskFiles)">
        <RelativePath>KioskServer\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
